---
import '../styles/global.css';
import { LayoutGrid, FileText, BookOpen, Bell, TrendingUp, Calculator, Moon, Sun, Search, X, CheckCircle } from '@lucide/astro';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  activeTab?: 'home' | 'syllabus' | 'pyqs' | 'results' | 'notices' | 'cgpa' | 'recheck';
}

const { title, activeTab } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, ''); // Remove trailing slash if any
const siteUrl = 'https://kolhanhub.in';

const pageDescription = Astro.props.description ?? 'Free Kolhan University PYQ (previous year question papers) and NEP 2020 syllabus for Tata College, Chaibasa students. Download exam papers, check results, and get academic resources for Kolhan University 2022 batch — Semester 1 to 8.';

const pageKeywords = Astro.props.keywords ?? 'Kolhan University PYQ, Kolhan University result, Kolhan University syllabus, Kolhan University Chaibasa, Kolhan University question papers download, Tata College Chaibasa, NEP 2020 Kolhan University, FYUGP syllabus Kolhan University, Tata College PYQ, 2022 batch Kolhan University';

const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const pageTitle = `${title} | Kolhan University — Tata College, Chaibasa`;

// Breadcrumb & per-page WebPage structured data
const breadcrumbItems: Array<{name: string; item: string}> = [
  { name: 'Home', item: siteUrl + '/' }
];
const activePageName =
  activeTab === 'pyqs'     ? 'Previous Year Question Papers (PYQ)' :
  activeTab === 'syllabus' ? 'Kolhan University Syllabus' :
  activeTab === 'results'  ? 'Kolhan University Result & Analysis' :
  activeTab === 'notices'  ? 'Notices & Announcements' :
  activeTab === 'cgpa'     ? 'CGPA Calculator' :
  activeTab === 'recheck'  ? 'Answer Sheet Recheck & Photocopy Guide' : null;
if (activePageName && activeTab !== 'home') {
  breadcrumbItems.push({ name: activePageName, item: canonicalUrl });
}

const webPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": pageTitle,
  "description": pageDescription,
  "url": canonicalUrl,
  "inLanguage": "en-IN",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Kolhan University Student Hub — Tata College, Chaibasa",
    "url": siteUrl,
    "potentialAction": {
      "@type": "SearchAction",
      "target": `${siteUrl}/pyqs/?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  "about": {
    "@type": "CollegeOrUniversity",
    "name": "Kolhan University",
    "url": "https://www.kolhanuniversity.ac.in"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems.map((crumb, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": crumb.name,
      "item": crumb.item
    }))
  }
});
---

<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnect to external domains for faster loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Google Fonts: non-blocking load with font-display=swap -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet" /></noscript>


    <!-- Google Analytics: deferred after page load to not block render -->
    <script is:inline>
      window.addEventListener('load', function() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-TV5YZQ3ELX';
        s.async = true;
        document.head.appendChild(s);
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-TV5YZQ3ELX', { 'send_page_view': true });
      });
    </script>

    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="author" content="Tata College Hub" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (WhatsApp / Facebook / Telegram previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Tata College Hub" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Tata College Hub",
        "alternateName": "Tata College Chaibasa Student Portal",
        "description": "Free Kolhan University PYQ (previous year question papers), NEP 2020 syllabus, exam results and notices for Tata College, Chaibasa. For Kolhan University 2022 batch FYUGP students — Semester 1 to 8.",
        "url": "https://kolhanhub.in",
        "sameAs": [],
        "keywords": "Kolhan University PYQ, Kolhan University result, Kolhan University syllabus, Tata College Chaibasa",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Chaibasa",
          "addressRegion": "Jharkhand",
          "addressCountry": "IN"
        },
        "parentOrganization": {
          "@type": "CollegeOrUniversity",
          "name": "Kolhan University",
          "alternateName": "KU Chaibasa",
          "url": "https://www.kolhanuniversity.ac.in"
        }
      }
    </script>

    <!-- Per-page WebPage + BreadcrumbList Structured Data -->
    <script type="application/ld+json" set:html={webPageSchema} />

    <!-- Theme initialization script to run before rendering -->
    <script is:inline>
      const getTheme = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark'; // DEFAULT theme is dark (Midnight Blue Legacy Theme)
      };
      
      const theme = getTheme();
      document.documentElement.setAttribute('data-theme', theme);
    </script>
    
    <style is:global>
      .logo-link {
        transition: opacity var(--transition-fast) !important;
      }
      .logo-link:hover .logo-icon {
        transform: scale(1.06) rotate(-3deg);
        box-shadow: 0 0 20px rgba(99, 102, 241, 0.45);
      }
      .logo-link:hover .logo-text-primary {
        color: var(--accent-primary) !important;
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
      
      <!-- Desktop Sidebar -->
      <aside class="sidebar">
        <a href={`${baseUrl}/`} class="logo-link" style="display: flex; align-items: center; gap: 0.75rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); text-decoration: none; color: inherit;">
          <div class="logo-icon" style="background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%); color: white; width: 40px; height: 40px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 800; font-size: 1.35rem; box-shadow: var(--shadow-glow); transition: all var(--transition-normal);">
            T
          </div>
          <div>
            <h2 style="font-size: 1.1rem; font-weight: 800; tracking: -0.02em; font-family: var(--font-display); margin: 0; transition: color var(--transition-fast);">
              <span style="color: var(--text-primary);" class="logo-text-primary">Tata </span><span style="color: var(--accent-primary);">Hub</span>
            </h2>
            <span style="font-size: 0.7rem; color: var(--text-secondary); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; display: block;">Student Portal</span>
          </div>
        </a>

        <nav style="display: flex; flex-direction: column; gap: 0.5rem; flex: 1;">
          <a href={`${baseUrl}/`} class={`mobile-nav-item ${activeTab === 'home' ? 'active' : ''}`} style="flex-direction: row; justify-content: flex-start; gap: 1rem; padding: 0.75rem 1rem; height: auto;">
            <LayoutGrid /> <span style="font-size: 0.95rem; font-weight: 600;">Home</span>
          </a>
          <a href={`${baseUrl}/pyqs`} class={`mobile-nav-item ${activeTab === 'pyqs' ? 'active' : ''}`} style="flex-direction: row; justify-content: flex-start; gap: 1rem; padding: 0.75rem 1rem; height: auto;">
            <FileText /> <span style="font-size: 0.95rem; font-weight: 600;">PYQs</span>
          </a>
          <a href={`${baseUrl}/syllabus`} class={`mobile-nav-item ${activeTab === 'syllabus' ? 'active' : ''}`} style="flex-direction: row; justify-content: flex-start; gap: 1rem; padding: 0.75rem 1rem; height: auto;">
            <BookOpen /> <span style="font-size: 0.95rem; font-weight: 600;">Syllabus</span>
          </a>
          <a href={`${baseUrl}/notices`} class={`mobile-nav-item ${activeTab === 'notices' ? 'active' : ''}`} style="flex-direction: row; justify-content: flex-start; gap: 1rem; padding: 0.75rem 1rem; height: auto;">
            <Bell /> <span style="font-size: 0.95rem; font-weight: 600;">Notices</span>
          </a>
          <a href={`${baseUrl}/results`} class={`mobile-nav-item ${activeTab === 'results' ? 'active' : ''}`} style="flex-direction: row; justify-content: flex-start; gap: 1rem; padding: 0.75rem 1rem; height: auto;">
            <TrendingUp /> <span style="font-size: 0.95rem; font-weight: 600;">Results</span>
          </a>
          <a href={`${baseUrl}/cgpa`} class={`mobile-nav-item ${activeTab === 'cgpa' ? 'active' : ''}`} style="flex-direction: row; justify-content: flex-start; gap: 1rem; padding: 0.75rem 1rem; height: auto;">
            <Calculator /> <span style="font-size: 0.95rem; font-weight: 600;">CGPA</span>
          </a>
        </nav>

        <div style="border-top: 1px solid var(--border-color); padding-top: 1rem;">
          <button id="theme-toggle-desktop" class="btn btn-secondary" style="width: 100%; justify-content: center; gap: 0.75rem;">
            <span class="theme-icon-container">
              <Sun class="sun-icon" style="display: none;" />
              <Moon class="moon-icon" />
            </span>
            <span style="font-size: 0.9rem; font-weight: 600;">Theme Mode</span>
          </button>
        </div>
      </aside>

      <!-- Main Shell Area -->
      <div style="flex: 1; display: flex; flex-direction: column; min-width: 0;">
        
        <!-- Sticky Header -->
        <header style="background-color: var(--glass-bg); backdrop-filter: blur(var(--glass-blur)); -webkit-backdrop-filter: blur(var(--glass-blur)); border-bottom: 1px solid var(--glass-border); position: sticky; top: 0; z-index: 40; padding: 0.75rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; box-shadow: var(--shadow-sm); height: 68px;">
          <!-- Logo & Branding -->
          <a href={`${baseUrl}/`} class="logo-link" style="display: flex; align-items: center; gap: 0.625rem; text-decoration: none; color: inherit;">
            <div class="logo-icon" style="background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%); color: white; width: 36px; height: 36px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 800; font-size: 1.2rem; box-shadow: var(--shadow-glow); transition: all var(--transition-normal);">
              T
            </div>
            <h1 style="font-size: 1.15rem; font-weight: 800; font-family: var(--font-display); tracking: -0.01em; margin: 0; transition: color var(--transition-fast);">
              <span style="color: var(--text-primary);" class="logo-text-primary">Tata </span><span style="color: var(--accent-primary);">Hub</span>
            </h1>
          </a>

          <!-- Header Search Bar Container -->
          <div id="header-search-container" class="header-search-container hidden-search-mobile">
            <Search style="position: absolute; left: 0.875rem; width: 18px; height: 18px; color: var(--text-tertiary);" />
            <input type="text" id="global-search-input" class="form-input" placeholder="Search syllabus, papers..." style="padding-left: 2.5rem; height: 40px; border-radius: var(--radius-full); font-size: 0.875rem;" />
            
            <!-- Dynamic search suggestion box -->
            <div id="search-suggestions" class="card" style="display: none; position: absolute; top: 46px; left: 0; right: 0; z-index: 60; max-height: 300px; overflow-y: auto; padding: 0.5rem; box-shadow: var(--shadow-lg); border-radius: var(--radius-md);">
            </div>
          </div>

          <!-- Action buttons -->
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <!-- Mobile Search Icon Trigger Button -->
            <button id="mobile-search-toggle" class="btn btn-secondary" style="width: 40px; height: 40px; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; padding: 0; background-color: var(--bg-tertiary); border: 1px solid var(--border-color);" aria-label="Search">
              <Search size="20" />
            </button>

            <!-- Theme Toggle -->
            <button id="theme-toggle-mobile" class="btn btn-secondary" style="width: 40px; height: 40px; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; padding: 0; background-color: var(--bg-tertiary); border: 1px solid var(--border-color);" aria-label="Toggle Theme">
              <Sun class="sun-icon" style="display: none;" />
              <Moon class="moon-icon" />
            </button>

            <!-- Request Button -->
            <button id="header-request-btn" class="btn btn-primary" style="font-size: 0.85rem; height: 40px; padding: 0 1rem; border-radius: var(--radius-full); font-weight: 700;" class="md:flex">
              Request Paper
            </button>
          </div>
        </header>

        <!-- Main Content Wrapper -->
        <main class="main-content">
          <div class="animate-fade-in">
            <slot />
          </div>
        </main>

        <!-- Footer -->
        <footer style="background-color: var(--bg-secondary); border-top: 1px solid var(--border-color); padding: 2.5rem 1rem 6.5rem 1rem; text-align: center; font-size: 0.825rem; color: var(--text-secondary);" class="md:pb-8">
          <p>© {new Date().getFullYear()} Tata Hub. Rebuilt in Astro.</p>
          <p style="margin-top: 0.5rem; color: var(--text-tertiary);">Disclaimer: Reference syllabus & PYQs source for student study. Verify with official administration.</p>
        </footer>

      </div>

      <!-- Mobile Bottom Navigation (6 Tabs matching Screenshot) -->
      <nav class="mobile-nav">
        <a href={`${baseUrl}/`} class={`mobile-nav-item ${activeTab === 'home' ? 'active' : ''}`}>
          <LayoutGrid /> <span>Home</span>
        </a>
        <a href={`${baseUrl}/pyqs`} class={`mobile-nav-item ${activeTab === 'pyqs' ? 'active' : ''}`}>
          <FileText /> <span>PYQs</span>
        </a>
        <a href={`${baseUrl}/syllabus`} class={`mobile-nav-item ${activeTab === 'syllabus' ? 'active' : ''}`}>
          <BookOpen /> <span>Syllabus</span>
        </a>
        <a href={`${baseUrl}/notices`} class={`mobile-nav-item ${activeTab === 'notices' ? 'active' : ''}`}>
          <Bell /> <span>Notices</span>
        </a>
        <a href={`${baseUrl}/results`} class={`mobile-nav-item ${activeTab === 'results' ? 'active' : ''}`}>
          <TrendingUp /> <span>Results</span>
        </a>
        <a href={`${baseUrl}/cgpa`} class={`mobile-nav-item ${activeTab === 'cgpa' ? 'active' : ''}`}>
          <Calculator /> <span>CGPA</span>
        </a>
      </nav>

    </div>

    <!-- Paper Request Modal (Strictly for requesting) -->
    <div id="request-modal" class="modal-overlay">
      <div class="modal-container">
        <div class="modal-close" id="close-modal-btn">
          <X size="20" />
        </div>
        <h2 style="font-size: 1.35rem; margin-bottom: 0.5rem; font-family: var(--font-display);">Request a Paper</h2>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;" id="modal-desc">
          Can't find a paper? Let us know what you need, and we'll notify you as soon as it's uploaded!
        </p>
        <!-- Form state -->
        <form id="paper-request-form" style="display: flex; flex-direction: column; gap: 1rem;">
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="req-name">Your Name (Optional)</label>
            <input type="text" id="req-name" class="form-input" placeholder="e.g. Binod" />
          </div>

          <!-- Request Type Click Option (Segmented pills) -->
          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label">What do you need?</label>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem;">
              <button type="button" class="btn btn-secondary request-type-btn active" data-type="pyq" style="height: 38px; font-size: 0.85rem; padding: 0; border-radius: var(--radius-xs); border: 1px solid var(--accent-primary); background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary);">
                📄 PYQ Paper
              </button>
              <button type="button" class="btn btn-secondary request-type-btn" data-type="syllabus" style="height: 38px; font-size: 0.85rem; padding: 0; border-radius: var(--radius-xs);">
                📚 Syllabus
              </button>
              <button type="button" class="btn btn-secondary request-type-btn" data-type="both" style="height: 38px; font-size: 0.85rem; padding: 0; border-radius: var(--radius-xs);">
                🔄 Both
              </button>
            </div>
            <input type="hidden" id="req-type" value="pyq" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="req-semester">Semester</label>
              <select id="req-semester" class="form-input" style="padding-right: 2rem;">
                <option value="All">All Semesters</option>
                <option value="1">Semester 1</option>
                <option value="2">Semester 2</option>
                <option value="3">Semester 3</option>
                <option value="4">Semester 4</option>
                <option value="5">Semester 5</option>
                <option value="6">Semester 6</option>
                <option value="7">Semester 7</option>
                <option value="8">Semester 8</option>
              </select>
            </div>
            
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="req-category">Category</label>
              <select id="req-category" class="form-input">
                <option value="Major">Major</option>
                <option value="Minor">Minor</option>
                <option value="SEC">SEC</option>
                <option value="MDC">MDC</option>
                <option value="AEC">AEC</option>
                <option value="VAC">VAC</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="req-subject">Subject/Paper Name</label>
            <input type="text" id="req-subject" required class="form-input" placeholder="e.g. Mathematics - Real Analysis" />
          </div>

          <div id="req-session-row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="req-year">Exam Year</label>
              <select id="req-year" class="form-input">
                <option value="Any">Any Year</option>
                <option value="2026">2026</option>
                <option value="2025">2025</option>
                <option value="2024">2024</option>
                <option value="2023">2023</option>
                <option value="2022">2022</option>
              </select>
            </div>
            
            <div class="form-group" id="req-session-wrapper" style="margin-bottom: 0;">
              <label class="form-label" for="req-session">Session/Batch</label>
              <select id="req-session" class="form-input">
                <option value="all batch">All Batches</option>
                <option value="2025-2029 batch">2025-2029 batch</option>
                <option value="2024-2028 batch">2024-2028 batch</option>
                <option value="2023-2027 batch">2023-2027 batch</option>
                <option value="2022-2026 batch">2022-2026 batch</option>
              </select>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 0;">
            <label class="form-label" for="req-contact">WhatsApp / Contact Number (Optional)</label>
            <input type="text" id="req-contact" class="form-input" placeholder="e.g. 100" />
          </div>

          <button type="submit" class="btn btn-primary" style="margin-top: 0.5rem; width: 100%;">
            Submit Request
          </button>
        </form>

        <!-- Success state -->
        <div id="modal-success-state" style="display: none; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem 0; text-align: center; gap: 1.25rem;">
          <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 64px; height: 64px; border-radius: var(--radius-full); display: flex; align-items: center; justify-content: center; margin-bottom: 0.5rem;">
            <CheckCircle size="36" />
          </div>
          <div>
            <h3 style="font-size: 1.4rem; font-family: var(--font-display); font-weight: 800; color: var(--text-primary);">Request Submitted</h3>
            <p id="success-message" style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.5rem; line-height: 1.5; max-width: 320px;">
              Your request has been submitted successfully. We'll try to add it soon!
            </p>
          </div>

          <button id="success-done-btn" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem; border-radius: var(--radius-sm); font-weight: 700;">
            Close
          </button>
        </div>

      </div>
    </div>

    <!-- Paper Submit Modal (Simplified premium selection) -->
    <div id="submit-modal" class="modal-overlay">
      <div class="modal-container" style="max-width: 500px;">
        <div class="modal-close" id="close-submit-modal-btn">
          <X size="20" />
        </div>
        <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem; font-family: var(--font-display); text-align: center; font-weight: 800;">Submit a Paper</h2>
        <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.75rem; text-align: center; line-height: 1.5;">
          Help fellow college students by contributing syllabus or previous year exam papers. Select your preferred method to submit:
        </p>

        <div class="submit-grid">
          <!-- Google Form Card Option -->
          <a 
            href="https://docs.google.com/forms/d/e/1FAIpQLSdBj3G1eQnF6zIrHjc5VtudcCzknOV1wsUXT2dE4xE11P9Qgg/viewform" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="submit-card-btn"
            style="text-decoration: none;"
          >
            <div class="submit-card-icon" style="color: var(--accent-success); background-color: rgba(16, 185, 129, 0.1);">
              📝
            </div>
            <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">Google Form</h3>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;">Upload PDFs, images, or files. 100% anonymous & private.</p>
            <span class="submit-card-badge" style="background-color: var(--accent-success); color: white;">Recommended</span>
          </a>
          
          <!-- WhatsApp Card Option -->
          <a 
            href="https://api.whatsapp.com/send?phone=918002059887&text=Hi%20Admin!%20I%20want%20to%20submit%20a%20syllabus%20or%20PYQ%20paper." 
            target="_blank" 
            rel="noopener noreferrer" 
            class="submit-card-btn"
            style="text-decoration: none;"
          >
            <div class="submit-card-icon" style="color: var(--accent-primary); background-color: rgba(99, 102, 241, 0.1);">
              💬
            </div>
            <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem;">WhatsApp</h3>
            <p style="font-size: 0.75rem; color: var(--text-secondary); line-height: 1.4;">Send files directly to the admin. Fast & interactive chat.</p>
            <span class="submit-card-badge" style="background: var(--bg-tertiary); color: var(--text-secondary); border: 1px solid var(--border-color);">Direct Message</span>
          </a>
        </div>

        <button id="close-submit-done-btn" class="btn btn-secondary" style="width: 100%; margin-top: 1.5rem; border-radius: var(--radius-sm); font-weight: 600;">
          Cancel
        </button>
      </div>
    </div>

    <!-- Floating Request Toast -->
    <div id="request-toast" class="toast-container">
      <button id="close-toast-btn" class="toast-close" aria-label="Close notification">
        <X size="16" />
      </button>
      <div style="display: flex; flex-direction: column; gap: 0.5rem; padding-right: 1.25rem;">
        <h4 style="font-size: 0.95rem; font-weight: 800; font-family: var(--font-display); color: var(--text-primary); display: flex; align-items: center; gap: 0.35rem; margin: 0;">
          🔍 Can't find your paper?
        </h4>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.45; margin: 0;">
          Request any question paper, syllabus, or note. We'll try to add it soon.
        </p>
        <button id="toast-action-btn" class="btn btn-primary btn-sm" style="margin-top: 0.25rem; font-size: 0.775rem; padding: 0.35rem 0.75rem; border-radius: var(--radius-xs); width: fit-content; font-weight: 700;">
          Request Now
        </button>
      </div>
    </div>

    <!-- Client-side Layout interactions script -->
    <script define:vars={{ baseUrl }}>
      // 1. Theme toggle logic
      const toggleTheme = () => {
        const currentTheme = document.documentElement.getAttribute('data-theme');
        const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', nextTheme);
        localStorage.setItem('theme', nextTheme);
        updateToggleIcons(nextTheme);
      };

      const updateToggleIcons = (theme) => {
        const sunIcons = document.querySelectorAll('.sun-icon');
        const moonIcons = document.querySelectorAll('.moon-icon');
        
        if (theme === 'dark') {
          sunIcons.forEach(icon => icon.style.display = 'block');
          moonIcons.forEach(icon => icon.style.display = 'none');
        } else {
          sunIcons.forEach(icon => icon.style.display = 'none');
          moonIcons.forEach(icon => icon.style.display = 'block');
        }
      };

      const initThemeIcons = () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
        updateToggleIcons(currentTheme);
      };

      document.getElementById('theme-toggle-desktop')?.addEventListener('click', toggleTheme);
      document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
      initThemeIcons();

      // Request Type toggling logic
      const typeBtns = document.querySelectorAll('.request-type-btn');
      const reqTypeInput = document.getElementById('req-type');
      const sessionWrapper = document.getElementById('req-session-wrapper');
      const sessionRow = document.getElementById('req-session-row');

      const setRequestType = (type) => {
        typeBtns.forEach(btn => {
          const btnType = btn.getAttribute('data-type');
          if (btnType === type) {
            btn.classList.add('active');
            btn.style.backgroundColor = 'rgba(99, 102, 241, 0.1)';
            btn.style.color = 'var(--accent-primary)';
            btn.style.borderColor = 'var(--accent-primary)';
          } else {
            btn.classList.remove('active');
            btn.style.backgroundColor = 'var(--bg-tertiary)';
            btn.style.color = 'var(--text-primary)';
            btn.style.borderColor = 'var(--border-color)';
          }
        });

        if (reqTypeInput) reqTypeInput.value = type;

        // Hide Session/Batch when requesting Syllabus only
        if (type === 'syllabus') {
          if (sessionWrapper) sessionWrapper.style.display = 'none';
          if (sessionRow) sessionRow.style.gridTemplateColumns = '1fr';
        } else {
          if (sessionWrapper) sessionWrapper.style.display = 'block';
          if (sessionRow) sessionRow.style.gridTemplateColumns = '1fr 1fr';
        }
      };

      typeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const type = btn.getAttribute('data-type');
          setRequestType(type);
        });
      });

      // 2. Global Request Modal logic
      const modal = document.getElementById('request-modal');
      const closeBtn = document.getElementById('close-modal-btn');
      const successDoneBtn = document.getElementById('success-done-btn');
      const requestForm = document.getElementById('paper-request-form');
      const successState = document.getElementById('modal-success-state');

      const openModal = (subject = '', semester = '1', category = 'Major') => {
        modal.classList.add('open');
        successState.style.display = 'none';
        requestForm.style.display = 'flex';
        setRequestType('pyq');
        
        if (subject) {
          document.getElementById('req-subject').value = subject;
        }
        if (semester) {
          document.getElementById('req-semester').value = semester;
        }
        if (category) {
          document.getElementById('req-category').value = category;
        }
      };

      const closeModal = () => {
        modal.classList.remove('open');
        requestForm.reset();
      };

      // Header click
      document.getElementById('header-request-btn')?.addEventListener('click', () => {
        openModal();
      });

      closeBtn?.addEventListener('click', closeModal);
      successDoneBtn?.addEventListener('click', closeModal);
      
      // Close on overlay click
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      // Handle custom events from other pages
      document.addEventListener('open-request-modal', (e) => {
        const { subject, semester, category } = e.detail || {};
        openModal(subject, semester, category);
      });

      // Form submit
      requestForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = requestForm.querySelector('button[type="submit"]');
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerHTML = '⏳ Submitting Request...';
        }
        
        // Extract field values
        const name = document.getElementById('req-name').value;
        const semester = document.getElementById('req-semester').value;
        const category = document.getElementById('req-category').value;
        const subject = document.getElementById('req-subject').value;
        const year = document.getElementById('req-year').value;
        const session = document.getElementById('req-session').value;
        const contact = document.getElementById('req-contact').value;
        const type = document.getElementById('req-type').value;

        const successState = document.getElementById('modal-success-state');
        const successMsgEl = document.getElementById('success-message');

        const webhookUrl = 'https://script.google.com/macros/s/AKfycbx3ZJ1VuRgNc71FSKnrIAzLsv3qxnUeBwA8HALHWhDxlpJC93YzOwCV5rmLLT-swLaXHQ/exec';

        const handleSuccess = () => {
          // Hide form and show success state
          requestForm.style.display = 'none';
          if (successState) successState.style.display = 'flex';
          
          if (successMsgEl) {
            successMsgEl.innerHTML = `Your request for <strong>${subject}</strong> has been submitted successfully. We'll try to add it soon!`;
          }
          
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Submit Request';
          }
        };

        if (!webhookUrl || webhookUrl === 'YOUR_GOOGLE_SHEETS_WEB_APP_URL') {
          // Demo Mode / Simulated Submission
          setTimeout(() => {
            try {
              const mockRequests = JSON.parse(localStorage.getItem('requests') || '[]');
              mockRequests.push({ name: name || 'Anonymous', semester, category, subject, year, session, contact, type, date: new Date().toISOString() });
              localStorage.setItem('requests', JSON.stringify(mockRequests));
              document.dispatchEvent(new CustomEvent('request-submitted'));
            } catch (err) {
              console.error(err);
            }
            handleSuccess();
          }, 1000);
        } else {
          // Real Submission
          try {
            await fetch(webhookUrl, {
              method: 'POST',
              mode: 'no-cors',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify({
                name: name || 'Anonymous',
                semester,
                category,
                subject,
                year,
                session,
                contact,
                type
              })
            });
            
            // Save to localStorage as history for the user's dashboard requests tracker
            try {
              const mockRequests = JSON.parse(localStorage.getItem('requests') || '[]');
              mockRequests.push({ name: name || 'Anonymous', semester, category, subject, year, session, contact, type, date: new Date().toISOString() });
              localStorage.setItem('requests', JSON.stringify(mockRequests));
              document.dispatchEvent(new CustomEvent('request-submitted'));
            } catch (err) {
              console.error(err);
            }
            
            handleSuccess();
          } catch (err) {
            console.error(err);
            alert('Submission failed. Please check your internet connection or try again later.');
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = 'Submit Request';
            }
          }
        }
      });

      // 2b. Global Submit Modal logic
      const submitModal = document.getElementById('submit-modal');
      const closeSubmitBtn = document.getElementById('close-submit-modal-btn');
      const closeSubmitDoneBtn = document.getElementById('close-submit-done-btn');

      const openSubmitModal = () => {
        submitModal?.classList.add('open');
      };

      const closeSubmitModal = () => {
        submitModal?.classList.remove('open');
      };

      closeSubmitBtn?.addEventListener('click', closeSubmitModal);
      closeSubmitDoneBtn?.addEventListener('click', closeSubmitModal);

      submitModal?.addEventListener('click', (e) => {
        if (e.target === submitModal) closeSubmitModal();
      });

      // Handle custom events for submit
      document.addEventListener('open-submit-modal', () => {
        openSubmitModal();
      });

      // 2c. Floating Request Toast logic
      const toast = document.getElementById('request-toast');
      const closeToastBtn = document.getElementById('close-toast-btn');
      const toastActionBtn = document.getElementById('toast-action-btn');

      const initToast = () => {
        // Disabled automatic popup to prevent LCP layout shifts and delays
        return;
      };

      closeToastBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        toast?.classList.remove('show');
        localStorage.setItem('hide-request-toast', 'true');
      });

      toastActionBtn?.addEventListener('click', () => {
        toast?.classList.remove('show');
        openModal();
      });

      initToast();


      // 3. Global Search Suggestion Engine
      const searchInput = document.getElementById('global-search-input');
      const suggestionsBox = document.getElementById('search-suggestions');

      let searchDatabase = { syllabus: [], pyqs: [] };

      // Load database from json files client-side for immediate reactive matching
      const fetchSearchData = async () => {
        try {
          const resSyl = await fetch(`${baseUrl}/data/syllabus.json`);
          const syllabus = await resSyl.json();
          
          const resMdc = await fetch(`${baseUrl}/data/mdc.json`);
          const mdc = await resMdc.json();
          
          const resAec = await fetch(`${baseUrl}/data/aec.json`);
          const aec = await resAec.json();
          
          const resVac = await fetch(`${baseUrl}/data/vac.json`);
          const vac = await resVac.json();
          
          const resPyq = await fetch(`${baseUrl}/data/pyqs.json`);
          const pyqs = await resPyq.json();

          const formattedSyllabus = [];

          syllabus.forEach(item => {
            const isMinor = item.department.toLowerCase().includes('minor');
            formattedSyllabus.push({
              type: isMinor ? 'minor' : 'major',
              title: item.title,
              subtitle: `${item.department} • ${item.semester}`,
              searchString: `${item.title} ${item.department} ${item.description} ${item.modules ? item.modules.join(' ') : ''} ${isMinor ? 'minor' : 'major honours hons'}`.toLowerCase(),
              link: `${baseUrl}/syllabus/${item.department.toLowerCase().replace(/\s+/g, '-')}`,
              targetBlank: false,
              download: false
            });
          });

          mdc.forEach(item => {
            formattedSyllabus.push({
              type: 'mdc',
              title: `${item.name} (MDC) Syllabus`,
              subtitle: `Multidisciplinary Course • ${item.category}`,
              searchString: `${item.name} mdc multidisciplinary ${item.category} syllabus`.toLowerCase(),
              link: item.link,
              targetBlank: true,
              download: false
            });
          });

          aec.forEach(item => {
            formattedSyllabus.push({
              type: 'aec',
              title: `${item.name} (AEC) Syllabus`,
              subtitle: `Ability Enhancement Course • ${item.semester}`,
              searchString: `${item.name} aec ability enhancement language ${item.semester} syllabus`.toLowerCase(),
              link: item.link,
              targetBlank: true,
              download: false
            });
          });

          vac.forEach(item => {
            formattedSyllabus.push({
              type: 'vac',
              title: `${item.name} (VAC) Syllabus`,
              subtitle: `Value Added Course • ${item.semester} • ${item.type}`,
              searchString: `${item.name} vac value added ${item.semester} ${item.type} syllabus`.toLowerCase(),
              link: `${baseUrl}${item.link}`,
              targetBlank: false,
              download: true
            });
          });

          const formattedPyqs = pyqs
            .filter(item => !!item.downloadUrl)
            .map(item => ({
              title: `${item.subject} (${item.category})`,
              subtitle: `Sem ${item.semester} • ${item.year} Exam Paper`,
              searchString: `${item.subject} ${item.category} ${item.title} sem ${item.semester} ${item.year} pyq pyqs exam paper question`.toLowerCase(),
              link: `${baseUrl}/pyqs/${item.category.toLowerCase()}/${item.subject.toLowerCase()}/${item.semester}`,
              category: item.category,
              subject: item.subject,
              semester: item.semester,
              year: item.year
            }));

          searchDatabase = {
            syllabus: formattedSyllabus,
            pyqs: formattedPyqs
          };
        } catch (err) {
          console.error("Failed to load search index: ", err);
        }
      };
      fetchSearchData();

      searchInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        if (!query) {
          suggestionsBox.style.display = 'none';
          return;
        }

        const queryWords = query.split(/\s+/).filter(w => w.length > 0);
        
        // Map common synonyms to standardized search terms
        const wordMapping = {
          'maths': 'mathematics',
          'math': 'mathematics',
          'phy': 'physics',
          'chem': 'chemistry',
          'eng': 'english',
          'evs': 'environmental'
        };
        const searchWords = queryWords.map(w => wordMapping[w] || w);

        // Check if query is explicitly searching for pyqs
        const isQueryingPyq = searchWords.some(w => ['pyq', 'pyqs', 'paper', 'papers', 'question', 'questions', 'previous', 'exam', 'exams'].includes(w));

        const getScore = (item, isPyqItem) => {
          let score = 0;
          let matchCount = 0;

          for (const word of searchWords) {
            if (item.searchString.includes(word)) {
              matchCount++;
              score += 10;
              if (item.title.toLowerCase().includes(word)) {
                score += 20;
              }
            }
          }

          if (matchCount === searchWords.length) {
            score += 100; // Perfect match bonus for matching all words
          }

          // Category-specific boosts
          if (searchWords.includes('major') && item.type === 'major') score += 50;
          if (searchWords.includes('minor') && item.type === 'minor') score += 50;
          if (searchWords.includes('mdc') && item.type === 'mdc') score += 50;
          if (searchWords.includes('aec') && item.type === 'aec') score += 50;
          if (searchWords.includes('vac') && item.type === 'vac') score += 50;

          // Priority bias: syllabus first unless query is explicitly about pyq
          if (!isPyqItem && !isQueryingPyq) {
            score += 30; // boost syllabus
          }
          if (isPyqItem && isQueryingPyq) {
            score += 50; // boost PYQ matches if search query is about pyqs
          }

          return score;
        };

        const scoredSyllabus = searchDatabase.syllabus
          .map(item => ({ item, score: getScore(item, false) }))
          .filter(res => res.score > 0)
          .sort((a, b) => b.score - a.score)
          .map(res => res.item);

        const scoredPyqs = searchDatabase.pyqs
          .map(item => ({ item, score: getScore(item, true) }))
          .filter(res => res.score > 0)
          .sort((a, b) => b.score - a.score)
          .map(res => res.item);

        const filteredSyllabus = scoredSyllabus.slice(0, 4);
        const filteredPyqs = scoredPyqs.slice(0, 4);

        if (filteredSyllabus.length === 0 && filteredPyqs.length === 0) {
          suggestionsBox.innerHTML = `
            <div style="padding: 0.75rem; color: var(--text-secondary); text-align: center; font-size: 0.9rem;">
              No matches found. 
              <button class="btn btn-outline btn-sm" id="search-req-btn" style="margin-top: 0.5rem; width: 100%;">
                Request this paper
              </button>
            </div>
          `;
          suggestionsBox.style.display = 'block';
          
          document.getElementById('search-req-btn')?.addEventListener('click', () => {
            suggestionsBox.style.display = 'none';
            openModal(query);
          });
          return;
        }

        let syllabusHtml = '';
        if (filteredSyllabus.length > 0) {
          syllabusHtml += `<div style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); padding: 0.5rem 0.75rem; text-transform: uppercase;">Syllabus Modules</div>`;
          filteredSyllabus.forEach(item => {
            const downloadAttr = item.download ? 'download' : '';
            const targetAttr = item.targetBlank ? 'target="_blank" rel="noopener noreferrer"' : '';
            syllabusHtml += `
              <a href="${item.link}" ${downloadAttr} ${targetAttr} style="display: block; padding: 0.625rem 0.75rem; border-radius: var(--radius-xs); color: var(--text-primary); transition: background 0.15s;" class="hover:bg-tertiary">
                <div style="font-weight: 600; font-size: 0.9rem; display: flex; justify-content: space-between; align-items: center;">
                  <span>${item.title}</span>
                  ${item.download ? '<span style="font-size: 0.7rem;" class="badge badge-primary">Download</span>' : ''}
                </div>
                <div style="font-size: 0.75rem; color: var(--text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.subtitle}</div>
              </a>
            `;
          });
        }

        let pyqHtml = '';
        if (filteredPyqs.length > 0) {
          pyqHtml += `<div style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); padding: 0.5rem 0.75rem; text-transform: uppercase;">Previous Papers</div>`;
          filteredPyqs.forEach(item => {
            pyqHtml += `
              <a href="${item.link}" style="display: block; padding: 0.625rem 0.75rem; border-radius: var(--radius-xs); color: var(--text-primary); transition: background 0.15s;" class="hover:bg-tertiary">
                <div style="font-weight: 600; font-size: 0.9rem;">${item.title}</div>
                <div style="font-size: 0.75rem; color: var(--text-secondary); display: flex; justify-content: space-between;">
                  <span>${item.subtitle}</span>
                  <span style="color: var(--accent-primary); font-weight: 500;">Download →</span>
                </div>
              </a>
            `;
          });
        }

        if (isQueryingPyq) {
          // If PYQ section is shown first, add margin top to syllabus section if both exist
          if (filteredSyllabus.length > 0 && filteredPyqs.length > 0) {
            syllabusHtml = syllabusHtml.replace('style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); padding: 0.5rem 0.75rem; text-transform: uppercase;"', 'style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); padding: 0.5rem 0.75rem; text-transform: uppercase; margin-top: 0.5rem;"');
          }
          suggestionsBox.innerHTML = pyqHtml + syllabusHtml;
        } else {
          // If Syllabus section is shown first, add margin top to PYQ section if both exist
          if (filteredSyllabus.length > 0 && filteredPyqs.length > 0) {
            pyqHtml = pyqHtml.replace('style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); padding: 0.5rem 0.75rem; text-transform: uppercase;"', 'style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); padding: 0.5rem 0.75rem; text-transform: uppercase; margin-top: 0.5rem;"');
          }
          suggestionsBox.innerHTML = syllabusHtml + pyqHtml;
        }
        suggestionsBox.style.display = 'block';
      });

      // Close suggestions when clicking outside
      document.addEventListener('click', (e) => {
        if (!searchInput?.contains(e.target) && !suggestionsBox?.contains(e.target)) {
          if (suggestionsBox) suggestionsBox.style.display = 'none';
        }
      });

      // Mobile search trigger toggle
      const mobileSearchToggle = document.getElementById('mobile-search-toggle');
      const headerEl = document.querySelector('header');
      mobileSearchToggle?.addEventListener('click', (e) => {
        e.stopPropagation();
        headerEl?.classList.toggle('show-mobile-search');
        if (headerEl?.classList.contains('show-mobile-search')) {
          searchInput?.focus();
        }
      });
      // Close search when clicking outside
      document.addEventListener('click', (e) => {
        const searchContainer = document.getElementById('header-search-container');
        if (!searchContainer?.contains(e.target) && !mobileSearchToggle?.contains(e.target)) {
          headerEl?.classList.remove('show-mobile-search');
        }
      });
    </script>
  </body>
</html>
