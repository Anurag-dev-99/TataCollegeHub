---
import Layout from '../layouts/Layout.astro';
import { ClipboardCheck, AlertTriangle, CheckCircle, MapPin, Clock, Building2, CreditCard, FileText, Camera, ChevronRight, Info, Landmark } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const steps = [
  {
    number: 1,
    icon: '✍️',
    title: 'Write Your Application',
    subtitle: 'Prepare application & attach required documents',
    color: '#6366f1',
    colorBg: 'rgba(99, 102, 241, 0.1)',
    details: [
      { text: 'Write your application clearly — title it <strong>"Application for Scrutiny"</strong> (not "Recheck").', warn: true },
      { text: 'Clearly mention: your name, roll number, semester, subject code, paper name, and reason.', warn: false },
      { text: 'Attach a <strong>photocopy of your Admit Card</strong>.', warn: false },
      { text: 'Attach a <strong>photocopy of your Result</strong> (marksheet/scoresheet).', warn: false },
    ],
    tip: null,
  },
  {
    number: 2,
    icon: '🏫',
    title: "Principal's Signature & Stamp",
    subtitle: 'Get your own college principal to sign and stamp the application',
    color: '#f59e0b',
    colorBg: 'rgba(245, 158, 11, 0.1)',
    details: [
      { text: 'Take your application to <strong>your own college\'s Principal</strong> for their official signature and stamp.', warn: false },
      { text: 'Each student must visit their respective college — Tata College students go to Tata College principal, Singhbhum College students go to their principal, and so on.', warn: false },
    ],
    tip: {
      label: '📌 Tata College Tip',
      text: 'Principal Mam may be at Tata College campus <em>or</em> at the Exam Department (KU, 1st floor). When going upstairs, look to the <strong>front-left side</strong> — that is her room at the Exam Department.',
    },
  },
  {
    number: 3,
    icon: '🏛️',
    title: 'Exam Department Verification',
    subtitle: 'Visit the Kolhan Exam Dept. (1st floor) for verification',
    color: '#10b981',
    colorBg: 'rgba(16, 185, 129, 0.1)',
    details: [
      { text: 'Go to the <strong>Kolhan University Exam Department on the 1st floor</strong>.', warn: false },
      { text: 'Submit your application to the staff there. They will check and verify your documents.', warn: false },
      { text: 'Once verified, they will <strong>direct you to collect a blank Challan</strong> for payment.', warn: false },
    ],
    tip: null,
  },
  {
    number: 4,
    icon: '📄',
    title: 'Collect & Fill the Challan',
    subtitle: 'Get the challan from the guard downstairs and get it signed',
    color: '#8b5cf6',
    colorBg: 'rgba(139, 92, 246, 0.1)',
    details: [
      { text: '<strong>Go downstairs</strong> — the guard stationed there holds the blank Challan forms. Request one from him.', warn: false },
      { text: 'Fill out the Challan completely with your details (name, roll number, subject, fee amount, etc.).', warn: false },
      { text: 'Bring the filled Challan to the <strong>1st-floor corner room</strong> — the staff will verify it and sign it.', warn: false },
      { text: 'Then return to the main exam counter room for the <strong>final approval signature</strong>.', warn: false },
    ],
    tip: null,
  },
  {
    number: 5,
    icon: '🏦',
    title: 'Pay the Challan at Canara Bank',
    subtitle: 'Deposit the fee at Canara Bank (~1 min walk from exam dept.)',
    color: '#ef4444',
    colorBg: 'rgba(239, 68, 68, 0.1)',
    details: [
      { text: 'Take your signed Challan to <strong>Canara Bank</strong>, located roughly a <strong>1-minute walk</strong> from the Kolhan University Exam Department.', warn: false },
      { text: 'Fee: <strong>₹200 for Scrutiny</strong> / <strong>₹1,000 for Photocopy</strong>. Deposit the required amount at the bank counter.', warn: false },
      { text: 'The bank teller will stamp your Challan and return a copy as your payment receipt.', warn: false },
    ],
    tip: {
      label: '🏦 Canara Bank Tip',
      text: 'The Canara Bank branch is a short, easy walk from the Kolhan Exam Dept. Carry your signed Challan and the <strong>exact fee amount</strong> (₹200 scrutiny / ₹1,000 photocopy).',
    },
  },
  {
    number: 6,
    icon: '✅',
    title: 'Registration & Final Receipt',
    subtitle: 'Return to exam dept. for registration and your receipt',
    color: '#10b981',
    colorBg: 'rgba(16, 185, 129, 0.1)',
    details: [
      { text: '<strong>Return to the Exam Department room</strong> with your bank-stamped Challan.', warn: false },
      { text: 'They will log your request in the register and provide you with the remaining copy of the Challan as your official receipt.', warn: false },
      { text: 'Your process is now <strong>complete</strong>! Keep this receipt safe.', warn: false },
    ],
    tip: {
      label: '⏱️ Processing Time',
      text: 'Photocopy requests typically take <strong>15 to 45 days</strong> to be processed and mailed to your college. Scrutiny results may vary.',
    },
  },
];

const docs = [
  {
    src: 'sem_6_recheck_application_scrutiny_blur.jpg',
    alt: 'Sem 6 History Minor Scrutiny Application — S.B. College Chandil',
    title: 'Sem 6 Scrutiny Application — S.B. College Chandil',
    label: 'Scrutiny Application',
    badgeClass: 'badge-primary',
    sub: 'Sem 6 — History Minor (MN-2C)',
    meta: 'S.B. College Chandil • FYUGP 2022–2026',
    downloadName: 'Scrutiny_Application_Sample_Sem6_KU.jpg',
    fee: '₹200',
    feeColor: 'var(--accent-primary)',
  },
  {
    src: 'Sem3_Photo_copy_Application_blur.jpg',
    alt: 'Sem 3 Maths Major Photocopy Application — Tata College Chaibasa',
    title: 'Sem 3 Maths Photocopy Application — Tata College Chaibasa',
    label: 'Photocopy Application',
    badgeClass: 'badge-success',
    sub: 'Sem 3 — Maths Major (MJ-05)',
    meta: 'Tata College Chaibasa • FYUGP 2022–2026',
    downloadName: 'Photocopy_Application_Sample_Sem3_KU.jpg',
    fee: '₹1,000',
    feeColor: 'var(--accent-success)',
  },
  {
    src: 'sem_3_challan_blur.jpg',
    alt: 'Challan copy for Kolhan University photocopy/scrutiny fee payment',
    title: 'Challan Copy — Canara Bank Payment',
    label: 'Challan (Canara Bank)',
    badgeClass: 'badge-warning',
    sub: 'Bank Payment Challan',
    meta: 'Sem 3 Photocopy Request • Kolhan University',
    downloadName: 'KU_Challan_Sample_Canara_Bank.jpg',
    fee: null,
    feeColor: null,
  },
];

const faqs = [
  {
    q: 'What is the difference between Scrutiny and Photocopy?',
    a: 'Scrutiny (also known as Recheck) means your answer sheet is re-evaluated by an examiner to check for any marking errors — it costs ₹200. Photocopy means you receive a physical copy of your evaluated answer sheet so you can review it yourself — it costs ₹1,000. Both are separate processes and require individual applications.',
  },
  {
    q: 'Why should I write "Scrutiny" instead of "Recheck" in my application?',
    a: 'The Kolhan University Exam Department officially uses the term "Scrutiny". We were specifically told by the exam department staff to write "Application for Scrutiny" — not "Recheck" — in the application heading. Using the wrong term may cause delays or your application being returned.',
  },
  {
    q: 'How long does a photocopy request take?',
    a: 'The exam department does not give an official confirmed timeline. Based on experience, photocopy requests may take anywhere from 15 days to 45 days or possibly more. Plan accordingly and do not expect it to arrive quickly.',
  },
  {
    q: 'Is the process the same for all Kolhan University affiliated colleges?',
    a: 'Yes — the process at the Kolhan University Exam Department is the same for students of all affiliated colleges including Tata College Chaibasa, Singhbhum College Chandil, and others. The only difference is that you must get your principal\'s signature from your own college before visiting the KU Exam Department.',
  },
  {
    q: 'What documents do I need to carry on the day?',
    a: 'You will need: (1) A written application titled "Application for Scrutiny" with your details, (2) A photocopy of your Admit Card, (3) A photocopy of your Result/Marksheet, and (4) Your principal\'s signature and stamp on the application. Also carry the exact fee amount — ₹200 for Scrutiny or ₹1,000 for Photocopy — to deposit at Canara Bank.',
  },
  {
    q: 'Where exactly is Canara Bank from the Kolhan University Exam Department?',
    a: 'Canara Bank is approximately a 1-minute walk from the Kolhan University Exam Department. It is very close and easy to find. The entire process — from submitting your application to paying at the bank and collecting your receipt — can be completed in a single day.',
  },
];

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
});
---

<Layout
  title="Answer Sheet Recheck & Photocopy Guide — Kolhan University"
  activeTab="recheck"
  description="Step-by-step guide for Kolhan University answer sheet scrutiny (recheck) and photocopy application process. Fee: ₹200 for scrutiny, ₹1000 for photocopy. Frequently asked questions and real sample applications for FYUGP students of Tata College Chaibasa, Singhbhum College Chandil and all KU affiliated colleges."
  keywords="Kolhan University recheck process, Kolhan University scrutiny, answer sheet photocopy Kolhan University, Tata College recheck, FYUGP scrutiny application, Kolhan University exam department, Canara Bank challan Kolhan, scrutiny fee 200 rupees, photocopy fee 1000 rupees, Kolhan University recheck FAQ, scrutiny vs photocopy difference"
>

  <!-- ===== PAGE HEADER ===== -->
  <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
      <h1 style="font-size: 2rem; font-family: var(--font-display); letter-spacing: -0.03em;">
        Answer Sheet Recheck &amp; Photocopy Guide
      </h1>
      <span class="badge badge-danger" style="font-size: 0.7rem; font-weight: 800; padding: 0.25rem 0.6rem; letter-spacing: normal; text-transform: none;">
        KU Exam Dept.
      </span>
    </div>
    <p style="color: var(--text-secondary); max-width: 680px; font-size: 1.05rem; line-height: 1.6;">
      Complete walkthrough for applying for <strong>Answer Sheet Scrutiny</strong> (write "Scrutiny" — not "Recheck") and <strong>Photocopy</strong> at Kolhan University. Real application samples included below — can be downloaded.
    </p>
  </div>

  <!-- ===== HERO DOCUMENT PREVIEW STRIP (top, small thumbnails) ===== -->
  <div style="margin-bottom: 2rem;">
    <p style="font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-tertiary); margin-bottom: 0.75rem;">📎 Real Sample Documents — Click to Zoom &amp; Download</p>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      {docs.map(doc => (
        <div
          class="hero-thumb-card image-doc-card"
          data-src={`${baseUrl}/images/${doc.src}`}
          data-title={doc.title}
          data-download={doc.downloadName}
          style="cursor: zoom-in; border-radius: var(--radius-md); border: 1px solid var(--border-color); overflow: hidden; background: var(--bg-secondary); display: flex; flex-direction: column; width: 110px; flex-shrink: 0; transition: all 0.2s; box-shadow: var(--shadow-sm);"
        >
          <div style="height: 130px; overflow: hidden; position: relative; background: var(--bg-tertiary);">
            <img
              src={`${baseUrl}/images/${doc.src}`}
              alt={doc.alt}
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.35s ease;"
              class="doc-thumb"
            />
            <div class="zoom-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0); display: flex; align-items: center; justify-content: center; transition: background 0.2s; opacity: 0;">
              <span style="background: rgba(255,255,255,0.95); color: #111; font-size: 0.65rem; font-weight: 700; padding: 0.2rem 0.55rem; border-radius: 999px;">🔍 Zoom</span>
            </div>
          </div>
          <div style="padding: 0.5rem 0.5rem 0.4rem; text-align: center;">
            <span style="font-size: 0.6rem; font-weight: 700; color: var(--text-secondary); display: block; line-height: 1.3;">{doc.label}</span>
            {doc.fee && <span style={`font-size: 0.65rem; font-weight: 800; color: ${doc.feeColor}; display: block; margin-top: 1px;`}>{doc.fee}</span>}
          </div>
        </div>
      ))}
      <!-- "View all" hint -->
      <div style="display: flex; align-items: center; padding: 0 0.25rem;">
        <p style="font-size: 0.75rem; color: var(--text-tertiary); line-height: 1.4; max-width: 120px;">Scroll down for full gallery &amp; download links ↓</p>
      </div>
    </div>
  </div>

  <!-- ===== QUICK INFO + FEE CARDS ===== -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(185px, 1fr)); gap: 1rem; margin-bottom: 2.5rem;">

    <!-- Single Day -->
    <div class="card" style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1.1rem; border-color: rgba(16, 185, 129, 0.3); background: linear-gradient(135deg, rgba(16, 185, 129, 0.04) 0%, transparent 100%);">
      <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 38px; height: 38px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.15rem;">✅</div>
      <div>
        <h3 style="font-size: 0.88rem; font-weight: 800; color: var(--accent-success); margin-bottom: 0.2rem;">Single Day Process</h3>
        <p style="font-size: 0.76rem; color: var(--text-secondary); line-height: 1.4;">Entire process done in <strong>one day</strong>. Great for students travelling from far.</p>
      </div>
    </div>

    <!-- Write Scrutiny Warning -->
    <div class="card" style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1.1rem; border-color: rgba(239, 68, 68, 0.3); background: linear-gradient(135deg, rgba(239, 68, 68, 0.04) 0%, transparent 100%);">
      <div style="background-color: rgba(239, 68, 68, 0.1); color: var(--accent-danger); width: 38px; height: 38px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.15rem;">⚠️</div>
      <div>
        <h3 style="font-size: 0.88rem; font-weight: 800; color: var(--accent-danger); margin-bottom: 0.2rem;">Write "Scrutiny" Not "Recheck"</h3>
        <p style="font-size: 0.76rem; color: var(--text-secondary); line-height: 1.4;">The Exam Dept. specifically asks for <strong>"Application for Scrutiny"</strong> in the heading.</p>
      </div>
    </div>

    <!-- Scrutiny Fee -->
    <div class="card fee-card" style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1.1rem; border-color: rgba(99, 102, 241, 0.35); background: linear-gradient(135deg, rgba(99, 102, 241, 0.06) 0%, transparent 100%);">
      <div style="background-color: rgba(99, 102, 241, 0.12); color: var(--accent-primary); width: 38px; height: 38px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.15rem;">🔍</div>
      <div>
        <h3 style="font-size: 0.88rem; font-weight: 800; color: var(--accent-primary); margin-bottom: 0.2rem;">Scrutiny Fee</h3>
        <p style="font-size: 2rem; font-family: var(--font-display); font-weight: 800; color: var(--accent-primary); line-height: 1; margin: 0.2rem 0;">₹200</p>
        <p style="font-size: 0.72rem; color: var(--text-secondary);">Pay at Canara Bank via Challan</p>
      </div>
    </div>

    <!-- Photocopy Fee -->
    <div class="card fee-card" style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1.1rem; border-color: rgba(16, 185, 129, 0.35); background: linear-gradient(135deg, rgba(16, 185, 129, 0.06) 0%, transparent 100%);">
      <div style="background-color: rgba(16, 185, 129, 0.12); color: var(--accent-success); width: 38px; height: 38px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.15rem;">📄</div>
      <div>
        <h3 style="font-size: 0.88rem; font-weight: 800; color: var(--accent-success); margin-bottom: 0.2rem;">Photocopy Fee</h3>
        <p style="font-size: 2rem; font-family: var(--font-display); font-weight: 800; color: var(--accent-success); line-height: 1; margin: 0.2rem 0;">₹1,000</p>
        <p style="font-size: 0.72rem; color: var(--text-secondary);">Pay at Canara Bank via Challan</p>
      </div>
    </div>

    <!-- Canara Bank -->
    <div class="card" style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1.1rem; border-color: rgba(245, 158, 11, 0.3); background: linear-gradient(135deg, rgba(245, 158, 11, 0.04) 0%, transparent 100%);">
      <div style="background-color: rgba(245, 158, 11, 0.1); color: var(--accent-warning); width: 38px; height: 38px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.15rem;">🏦</div>
      <div>
        <h3 style="font-size: 0.88rem; font-weight: 800; color: var(--accent-warning); margin-bottom: 0.2rem;">Canara Bank (~1 min walk)</h3>
        <p style="font-size: 0.76rem; color: var(--text-secondary); line-height: 1.4;">Very close to the Kolhan Exam Dept. Carry exact fee amount.</p>
      </div>
    </div>

    <!-- Processing Time -->
    <div class="card" style="display: flex; align-items: flex-start; gap: 0.875rem; padding: 1.1rem; border-color: rgba(100, 116, 139, 0.3); background: linear-gradient(135deg, rgba(100, 116, 139, 0.04) 0%, transparent 100%);">
      <div style="background-color: rgba(100, 116, 139, 0.1); color: var(--text-secondary); width: 38px; height: 38px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.15rem;">⏳</div>
      <div>
        <h3 style="font-size: 0.88rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.2rem;">15–45 Day Turnaround</h3>
        <p style="font-size: 0.76rem; color: var(--text-secondary); line-height: 1.4;">Photocopy requests typically take <strong>15 to 45 days</strong> to process.</p>
      </div>
    </div>

  </div>

  <!-- ===== SECTION TOGGLE: Scrutiny vs Photocopy ===== -->
  <div style="margin-bottom: 2rem;">
    <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem;">
      <h2 style="font-size: 1.4rem; font-family: var(--font-display); font-weight: 800;">Step-by-Step Process</h2>
      <div style="display: flex; background-color: var(--bg-tertiary); padding: 0.25rem; border-radius: var(--radius-full); border: 1px solid var(--border-color);">
        <button id="tab-scrutiny-btn" class="recheck-tab-btn active" style="font-size: 0.8rem; font-weight: 700; padding: 0.4rem 1rem; border-radius: var(--radius-full); transition: all 0.15s; cursor: pointer;">
          🔍 Scrutiny
        </button>
        <button id="tab-photocopy-btn" class="recheck-tab-btn" style="font-size: 0.8rem; font-weight: 700; padding: 0.4rem 1rem; border-radius: var(--radius-full); transition: all 0.15s; cursor: pointer; color: var(--text-secondary);">
          📄 Photocopy
        </button>
      </div>
    </div>

    <div id="context-scrutiny" class="recheck-context-banner" style="border: 1px solid rgba(99,102,241,0.25); background: rgba(99,102,241,0.05); border-radius: var(--radius-md); padding: 1rem 1.25rem; display: flex; gap: 0.75rem; align-items: flex-start; margin-bottom: 2rem; border-left: 4px solid var(--accent-primary);">
      <span style="font-size: 1.3rem; flex-shrink: 0;">🔍</span>
      <div>
        <strong style="font-size: 0.9rem; color: var(--accent-primary);">Scrutiny / Recheck Application — <span style="background: rgba(99,102,241,0.15); padding: 0.1rem 0.45rem; border-radius: 4px;">₹200 Fee</span></strong>
        <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem; line-height: 1.5;">Used for getting your answer sheet <em>re-evaluated</em>. Based on a real <strong>Sem 6 History Minor (MN-2C)</strong> application from S.B. College Chandil. Same process for all KU colleges. Remember: write <strong>"Scrutiny"</strong> — not "Recheck".</p>
      </div>
    </div>

    <div id="context-photocopy" class="recheck-context-banner" style="border: 1px solid rgba(16,185,129,0.25); background: rgba(16,185,129,0.05); border-radius: var(--radius-md); padding: 1rem 1.25rem; display: flex; gap: 0.75rem; align-items: flex-start; margin-bottom: 2rem; border-left: 4px solid var(--accent-success); display: none;">
      <span style="font-size: 1.3rem; flex-shrink: 0;">📄</span>
      <div>
        <strong style="font-size: 0.9rem; color: var(--accent-success);">Photocopy Application — <span style="background: rgba(16,185,129,0.15); padding: 0.1rem 0.45rem; border-radius: 4px;">₹1,000 Fee</span></strong>
        <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem; line-height: 1.5;">Used to <em>receive a physical copy of your evaluated answer sheet</em>. Based on a real <strong>Sem 3 Maths Major (MJ-05)</strong> application from Tata College Chaibasa. Steps and challan are identical — only the purpose differs.</p>
      </div>
    </div>
  </div>

  <!-- ===== STEPS TIMELINE ===== -->
  <div style="display: flex; flex-direction: column; gap: 0; margin-bottom: 3rem;" class="steps-container">
    {steps.map((step, idx) => (
      <div class="step-item" style="display: flex; gap: 0; position: relative;">
        <div style="display: flex; flex-direction: column; align-items: center; flex-shrink: 0; width: 56px;">
          <div style={`width: 48px; height: 48px; border-radius: 50%; background: ${step.colorBg}; border: 2.5px solid ${step.color}; display: flex; align-items: center; justify-content: center; font-size: 1.35rem; flex-shrink: 0; z-index: 1; position: relative;`}>
            {step.icon}
          </div>
          {idx < steps.length - 1 && (
            <div style={`width: 2px; background: linear-gradient(to bottom, ${step.color}40, ${steps[idx+1].color}40); flex: 1; min-height: 24px; margin: 2px 0;`}></div>
          )}
        </div>

        <div style={`flex: 1; padding-bottom: ${idx < steps.length - 1 ? '1.75rem' : '0'}; padding-left: 1.25rem; padding-top: 0.25rem;`}>
          <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.35rem;">
            <span style={`font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; color: ${step.color};`}>Step {step.number}</span>
            <span style="font-size: 0.65rem; color: var(--text-tertiary);">—</span>
          </div>
          <h3 style="font-size: 1.1rem; font-family: var(--font-display); font-weight: 800; color: var(--text-primary); margin-bottom: 0.15rem;">{step.title}</h3>
          <p style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 0.875rem;">{step.subtitle}</p>

          <div class="card" style="padding: 1rem 1.25rem; display: flex; flex-direction: column; gap: 0.6rem;">
            {step.details.map(detail => (
              <div style="display: flex; gap: 0.6rem; align-items: flex-start; font-size: 0.85rem;">
                <span style={`font-size: 0.9rem; flex-shrink: 0; margin-top: 1px; color: ${detail.warn ? 'var(--accent-danger)' : 'var(--accent-success)'};`}>
                  {detail.warn ? '⚠️' : '✓'}
                </span>
                <span style="color: var(--text-primary); line-height: 1.5;" set:html={detail.text}></span>
              </div>
            ))}

            {step.tip && (
              <div style="margin-top: 0.5rem; padding: 0.75rem 1rem; background-color: var(--bg-tertiary); border-radius: var(--radius-sm); border-left: 3px solid var(--accent-primary);">
                <span style="font-size: 0.75rem; font-weight: 800; color: var(--accent-primary); display: block; margin-bottom: 0.2rem;">{step.tip.label}</span>
                <span style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;" set:html={step.tip.text}></span>
              </div>
            )}
          </div>
        </div>
      </div>
    ))}
  </div>

  <!-- ===== FULL DOCUMENT GALLERY WITH DOWNLOAD ===== -->
  <div style="margin-bottom: 3rem;">
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
      <h2 style="font-size: 1.4rem; font-family: var(--font-display); font-weight: 800;">Sample Application Documents</h2>
      <span class="badge badge-primary" style="font-size: 0.7rem; font-weight: 700; letter-spacing: normal; text-transform: none;">Click to Zoom</span>
    </div>
    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.75rem; max-width: 640px; line-height: 1.6;">
      Real applications submitted by KU students — use as templates. Images blurred for privacy. You can <strong>download</strong> any image to save as reference.
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
      {docs.map(doc => (
        <div class="image-doc-card card" data-src={`${baseUrl}/images/${doc.src}`} data-title={doc.title} data-download={doc.downloadName} style="cursor: zoom-in; padding: 0; overflow: hidden; border-radius: var(--radius-md);">
          <div style="aspect-ratio: 3/4; overflow: hidden; position: relative; background-color: var(--bg-tertiary);">
            <img
              src={`${baseUrl}/images/${doc.src}`}
              alt={doc.alt}
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
              class="doc-thumb"
            />
            <div class="zoom-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0); display: flex; align-items: center; justify-content: center; transition: background 0.25s; opacity: 0;">
              <span style="background: rgba(255,255,255,0.95); color: #111; font-size: 0.8rem; font-weight: 700; padding: 0.4rem 0.85rem; border-radius: var(--radius-full); display: flex; align-items: center; gap: 0.35rem;">🔍 Zoom</span>
            </div>
            {doc.fee && (
              <div style={`position: absolute; top: 0.6rem; right: 0.6rem; background: rgba(0,0,0,0.72); backdrop-filter: blur(4px); color: white; font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.55rem; border-radius: 6px; font-family: var(--font-display);`}>
                {doc.fee}
              </div>
            )}
          </div>
          <div style="padding: 1rem 1rem 0.75rem;">
            <div class={`badge ${doc.badgeClass}`} style="font-size: 0.65rem; font-weight: 700; letter-spacing: normal; text-transform: none; margin-bottom: 0.5rem;">{doc.label}</div>
            <h3 style="font-size: 0.9rem; font-weight: 800; color: var(--text-primary); line-height: 1.35; margin-bottom: 0.15rem;">{doc.sub}</h3>
            <p style="font-size: 0.75rem; color: var(--text-secondary); margin-bottom: 0.75rem;">{doc.meta}</p>
            <!-- Download Button -->
            <a
              href={`${baseUrl}/images/${doc.src}`}
              download={doc.downloadName}
              class="btn btn-secondary btn-sm doc-download-btn"
              style="width: 100%; font-size: 0.75rem; font-weight: 700; height: 32px; border-color: var(--border-color); gap: 0.35rem;"
              onclick="event.stopPropagation();"
            >
              ⬇️ Download Image
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- ===== QUICK REFERENCE CHECKLIST ===== -->
  <div class="card" style="background: linear-gradient(135deg, rgba(99,102,241,0.04) 0%, rgba(16,185,129,0.04) 100%); border-color: rgba(99,102,241,0.2); margin-bottom: 2rem;">
    <h2 style="font-size: 1.2rem; font-family: var(--font-display); font-weight: 800; margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
      📋 Quick Reference Checklist
    </h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
      {[
        { icon: '📝', text: 'Written application (title: "Application for Scrutiny")' },
        { icon: '🪪', text: 'Photocopy of Admit Card' },
        { icon: '📊', text: 'Photocopy of Result / Marksheet' },
        { icon: '🏫', text: 'Principal\'s signature & stamp (your own college)' },
        { icon: '🏛️', text: 'Kolhan Exam Dept. verification (1st floor)' },
        { icon: '📄', text: 'Blank Challan from downstairs guard' },
        { icon: '✍️', text: 'Fill & get Challan signed (1st floor corner room)' },
        { icon: '🏦', text: 'Pay at Canara Bank — ₹200 (scrutiny) or ₹1,000 (photocopy)' },
        { icon: '🧾', text: 'Return to Exam Dept. for registration & receipt' },
      ].map(item => (
        <div style="display: flex; align-items: center; gap: 0.65rem; font-size: 0.83rem; padding: 0.6rem 0.75rem; background: var(--bg-secondary); border-radius: var(--radius-sm); border: 1px solid var(--border-color);">
          <span style="font-size: 1rem; flex-shrink: 0;">{item.icon}</span>
          <span style="color: var(--text-primary); line-height: 1.4;">{item.text}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- ===== LIGHTBOX MODAL ===== -->
  <div id="img-lightbox" style="position: fixed; inset: 0; background: rgba(0,0,0,0.93); z-index: 200; display: none; align-items: center; justify-content: center; padding: 1rem; flex-direction: column; gap: 0.75rem;" onclick="closeLightbox(event)">
    <div style="position: relative; max-width: 720px; width: 100%; display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
      <!-- Close -->
      <button onclick="closeLightbox()" style="position: absolute; top: -48px; right: 0; background: rgba(255,255,255,0.12); border: none; color: white; width: 38px; height: 38px; border-radius: 50%; font-size: 1.25rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">✕</button>
      <!-- Image -->
      <img id="lightbox-img" src="" alt="" style="max-height: 80vh; width: 100%; object-fit: contain; border-radius: var(--radius-md); box-shadow: 0 20px 60px rgba(0,0,0,0.8);" />
      <!-- Caption + Download in lightbox -->
      <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; justify-content: center;">
        <p id="lightbox-caption" style="color: rgba(255,255,255,0.75); font-size: 0.82rem; text-align: center; font-weight: 600; margin: 0;"></p>
        <a id="lightbox-download-btn" href="" download="" style="background: rgba(255,255,255,0.12); color: white; font-size: 0.78rem; font-weight: 700; padding: 0.35rem 0.9rem; border-radius: 999px; text-decoration: none; display: flex; align-items: center; gap: 0.35rem; transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.background='rgba(255,255,255,0.12)'">⬇️ Download</a>
      </div>
    </div>
  </div>

  <!-- ===== FAQ SECTION ===== -->
  <div style="margin-bottom: 2.5rem;" id="faq">
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap;">
      <h2 style="font-size: 1.4rem; font-family: var(--font-display); font-weight: 800;">Frequently Asked Questions</h2>
      <span class="badge badge-warning" style="font-size: 0.7rem; font-weight: 700; letter-spacing: normal; text-transform: none;">FAQ</span>
    </div>
    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.75rem; max-width: 620px; line-height: 1.6;">
      Common questions about the Kolhan University Scrutiny and Photocopy process — answered based on real experience.
    </p>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      {faqs.map((faq, idx) => (
        <div class="faq-item card" id={`faq-${idx}`} style="padding: 0; overflow: hidden;">
          <button
            class="faq-trigger"
            aria-expanded="false"
            aria-controls={`faq-body-${idx}`}
            style="width: 100%; text-align: left; padding: 1.1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; background: none; border: none; font-family: var(--font-sans);"
          >
            <span style="font-size: 0.925rem; font-weight: 700; color: var(--text-primary); line-height: 1.4; flex: 1;">{faq.q}</span>
            <span class="faq-chevron" style="font-size: 1rem; color: var(--accent-primary); flex-shrink: 0; transition: transform 0.25s ease; display: flex; align-items: center;">﹢</span>
          </button>
          <div
            class="faq-body"
            id={`faq-body-${idx}`}
            style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease, padding 0.25s ease;"
          >
            <p style="padding: 0 1.25rem 1.1rem; font-size: 0.875rem; color: var(--text-secondary); line-height: 1.7; border-top: 1px solid var(--border-color); margin: 0; padding-top: 0.9rem;">{faq.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- FAQ JSON-LD Schema for SEO -->
  <script type="application/ld+json" set:html={faqSchema} />

</Layout>

<style is:global>
  .recheck-tab-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
  }
  .recheck-tab-btn.active {
    background-color: var(--bg-secondary);
    color: var(--accent-primary);
    box-shadow: var(--shadow-sm);
  }

  .image-doc-card:hover .doc-thumb {
    transform: scale(1.04);
  }
  .image-doc-card:hover .zoom-overlay {
    background: rgba(0,0,0,0.35) !important;
    opacity: 1 !important;
  }

  .hero-thumb-card:hover {
    border-color: var(--accent-primary) !important;
    transform: translateY(-3px);
    box-shadow: var(--shadow-md), var(--shadow-glow) !important;
  }
  .hero-thumb-card:hover .doc-thumb {
    transform: scale(1.06);
  }
  .hero-thumb-card:hover .zoom-overlay {
    background: rgba(0,0,0,0.3) !important;
    opacity: 1 !important;
  }

  .fee-card {
    position: relative;
    overflow: hidden;
  }

  .doc-download-btn:hover {
    border-color: var(--accent-primary) !important;
    color: var(--accent-primary) !important;
  }

  .steps-container .step-item > div:first-child {
    min-height: 48px;
  }

  @keyframes recheck-fadein {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .steps-container {
    animation: recheck-fadein 0.4s ease forwards;
  }

  /* FAQ Accordion */
  .faq-item {
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .faq-item.open {
    border-color: var(--accent-primary);
    box-shadow: 0 0 0 1px rgba(99,102,241,0.15), var(--shadow-md);
  }
  .faq-trigger:hover > span:first-child {
    color: var(--accent-primary);
  }
  .faq-item.open .faq-chevron {
    transform: rotate(45deg);
    color: var(--accent-primary);
  }
  .faq-trigger:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: -2px;
  }
</style>

<script is:inline>
  // Tab switching
  const tabScrutinyBtn = document.getElementById('tab-scrutiny-btn');
  const tabPhotocopyBtn = document.getElementById('tab-photocopy-btn');
  const ctxScrutiny = document.getElementById('context-scrutiny');
  const ctxPhotocopy = document.getElementById('context-photocopy');

  const setTab = (tab) => {
    if (tab === 'scrutiny') {
      tabScrutinyBtn.classList.add('active');
      tabScrutinyBtn.style.color = 'var(--accent-primary)';
      tabPhotocopyBtn.classList.remove('active');
      tabPhotocopyBtn.style.color = 'var(--text-secondary)';
      ctxScrutiny.style.display = 'flex';
      ctxPhotocopy.style.display = 'none';
    } else {
      tabPhotocopyBtn.classList.add('active');
      tabPhotocopyBtn.style.color = 'var(--accent-success)';
      tabScrutinyBtn.classList.remove('active');
      tabScrutinyBtn.style.color = 'var(--text-secondary)';
      ctxScrutiny.style.display = 'none';
      ctxPhotocopy.style.display = 'flex';
    }
  };

  tabScrutinyBtn?.addEventListener('click', () => setTab('scrutiny'));
  tabPhotocopyBtn?.addEventListener('click', () => setTab('photocopy'));
  setTab('scrutiny');

  // Lightbox
  const lightbox = document.getElementById('img-lightbox');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxDownloadBtn = document.getElementById('lightbox-download-btn');

  document.querySelectorAll('.image-doc-card').forEach(card => {
    card.addEventListener('click', (e) => {
      // Don't open lightbox when clicking download button
      if (e.target.closest('.doc-download-btn')) return;
      const src = card.getAttribute('data-src');
      const title = card.getAttribute('data-title');
      const dlName = card.getAttribute('data-download');
      lightboxImg.src = src;
      lightboxImg.alt = title;
      lightboxCaption.textContent = title;
      lightboxDownloadBtn.href = src;
      lightboxDownloadBtn.download = dlName;
      lightbox.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    });
  });

  window.closeLightbox = (e) => {
    if (!e || e.target === lightbox) {
      lightbox.style.display = 'none';
      lightboxImg.src = '';
      document.body.style.overflow = '';
    }
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox.style.display === 'flex') {
      window.closeLightbox();
    }
  });

  // FAQ Accordion
  document.querySelectorAll('.faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.faq-item');
      const body = trigger.nextElementSibling;
      const isOpen = item.classList.contains('open');

      // Close all others
      document.querySelectorAll('.faq-item.open').forEach(openItem => {
        openItem.classList.remove('open');
        openItem.querySelector('.faq-trigger').setAttribute('aria-expanded', 'false');
        openItem.querySelector('.faq-body').style.maxHeight = '0';
      });

      // Toggle this one
      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
        body.style.maxHeight = body.scrollHeight + 'px';
        // Smooth scroll into view on mobile
        setTimeout(() => item.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 50);
      }
    });
  });

</script>
