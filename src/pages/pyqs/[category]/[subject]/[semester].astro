  )}

  {/* ── Past Batch Score Glimpse (Real KU Marksheet Stats) ─────────────────────── */}
  <PastBatchScoreGlimpse
    category={category}
    subject={originalSubject}
    semester={semester}
    marginTop="1.5rem"
    marginBottom="0"
  />

  {/* ── Matching Syllabus Card ─────────────────────── */}
  <div style="margin-top: 1.5rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; background: var(--bg-secondary); display: flex; flex-direction: column; gap: 0.7rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <BookOpen size="17" style="color: var(--accent-primary); flex-shrink: 0;" />
      <h2 style="font-size: 0.98rem; font-weight: 800; margin: 0; color: var(--text-primary);">{originalSubject} Syllabus</h2>
    </div>
    <div style="display: flex; flex-direction: column; gap: 0.5rem;">
      {matchedSyllabi.map(syl => (
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; padding: 0.65rem 0.85rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: var(--radius-xs);">
          <div style="min-width: 0; flex: 1;">
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); overflow-wrap: anywhere;">{syl.label}</div>
            <div style="font-size: 0.72rem; color: var(--text-tertiary); margin-top: 1px;">{syl.subtitle}</div>
          </div>
          {syl.external ? (
            <a
              href={syl.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-outline btn-sm syl-download-btn"
              data-track-subject={syl.label}
              data-track-category={originalCategory}
              data-track-semester={originalSemester}
              style="font-size: 0.76rem; padding: 0.38rem 0.8rem; gap: 0.3rem; white-space: nowrap;"
            >
              Download Syllabus PDF <ExternalLink size="12" />
            </a>
          ) : (
            <a
              href={syl.href}
              class="btn btn-outline btn-sm"
              style="font-size: 0.76rem; padding: 0.38rem 0.8rem; white-space: nowrap;"
            >
              View Syllabus →
            </a>
          )}
        </div>
      ))}
    </div>
  </div>

  {/* ── Compact Exam Pattern & Passing Marks Strip ─────────────────────── */}
  <div style="margin-top: 1.5rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; background: linear-gradient(135deg, rgba(99,102,241,0.05) 0%, rgba(16,185,129,0.03) 100%); display: flex; flex-direction: column; gap: 0.75rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem;">
      <GraduationCap size="17" style="color: var(--accent-success); flex-shrink: 0;" />
      <h2 style="font-size: 0.95rem; font-weight: 800; margin: 0; color: var(--text-primary);">Exam Pattern &amp; Passing Marks ({originalCategory})</h2>
    </div>
    <div class="exam-pattern-grid">
      <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.6rem 0.7rem; min-width: 0;">
        <div style="font-size: 0.66rem; color: var(--text-tertiary); font-weight: 700; text-transform: uppercase;">Full Marks</div>
        <div style="font-size: 0.85rem; font-weight: 800; color: var(--accent-primary); margin-top: 2px;">{pattern.total}</div>
      </div>
      <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.6rem 0.7rem; min-width: 0;">
        <div style="font-size: 0.66rem; color: var(--text-tertiary); font-weight: 700; text-transform: uppercase;">Marks Split</div>
        <div style="font-size: 0.82rem; font-weight: 700; color: var(--text-primary); margin-top: 2px;">{pattern.split}</div>
      </div>
      <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.6rem 0.7rem; min-width: 0;">
        <div style="font-size: 0.66rem; color: var(--text-tertiary); font-weight: 700; text-transform: uppercase;">Pass Marks</div>
        <div style="font-size: 0.85rem; font-weight: 800; color: var(--accent-success); margin-top: 2px;">{pattern.pass}</div>
      </div>
      <div style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.6rem 0.7rem; min-width: 0;">
        <div style="font-size: 0.66rem; color: var(--text-tertiary); font-weight: 700; text-transform: uppercase;">Duration</div>
        <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-top: 2px;">{pattern.duration}</div>
      </div>
    </div>
    {pattern.note && (
      <p style="font-size: 0.74rem; color: var(--text-secondary); margin: 0; line-height: 1.5; display: flex; align-items: flex-start; gap: 0.35rem;">
        <CheckCircle2 size="13" style="color: var(--accent-success); flex-shrink: 0; margin-top: 2px;" />
        <span>{pattern.note}</span>
      </p>
    )}
  </div>

  {/* ── Compact 3-Question Visible FAQ (non-Maths Sem 3 pages; Maths Sem 3 already has deep FAQs) ─────────────────────── */}
  {!isMathsMajorSem3 && (
    <div style="margin-top: 1.5rem; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem; background: var(--bg-secondary); display: flex; flex-direction: column; gap: 0.6rem;">
      <h2 style="font-size: 0.95rem; font-weight: 800; margin: 0; color: var(--text-primary);">❓ Frequently Asked Questions</h2>
      <div style="display: flex; flex-direction: column; gap: 0.45rem;">
        {autoFaqs.map(faq => (
          <details style="border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.65rem 0.85rem; background: var(--bg-tertiary);">
            <summary style="font-size: 0.82rem; font-weight: 700; color: var(--text-primary); cursor: pointer;">{faq.q}</summary>
            <p style="font-size: 0.78rem; color: var(--text-secondary); line-height: 1.55; margin: 0.5rem 0 0; padding-top: 0.5rem; border-top: 1px solid var(--border-color);">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  )}

  {/* ── Bottom Quick Action Row ─────────────────────── */}
  <div style="margin-top: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.6rem; justify-content: space-between; align-items: center;">
    <a href={`${baseUrl}/pyqs/`} class="btn btn-secondary btn-sm" style="font-size: 0.8rem; gap: 0.3rem;">
      <ChevronLeft size="14" /> Back to All PYQs
    </a>
    <button
      type="button"
      class="btn btn-outline btn-sm open-prefilled-request"
      data-req-subject={originalSubject}
      data-req-semester={originalSemester}
      data-req-category={originalCategory}
      style="font-size: 0.8rem;"
    >
      Request Missing Paper
    </button>
  </div>

  <style>
    .exam-pattern-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }
    @media (min-width: 600px) {
      .exam-pattern-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }
  </style>

  <script is:inline>
    (function() {
      // Track PYQ, inline notes, and external syllabus PDF clicks cleanly via data attributes
      document.querySelectorAll('.pyq-download-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (window.trackDownload) {
            window.trackDownload('pyq', {
              subject: btn.getAttribute('data-track-subject') || '',
              category: btn.getAttribute('data-track-category') || '',
              semester: btn.getAttribute('data-track-semester') || '',
              university: btn.getAttribute('data-track-university') || ''
            });
          }
        });
      });

      document.querySelectorAll('.note-download-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (window.trackDownload) {
            window.trackDownload('note', {
              subject: btn.getAttribute('data-track-subject') || '',
              category: btn.getAttribute('data-track-category') || '',
              semester: btn.getAttribute('data-track-semester') || ''
            });
          }
        });
      });

      document.querySelectorAll('.syl-download-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (window.trackDownload) {
            window.trackDownload('syllabus', {
              subject: btn.getAttribute('data-track-subject') || '',
              category: btn.getAttribute('data-track-category') || '',
              semester: btn.getAttribute('data-track-semester') || ''
            });
          }
        });
      });

      document.querySelectorAll('.open-prefilled-request').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.dispatchEvent(new CustomEvent('open-request-modal', {
            detail: {
              subject: btn.getAttribute('data-req-subject') || '',
              semester: btn.getAttribute('data-req-semester') || '1',
              category: btn.getAttribute('data-req-category') || 'Major'
            }
          }));
        });
      });

      // Live download counts — reveal only when count > 0
      var elements = document.querySelectorAll('.live-paper-download-count');
      if (!elements.length) return;
      var url = 'https://script.google.com/macros/s/AKfycbx3ZJ1VuRgNc71FSKnrIAzLsv3qxnUeBwA8HALHWhDxlpJC93YzOwCV5rmLLT-swLaXHQ/exec?action=papercounts';
      fetch(url)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.status === 'ok' && data.counts) {
            elements.forEach(function(el) {
              var title = el.getAttribute('data-subject-title');
              var count = Number(data.counts[title] || 0);
              if (count > 0) {
                el.textContent = count.toLocaleString();
                var wrap = el.closest('.live-paper-dl-wrap');
                if (wrap) wrap.style.display = 'inline-flex';
              }
            });
          }
        })
        .catch(function() {});
    })();
  </script>
</Layout>
