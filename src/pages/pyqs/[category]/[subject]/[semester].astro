---
import Layout from '../../../../layouts/Layout.astro';
import pyqsData from '../../../../../public/data/pyqs.json';
import { ChevronLeft, Calendar, Download, FileCode, AlertCircle, HelpCircle, ExternalLink, BookOpen, Globe } from '@lucide/astro';

export async function getStaticPaths() {
  const pathsMap = new Map();
  
  // Include ALL papers — available ones AND missing AEC papers so those pages render
  pyqsData.forEach(item => {
    // For non-AEC categories, only show pages that have an actual downloadUrl
    if (item.category !== 'AEC' && !item.downloadUrl) return;

    const key = `${item.category.toLowerCase()}|${item.subject.toLowerCase()}|${item.semester}`;
    if (!pathsMap.has(key)) {
      pathsMap.set(key, {
        params: {
          category: item.category.toLowerCase(),
          subject: item.subject.toLowerCase(),
          semester: item.semester.toString()
        },
        props: {
          originalCategory: item.category,
          originalSubject: item.subject,
          originalSemester: item.semester
        }
      });
    }
  });
  
  return Array.from(pathsMap.values());
}

const { category, subject, semester } = Astro.params;
const { originalCategory, originalSubject, originalSemester } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Filter papers matching these exactly
const matchingPapers = pyqsData.filter(p => 
  p.category.toLowerCase() === category &&
  p.subject.toLowerCase() === subject &&
  p.semester.toString() === semester
);
---

<Layout title={`${originalSubject} Sem ${originalSemester} PYQs`} activeTab="pyqs">

  <!-- Breadcrumb Navigation -->
  <div style="margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.85rem;">
    <a href={`${baseUrl}/pyqs`} style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; color: var(--text-secondary);">
      <ChevronLeft size="16" /> PYQs Database
    </a>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-secondary); font-weight: 500;">{originalCategory}</span>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-secondary); font-weight: 500;">{originalSubject}</span>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-primary); font-weight: 600;">Sem {originalSemester}</span>
  </div>

  <!-- Page Header -->
  <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 1.75rem; font-family: var(--font-display); tracking: -0.03em;">
      {originalSubject} Question Papers
    </h1>
    <p style="color: var(--text-secondary); font-size: 1rem;">
      Category: <strong>{originalCategory}</strong> • Semester: <strong>{originalSemester}</strong>
    </p>
  </div>

  {matchingPapers.length === 0 ? (
    <div class="card" style="text-align: center; padding: 4rem 1rem; display: flex; flex-direction: column; align-items: center; gap: 1rem;">
      <AlertCircle size="40" style="color: var(--text-tertiary);" />
      <div>
        <h3 style="font-size: 1.25rem; font-family: var(--font-display);">No papers available yet</h3>
        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.25rem;">
          We are currently checking archives for this subject paper.
        </p>
      </div>
      <button 
        class="btn btn-primary btn-sm" 
        style="margin-top: 0.5rem;"
        onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { subject: '${originalSubject}', semester: '${originalSemester}', category: '${originalCategory}' } }));`}
      >
        Request Paper Now
      </button>
    </div>
  ) : (
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      {matchingPapers.map(paper => {
        const hasUrl = !!paper.downloadUrl;
        const isMissing = !!(paper as any).missing;
        
        return (
          <div 
            class="card animate-fade-in" 
            style={`display: flex; flex-direction: column; gap: 1rem; border-color: ${isMissing ? 'rgba(245,158,11,0.3)' : 'var(--border-color)'}; ${isMissing ? 'background: linear-gradient(135deg, rgba(245,158,11,0.04) 0%, var(--bg-secondary) 100%);' : ''}`}
          >

            {/* Missing paper top-banner — AEC only */}
            {isMissing && (
              <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(245,158,11,0.10); border: 1px solid rgba(245,158,11,0.25); border-radius: var(--radius-xs); padding: 0.5rem 0.85rem; font-size: 0.78rem; color: #d97706; font-weight: 600; margin-bottom: -0.25rem;">
                <AlertCircle size="14" style="flex-shrink:0;" />
                <span>Not Available — This paper is missing from our archive.</span>
              </div>
            )}
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
              <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style={`background-color: ${isMissing ? 'rgba(245,158,11,0.12)' : 'var(--bg-tertiary)'}; color: ${isMissing ? '#d97706' : 'var(--accent-primary)'}; width: 40px; height: 40px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; flex-shrink: 0;`}>
                  {isMissing ? <HelpCircle size="20" /> : <FileCode size="20" />}
                </div>
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary);">{paper.title}</h3>
                  <div style="display: flex; gap: 0.75rem; font-size: 0.775rem; color: var(--text-secondary); margin-top: 0.25rem; flex-wrap: wrap;">
                    <span>Year: <strong>{paper.year}</strong></span>
                    {(paper as any).set && <><span>•</span><span>{(paper as any).set}</span></>}
                    {!isMissing && <><span>•</span><span style="display: flex; align-items: center; gap: 0.15rem;"><Download size="12" /> <span class="live-paper-download-count" data-subject-title={paper.title}>—</span> downloads</span></>}
                  </div>
                </div>
              </div>
              
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; flex-shrink: 0;">
                <span class="badge badge-primary" style="font-size: 0.7rem;">{paper.category}</span>
                {isMissing && (
                  <span style="font-size: 0.62rem; font-weight: 700; background: rgba(245,158,11,0.15); color: #d97706; border: 1px solid rgba(245,158,11,0.3); border-radius: 20px; padding: 2px 7px; white-space: nowrap;">Missing</span>
                )}
              </div>
            </div>

            <!-- Download / Upload CTA -->
            <div style="border-top: 1px solid var(--border-color); padding-top: 0.875rem; display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem;">
              {hasUrl ? (
              <a 
                  href={paper.downloadUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn btn-primary btn-sm" 
                  style="gap: 0.35rem; font-size: 0.85rem;"
                  onclick={`if(window.trackDownload) window.trackDownload('pyq', { subject: '${paper.title}', category: '${paper.category}', semester: '${paper.semester}' });`}
                >
                  Download Paper <ExternalLink size="14" />
                </a>
              ) : isMissing ? (
                <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; justify-content: space-between; flex-wrap: wrap;">
                  <span style="font-size: 0.8rem; color: var(--text-tertiary); display: flex; align-items: center; gap: 0.3rem;">
                    <AlertCircle size="13" /> Paper not yet in our archive
                  </span>
                  <div style="display: flex; gap: 0.5rem;">
                    <button 
                      class="btn btn-sm" 
                      style="font-size: 0.8rem; white-space: nowrap; background: rgba(245,158,11,0.12); color: #d97706; border: 1px solid rgba(245,158,11,0.3); border-radius: var(--radius-xs); padding: 0.35rem 0.85rem; cursor: pointer; transition: background 0.2s;"
                      onclick={`document.dispatchEvent(new CustomEvent('open-submit-modal'));`}
                    >
                      📤 Upload if you have it
                    </button>
                    <button 
                      class="btn btn-outline btn-sm" 
                      style="font-size: 0.8rem; white-space: nowrap;"
                      onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { subject: '${paper.title}', semester: '${paper.semester}', category: '${paper.category}' } }));`}
                    >
                      Request Paper
                    </button>
                  </div>
                </div>
              ) : (
                <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; justify-content: space-between;">
                  <span style="font-size: 0.8rem; color: var(--text-tertiary); display: flex; align-items: center; gap: 0.25rem;">
                    <AlertCircle size="14" /> PDF link awaiting upload
                  </span>
                  <div style="display: flex; gap: 0.5rem;">
                    <button 
                      disabled 
                      class="btn btn-secondary btn-sm" 
                      style="opacity: 0.6; cursor: not-allowed; font-size: 0.8rem; background: var(--bg-hover);"
                    >
                      Coming Soon
                    </button>
                    <button 
                      class="btn btn-outline btn-sm" 
                      style="font-size: 0.8rem; white-space: nowrap;"
                      onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { subject: '${paper.title}', semester: '${paper.semester}', category: '${paper.category}' } }));`}
                    >
                      Request Paper
                    </button>
                  </div>
                </div>
              )}
            </div>

          </div>
        );
      })}
    </div>
  )}

  {/* ── Study Notes Section (MDC Psychology & Economics) ─────────────────────── */}
  {category === 'mdc' && (subject === 'psychology' || subject === 'economics') && (
    <div style="margin-top: 2rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1rem;">
        <BookOpen size="18" style="color: #06b6d4; flex-shrink: 0;" />
        <h2 style="font-size: 1rem; font-weight: 800; color: var(--text-primary); letter-spacing: -0.01em;">Study Notes Available</h2>
        <span style="font-size: 0.6rem; font-weight: 700; background: rgba(6,182,212,0.12); color: #06b6d4; border: 1px solid rgba(6,182,212,0.3); border-radius: 20px; padding: 2px 7px; white-space: nowrap;">FREE</span>
      </div>

      <div style="background: linear-gradient(135deg, rgba(6,182,212,0.06) 0%, rgba(245,158,11,0.04) 100%); border: 1px solid rgba(6,182,212,0.2); border-radius: var(--radius-sm); padding: 1.1rem 1.25rem; display: flex; flex-direction: column; gap: 0.85rem;">

        <p style="font-size: 0.82rem; color: var(--text-secondary); line-height: 1.6; margin: 0;">
          Handwritten study notes for <strong style="color: var(--text-primary);">MDC {subject === 'psychology' ? 'Psychology' : 'Economics'}</strong> — covering key concepts, important questions, and exam-focused summaries. Available in Hindi &amp; English.
        </p>

        {subject === 'psychology' && (
          <div style="display: flex; flex-direction: column; gap: 0.5rem;">

            {/* Hindi Notes */}
            <a
              href="https://drive.google.com/file/d/14pbl6LnBudXXh4G7i6zU4cCFKiypkrVO/view?usp=drive_link"
              target="_blank"
              rel="noopener noreferrer"
              style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.65rem 1rem; background: rgba(6,182,212,0.1); border: 1px solid rgba(6,182,212,0.25); border-radius: var(--radius-xs); text-decoration: none; transition: background 0.2s; cursor: pointer;"
              onmouseover="this.style.background='rgba(6,182,212,0.18)'"
              onmouseout="this.style.background='rgba(6,182,212,0.1)'"
              onclick="if(window.trackDownload) window.trackDownload('note', { subject: 'Psychology', language: 'Hindi', category: 'MDC', medium: 'HI' });"
            >
              <div style="display: flex; align-items: center; gap: 0.6rem; min-width: 0;">
                <span style="font-size: 1rem; flex-shrink: 0;">📝</span>
                <div style="min-width: 0;">
                  <div style="font-size: 0.85rem; font-weight: 700; color: #06b6d4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Psychology Notes — Hindi</div>
                  <div style="font-size: 0.7rem; color: var(--text-tertiary); margin-top: 0.05rem;">हिंदी माध्यम में नोट्स</div>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0;">
                <span style="font-size: 0.65rem; font-weight: 700; background: rgba(6,182,212,0.15); color: #06b6d4; border: 1px solid rgba(6,182,212,0.25); border-radius: 10px; padding: 1px 6px;">HI</span>
                <ExternalLink size="13" style="color: #06b6d4;" />
              </div>
            </a>

            {/* English Notes */}
            <a
              href="https://drive.google.com/file/d/1HF_YhACN2FaNEYe-twiVsl5gxjXoFmfl/view?usp=drive_link"
              target="_blank"
              rel="noopener noreferrer"
              style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.65rem 1rem; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.22); border-radius: var(--radius-xs); text-decoration: none; transition: background 0.2s; cursor: pointer;"
              onmouseover="this.style.background='rgba(245,158,11,0.16)'"
              onmouseout="this.style.background='rgba(245,158,11,0.08)'"
              onclick="if(window.trackDownload) window.trackDownload('note', { subject: 'Psychology', language: 'English', category: 'MDC', medium: 'EN' });"
            >
              <div style="display: flex; align-items: center; gap: 0.6rem; min-width: 0;">
                <span style="font-size: 1rem; flex-shrink: 0;">📝</span>
                <div style="min-width: 0;">
                  <div style="font-size: 0.85rem; font-weight: 700; color: var(--accent-warning); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Psychology Notes — English</div>
                  <div style="font-size: 0.7rem; color: var(--text-tertiary); margin-top: 0.05rem;">English medium notes</div>
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0;">
                <span style="font-size: 0.65rem; font-weight: 700; background: rgba(245,158,11,0.15); color: var(--accent-warning); border: 1px solid rgba(245,158,11,0.25); border-radius: 10px; padding: 1px 6px;">EN</span>
                <ExternalLink size="13" style="color: var(--accent-warning);" />
              </div>
            </a>

          </div>
        )}

        {subject === 'economics' && (
          <div style="display: flex; flex-direction: column; gap: 0.75rem;">

            {/* Hindi Notes — 6 Parts */}
            <div>
              <div style="font-size: 0.65rem; font-weight: 700; color: #06b6d4; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.3rem;">🇮🇳 Hindi Notes — 6 Parts</div>
              <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                {[
                  'https://drive.google.com/file/d/1zQtrK7oKtcgwgEHvyva3AjMzWgmltbMe/view?usp=drive_link',
                  'https://drive.google.com/file/d/10H5g8bSTqmfC52zbMOZJBpvi087IfHi8/view?usp=drive_link',
                  'https://drive.google.com/file/d/1bJnM-vubtpwJ-GedFWaG8xz8moWM9pzq/view?usp=drive_link',
                  'https://drive.google.com/file/d/1bfyP9n9lqZBvYP8NGzi1ckPUMpevJnQq/view?usp=drive_link',
                  'https://drive.google.com/file/d/17AVOKb_nkJLfTOm70cEUnjG9dybdSu7Y/view?usp=drive_link',
                  'https://drive.google.com/file/d/1N74vTH34MxTumRylAI0UBL7IG4M2RuyT/view?usp=drive_link',
                ].map((url, i) => (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.55rem 0.85rem; background: rgba(6,182,212,0.1); border: 1px solid rgba(6,182,212,0.25); border-radius: var(--radius-xs); text-decoration: none; transition: background 0.2s;"
                    onmouseover="this.style.background='rgba(6,182,212,0.18)'"
                    onmouseout="this.style.background='rgba(6,182,212,0.1)'"
                    onclick={`if(window.trackDownload) window.trackDownload('note', { subject: 'Economics', language: 'Hindi', category: 'MDC', medium: 'HI', part: ${i + 1} });`}
                  >
                    <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0;">
                      <span style="font-size: 0.85rem; flex-shrink: 0;">📝</span>
                      <div style="font-size: 0.82rem; font-weight: 700; color: #06b6d4;">Economics Notes — Hindi · Part {i + 1}</div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0;">
                      <span style="font-size: 0.6rem; font-weight: 700; background: rgba(6,182,212,0.15); color: #06b6d4; border: 1px solid rgba(6,182,212,0.25); border-radius: 10px; padding: 1px 5px;">HI</span>
                      <ExternalLink size="12" style="color: #06b6d4;" />
                    </div>
                  </a>
                ))}
              </div>
            </div>

            {/* English Notes — 6 Parts */}
            <div>
              <div style="font-size: 0.65rem; font-weight: 700; color: var(--accent-warning); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 0.4rem; display: flex; align-items: center; gap: 0.3rem;">🇬🇧 English Notes — 6 Parts</div>
              <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                {[
                  'https://drive.google.com/file/d/1QK023k5qJka4CgGqFA4acZRrphTOTZni/view?usp=drive_link',
                  'https://drive.google.com/file/d/1dK737cXukGiN4Dc-RS1zCJv0a5eumeYF/view?usp=drive_link',
                  'https://drive.google.com/file/d/10WkAns8spzpIY21bClNSbU6Hb344Y2Wm/view?usp=drive_link',
                  'https://drive.google.com/file/d/12pyJeseGPT0fk6U9OG37W7V7T0AjRy40/view?usp=drive_link',
                  'https://drive.google.com/file/d/1ch1t7_aefSDyaubVY7bpY9VAq0jP0jvH/view?usp=drive_link',
                  'https://drive.google.com/file/d/1pUXjwAV13pyM1KOEHbHgjjPgf3l-Ahjf/view?usp=drive_link',
                ].map((url, i) => (
                  <a
                    href={url}
                    target="_blank"
                    rel="noopener noreferrer"
                    style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; padding: 0.55rem 0.85rem; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.22); border-radius: var(--radius-xs); text-decoration: none; transition: background 0.2s;"
                    onmouseover="this.style.background='rgba(245,158,11,0.16)'"
                    onmouseout="this.style.background='rgba(245,158,11,0.08)'"
                    onclick={`if(window.trackDownload) window.trackDownload('note', { subject: 'Economics', language: 'English', category: 'MDC', medium: 'EN', part: ${i + 1} });`}
                  >
                    <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 0;">
                      <span style="font-size: 0.85rem; flex-shrink: 0;">📝</span>
                      <div style="font-size: 0.82rem; font-weight: 700; color: var(--accent-warning);">Economics Notes — English · Part {i + 1}</div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.35rem; flex-shrink: 0;">
                      <span style="font-size: 0.6rem; font-weight: 700; background: rgba(245,158,11,0.15); color: var(--accent-warning); border: 1px solid rgba(245,158,11,0.25); border-radius: 10px; padding: 1px 5px;">EN</span>
                      <ExternalLink size="12" style="color: var(--accent-warning);" />
                    </div>
                  </a>
                ))}
              </div>
            </div>

          </div>
        )}

        <p style="font-size: 0.7rem; color: var(--text-tertiary); margin: 0; display: flex; align-items: center; gap: 0.3rem;">
          <Globe size="11" />
          Notes open in Google Drive. No account required to view.
        </p>
      </div>
    </div>
  )}

  <script is:inline>
    (function() {
      var elements = document.querySelectorAll('.live-paper-download-count');
      if (!elements.length) return;
      var url = 'https://script.google.com/macros/s/AKfycbx3ZJ1VuRgNc71FSKnrIAzLsv3qxnUeBwA8HALHWhDxlpJC93YzOwCV5rmLLT-swLaXHQ/exec?action=papercounts';
      fetch(url)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.status === 'ok' && data.counts) {
            elements.forEach(function(el) {
              var title = el.getAttribute('data-subject-title');
              var count = data.counts[title] || 0;
              el.textContent = count.toLocaleString();
            });
          }
        })
        .catch(function() {
          elements.forEach(function(el) {
            el.textContent = '0';
          });
        });
    })();
  </script>
</Layout>
