      <script is:inline>
        (function() {
          // Paper switcher (MJ-04 vs MJ-05)
          var paperTabs = document.querySelectorAll('.pyq-paper-tab');
          var paperPanels = document.querySelectorAll('.pyq-paper-panel');
          paperTabs.forEach(function(tab) {
            tab.addEventListener('click', function() {
              var code = tab.getAttribute('data-paper-code');
              paperTabs.forEach(function(t) {
                var active = t === tab;
                t.style.borderColor = active ? '#818cf8' : 'var(--border-color)';
                t.style.background = active ? 'rgba(129,140,248,0.18)' : 'var(--bg-secondary)';
              });
              paperPanels.forEach(function(panel) {
                panel.style.display = panel.id === 'pyq-panel-' + code ? 'flex' : 'none';
              });
            });
          });

          // Batch sub-tabs (2022-2026 vs 2023-2027)
          var batchBtns = document.querySelectorAll('.pyq-batch-subtab');
          batchBtns.forEach(function(btn) {
            btn.addEventListener('click', function() {
              var parentCode = btn.getAttribute('data-parent-paper');
              var targetId = 'batch-box-' + btn.getAttribute('data-target-batch');
              document.querySelectorAll('.pyq-batch-subtab[data-parent-paper="' + parentCode + '"]').forEach(function(b) {
                var active = b === btn;
                b.style.borderColor = active ? '#34d399' : 'var(--border-color)';
                b.style.background = active ? 'rgba(16,185,129,0.16)' : 'var(--bg-tertiary)';
                b.style.color = active ? '#34d399' : 'var(--text-secondary)';
              });
              document.querySelectorAll('.batch-of-' + parentCode).forEach(function(box) {
                box.style.display = box.id === targetId ? 'flex' : 'none';
              });
            });
          });

          // Expand / Collapse all solutions button
          document.querySelectorAll('.toggle-all-solutions-btn').forEach(function(btn) {
            var expanded = false;
            btn.addEventListener('click', function() {
              expanded = !expanded;
              var code = btn.getAttribute('data-target-paper');
              var panel = document.getElementById('pyq-panel-' + code);
              if (!panel) return;
              panel.querySelectorAll('details.pyq-solution-details').forEach(function(d) {
                d.open = expanded;
              });
              btn.textContent = expanded ? '🔼 Collapse All Answers' : '💡 Expand All Answers';
            });
          });
        })();
      </script>
    </div>
  )}

