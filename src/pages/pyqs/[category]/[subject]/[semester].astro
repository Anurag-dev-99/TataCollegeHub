---
import Layout from '../../../../layouts/Layout.astro';
import pyqsData from '../../../../../public/data/pyqs.json';
import notesData from '../../../../../public/data/notes.json';
import mathsSem3Data from '../../../../../public/data/maths-sem3-complete.json';
import { renderMathText } from '../../../../utils/renderMath';
import { ChevronLeft, Calendar, Download, FileCode, AlertCircle, HelpCircle, ExternalLink, BookOpen, Globe, Sparkles, Eye, MessageCircle } from '@lucide/astro';

export async function getStaticPaths() {
  const pathsMap = new Map();
  
  // Include ALL papers — available ones AND missing AEC papers so those pages render
  pyqsData.forEach(item => {
    // For non-AEC categories, only show pages that have an actual downloadUrl
    if (item.category !== 'AEC' && !item.downloadUrl) return;

    const key = `${item.category.toLowerCase()}|${item.subject.toLowerCase()}|${item.semester}`;
    if (!pathsMap.has(key)) {
      pathsMap.set(key, {
        params: {
          category: item.category.toLowerCase(),
          subject: item.subject.toLowerCase(),
          semester: item.semester.toString()
        },
        props: {
          originalCategory: item.category,
          originalSubject: item.subject,
          originalSemester: item.semester
        }
      });
    }
  });
  
  return Array.from(pathsMap.values());
}

const { category, subject, semester } = Astro.params;
const { originalCategory, originalSubject, originalSemester } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const isMathsMajorSem3 = category === 'major' && subject === 'mathematics' && semester === '3';

// Paid notes for this paper (from notes.json) — shown below the free PYQs
const paidNotes = notesData.products.filter(n => n.available && n.match.category === category && n.match.subject === subject && n.match.semester === semester);
const notesWaLink = (item: string, price: number) => `https://api.whatsapp.com/send?phone=${notesData.whatsapp}&text=${encodeURIComponent(`Hi KolhanHub! 👋 I want to buy: ${item} – ₹${price}. Please send the payment QR.`)}`;

// Filter papers matching these exactly
const matchingPapers = pyqsData.filter(p => 
  p.category.toLowerCase() === category &&
  p.subject.toLowerCase() === subject &&
  p.semester.toString() === semester
);
---

<Layout
  title={isMathsMajorSem3 ? 'Kolhan University B.Sc Maths Major Sem 3 PYQs (MJ-04 Real Analysis & MJ-05 Vectors) with Solutions' : `${originalSubject} Sem ${originalSemester} PYQs`}
  description={isMathsMajorSem3 ? 'Download Kolhan University B.Sc. Mathematics Honours Semester 3 Previous Year Question Papers (MJ-04 Real Analysis & MJ-05 Vectors) for 2022 & 2023 batches with complete step-by-step solved answers, repeated questions, book guide, and 2023 batch result stats.' : undefined}
  activeTab="pyqs"
>
  {isMathsMajorSem3 && (
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
  )}

  <!-- Breadcrumb Navigation -->
  <div style="margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.85rem;">
    <a href={`${baseUrl}/pyqs`} style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; color: var(--text-secondary);">
      <ChevronLeft size="16" /> PYQs Database
    </a>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-secondary); font-weight: 500;">{originalCategory}</span>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-secondary); font-weight: 500;">{originalSubject}</span>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-primary); font-weight: 600;">Sem {originalSemester}</span>
  </div>

  <!-- Page Header -->
  <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 1.75rem; font-family: var(--font-display); tracking: -0.03em;">
      {originalSubject} Question Papers
    </h1>
    <p style="color: var(--text-secondary); font-size: 1rem;">
      Category: <strong>{originalCategory}</strong> • Semester: <strong>{originalSemester}</strong>
      {isMathsMajorSem3 && <> • Papers: <strong>MJ-04 (Real Analysis) &amp; MJ-05 (Vectors)</strong></>}
    </p>
  </div>

  {matchingPapers.length === 0 ? (
    <div class="card" style="text-align: center; padding: 4rem 1rem; display: flex; flex-direction: column; align-items: center; gap: 1rem;">
      <AlertCircle size="40" style="color: var(--text-tertiary);" />
      <div>
        <h3 style="font-size: 1.25rem; font-family: var(--font-display);">No papers available yet</h3>
        <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.25rem;">
          We are currently checking archives for this subject paper.
        </p>
      </div>
      <button 
        class="btn btn-primary btn-sm" 
        style="margin-top: 0.5rem;"
        onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { subject: '${originalSubject}', semester: '${originalSemester}', category: '${originalCategory}' } }));`}
      >
        Request Paper Now
      </button>
    </div>
  ) : (
    <div style="display: flex; flex-direction: column; gap: 1.25rem;">
      {matchingPapers.map(paper => {
        const hasUrl = !!paper.downloadUrl;
        const isMissing = !!(paper as any).missing;
        
        return (
          <div 
            class="card animate-fade-in" 
            style={`display: flex; flex-direction: column; gap: 1rem; border-color: ${isMissing ? 'rgba(245,158,11,0.3)' : 'var(--border-color)'}; ${isMissing ? 'background: linear-gradient(135deg, rgba(245,158,11,0.04) 0%, var(--bg-secondary) 100%);' : ''}`}
          >

            {/* Missing paper top-banner — AEC only */}
            {isMissing && (
              <div style="display: flex; align-items: center; gap: 0.5rem; background: rgba(245,158,11,0.10); border: 1px solid rgba(245,158,11,0.25); border-radius: var(--radius-xs); padding: 0.5rem 0.85rem; font-size: 0.78rem; color: #d97706; font-weight: 600; margin-bottom: -0.25rem;">
                <AlertCircle size="14" style="flex-shrink:0;" />
                <span>Not Available — This paper is missing from our archive.</span>
              </div>
            )}
            
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
              <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <div style={`background-color: ${isMissing ? 'rgba(245,158,11,0.12)' : 'var(--bg-tertiary)'}; color: ${isMissing ? '#d97706' : 'var(--accent-primary)'}; width: 40px; height: 40px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center; flex-shrink: 0;`}>
                  {isMissing ? <HelpCircle size="20" /> : <FileCode size="20" />}
                </div>
                <div>
                  <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-primary);">{paper.title}</h3>
                  <div style="display: flex; gap: 0.75rem; font-size: 0.775rem; color: var(--text-secondary); margin-top: 0.25rem; flex-wrap: wrap;">
                    <span>Year: <strong>{paper.year}</strong></span>
                    {(paper as any).set && <><span>•</span><span>{(paper as any).set}</span></>}
                    {!isMissing && <><span>•</span><span style="display: flex; align-items: center; gap: 0.15rem;"><Download size="12" /> <span class="live-paper-download-count" data-subject-title={paper.title}>—</span> downloads</span></>}
                  </div>
                </div>
              </div>
              
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem; flex-shrink: 0;">
                <span class="badge badge-primary" style="font-size: 0.7rem;">{paper.category}</span>
                {isMissing && (
                  <span style="font-size: 0.62rem; font-weight: 700; background: rgba(245,158,11,0.15); color: #d97706; border: 1px solid rgba(245,158,11,0.3); border-radius: 20px; padding: 2px 7px; white-space: nowrap;">Missing</span>
                )}
              </div>
            </div>

            <!-- Download / Upload CTA -->
            <div style="border-top: 1px solid var(--border-color); padding-top: 0.875rem; display: flex; justify-content: flex-end; align-items: center; gap: 0.75rem;">
              {hasUrl ? (
              <a 
                  href={paper.downloadUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn btn-primary btn-sm" 
                  style="gap: 0.35rem; font-size: 0.85rem;"
                  onclick={`if(window.trackDownload) window.trackDownload('pyq', { subject: '${paper.title}', category: '${paper.category}', semester: '${paper.semester}' });`}
                >
                  Download Paper <ExternalLink size="14" />
                </a>
              ) : isMissing ? (
                <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; justify-content: space-between; flex-wrap: wrap;">
                  <span style="font-size: 0.8rem; color: var(--text-tertiary); display: flex; align-items: center; gap: 0.3rem;">
                    <AlertCircle size="13" /> Paper not yet in our archive
                  </span>
                  <div style="display: flex; gap: 0.5rem;">
                    <button 
                      class="btn btn-sm" 
                      style="font-size: 0.8rem; white-space: nowrap; background: rgba(245,158,11,0.12); color: #d97706; border: 1px solid rgba(245,158,11,0.3); border-radius: 20px; padding: 0.35rem 0.85rem; cursor: pointer; transition: background 0.2s;"
                      onclick={`document.dispatchEvent(new CustomEvent('open-submit-modal'));`}
                    >
                      📤 Upload if you have it
                    </button>
                    <button 
                      class="btn btn-outline btn-sm" 
                      style="font-size: 0.8rem; white-space: nowrap;"
                      onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { subject: '${paper.title}', semester: '${paper.semester}', category: '${paper.category}' } }));`}
                    >
                      Request Paper
                    </button>
                  </div>
                </div>
              ) : (
                <div style="display: flex; align-items: center; gap: 0.5rem; width: 100%; justify-content: space-between;">
                  <span style="font-size: 0.8rem; color: var(--text-tertiary); display: flex; align-items: center; gap: 0.25rem;">
                    <AlertCircle size="14" /> PDF link awaiting upload
                  </span>
                  <div style="display: flex; gap: 0.5rem;">
                    <button 
                      disabled 
                      class="btn btn-secondary btn-sm" 
                      style="opacity: 0.6; cursor: not-allowed; font-size: 0.8rem; background: var(--bg-hover);"
                    >
                      Coming Soon
                    </button>
                    <button 
                      class="btn btn-outline btn-sm" 
                      style="font-size: 0.8rem; white-space: nowrap;"
                      onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { subject: '${paper.title}', semester: '${paper.semester}', category: '${paper.category}' } }));`}
                    >
                      Request Paper
                    </button>
                  </div>
                </div>
              )}
            </div>

          </div>
        );
      })}
    </div>
  )}

  {/* ── Paid Notes (from notes.json) ─────────────────────── */}
  {paidNotes.length > 0 && (
    <div style="margin-top: 2rem;">
      <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.85rem; flex-wrap: wrap;">
        <BookOpen size="18" style="color: #818cf8; flex-shrink: 0;" />
        <h2 style="font-size: 1rem; font-weight: 800; color: var(--text-primary); margin: 0;">Notes for this paper</h2>
        <span style="font-size: 0.6rem; font-weight: 700; background: rgba(129,140,248,0.12); color: #818cf8; border: 1px solid rgba(129,140,248,0.3); border-radius: 20px; padding: 2px 7px; white-space: nowrap;">FREE SAMPLE</span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 0.6rem;">
        {paidNotes.map(n => (
          <div style={`display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; border: 1px solid ${n.color}33; border-radius: var(--radius-sm); padding: 0.75rem 1rem; background: linear-gradient(135deg, ${n.color}0d 0%, rgba(0,0,0,0.12) 100%);`}>
            <div style="display: flex; align-items: center; gap: 0.6rem; min-width: 0;">
              <span style="font-size: 1.2rem; flex-shrink: 0;">{n.emoji}</span>
              <div style="min-width: 0;">
                <div style={`font-size: 0.88rem; font-weight: 800; color: ${n.color};`}>{n.title} Notes</div>
                <div style="font-size: 0.7rem; color: var(--text-tertiary); margin-top: 1px;">{n.course} · Scanned PDF</div>
              </div>
            </div>
            <div style="display: flex; gap: 0.45rem; flex-wrap: wrap;">
              <a href={n.demoUrl} target="_blank" rel="noopener noreferrer"
                 data-notes-event="notes_sample" data-notes-id={n.id}
                 data-sheet-subject={n.title} data-sheet-action="Free Sample" data-sheet-category={n.course}
                 style={`display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; font-weight: 700; color: ${n.color}; text-decoration: none; border: 1px solid ${n.color}55; border-radius: 20px; padding: 5px 11px; white-space: nowrap;`}>
                👀 Free sample
              </a>
              <a href={notesWaLink(`${n.title} notes (${n.course})`, n.price)} target="_blank" rel="noopener noreferrer"
                 data-notes-event="notes_buy" data-notes-id={n.id}
                 data-sheet-subject={n.title} data-sheet-action={`Get Notes (₹${n.price})`} data-sheet-category={n.course}
                 style={`display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.72rem; font-weight: 800; color: #0b0b12; text-decoration: none; background: ${n.color}; border-radius: 20px; padding: 5px 11px; white-space: nowrap;`}>
                Get Full Notes →
              </a>
            </div>
          </div>
        ))}
      </div>
      <a href={`${baseUrl}/notes`}
         onclick="if(window.trackDownload) window.trackDownload('note', { subject: 'Notes Hub Link', language: 'See All Notes Click', category: 'PYQ Page', medium: 'PYQ_PAGE' });"
         style="display: inline-block; margin-top: 0.6rem; font-size: 0.72rem; color: var(--text-secondary); text-decoration: underline;">See combos & all notes in the Notes Hub →</a>
      <script is:inline>
        document.querySelectorAll('[data-notes-event]').forEach(function (el) {
          el.addEventListener('click', function () {
            if (window.trackDownload) {
              window.trackDownload('note', {
                subject: el.getAttribute('data-sheet-subject') || el.getAttribute('data-notes-id'),
                language: el.getAttribute('data-sheet-action') || el.getAttribute('data-notes-event'),
                category: el.getAttribute('data-sheet-category') || 'Paid Notes',
                medium: 'PYQ_PAGE'
              });
            }
            if (typeof window.gtag === 'function') {
              window.gtag('event', el.getAttribute('data-notes-event'), { notes_id: el.getAttribute('data-notes-id'), page: 'pyq' });
            }
          });
        });
      </script>
    </div>
  )}

  {/* ══════════════════════════════════════════════════════════════════════════
      SOLVED PYQs + STEP-BY-STEP SOLUTIONS + ANALYSIS (MATHS MAJOR SEM 3)
  ══════════════════════════════════════════════════════════════════════════ */}
  {isMathsMajorSem3 && (
    <div style="margin-top: 2.25rem; display: flex; flex-direction: column; gap: 1.5rem;">

      <!-- Header + Paper Switcher -->
      <div style="border: 1px solid rgba(129,140,248,0.3); border-radius: var(--radius-sm); padding: 1.15rem 1.25rem; background: linear-gradient(135deg, rgba(129,140,248,0.08) 0%, rgba(16,185,129,0.04) 100%); display: flex; flex-direction: column; gap: 0.85rem;">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;">
          <div>
            <div style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.68rem; font-weight: 800; color: #34d399; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); border-radius: 20px; padding: 2px 9px; margin-bottom: 0.35rem;">
              <Sparkles size="12" /> COMPLETE TEXT PYQs + STEP-BY-STEP SOLUTIONS
            </div>
            <h2 style="font-size: 1.35rem; font-weight: 850; font-family: var(--font-display); margin: 0; color: var(--text-primary);">
              Solved Question Papers, Repeated Questions &amp; Exam Guide
            </h2>
            <p style="font-size: 0.82rem; color: var(--text-secondary); margin: 0.2rem 0 0;">
              Read every question in text format, click "Show Answer" for step-by-step university solutions, and check repeated questions &amp; book advice.
            </p>
          </div>
          <a href={`${baseUrl}/syllabus/mathematics`} style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.78rem; font-weight: 800; color: #0b0b12; background: #818cf8; border-radius: 20px; padding: 7px 14px; text-decoration: none; white-space: nowrap;">
            📚 View Sem 3 Syllabus &amp; Unit Weightage →
          </a>
        </div>

        <!-- Paper Tabs (MJ-04 vs MJ-05) -->
        <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; border-top: 1px solid var(--border-color); padding-top: 0.85rem;">
          {mathsSem3Data.papers.map((p, idx) => (
            <button
              type="button"
              class={`pyq-paper-tab ${idx === 0 ? 'active' : ''}`}
              data-paper-code={p.paperCode}
              style={`flex: 1; min-width: 220px; padding: 0.7rem 1rem; border-radius: var(--radius-xs); border: 1px solid ${idx === 0 ? '#818cf8' : 'var(--border-color)'}; background: ${idx === 0 ? 'rgba(129,140,248,0.18)' : 'var(--bg-secondary)'}; color: var(--text-primary); font-weight: 800; font-size: 0.88rem; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;`}
            >
              <span>📘 {p.paperCode}: {p.paperTitle}</span>
              <span style="font-size: 0.68rem; color: #34d399; font-weight: 700;">2 Solved Papers</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Paper Content Panels (MJ-04 & MJ-05) -->
      {mathsSem3Data.papers.map((p, pIdx) => (
        <div
          class="pyq-paper-panel"
          id={`pyq-panel-${p.paperCode}`}
          style={`display: ${pIdx === 0 ? 'flex' : 'none'}; flex-direction: column; gap: 1.4rem;`}
        >
          <!-- Batch Switcher (2023-2027 vs 2022-2026) + Show All Answers Toggle -->
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.75rem 1rem;">
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
              <span style="font-size: 0.75rem; font-weight: 800; color: var(--text-tertiary); text-transform: uppercase;">Select Batch Paper:</span>
              {p.pyqPapers.map((bPaper: any, bIdx: number) => (
                <button
                  type="button"
                  class="pyq-batch-subtab"
                  data-parent-paper={p.paperCode}
                  data-target-batch={`${p.paperCode}-${bPaper.batch}`}
                  style={`padding: 0.45rem 0.9rem; border-radius: 20px; border: 1px solid ${bIdx === 0 ? '#34d399' : 'var(--border-color)'}; background: ${bIdx === 0 ? 'rgba(16,185,129,0.16)' : 'var(--bg-tertiary)'}; color: ${bIdx === 0 ? '#34d399' : 'var(--text-secondary)'}; font-weight: 800; font-size: 0.78rem; cursor: pointer;`}
                >
                  {bPaper.batch} Batch ({bPaper.questionsCount || '18'} Qs Solved)
                </button>
              ))}
            </div>
            <button
              type="button"
              class="toggle-all-solutions-btn"
              data-target-paper={p.paperCode}
              style="padding: 0.45rem 0.9rem; border-radius: 20px; border: 1px solid rgba(251,191,36,0.35); background: rgba(251,191,36,0.1); color: #fbbf24; font-weight: 800; font-size: 0.75rem; cursor: pointer;"
            >
              💡 Expand All Answers
            </button>
          </div>

          <!-- Each Batch's Questions & Solutions -->
          {p.pyqPapers.map((bPaper: any, bIdx: number) => (
            <div
              class={`pyq-batch-container batch-of-${p.paperCode}`}
              id={`batch-box-${p.paperCode}-${bPaper.batch}`}
              style={`display: ${bIdx === 0 ? 'flex' : 'none'}; flex-direction: column; gap: 1.15rem;`}
            >
              <!-- Batch Header Bar with Direct PDF Link -->
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap; padding: 0.75rem 1rem; border-radius: var(--radius-xs); background: rgba(129,140,248,0.07); border: 1px solid rgba(129,140,248,0.22);">
                <div>
                  <div style="font-size: 0.95rem; font-weight: 800; color: var(--text-primary);">
                    {p.paperCode} ({p.paperTitle}) — {bPaper.batch} Batch Question Paper
                  </div>
                  <div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 2px;">
                    Full Marks: 75 · Time: 3 Hours · Pass Marks: 30 (Theory) / 40 (Total with Internal)
                  </div>
                </div>
                {bPaper.downloadUrl && (
                  <a
                    href={bPaper.downloadUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary btn-sm"
                    style="font-size: 0.78rem; gap: 0.35rem;"
                    onclick={`if(window.trackDownload) window.trackDownload('pyq', { subject: '${bPaper.pdfTitle}', category: 'Major', semester: '3' });`}
                  >
                    <Download size="13" /> Original Question Paper PDF
                  </a>
                )}
              </div>

              <!-- Groups (Group A MCQs, Group A Short Answer, Group B Long Answer) -->
              {bPaper.groups.map((grp: any) => (
                <div class="card" style="background: var(--bg-secondary); display: flex; flex-direction: column; gap: 0.85rem; padding: 1.1rem 1.2rem;">
                  <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; border-bottom: 1px solid var(--border-color); padding-bottom: 0.65rem;">
                    <h3 style="font-size: 0.98rem; font-weight: 800; color: #818cf8; margin: 0; font-family: var(--font-display);">
                      {grp.groupName}
                    </h3>
                    <span style="font-size: 0.7rem; font-weight: 800; background: rgba(129,140,248,0.14); color: #818cf8; border: 1px solid rgba(129,140,248,0.3); border-radius: 20px; padding: 2px 9px;">
                      {grp.marksPerQuestion} {grp.marksPerQuestion === 1 ? 'Mark' : 'Marks'} Each
                    </span>
                  </div>

                  <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    {grp.questions.map((q: any) => (
                      <div style="border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.85rem 1rem; background: rgba(0,0,0,0.14); display: flex; flex-direction: column; gap: 0.55rem;">
                        <!-- Question Metadata Row -->
                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
                          <div style="display: flex; align-items: center; gap: 0.45rem; flex-wrap: wrap;">
                            <span style="font-size: 0.72rem; font-weight: 800; background: #818cf8; color: #0b0b12; border-radius: 5px; padding: 2px 7px;">
                              Q. {q.qNo}
                            </span>
                            {q.unit && (
                              <span style="font-size: 0.66rem; font-weight: 700; color: var(--text-tertiary); background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 5px; padding: 1px 6px;">
                                Unit {q.unit}
                              </span>
                            )}
                            {q.topic && (
                              <span style="font-size: 0.68rem; color: #fbbf24; font-weight: 600;" set:html={renderMathText(q.topic)} />
                            )}
                          </div>
                          <span style="font-size: 0.68rem; font-weight: 700; color: var(--text-secondary);">
