---
import Layout from '../../../../layouts/Layout.astro';
import pyqsData from '../../../../../public/data/pyqs.json';
import notesData from '../../../../../public/data/notes.json';
import mathsSem3Data from '../../../../../public/data/maths-sem3-complete.json';
import syllabusData from '../../../../../public/data/syllabus.json';
import mdcData from '../../../../../public/data/mdc.json';
import aecData from '../../../../../public/data/aec.json';
import vacData from '../../../../../public/data/vac.json';
import secData from '../../../../../public/data/sec.json';
import iksData from '../../../../../public/data/iks.json';
import markingSchemes from '../../../../../public/data/paper_marking_schemes.json';
import PastBatchScoreGlimpse from '../../../../components/PastBatchScoreGlimpse.astro';
import { renderMathText } from '../../../../utils/renderMath';
import { ChevronLeft, Download, FileCode, AlertCircle, HelpCircle, ExternalLink, BookOpen, Globe, Sparkles, GraduationCap, CheckCircle2 } from '@lucide/astro';

export async function getStaticPaths() {
  const pathsMap = new Map();

  // Include ALL papers — available ones AND missing AEC papers so those pages render
  pyqsData.forEach(item => {
    // For non-AEC categories, only show pages that have an actual downloadUrl
    if (item.category !== 'AEC' && !item.downloadUrl) return;

    const key = `${item.category.toLowerCase()}|${item.subject.toLowerCase()}|${item.semester}`;
    if (!pathsMap.has(key)) {
      pathsMap.set(key, {
        params: {
          category: item.category.toLowerCase(),
          subject: item.subject.toLowerCase(),
          semester: item.semester.toString()
        },
        props: {
          originalCategory: item.category,
          originalSubject: item.subject,
          originalSemester: item.semester
        }
      });
    }
  });

  return Array.from(pathsMap.values());
}

const { category, subject, semester } = Astro.params;
const { originalCategory, originalSubject, originalSemester } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const siteUrl = 'https://kolhanhub.in';

const isMathsMajorSem3 = category === 'major' && subject === 'mathematics' && semester === '3';

// Paid notes for this paper (from notes.json) — shown below the free PYQs
const paidNotes = notesData.products.filter(n => n.available && n.match.category === category && n.match.subject === subject && n.match.semester === semester);
const notesWaLink = (item: string, price: number) => `https://api.whatsapp.com/send?phone=${notesData.whatsapp}&text=${encodeURIComponent(`Hi KolhanHub! 👋 I want to buy: ${item} – ₹${price}. Please send the payment QR.`)}`;

// Filter entries matching this category/subject/semester
const matchingPapers = pyqsData.filter(p =>
  p.category.toLowerCase() === category &&
  p.subject.toLowerCase() === subject &&
  p.semester.toString() === semester
);

// Separate question papers from inline notes (e.g., IKS notes stored in pyqs.json)
const questionPapers = matchingPapers.filter((p: any) => p.type !== 'notes');
const inlineNotes = matchingPapers.filter((p: any) => p.type === 'notes' && !!p.downloadUrl);
const availablePapers = questionPapers.filter(p => !!p.downloadUrl);
const availableCount = availablePapers.length;

// Display-only formatter for the 21 raw filenames in pyqs.json (keeps raw paper.title untouched for Google Sheets tracking)
function formatPaperDisplayTitle(paper: any): string {
  const raw = String(paper.title || '').trim();
  if (!/\.pdf$/i.test(raw) && !raw.includes('_')) {
    return raw;
  }

  const codeMatch = raw.match(/(?:^|[^a-z0-9])(mj|mn|mdc|sec|aec|vac)[-_ ]?(\d+[a-z]?)(?=$|[^a-z0-9])/i);
  let codeTag = codeMatch ? `${codeMatch[1].toUpperCase()}-${codeMatch[2].toUpperCase()}` : '';
  if (!codeTag && ['SEC', 'AEC', 'VAC', 'MDC'].includes(paper.category)) {
    codeTag = `${paper.category}-${paper.semester}`;
  }

  const yr = paper.year ? ` — ${paper.year}` : '';
  const setPart = paper.set ? ` (${paper.set})` : '';

  if (paper.category === 'Major' || paper.category === 'Minor') {
    return `${paper.subject} ${paper.category}${codeTag ? ' ' + codeTag : ''} Sem ${paper.semester} Question Paper${yr}${setPart}`;
  }
  return `${paper.subject}${codeTag ? ` (${codeTag})` : ''} Question Paper${yr}${setPart}`;
}

// Sibling semesters for the same category + subject (only semesters that generate a page)
const siblingSemesters = [...new Set(
  pyqsData
    .filter(p =>
      p.category.toLowerCase() === category &&
      p.subject.toLowerCase() === subject &&
      (p.category === 'AEC' || !!p.downloadUrl)
    )
    .map(p => Number(p.semester))
)].sort((a, b) => a - b);

// Category exam pattern & passing marks backed by paper_marking_schemes.json
type ExamPattern = { badge: string; total: string; split: string; pass: string; duration: string; note: string };

function getExamPattern(cat: string, subj: string, sem: string | number): ExamPattern {
  const SUBJECT_ALIASES: Record<string, string> = {
    'bba': 'business administration',
    'evs': 'environment & water management',
    'bca': 'computer application',
    'it': 'information technology',
    'mass communication': 'mass communication and video production'
  };
  const subLower = subj.toLowerCase().trim();
  const normalizedSub = SUBJECT_ALIASES[subLower] || subLower;
  const semNum = Number(sem);

  if (cat === 'major' || cat === 'minor') {
    let isPractical = markingSchemes.subjects.alwaysPractical.some(
      s => s.toLowerCase() === normalizedSub
    );

    if (!isPractical && cat === 'minor') {
      isPractical = markingSchemes.exceptions.nonPracticalSubjectsThatHavePracticalInSpecificMinorPapers.some(
        ex => ex.sem === semNum && ex.paper.toLowerCase().includes(normalizedSub)
      );
    }

    if (markingSchemes.subjects.mixedVocationalSubjects.some(s => s.toLowerCase() === normalizedSub)) {
      const isMixedNonPrac = markingSchemes.exceptions.mixedSubjectsNonPracticalPapers.some(
        ex => ex.sem === semNum && ex.paper.toLowerCase().includes(normalizedSub) && ex.paper.toLowerCase().includes(cat)
      );
      isPractical = !isMixedNonPrac;
    }

    const acNote = cat === 'minor' ? ' 2025 batch onwards, Minor is officially called Associated Core (AC).' : '';
    if (isPractical) {
      const fm = markingSchemes.schemes['100_PRACTICAL'].fullMarks;
      const pm = markingSchemes.schemes['100_PRACTICAL'].passMarks;
      return {
        badge: cat === 'major' ? 'MJ · 100 Marks (Practical)' : 'MN / AC · 100 Marks (Practical)',
        total: `${fm.total} Marks`,
        split: `${fm.theory} Th + ${fm.internal} Int + ${fm.practical} Prac`,
        pass: `${pm.total} Total (${pm.theory} / ${pm.internal} / ${pm.practical})`,
        duration: '3 Hours',
        note: `Minimum 40% required in each component: Theory (${pm.theory}/${fm.theory}), Internal (${pm.internal}/${fm.internal}), and Practical (${pm.practical}/${fm.practical}).${acNote}`
      };
    } else {
      const fm = markingSchemes.schemes['100_NON_PRACTICAL'].fullMarks;
      const pm = markingSchemes.schemes['100_NON_PRACTICAL'].passMarks;
      return {
        badge: cat === 'major' ? 'MJ · 100 Marks' : 'MN / AC · 100 Marks',
        total: `${fm.total} Marks`,
        split: `${fm.theory} Theory + ${fm.internal} Internal`,
        pass: `${pm.total} Total (${pm.theory} Th / ${pm.internal} Int)`,
        duration: '3 Hours',
        note: `Minimum 40% required in each component: Theory (${pm.theory}/${fm.theory}) and Internal (${pm.internal}/${fm.internal}).${acNote}`
      };
    }
  }

  const staticPatterns: Record<string, ExamPattern> = {
    mdc: {
      badge: 'MDC · 75 Marks',
      total: '75 Marks',
      split: '75 Theory Only',
      pass: '30 Marks (40%)',
      duration: '3 Hours',
      note: 'Theory-only paper (no internal or practical). MDC syllabus is identical for Semester 1, 2 & 3 — papers from any of these semesters help.'
    },
    sec: {
      badge: 'SEC · 75 Marks',
      total: '75 Marks',
      split: '75 Theory Only',
      pass: '30 Marks (40%)',
      duration: '3 Hours',
      note: 'Theory-only paper (no internal or practical).'
    },
    aec: {
      badge: 'AEC · 50 Marks',
      total: '50 Marks',
      split: '50 Theory Only',
      pass: '20 Marks (40%)',
      duration: '2 Hours',
      note: 'Theory-only paper (no internal or practical). AEC-3 (Sem 3) and AEC-4 (Sem 4) follow the same chosen language.'
    },
    vac: {
      badge: 'VAC · 50 Marks',
      total: '50 Marks',
      split: '50 Theory Only',
      pass: '20 Marks (40%)',
      duration: '2 Hours',
      note: 'Theory-only paper (no internal or practical).'
    },
    iks: {
      badge: 'IKS · Compulsory',
      total: '50 Marks',
      split: '50 MCQs (OMR)',
      pass: '20 Marks (40%)',
      duration: '1.5 Hours',
      note: 'Compulsory NEP paper for Semester 1 across Kolhan University.'
    }
  };

  return staticPatterns[cat] || {
    badge: originalCategory,
    total: '75–100 Marks',
    split: 'NEP FYUGP Pattern',
    pass: '40% Aggregate',
    duration: '3 Hours',
    note: ''
  };
}

const pattern = getExamPattern(category, originalSubject, originalSemester);

// Matching syllabus resolver
type SyllabusLink = { label: string; subtitle: string; href: string; external: boolean };
const matchedSyllabi: SyllabusLink[] = [];

if (category === 'major') {
  const deptMatch = syllabusData.find(s => !s.department.toLowerCase().includes('minor') && s.department.toLowerCase() === subject);
  if (deptMatch) {
    const slug = deptMatch.department.toLowerCase().replace(/\s+/g, '-');
    matchedSyllabi.push({
      label: `${deptMatch.department} Major Syllabus (Sem 1–8)`,
      subtitle: 'Unit-wise syllabus & PDF downloads on KolhanHub',
      href: `${baseUrl}/syllabus/${slug}/`,
      external: false
    });
  }
} else if (category === 'minor') {
  const minorMatch = syllabusData.find(s => s.department.toLowerCase() === `${subject} minor`);
  const fallbackMajor = syllabusData.find(s => !s.department.toLowerCase().includes('minor') && s.department.toLowerCase() === subject);
  const chosen = minorMatch || fallbackMajor;
  if (chosen) {
    const slug = chosen.department.toLowerCase().replace(/\s+/g, '-');
    matchedSyllabi.push({
      label: minorMatch ? `${chosen.department} Syllabus` : `${chosen.department} Syllabus (NEP FYUGP)`,
      subtitle: minorMatch ? 'Official Minor / AC curriculum PDF & units' : 'Check department syllabus hub for Major & Minor units',
      href: `${baseUrl}/syllabus/${slug}/`,
      external: false
    });
  }
} else if (category === 'mdc') {
  let mdcMatches = mdcData.filter(m => m.name.toLowerCase() === subject);
  if (mdcMatches.length === 0 && subject === 'information technology') {
    mdcMatches = mdcData.filter(m => m.name.toLowerCase().includes('information technology'));
  }
  if (mdcMatches.length === 0) {
    mdcMatches = mdcData.filter(m => m.name.toLowerCase().includes(subject));
  }
  mdcMatches.forEach(m => {
    matchedSyllabi.push({
      label: `${m.name} (MDC) Syllabus PDF`,
      subtitle: `Common for Sem 1, 2 & 3 • ${m.category}`,
      href: m.link,
      external: true
    });
  });
  matchedSyllabi.push({
    label: 'All Kolhan University MDC Syllabi (32 Subjects)',
    subtitle: 'Official NEP FYUGP MDC PDFs, selection rules & PYQs',
    href: `${baseUrl}/syllabus/mdc/`,
    external: false
  });
} else if (category === 'aec') {
  const aecMatches = aecData.filter(a =>
    a.semester === `Semester ${originalSemester}` &&
    a.name.toLowerCase().includes(subject)
  );
  aecMatches.forEach(a => {
    matchedSyllabi.push({
      label: `${a.name} Syllabus PDF`,
      subtitle: `${a.semester} • Official Kolhan University PDF`,
      href: a.link,
      external: true
    });
  });
  matchedSyllabi.push({
    label: 'All Kolhan University AEC Syllabi (Sem 1–4)',
    subtitle: 'Hindi, English, Sanskrit & regional language PDFs',
    href: `${baseUrl}/syllabus/aec/`,
    external: false
  });
} else if (category === 'vac') {
  const vacMatches = vacData.filter(v => {
    const n = v.name.toLowerCase();
    if (subject.includes('understanding india')) return n.includes('understanding india');
    if (subject.includes('global citizenship')) return n.includes('global citizenship');
    if (subject.includes('environmental')) return n.includes('environmental');
    return n.includes(subject);
  });
  vacMatches.forEach(v => {
    matchedSyllabi.push({
      label: `${v.name} Syllabus PDF`,
      subtitle: `${v.semester} • Value Added Course`,
      href: v.link,
      external: true
    });
  });
  matchedSyllabi.push({
    label: 'All Kolhan University VAC Syllabi (Sem 1 & 4)',
    subtitle: 'Understanding India, EVS, Yoga & Global Citizenship PDFs',
    href: `${baseUrl}/syllabus/vac/`,
    external: false
  });
} else if (category === 'sec') {
  if (subject.includes('mathematical') && semester === '3') {
    matchedSyllabi.push({
      label: 'SEC-3 Syllabus & Unit Breakdown',
      subtitle: 'Complete interactive unit guide + PYQ weightage',
      href: `${baseUrl}/syllabus/sec-3/`,
      external: false
    });
  }
  const secMatches = secData.filter(s => {
    const n = s.name.toLowerCase();
    if (subject.includes('communication skill')) return n.includes('communication skill');
    if (subject.includes('digital education')) return n.includes('digital education');
    if (subject.includes('news writing')) return n.includes('news writing');
    if (subject.includes('mathematical')) return n.includes('mathematical');
    return n.includes(subject);
  });
  secMatches.forEach(s => {
    matchedSyllabi.push({
      label: `${s.name} Syllabus PDF`,
      subtitle: `${s.semester} • Skill Enhancement Course`,
      href: s.link,
      external: true
    });
  });
  matchedSyllabi.push({
    label: 'All Kolhan University SEC Syllabi (Sem 1–3)',
    subtitle: 'Digital Education, Comm. Skills, News Writing & SEC-3',
    href: `${baseUrl}/syllabus/sec/`,
    external: false
  });
} else if (category === 'iks') {
  if (Array.isArray(iksData) && iksData[0]) {
    matchedSyllabi.push({
      label: `${iksData[0].name} Syllabus PDF`,
      subtitle: `${iksData[0].semester} • ${iksData[0].type || 'Compulsory'}`,
      href: iksData[0].link,
      external: true
    });
  }
  matchedSyllabi.push({
    label: 'Kolhan University IKS Syllabus & Study Notes',
    subtitle: 'Official Sem 1 IKS PDF, exam pattern & free notes',
    href: `${baseUrl}/syllabus/iks/`,
    external: false
  });
}

if (matchedSyllabi.length === 0) {
  matchedSyllabi.push({
    label: 'Browse All Kolhan University Syllabi',
    subtitle: 'Official NEP FYUGP Curriculum PDFs',
    href: `${baseUrl}/syllabus/`,
    external: false
  });
}

// Dynamic SEO metadata
const uniqueYears = [...new Set(availablePapers.map(p => String(p.year || '')).filter(Boolean))].sort();
const yearsSummary = uniqueYears.length > 0 ? uniqueYears.join(', ') : '2022–2026';

const SHORT_SUBJECT_MAP: Record<string, string> = {
  'global citizenship education for sustainable development': 'Global Citizenship',
  'mathematical & computational thinking and analysis': 'Maths & Comp. Thinking',
  'communication skill and personality development': 'Communication Skills',
  'indian knowledge system': 'IKS (Indian Knowledge System)'
};
const shortSubject = SHORT_SUBJECT_MAP[subject] || originalSubject;

let seoTitle = '';
if (isMathsMajorSem3) {
  seoTitle = 'Kolhan University B.Sc Maths Major Sem 3 PYQs (MJ-04 & MJ-05) with Solutions';
} else {
  const c1 = `${shortSubject} Sem ${originalSemester} ${originalCategory} Question Paper PDF — Kolhan University`;
  const c2 = `${shortSubject} Sem ${originalSemester} ${originalCategory} Question Paper PDF — KU`;
  const c3 = `${shortSubject} Sem ${originalSemester} ${originalCategory} PYQ PDF — KU`;
  seoTitle = c1.length <= 62 ? c1 : (c2.length <= 62 ? c2 : c3);
}

const startYears = [...new Set(uniqueYears.map(y => y.slice(0, 4)).filter(Boolean))].sort();
const yearsShort = uniqueYears.length === 0
  ? '2022–2026 batches'
  : uniqueYears.length === 1
    ? (/^\d{4}$/.test(uniqueYears[0]) ? uniqueYears[0] : `${uniqueYears[0]} batch`)
    : uniqueYears.length === 2
      ? `${startYears[0]}, ${startYears[1]} batches`
      : `${startYears[0]}–${startYears[startYears.length - 1]} batches`;

const descSubject = originalSubject.length > 32 ? shortSubject : originalSubject;

let seoDescription = '';
if (isMathsMajorSem3) {
  seoDescription = 'Download Kolhan University B.Sc. Mathematics Honours Semester 3 Previous Year Question Papers (MJ-04 Real Analysis & MJ-05 Vectors) for 2022 & 2023 batches with complete step-by-step solved answers, repeated questions, book guide, and 2023 batch result stats.';
} else if (availableCount > 0) {
  const paperWord = availableCount === 1 ? 'paper' : 'papers';
  const fullDesc = `Download free Kolhan University ${descSubject} (${originalCategory}) Sem ${originalSemester} previous year question paper PDF (${yearsShort} — ${availableCount} ${paperWord}) for NEP FYUGP all 37 colleges.`;
  const compactDesc = `Download free Kolhan University ${descSubject} (${originalCategory}) Sem ${originalSemester} PYQ PDF (${yearsShort} — ${availableCount} ${paperWord}) for all 37 colleges.`;
  seoDescription = fullDesc.length <= 160 ? fullDesc : compactDesc;
} else {
  const fullEmpty = `Kolhan University ${descSubject} (${originalCategory}) Sem ${originalSemester} previous year question paper archive for NEP FYUGP all 37 colleges. Request or upload on KolhanHub.`;
  const compactEmpty = `Kolhan University ${descSubject} (${originalCategory}) Sem ${originalSemester} PYQ archive for all 37 colleges. Request or upload on KolhanHub.`;
  seoDescription = fullEmpty.length <= 160 ? fullEmpty : compactEmpty;
}

const seoKeywords = `${originalSubject} sem ${originalSemester} question paper, ${originalSubject} ${originalCategory} sem ${originalSemester} pyq, Kolhan University ${originalSubject} previous year question paper pdf, ${originalCategory} ${originalSubject} sem ${originalSemester}, NEP FYUGP ${originalSubject} pyq, Kolhan University question paper 2025 2026`;

// Visible + Schema FAQs
const autoFaqs = [
  {
    q: `How to download Kolhan University ${originalSubject} (${originalCategory}) Semester ${originalSemester} PYQ PDF?`,
    a: availableCount > 0
      ? `Tap any "Download PDF" button at the top of this page to open the free ${originalSubject} Semester ${originalSemester} (${originalCategory}) question paper directly on Google Drive without login or fees.`
      : `This paper is currently missing from our archive. Tap "Request Paper" below to notify us, or share a clear photo/PDF if you already have it.`
  },
  {
    q: `Which years and batches are included in ${originalSubject} Sem ${originalSemester} PYQs?`,
    a: availableCount > 0
      ? `This page currently includes ${availableCount} ${availableCount === 1 ? 'paper' : 'papers'} (${yearsSummary}) applicable across all 37 Kolhan University colleges under the NEP 2020 FYUGP syllabus.`
      : `Kolhan University NEP FYUGP batches (2022–2029) follow the same core university examination framework across all 37 affiliated colleges.`
  },
  {
    q: `What is the exam pattern and passing marks for ${originalCategory} papers in Kolhan University NEP FYUGP?`,
    a: `${originalCategory} papers carry ${pattern.total} (${pattern.split}) with a ${pattern.duration} exam duration. You need at least ${pattern.pass} to qualify under Kolhan University NEP FYUGP rules.${pattern.note ? ' ' + pattern.note : ''}`
  }
];

const schemaFaqEntities = isMathsMajorSem3
  ? mathsSem3Data.papers.flatMap((p: any) => p.faqs || []).slice(0, 6)
  : autoFaqs;

const canonicalSubpageUrl = `${siteUrl}/pyqs/${encodeURIComponent(category)}/${encodeURIComponent(subject)}/${encodeURIComponent(semester)}/`;

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": schemaFaqEntities.map((item: any) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
});

const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/` },
    { "@type": "ListItem", "position": 2, "name": "PYQs", "item": `${siteUrl}/pyqs/` },
    { "@type": "ListItem", "position": 3, "name": originalCategory, "item": `${siteUrl}/pyqs/#${category}-pyq-trigger` },
    { "@type": "ListItem", "position": 4, "name": `${originalSubject} Sem ${originalSemester}`, "item": canonicalSubpageUrl }
  ]
});
---

<Layout
  title={seoTitle}
  rawTitle={true}
  description={seoDescription}
  keywords={seoKeywords}
  activeTab="pyqs"
  hideDefaultBreadcrumb={true}
>
  <Fragment slot="head">
    {isMathsMajorSem3 && (
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    )}
    <script type="application/ld+json" set:html={faqSchema} />
    <script type="application/ld+json" set:html={breadcrumbSchema} />
  </Fragment>

  <!-- Breadcrumb Navigation -->
  <nav aria-label="Breadcrumb" style="margin-bottom: 1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; font-size: 0.82rem; min-width: 0;">
    <a href={`${baseUrl}/pyqs/`} style="display: inline-flex; align-items: center; gap: 0.2rem; font-weight: 700; color: var(--text-secondary); text-decoration: none;">
      <ChevronLeft size="15" /> PYQs
    </a>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-secondary); font-weight: 500;">{originalCategory}</span>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-secondary); font-weight: 500; overflow-wrap: anywhere;">{originalSubject}</span>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-primary); font-weight: 700;">Sem {originalSemester}</span>
  </nav>

  <!-- Compact Page Header -->
  <div style="margin-bottom: 1.15rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: clamp(1.35rem, 5.2vw, 1.85rem); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin: 0; overflow-wrap: anywhere;">
      {originalSubject} Sem {originalSemester} PYQs
    </h1>
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;">
      <span style="font-size: 0.68rem; font-weight: 700; background: rgba(99,102,241,0.12); color: var(--accent-primary); border: 1px solid rgba(99,102,241,0.28); border-radius: 20px; padding: 2px 9px;">
        {pattern.badge}
      </span>
      {availableCount > 0 && (
        <span style="font-size: 0.68rem; font-weight: 700; background: rgba(16,185,129,0.12); color: var(--accent-success); border: 1px solid rgba(16,185,129,0.28); border-radius: 20px; padding: 2px 9px;">
          {availableCount} Free {availableCount === 1 ? 'PDF' : 'PDFs'}
        </span>
      )}
      <span style="font-size: 0.68rem; font-weight: 600; color: var(--text-tertiary); background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 20px; padding: 2px 9px;">
        NEP FYUGP · All 37 Colleges
      </span>
    </div>
    {isMathsMajorSem3 && (
      <p style="color: var(--text-secondary); font-size: 0.84rem; margin: 0;">
        Papers: <strong>MJ-04 (Real Analysis) &amp; MJ-05 (Vectors)</strong> &bull; Solved PYQs Included
      </p>
    )}
  </div>

  <!-- Sibling Semester Switcher Pills -->
  {siblingSemesters.length > 1 && (
    <div style="margin-bottom: 1.25rem; display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; padding: 0.65rem 0.85rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
