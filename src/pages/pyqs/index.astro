          <a href="https://api.whatsapp.com/send?phone=918002059887&text=Hi!%20I%20have%20some%20PYQ%20papers%20to%20share%20%F0%9F%93%9A" target="_blank" rel="noopener noreferrer" style="font-size: 0.7rem; color: rgba(37,211,102,0.9); font-weight: 600; text-decoration: none; margin-top: 0.2rem;">
