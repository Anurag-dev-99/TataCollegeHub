              </button>

              <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease-out; background-color: rgba(0,0,0,0.15);">
                <div style="padding: 1rem 1.25rem 1.25rem;">
                  <div style="display: flex; align-items: flex-start; gap: 0.55rem; background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-xs); padding: 0.65rem 0.9rem; font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 0.85rem;">
                    <span style="flex-shrink: 0;">ℹ️</span>
                    <span><strong style="color: var(--accent-success);">2025 batch onwards:</strong> "Minor" is officially renamed <strong>Associated Core (AC)</strong>. Same papers, new name.</span>
                  </div>
                  <div style="background-color: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.1rem 1rem 1rem;">
                    <div id="minor-pyq-tabs" style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.9rem; align-items: center;">
                      <button class="btn btn-secondary minor-pyq-tab active" data-sem="all" style="height: 34px; font-size: 0.8rem; padding: 0 0.85rem; border-radius: var(--radius-xs);">
                        All ({minorData.length})
                      </button>
                      {minorSems.map(sem => (
                        <button class="btn btn-secondary minor-pyq-tab" data-sem={String(sem)} style="height: 34px; font-size: 0.8rem; padding: 0 0.85rem; border-radius: var(--radius-xs);">
                          Sem {sem}
                        </button>
                      ))}
                      <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="minor-pyq-search-wrapper">
                        <input type="text" id="minor-pyq-search" class="form-input" placeholder="Search subjects..." style="height: 34px; padding-left: 2.1rem; font-size: 0.8rem; width: 200px; border-radius: var(--radius-xs);" />
                        <span style="position: absolute; left: 0.65rem; color: var(--text-tertiary); font-size: 0.85rem;">🔍</span>
                      </div>
                    </div>

                    <div id="minor-pyq-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
                      {minorData.map(({ subject, sems, totalPapers }) => {
                        const subjectSlug = subject.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
                        const cardId = `minor-card-${subjectSlug}`;
                        const panelId = `minor-panel-${subjectSlug}`;
                        const semAttr = sems.join(',');
                        return (
