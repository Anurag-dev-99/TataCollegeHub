---
import Layout from '../../layouts/Layout.astro';
import pyqsData from '../../../public/data/pyqs.json';
import { ChevronRight, FileText, Download, HelpCircle, GraduationCap, Search } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// For AEC: include ALL papers (including missing ones)
// For other categories: only show papers with downloadUrl
const availablePyqs = pyqsData.filter(item => {
  if (item.category === 'AEC') return true;
  return !!item.downloadUrl;
});

// All AEC papers sorted by semester then subject then year
const aecPapers = availablePyqs
  .filter(p => p.category === 'AEC')
  .sort((a, b) => {
    if (a.semester !== b.semester) return a.semester - b.semester;
    if (a.subject !== b.subject) return a.subject.localeCompare(b.subject);
    const yearA = parseInt(String((a as any).batch || a.year || '0'));
    const yearB = parseInt(String((b as any).batch || b.year || '0'));
    if (yearA !== yearB) return yearA - yearB;
    const setA = String((a as any).set || '');
    const setB = String((b as any).set || '');
    return setA.localeCompare(setB);
  });

const aecTotal = aecPapers.length;

// Non-AEC categories for the generic accordion
const nonAecCategories = ['Major', 'Minor', 'MDC', 'SEC', 'VAC'];

// Marks info per category
const categoryInfo: Record<string, { marks: string; label: string; color: string; bg: string; border: string }> = {
  Major: { marks: '100 Marks', label: 'MJ', color: 'var(--accent-primary)', bg: 'rgba(99,102,241,0.12)', border: 'rgba(99,102,241,0.25)' },
  Minor: { marks: '100 Marks', label: 'AC', color: 'var(--accent-success)', bg: 'rgba(16,185,129,0.12)', border: 'rgba(16,185,129,0.25)' },
  MDC:   { marks: '75 Marks',  label: 'MDC', color: 'var(--accent-warning)', bg: 'rgba(245,158,11,0.12)', border: 'rgba(245,158,11,0.25)' },
  SEC:   { marks: '75 Marks',  label: 'SEC', color: 'var(--accent-warning)', bg: 'rgba(245,158,11,0.12)', border: 'rgba(245,158,11,0.25)' },
  VAC:   { marks: '50 Marks',  label: 'VAC', color: 'var(--accent-primary)', bg: 'rgba(99,102,241,0.12)', border: 'rgba(99,102,241,0.25)' },
  AEC:   { marks: '50 Marks',  label: 'AEC', color: 'var(--accent-success)', bg: 'rgba(16,185,129,0.12)', border: 'rgba(16,185,129,0.25)' },
};

// Get unique subjects per non-AEC category (only papers with downloadUrl)
const getSubjectsForCategory = (cat: string) => {
  return [...new Set(availablePyqs.filter(p => p.category === cat && !!p.downloadUrl).map(p => p.subject))].sort();
};

// Get unique semesters for category + subject (only papers with downloadUrl)
const getSemestersForSubject = (cat: string, sub: string) => {
  return [...new Set(availablePyqs.filter(p => p.category === cat && p.subject === sub && !!p.downloadUrl).map(p => p.semester))].sort((a, b) => a - b);
};

// Popular papers (non-AEC, has downloadUrl)
const popularPapers = [...availablePyqs.filter(p => !!p.downloadUrl)]
  .sort((a, b) => (b.downloadCount || 0) - (a.downloadCount || 0))
  .slice(0, 5);
---

<Layout 
  title="Kolhan University Previous Year Question Papers (PYQ) — Tata College"
  description="Download free Kolhan University PYQ (previous year question papers) for Tata College, Chaibasa. Semester-wise exam papers for NEP FYUGP 2022 batch — Major, Minor, MDC, SEC, VAC, AEC for Semester 1 to 8. Free PDF download."
  keywords="Kolhan University PYQ, Kolhan University previous year papers, Kolhan PYQ download, Kolhan University question papers, Tata College PYQ, Tata College Chaibasa question papers, NEP 2022 batch Kolhan University, Kolhan University exam papers 2024, Kolhan University semester papers, FYUGP question papers Kolhan"
  activeTab="pyqs"
>

  <!-- Title & Description -->
  <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2.25rem; font-family: var(--font-display); font-weight: 800; tracking: -0.02em;">Kolhan University PYQ</h1>
    <p style="color: var(--text-secondary); font-size: 1.05rem; font-weight: 500; max-width: 650px; line-height: 1.6;">
      Download free <strong>Kolhan University previous year question papers</strong> (PYQ) for Tata College, Chaibasa.
      Browse semester-wise exam papers for the <strong>NEP 2020 FYUGP 2022 batch</strong> &mdash; Major, Minor, MDC, SEC, VAC &amp; AEC courses.
    </p>
  </div>

  <!-- Passing Marks Info Panel -->
  <div style="background: linear-gradient(135deg, rgba(99,102,241,0.06) 0%, rgba(16,185,129,0.04) 100%); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.1rem 1.35rem; margin-bottom: 1.75rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.85rem;">
      <span style="font-size: 1rem;">📊</span>
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); letter-spacing: 0.06em; text-transform: uppercase;">Marks &amp; Passing Criteria (FYUGP)</span>
      <span style="font-size: 0.7rem; color: var(--text-tertiary); margin-left: auto;">Qualifying: <strong style="color: var(--accent-success);">40% of total marks</strong></span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-primary);">MJ / AC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">100 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 40</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-warning);">MDC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">75 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 30</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-warning);">SEC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">75 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 30</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-primary);">AEC / VAC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">50 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 20</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--text-secondary);">Practical / Lab</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">25 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 10</span>
      </div>
    </div>
    <p style="font-size: 0.72rem; color: var(--text-tertiary); margin-top: 0.75rem; line-height: 1.5;">* For 100-mark theory papers: 75 marks End-Semester + 25 marks Internal Assessment. Combined total must meet the passing threshold.</p>
  </div>

  <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;" class="md:grid-cols-3">
    
    <!-- Left 2 Cols: Browse Categories Accordion -->
    <div class="md:col-span-2" style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Styled Slate Container Card -->
      <div class="card" style="padding: 1.5rem 1.25rem; background-color: var(--bg-secondary); border-color: var(--border-color); box-shadow: var(--shadow-lg);">
        <h2 style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1rem; padding-left: 0.5rem;">
          CHOOSE COURSE CATEGORY
        </h2>
        
        <!-- Accordion Category List (non-AEC) -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {nonAecCategories.map(cat => {
            const catSubjects = getSubjectsForCategory(cat);
            const hasData = catSubjects.length > 0;
            
            return (
              <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden;">
                <!-- Row Trigger -->
                <button 
                  class="accordion-trigger" 
                  data-cat={cat.toLowerCase()}
                  style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; transition: background 0.25s;"
                >
                  <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                    <span style={`font-size: 1.05rem; font-weight: 700; color: ${categoryInfo[cat]?.color ?? 'var(--accent-primary)'};`}>{cat} Paper</span>
                    {categoryInfo[cat] && (
                      <span style={`font-size: 0.62rem; font-weight: 700; background: ${categoryInfo[cat].bg}; color: ${categoryInfo[cat].color}; border: 1px solid ${categoryInfo[cat].border}; border-radius: 20px; padding: 2px 7px; letter-spacing: 0.3px;`}>
                        {categoryInfo[cat].label} · {categoryInfo[cat].marks}
                      </span>
                    )}
                  </div>
                  <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s;" />
                </button>

                <!-- Subjects list (Collapsible) -->
                <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.25s ease-out; background-color: rgba(0,0,0,0.15);">
                  {hasData ? (
                    <div style="padding: 0.75rem 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
                      {cat === 'Minor' && (
                        <div style="display: flex; align-items: flex-start; gap: 0.55rem; background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-xs); padding: 0.65rem 0.9rem; font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 0.25rem;">
                          <span style="flex-shrink: 0;">ℹ️</span>
                          <span><strong style="color: var(--accent-success);">2025 batch onwards:</strong> "Minor" is officially renamed <strong>Associated Core (AC)</strong>. Same papers, new name.</span>
                        </div>
                      )}
                      {catSubjects.map(sub => {
                        const sems = getSemestersForSubject(cat, sub);
                        return (
                          <div style="border-bottom: 1px dashed var(--border-color); padding-bottom: 0.75rem;">
                            <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">{sub}</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                              {sems.map(sem => (
                                <a 
                                  href={`${baseUrl}/pyqs/${cat.toLowerCase()}/${sub.toLowerCase()}/${sem}`} 
                                  class="btn btn-secondary btn-sm"
                                  style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: var(--radius-xs);"
                                >
                                  Semester {sem}
                                </a>
                              ))}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  ) : (
                    <div style="padding: 1.25rem; text-align: center; color: var(--text-secondary); font-size: 0.875rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                      <span>No active exam papers uploaded yet.</span>
                      <button 
                        class="btn btn-outline btn-sm" 
                        style="margin-top: 0.25rem;"
                        onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { category: '${cat}' } }));`}
                      >
                        Request Paper
                      </button>
                    </div>
                  )}
                </div>
              </div>
            );
          })}

          <!-- ─── AEC Accordion (Syllabus-style widget) ──────────────────────── -->
          <div class="accordion-item" style="border: 1px solid rgba(16,185,129,0.25); border-radius: var(--radius-sm); overflow: hidden;">
            <!-- AEC Trigger -->
            <button
              id="aec-pyq-trigger"
              class="accordion-trigger"
              data-cat="aec"
              style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; transition: background 0.25s;"
            >
              <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                <span style="font-size: 1.05rem; font-weight: 700; color: var(--accent-success);">AEC Paper</span>
                <span style="font-size: 0.62rem; font-weight: 700; background: rgba(16,185,129,0.12); color: var(--accent-success); border: 1px solid rgba(16,185,129,0.25); border-radius: 20px; padding: 2px 7px; letter-spacing: 0.3px;">
                  AEC · 50 Marks
                </span>
                <span style="font-size: 0.62rem; font-weight: 600; color: var(--text-tertiary); margin-left: 0.25rem;">{aecTotal} papers</span>
              </div>
              <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s;" />
            </button>

            <!-- AEC Collapsible Content -->
            <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease-out; background-color: rgba(0,0,0,0.15);">
              <div style="padding: 1rem 1.25rem 1.25rem;">

                <!-- Description -->
                <p style="color: var(--text-secondary); font-size: 0.82rem; line-height: 1.55; margin-bottom: 1rem;">
                  Ability Enhancement Courses (AEC) run across Semesters 1–4. Filter by semester to browse all available and missing papers. Available papers link directly to Google Drive. Missing ones show an upload prompt.
                </p>

                <!-- Semester filter tabs + search -->
                <div style="background-color: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.1rem 1rem 1rem;">
                  <div id="aec-pyq-tabs" style="display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.9rem; align-items: center;">
                    <button class="btn btn-secondary aec-pyq-tab active" data-sem="all" style="height: 34px; font-size: 0.8rem; padding: 0 0.85rem; border-radius: var(--radius-xs);">
                      All ({aecTotal})
                    </button>
                    <button class="btn btn-secondary aec-pyq-tab" data-sem="1" style="height: 34px; font-size: 0.8rem; padding: 0 0.85rem; border-radius: var(--radius-xs);">
                      Sem 1 — AEC-1 ({aecPapers.filter(p => p.semester === 1).length})
                    </button>
                    <button class="btn btn-secondary aec-pyq-tab" data-sem="2" style="height: 34px; font-size: 0.8rem; padding: 0 0.85rem; border-radius: var(--radius-xs);">
                      Sem 2 — AEC-2 ({aecPapers.filter(p => p.semester === 2).length})
                    </button>
                    <button class="btn btn-secondary aec-pyq-tab" data-sem="3" style="height: 34px; font-size: 0.8rem; padding: 0 0.85rem; border-radius: var(--radius-xs);">
                      Sem 3 — AEC-3 ({aecPapers.filter(p => p.semester === 3).length})
                    </button>
                    <button class="btn btn-secondary aec-pyq-tab" data-sem="4" style="height: 34px; font-size: 0.8rem; padding: 0 0.85rem; border-radius: var(--radius-xs);">
                      Sem 4 — AEC-4 ({aecPapers.filter(p => p.semester === 4).length})
                    </button>

                    <!-- Search -->
                    <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="aec-pyq-search-wrapper">
                      <input
                        type="text"
                        id="aec-pyq-search"
                        class="form-input"
                        placeholder="Search AEC papers..."
                        style="height: 34px; padding-left: 2.1rem; font-size: 0.8rem; width: 200px; border-radius: var(--radius-xs);"
                      />
                      <span style="position: absolute; left: 0.65rem; color: var(--text-tertiary); font-size: 0.85rem;">🔍</span>
                    </div>
                  </div>

                  <!-- Paper card grid -->
                  <div id="aec-pyq-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.75rem;">
                    {aecPapers.map(paper => {
                      const isMissing = !!(paper as any).missing;
                      const hasUrl = !!paper.downloadUrl;
                      const semNum = paper.semester;
                      const setBadge = (paper as any).set ? ` · ${(paper as any).set}` : '';
                      const batchLabel = (paper as any).batch ? `${(paper as any).batch} Batch` : paper.year;
                      const cardLabel = `AEC-${semNum} ${paper.subject}`;
                      const searchStr = `${cardLabel} ${batchLabel} ${setBadge} sem${semNum}`.toLowerCase();

                      return (
                        <div
                          class="aec-pyq-card card"
                          data-sem={String(semNum)}
                          data-search={searchStr}
                          style={`padding: 0.85rem 1rem; display: flex; flex-direction: column; gap: 0.6rem; border-color: ${isMissing ? 'rgba(245,158,11,0.25)' : 'var(--border-color)'}; ${isMissing ? 'background: linear-gradient(135deg, rgba(245,158,11,0.03) 0%, var(--bg-secondary) 100%);' : ''} transition: border-color 0.2s;`}
                        >
                          <!-- Card Header -->
                          <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.5rem;">
                            <div>
                              <div style="font-weight: 700; font-size: 0.9rem; color: var(--text-primary); line-height: 1.3;">{cardLabel}</div>
                              <div style="font-size: 0.72rem; color: var(--text-secondary); margin-top: 0.2rem;">
                                {batchLabel}{setBadge}
                              </div>
                            </div>
                            {isMissing ? (
                              <span style="font-size: 0.6rem; font-weight: 700; background: rgba(245,158,11,0.15); color: #d97706; border: 1px solid rgba(245,158,11,0.3); border-radius: 20px; padding: 2px 6px; white-space: nowrap; flex-shrink: 0;">Missing</span>
                            ) : (
                              <span style="font-size: 0.6rem; font-weight: 700; background: rgba(16,185,129,0.1); color: var(--accent-success); border: 1px solid rgba(16,185,129,0.25); border-radius: 20px; padding: 2px 6px; white-space: nowrap; flex-shrink: 0;">Available</span>
                            )}
                          </div>

                          <!-- Card Footer Action -->
                          <div style="border-top: 1px solid var(--border-color); padding-top: 0.55rem; display: flex; justify-content: flex-end;">
                            {hasUrl ? (
                              <a
                                href={paper.downloadUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="btn btn-primary btn-sm"
                                style="font-size: 0.75rem; padding: 0.3rem 0.75rem; gap: 0.3rem;"
                                onclick={`if(window.trackDownload) window.trackDownload('pyq', { subject: '${paper.subject}', category: '${paper.category}', semester: '${paper.semester}' });`}
                              >
                                📥 Download
                              </a>
                            ) : (
                              <div style="display: flex; gap: 0.4rem;">
                                <button
                                  class="btn btn-sm"
                                  style="font-size: 0.72rem; padding: 0.3rem 0.6rem; background: rgba(245,158,11,0.12); color: #d97706; border: 1px solid rgba(245,158,11,0.3); border-radius: var(--radius-xs); cursor: pointer;"
                                  onclick="document.dispatchEvent(new CustomEvent('open-submit-modal'));"
                                >
                                  📤 Upload
                                </button>
                                <button
                                  class="btn btn-outline btn-sm"
                                  style="font-size: 0.72rem; padding: 0.3rem 0.6rem;"
                                  onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { subject: '${paper.title}', semester: '${paper.semester}', category: 'AEC' } }));`}
                                >
                                  Request
                                </button>
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>

                  <!-- Empty state -->
                  <div id="aec-pyq-empty" style="display: none; text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 0.9rem;">
                    No matching AEC papers found.
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- ─────────────────────────────────────────────────────────────────── -->

        </div>
      </div>

    </div>

    <!-- Right 1 Col: Popular downloads & Quick request -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Popular Downloads -->
      <div class="card">
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <GraduationCap style="color: var(--accent-success);" /> Most Downloaded
        </h2>
        
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {popularPapers.map(paper => {
            const path = `${baseUrl}/pyqs/${paper.category.toLowerCase()}/${paper.subject.toLowerCase()}/${paper.semester}`;
            return (
              <a href={path} style="display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none; color: inherit; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);" class="hover-trigger">
                <div style="font-weight: 700; font-size: 0.875rem; color: var(--text-primary);" class="hover-text-primary">
                  {paper.subject} ({paper.category})
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.15rem;">
                  <span>Sem {paper.semester} • {paper.year}</span>
                  <span style="display: flex; align-items: center; gap: 0.2rem; color: var(--accent-success); font-weight: 600;">
                    <Download size="12" /> {paper.downloadCount}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Quick Contribution Card -->
      <div class="card" style="background-color: var(--bg-tertiary); text-align: center; display: flex; flex-direction: column; gap: 0.75rem;">
        <h3 style="font-size: 1.1rem; font-family: var(--font-display);">Missing a paper?</h3>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">
          Help fellow college students by contributing missing papers, or request a specific semester PYQ paper!
        </p>
        <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%; margin-top: 0.5rem;">
          <button 
            class="btn btn-outline btn-sm" 
            style="width: 100%;"
            onclick="document.dispatchEvent(new CustomEvent('open-submit-modal'));"
          >
            Submit / Upload Paper
          </button>
          <button 
            class="btn btn-primary btn-sm" 
            style="width: 100%;"
            onclick="document.dispatchEvent(new CustomEvent('open-request-modal'));"
          >
            Request a Paper
          </button>
        </div>
      </div>

    </div>

  </div>

  <style>
    .aec-pyq-tab.active {
      background-color: rgba(16,185,129,0.12) !important;
      color: var(--accent-success) !important;
      border-color: var(--accent-success) !important;
      font-weight: 700;
    }
    .aec-pyq-card:hover {
      border-color: var(--accent-success) !important;
      box-shadow: 0 0 0 1px rgba(16,185,129,0.15);
    }
    .aec-pyq-card[data-missing="true"]:hover {
      border-color: rgba(245,158,11,0.5) !important;
    }
    @media (max-width: 600px) {
      .aec-pyq-search-wrapper { width: 100% !important; margin-top: 0.5rem; }
      .aec-pyq-search-wrapper input { width: 100% !important; }
    }
  </style>

  <script>
    // ── Accordion script (non-AEC categories) ──────────────────────────────
    const triggers = document.querySelectorAll('.accordion-trigger');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const content = btn.nextElementSibling as HTMLElement;
        const chevron = btn.querySelector('.chevron') as HTMLElement;

        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        // Close all others
        document.querySelectorAll('.accordion-content').forEach(c => {
          (c as HTMLElement).style.maxHeight = '0px';
        });
        document.querySelectorAll('.chevron').forEach(ch => {
          (ch as HTMLElement).style.transform = 'rotate(0deg)';
        });
        document.querySelectorAll('.accordion-trigger').forEach(tr => {
          (tr as HTMLElement).style.backgroundColor = 'transparent';
        });

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
          if (chevron) chevron.style.transform = 'rotate(90deg)';
          btn.style.backgroundColor = 'rgba(99,102,241,0.08)';
        }
      });
    });

    // ── AEC PYQ: Tab filter + Search ───────────────────────────────────────
    const aecTabs    = document.querySelectorAll('.aec-pyq-tab') as NodeListOf<HTMLButtonElement>;
    const aecCards   = document.querySelectorAll('.aec-pyq-card') as NodeListOf<HTMLElement>;
    const aecSearch  = document.getElementById('aec-pyq-search') as HTMLInputElement;
    const aecEmpty   = document.getElementById('aec-pyq-empty') as HTMLElement;

    let activeSem  = 'all';
    let searchTerm = '';

    function filterAec() {
      let visible = 0;
      aecCards.forEach(card => {
        const cardSem    = card.getAttribute('data-sem') || '';
        const cardSearch = card.getAttribute('data-search') || '';
        const semMatch   = activeSem === 'all' || cardSem === activeSem;
        const txtMatch   = searchTerm === '' || cardSearch.includes(searchTerm);
        const show       = semMatch && txtMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      aecEmpty.style.display = visible === 0 ? 'block' : 'none';

      // Re-measure accordion height after filter so it doesn't clip
      const aecContent = document.getElementById('aec-pyq-trigger')?.nextElementSibling as HTMLElement | null;
      if (aecContent && aecContent.style.maxHeight && aecContent.style.maxHeight !== '0px') {
        aecContent.style.maxHeight = 'none';
      }
    }

    aecTabs.forEach(btn => {
      btn.addEventListener('click', () => {
        aecTabs.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeSem = btn.getAttribute('data-sem') || 'all';
        filterAec();
      });
    });

    aecSearch?.addEventListener('input', () => {
      searchTerm = aecSearch.value.toLowerCase().trim();
      filterAec();
    });
  </script>

</Layout>
