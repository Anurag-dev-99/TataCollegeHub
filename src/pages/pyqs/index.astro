---
import Layout from '../../layouts/Layout.astro';
import pyqsData from '../../../public/data/pyqs.json';
import { ChevronRight, FileText, Download, HelpCircle, GraduationCap, Search, Award, BookOpen } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Only show papers that have a download URL (all categories)
const availablePyqs = pyqsData.filter(item => !!item.downloadUrl);

// ── AEC PYQ subject groups ────────────────────────────────────────────────────
// AEC groups by (semester, subject) — e.g. (1,'Hindi'), (2,'English'), (3,'Hindi'), …
const aecPapers = availablePyqs.filter(p => p.category === 'AEC');

const aecGroupsRaw = [...new Map(
  aecPapers.map(p => [`${p.semester}-${p.subject}`, { semester: p.semester, subject: p.subject }])
).values()].sort((a, b) =>
  a.semester !== b.semester ? a.semester - b.semester : a.subject.localeCompare(b.subject)
);

const getAecGroupPapers = (sem: number, subject: string) =>
  aecPapers
    .filter(p => p.semester === sem && p.subject === subject)
    .sort((a, b) => {
      const yA = String(a.year || ''), yB = String(b.year || '');
      if (yA !== yB) return yA.localeCompare(yB);
      return String((a as any).set || '').localeCompare(String((b as any).set || ''));
    });

const aecSemesters = [...new Set(aecPapers.map(p => p.semester))].sort((a, b) => a - b);
const aecTotal = aecPapers.length;



// ── VAC PYQ subject groups ────────────────────────────────────────────────────
const vacPapers = availablePyqs.filter(p => p.category === 'VAC' && !!p.downloadUrl);

// Get unique VAC subjects sorted by semester then name
const vacSubjects = [...new Set(vacPapers.map(p => p.subject))].sort((a, b) => {
  const semA = Math.min(...vacPapers.filter(p => p.subject === a).map(p => p.semester));
  const semB = Math.min(...vacPapers.filter(p => p.subject === b).map(p => p.semester));
  return semA !== semB ? semA - semB : a.localeCompare(b);
});

// Get all unique semesters for VAC
const vacSemesters = [...new Set(vacPapers.map(p => p.semester))].sort((a, b) => a - b);

// Get papers for a specific VAC subject
const getVacPapersForSubject = (subject: string) =>
  vacPapers.filter(p => p.subject === subject).sort((a, b) => {
    if (a.semester !== b.semester) return a.semester - b.semester;
    return String(a.year || '').localeCompare(String(b.year || ''));
  });

// ── SEC PYQ subject groups ────────────────────────────────────────────────────
const secPapers = availablePyqs.filter(p => p.category === 'SEC' && !!p.downloadUrl);

// Get unique SEC subjects sorted by semester then name
const secSubjects = [...new Set(secPapers.map(p => p.subject))].sort((a, b) => {
  const semA = Math.min(...secPapers.filter(p => p.subject === a).map(p => p.semester));
  const semB = Math.min(...secPapers.filter(p => p.subject === b).map(p => p.semester));
  return semA !== semB ? semA - semB : a.localeCompare(b);
});

// Get all unique semesters for SEC
const secSemesters = [...new Set(secPapers.map(p => p.semester))].sort((a, b) => a - b);

// Get papers for a specific SEC subject
const getSecPapersForSubject = (subject: string) =>
  secPapers.filter(p => p.subject === subject).sort((a, b) => {
    if (a.semester !== b.semester) return a.semester - b.semester;
    return String(a.year || '').localeCompare(String(b.year || ''));
  });

// ── Generic category helpers (Major, Minor, MDC) ─────────────────────────
// Builds structured data for a given category: { subject, semesters[], totalPapers }
const buildCatData = (cat: string) => {
  const papers = availablePyqs.filter(p => p.category === cat && !!p.downloadUrl);
  const subjects = [...new Set(papers.map(p => p.subject))].sort();
  return subjects.map(subject => {
    const subPapers = papers.filter(p => p.subject === subject);
    const sems = [...new Set(subPapers.map(p => p.semester))].sort((a, b) => a - b);
    return { subject, sems, totalPapers: subPapers.length };
  });
};

const majorData   = buildCatData('Major');
const minorData   = buildCatData('Minor');
const mdcData     = buildCatData('MDC');

const majorSems   = [...new Set(availablePyqs.filter(p => p.category === 'Major' && !!p.downloadUrl).map(p => p.semester))].sort((a, b) => a - b);
const minorSems   = [...new Set(availablePyqs.filter(p => p.category === 'Minor' && !!p.downloadUrl).map(p => p.semester))].sort((a, b) => a - b);
const mdcSems     = [...new Set(availablePyqs.filter(p => p.category === 'MDC'   && !!p.downloadUrl).map(p => p.semester))].sort((a, b) => a - b);

// Popular papers (non-AEC, has downloadUrl)
const popularPapers = [...availablePyqs.filter(p => !!p.downloadUrl)]
  .sort((a, b) => (b.downloadCount || 0) - (a.downloadCount || 0))
  .slice(0, 5);
---

