---
import Layout from '../../layouts/Layout.astro';
import pyqsData from '../../../public/data/pyqs.json';
import notesData from '../../../public/data/notes.json';
import markingSchemes from '../../../public/data/paper_marking_schemes.json';
import { ChevronRight, FileText, Download, GraduationCap, Award, BookOpen } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Available question papers (exclude inline notes entries)
const availablePyqs = pyqsData.filter((p: any) => !!p.downloadUrl && p.type !== 'notes');

// Check if a (catLower, subjectLower, sem) has notes or solved PYQs
const hasNotesFor = (catLower: string, subjectLower: string, sem: number): boolean => {
  const hasPaid = notesData.products.some(
    n => n.available && n.match.category === catLower && n.match.subject === subjectLower && n.match.semester === String(sem)
  );
  if (hasPaid) return true;
  if (catLower === 'mdc' && (subjectLower === 'psychology' || subjectLower === 'economics')) return true;
  if (catLower === 'iks') return pyqsData.some((p: any) => p.category === 'IKS' && p.type === 'notes' && !!p.downloadUrl);
  return false;
};

// Build unified flat index of all ~98 PYQ subpages (matches [semester].astro getStaticPaths)
type SubpageEntry = {
  cat: string;
  catLower: string;
  subject: string;
  subjectLower: string;
  sem: number;
  count: number;
  years: string[];
  href: string;
  hasNotes: boolean;
  hasSolved: boolean;
};

const subpageMap = new Map<string, SubpageEntry>();
pyqsData.forEach((item: any) => {
  if (item.category !== 'AEC' && !item.downloadUrl) return;
  const catLower = item.category.toLowerCase();
  const subjectLower = item.subject.toLowerCase();
  const sem = Number(item.semester);
  const key = `${catLower}|${subjectLower}|${sem}`;

  if (!subpageMap.has(key)) {
    subpageMap.set(key, {
      cat: item.category,
      catLower,
      subject: item.subject,
      subjectLower,
      sem,
      count: 0,
      years: [],
      href: `${baseUrl}/pyqs/${catLower}/${subjectLower}/${sem}/`,
      hasNotes: hasNotesFor(catLower, subjectLower, sem),
      hasSolved: catLower === 'major' && subjectLower === 'mathematics' && sem === 3
    });
  }

  if (item.downloadUrl && item.type !== 'notes') {
    const entry = subpageMap.get(key)!;
    entry.count += 1;
    if (item.year && !entry.years.includes(String(item.year))) {
      entry.years.push(String(item.year));
    }
  }
});

const allSubpages = Array.from(subpageMap.values()).sort((a, b) => {
  if (a.sem !== b.sem) return a.sem - b.sem;
  return a.subject.localeCompare(b.subject);
});
allSubpages.forEach(s => s.years.sort());

const subpagesJson = JSON.stringify(allSubpages);

// Category groupings for browse accordions
const buildCatData = (cat: string) => {
  const catLower = cat.toLowerCase();
  const entries = allSubpages.filter(s => s.cat === cat && s.count > 0);
  const subjects = [...new Set(entries.map(e => e.subject))].sort((a, b) => a.localeCompare(b));
  return subjects.map(subject => {
    const subEntries = entries.filter(e => e.subject === subject).sort((a, b) => a.sem - b.sem);
    return {
      subject,
      subjectLower: subject.toLowerCase(),
      sems: subEntries.map(e => e.sem),
      totalPapers: subEntries.reduce((sum, e) => sum + e.count, 0),
      hasNotes: subEntries.some(e => e.hasNotes),
      hasSolved: subEntries.some(e => e.hasSolved)
    };
  });
};

const majorData = buildCatData('Major');
const minorData = buildCatData('Minor');
const mdcData = buildCatData('MDC');

const buildSemSubjectGroups = (cat: string) =>
  allSubpages
    .filter(s => s.cat === cat)
    .sort((a, b) => (a.sem !== b.sem ? a.sem - b.sem : a.subject.localeCompare(b.subject)));

const aecGroups = buildSemSubjectGroups('AEC');
const aecTotal = availablePyqs.filter(p => p.category === 'AEC').length;

const vacGroups = buildSemSubjectGroups('VAC');
const vacTotal = availablePyqs.filter(p => p.category === 'VAC').length;

const secGroups = buildSemSubjectGroups('SEC');
const secTotal = availablePyqs.filter(p => p.category === 'SEC').length;

const iksPyqs = pyqsData.filter((p: any) => p.category === 'IKS' && p.type !== 'notes' && !!p.downloadUrl);
const iksNotes = pyqsData.filter((p: any) => p.category === 'IKS' && p.type === 'notes' && !!p.downloadUrl);

// Accurate schemes from paper_marking_schemes.json
const pracFull = markingSchemes.schemes['100_PRACTICAL'].fullMarks;
const pracPass = markingSchemes.schemes['100_PRACTICAL'].passMarks;
const nonPracFull = markingSchemes.schemes['100_NON_PRACTICAL'].fullMarks;
const nonPracPass = markingSchemes.schemes['100_NON_PRACTICAL'].passMarks;
const mdcSecFull = markingSchemes.schemes['75_THEORY_ONLY'].fullMarks;
const mdcSecPass = markingSchemes.schemes['75_THEORY_ONLY'].passMarks;
const aecVacFull = markingSchemes.schemes['50_THEORY_ONLY'].fullMarks;
const aecVacPass = markingSchemes.schemes['50_THEORY_ONLY'].passMarks;

// Deduplicated completed PYQ requests
const rawCompletedRequests = [
  { e: '🧠', t: 'Psychology Major PYQ', s: 'Sem 1' },
  { e: '📜', t: 'History Major PYQ', s: 'Sem 2' },
  { e: '📊', t: 'Economics Major PYQ', s: 'Sem 1' },
  { e: '⚛️', t: 'Physics Minor PYQ', s: 'Sem 1' },
  { e: '🐍', t: 'Zoology Minor PYQ', s: 'Sem 1' },
  { e: '📜', t: 'MDC History PYQ', s: 'Sem 1' },
  { e: '🌿', t: 'Botany Minor PYQ', s: 'Sem 1' },
  { e: '🏛️', t: 'Political Science Major PYQ', s: 'Sem 1' },
  { e: '📖', t: 'English Major PYQ', s: 'Sem 1' },
  { e: '📜', t: 'History Major PYQ', s: 'Sem 1' },
  { e: '⚛️', t: 'Physics Major PYQ', s: 'Sem 1' },
  { e: '🏛️', t: 'Political Science Minor PYQ', s: 'Sem 1' },
  { e: '🐍', t: 'Zoology Major PYQ', s: 'Sem 1' },
  { e: '🌿', t: 'Botany Major PYQ', s: 'Sem 1' },
  { e: '🏠', t: 'MDC Home Science PYQ', s: 'Sem 1 & 3' },
  { e: '📐', t: 'Maths Minor PYQ', s: 'Sem 1' },
  { e: '🧪', t: 'Chemistry Minor PYQ', s: 'Sem 1' },
  { e: '⚛️', t: 'Physics Major PYQ', s: 'Sem 1 · 2024 Batch' },
  { e: '📐', t: 'Maths Major PYQ', s: 'Sem 1 · All Batches' },
  { e: '⚛️', t: 'Physics Major PYQ', s: 'Sem 1–6' },
  { e: '🧪', t: 'Chemistry Major PYQ', s: 'Sem 1–3' },
  { e: '📖', t: 'English Major PYQ', s: 'Sem 1–4' },
  { e: '🧠', t: 'MDC Psychology PYQ', s: 'Sem 1–3' },
  { e: '📊', t: 'MDC Statistics PYQ', s: 'Sem 1' },
  { e: '🧠', t: 'Philosophy MDC PYQ', s: 'Sem 1' },
  { e: '🌍', t: 'MDC Geography PYQ', s: 'Sem 1' },
  { e: '📱', t: 'SEC Digital India PYQ', s: 'Sem 1 (Set 1)' },
  { e: '🧠', t: 'MDC Philosophy PYQ', s: 'Sem 1 (2025)' },
  { e: '🧠', t: 'MDC Psychology PYQ', s: 'Sem 1 (2025)' }
];
const completedRequests = Array.from(
  new Map(rawCompletedRequests.map(r => [`${r.t}|${r.s}`, r])).values()
);

const contributorsList = [
  { i: 'A', c: '#f59e0b,#d97706', n: 'Ayushi Kumari', f: 'Geo Major, PolSci Minor, Phil MDC, Digital Edu Sem 1' },
  { i: 'I', c: '#06b6d4,#0e7490', n: 'ISHA KUMARI', f: 'Economics Minor Sem 1' },
  { i: 'I', c: '#ec4899,#be185d', n: 'Isha Kumari', f: 'History MDC, Chem Minor Sem 1' },
  { i: 'G', c: '#3b82f6,#1d4ed8', n: 'Gouranga (GG)', f: 'Maths Minor, Geo MDC Sem 1' },
  { i: 'P', c: '#a855f7,#7e22ce', n: 'Pooja Rani Pradhan', f: 'Home Science MDC Sem 1' },
  { i: 'D', c: '#6366f1,#8b5cf6', n: 'Dheeraj', f: 'Physics Major Sem 1 & 2' },
  { i: 'I', c: '#10b981,#059669', n: 'Indra', f: 'Physics Major Sem 3' },
  { i: 'A', c: '#f59e0b,#d97706', n: 'Ankit', f: 'Chemistry Major Sem 1–3' },
  { i: 'S', c: '#a78bfa,#7c3aed', n: 'Sunita', f: 'Maths Major Sem 5' },
  { i: 'R', c: '#f97316,#ea580c', n: 'Ritik', f: 'Home Science MDC' },
  { i: 'S', c: '#3b82f6,#2563eb', n: 'Suman', f: 'MDC Psychology, Geo' },
  { i: 'P', c: '#f472b6,#ec4899', n: 'Priya Sinha', f: 'SEC Comm. Skills' },
  { i: 'A', c: '#84cc16,#65a30d', n: 'Amit', f: 'MDC History Sem 2' }
];

// Visible FAQs + synced FAQPage JSON-LD
const faqItems = [
  {
    q: 'How to download Kolhan University previous year question papers (PYQ PDF) for free?',
    a: 'Choose your paper category (Major, Minor, MDC, AEC, VAC, SEC, or IKS) above, open your subject and semester, and tap Download PDF. All question papers open directly on Google Drive without login or fees.'
  },
  {
    q: 'Are these PYQ papers valid for all 37 Kolhan University colleges?',
    a: 'Yes! Kolhan University conducts a single unified university examination across all 37 constituent and affiliated colleges under the NEP 2020 FYUGP syllabus (Batches 2022–26, 2023–27, 2024–28, and 2025–29).'
  },
  {
    q: 'What are MJ, MN/AC, MDC, AEC, VAC, SEC, and IKS papers in Kolhan University?',
    a: 'Under NEP FYUGP: MJ is Major (100 marks), MN/AC is Minor / Associated Core (100 marks), MDC is Multidisciplinary Course (75 marks, same syllabus for Sem 1–3), SEC is Skill Enhancement (75 marks), AEC is Ability Enhancement Language (50 marks), VAC is Value Added Course like Understanding India (50 marks), and IKS is Indian Knowledge System (50 MCQs).'
  },
  {
    q: 'What if my subject or semester question paper is missing?',
    a: 'Tap "Request a Paper" on this page to submit the subject name, semester, and category. If you have a question paper PDF or clear photos, tap "Submit / Upload Paper" to share it with juniors.'
  }
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
});
---

<Layout
  title="Kolhan University Previous Year Question Papers (PYQ) PDF"
  rawTitle={true}
  description="Download free Kolhan University previous year question papers (PYQ PDF) for all 37 colleges — NEP FYUGP Sem 1 to 8 (Major, Minor, MDC, SEC, VAC, AEC, IKS)."
  keywords="Kolhan University PYQ, Kolhan University previous year question papers, Kolhan University previous year question papers pdf download, Kolhan PYQ download 2025 2026, Kolhan University question paper sem 1 sem 2 sem 3 sem 4, Understanding India PYQ, IKS PYQ, AEC MDC VAC SEC Major Minor Kolhan University, कोल्हान यूनिवर्सिटी पिछले वर्ष के प्रश्न पत्र"
  activeTab="pyqs"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <!-- Compact Hero Header -->
  <div style="margin-bottom: 1.15rem;">
    <h1 style="font-size: clamp(1.38rem, 5.2vw, 1.9rem); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin: 0;">
      Kolhan University Previous Year Question Papers (PYQ)
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.84rem; line-height: 1.45; margin-top: 0.35rem;">
      Sem 1–8 (NEP FYUGP) &bull; All 37 Colleges
    </p>
  </div>

  <!-- ═══ BROWSE BY COURSE CATEGORY (7 Clean Collapsible Sections) ═══ -->
  <section aria-label="Browse question papers by course category" class="card" style="padding: 1.15rem 1rem; margin-bottom: 1.25rem; background-color: var(--bg-secondary); border-color: var(--border-color); box-shadow: var(--shadow-lg);">
    <h2 style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); letter-spacing: 0.05em; text-transform: uppercase; margin: 0 0 0.85rem 0.25rem;">
      Browse by Course Category
    </h2>

    <div style="display: flex; flex-direction: column; gap: 0.7rem;">

      <!-- ─── 1. Major PYQ Accordion ─── -->
      {majorData.length > 0 && (
        <div class="accordion-item" style="border: 1px solid rgba(99,102,241,0.25); border-radius: var(--radius-sm); overflow: hidden;">
          <button
            id="major-pyq-trigger"
            type="button"
            class="accordion-trigger"
            data-cat="major"
            style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0.95rem 1rem; transition: background 0.2s;"
          >
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; min-width: 0;">
              <span style="font-size: 1rem; font-weight: 700; color: var(--accent-primary);">Major Paper</span>
              <span style="font-size: 0.62rem; font-weight: 700; background: rgba(99,102,241,0.12); color: var(--accent-primary); border: 1px solid rgba(99,102,241,0.25); border-radius: 20px; padding: 2px 7px;">
                MJ · 100 Marks
              </span>
              <span style="font-size: 0.66rem; font-weight: 600; color: var(--text-tertiary);">{majorData.length} subjects</span>
            </div>
            <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
          </button>

          <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease-out; background-color: rgba(0,0,0,0.15);">
            <div style="padding: 0.85rem;">
              <div class="pyq-cat-grid">
                {majorData.map(({ subject, subjectLower, sems, totalPapers, hasSolved, hasNotes }) => (
                  <div class="card pyq-subject-box" style="padding: 0.85rem; display: flex; flex-direction: column; gap: 0.55rem; min-width: 0;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.4rem;">
                      <span style="font-weight: 700; font-size: 0.92rem; color: var(--text-primary); overflow-wrap: anywhere;">{subject}</span>
                      <span style="font-size: 0.65rem; font-weight: 700; color: var(--accent-primary); white-space: nowrap;">{totalPapers} PDFs</span>
                    </div>
                    {(hasSolved || hasNotes) && (
                      <div style="display: flex; gap: 0.3rem; flex-wrap: wrap;">
                        {hasSolved && <span style="font-size: 0.6rem; font-weight: 700; background: rgba(16,185,129,0.12); color: #34d399; border: 1px solid rgba(16,185,129,0.3); border-radius: 20px; padding: 1px 6px;">✨ Solved PYQs</span>}
                        {hasNotes && <span style="font-size: 0.6rem; font-weight: 700; background: rgba(129,140,248,0.12); color: #818cf8; border: 1px solid rgba(129,140,248,0.3); border-radius: 20px; padding: 1px 6px;">📝 Notes</span>}
                      </div>
                    )}
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: auto;">
                      {sems.map(sem => (
                        <a
                          href={`${baseUrl}/pyqs/major/${subjectLower}/${sem}/`}
                          class="pyq-sem-link pyq-sem-link-primary"
                        >
                          Sem {sem}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- ─── 2. Minor PYQ Accordion ─── -->
      {minorData.length > 0 && (
        <div class="accordion-item" style="border: 1px solid rgba(16,185,129,0.25); border-radius: var(--radius-sm); overflow: hidden;">
          <button
            id="minor-pyq-trigger"
            type="button"
            class="accordion-trigger"
            data-cat="minor"
            style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0.95rem 1rem; transition: background 0.2s;"
          >
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; min-width: 0;">
              <span style="font-size: 1rem; font-weight: 700; color: var(--accent-success);">Minor Paper</span>
              <span style="font-size: 0.62rem; font-weight: 700; background: rgba(16,185,129,0.12); color: var(--accent-success); border: 1px solid rgba(16,185,129,0.25); border-radius: 20px; padding: 2px 7px;">
                AC · 100 Marks
              </span>
              <span style="font-size: 0.66rem; font-weight: 600; color: var(--text-tertiary);">{minorData.length} subjects</span>
            </div>
            <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
          </button>

          <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease-out; background-color: rgba(0,0,0,0.15);">
            <div style="padding: 0.85rem;">
              <div style="display: flex; align-items: flex-start; gap: 0.5rem; background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-xs); padding: 0.6rem 0.85rem; font-size: 0.76rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 0.8rem;">
                <span style="flex-shrink: 0;">ℹ️</span>
                <span><strong style="color: var(--accent-success);">2025 batch onwards:</strong> "Minor" is officially renamed <strong>Associated Core (AC)</strong>. Same papers, new name.</span>
              </div>
              <div class="pyq-cat-grid">
                {minorData.map(({ subject, subjectLower, sems, totalPapers }) => (
                  <div class="card pyq-subject-box" style="padding: 0.85rem; display: flex; flex-direction: column; gap: 0.55rem; min-width: 0;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.4rem;">
                      <span style="font-weight: 700; font-size: 0.92rem; color: var(--text-primary); overflow-wrap: anywhere;">{subject}</span>
                      <span style="font-size: 0.65rem; font-weight: 700; color: var(--accent-success); white-space: nowrap;">{totalPapers} PDFs</span>
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: auto;">
                      {sems.map(sem => (
                        <a
                          href={`${baseUrl}/pyqs/minor/${subjectLower}/${sem}/`}
                          class="pyq-sem-link pyq-sem-link-success"
                        >
                          Sem {sem}
                        </a>
                      ))}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- ─── 3. MDC PYQ Accordion ─── -->
      {mdcData.length > 0 && (
        <div class="accordion-item" style="border: 1px solid rgba(245,158,11,0.25); border-radius: var(--radius-sm); overflow: hidden;">
          <button
            id="mdc-pyq-trigger"
            type="button"
            class="accordion-trigger"
            data-cat="mdc"
            style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0.95rem 1rem; transition: background 0.2s;"
          >
            <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; min-width: 0;">
              <span style="font-size: 1rem; font-weight: 700; color: var(--accent-warning);">MDC Paper</span>
              <span style="font-size: 0.62rem; font-weight: 700; background: rgba(245,158,11,0.12); color: var(--accent-warning); border: 1px solid rgba(245,158,11,0.25); border-radius: 20px; padding: 2px 7px;">
                MDC · 75 Marks
              </span>
              <span style="font-size: 0.66rem; font-weight: 600; color: var(--text-tertiary);">{mdcData.length} subjects</span>
            </div>
            <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
          </button>

          <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.35s ease-out; background-color: rgba(0,0,0,0.15);">
            <div style="padding: 0.85rem;">
              <div style="display: flex; align-items: flex-start; gap: 0.5rem; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.3); border-radius: var(--radius-xs); padding: 0.6rem 0.85rem; font-size: 0.76rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 0.7rem;">
                <span style="flex-shrink: 0;">💡</span>
                <span><strong style="color: var(--accent-warning);">MDC syllabus is the same for Sem 1, 2 &amp; 3</strong> — check papers from all three semesters for better exam preparation.</span>
              </div>

              <!-- Collapsible MDC Guide -->
              <details id="mdc-guide-details" style="margin-bottom: 0.85rem; border: 1px solid rgba(245,158,11,0.2); border-radius: var(--radius-xs); overflow: hidden; background: rgba(245,158,11,0.04);">
                <summary id="mdc-guide-summary" style="cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0.85rem; font-size: 0.78rem; font-weight: 700; color: var(--accent-warning); user-select: none;">
                  <span style="display: flex; align-items: center; gap: 0.4rem;">
                    <span>📖</span>
                    <span>MDC Guide — Rules &amp; how to choose your subject</span>
                  </span>
                  <span id="mdc-guide-arrow" style="font-size: 0.7rem; color: var(--text-tertiary); transition: transform 0.25s; display: inline-block;">▼</span>
                </summary>

                <div style="padding: 0.75rem 0.85rem 0.9rem; border-top: 1px solid rgba(245,158,11,0.15); display: flex; flex-direction: column; gap: 0.65rem; font-size: 0.75rem; color: var(--text-secondary); line-height: 1.55;">
                  <p style="margin: 0;">Under Kolhan University's <strong>NEP 2020 FYUGP</strong>, MDC runs in Sem 1, 2 &amp; 3 with the same syllabus pattern across all three semesters.</p>
                  <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                    <div style="background: rgba(0,0,0,0.18); border-radius: 6px; padding: 0.45rem 0.6rem;">🔬 <strong>Science students</strong> → choose MDC from <strong>Arts or Commerce</strong>.</div>
                    <div style="background: rgba(0,0,0,0.18); border-radius: 6px; padding: 0.45rem 0.6rem;">🎨 <strong>Arts students</strong> → choose MDC from <strong>Science or Commerce</strong> (prefer subjects not in 10+2 marksheet).</div>
                    <div style="background: rgba(0,0,0,0.18); border-radius: 6px; padding: 0.45rem 0.6rem;">💼 <strong>Commerce students</strong> → cannot choose "Fundamentals of Commerce"; pick from <strong>Arts or Science</strong>.</div>
                  </div>
                </div>
              </details>

              <div class="pyq-cat-grid">
                {mdcData.map(({ subject, subjectLower, sems, totalPapers, hasNotes }) => (
                  <div class="card pyq-subject-box" style="padding: 0.85rem; display: flex; flex-direction: column; gap: 0.55rem; min-width: 0;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 0.4rem;">
                      <span style="font-weight: 700; font-size: 0.92rem; color: var(--text-primary); overflow-wrap: anywhere;">{subject}</span>
