      <div id="pyq-req-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; border-top: 1px solid rgba(16,185,129,0.12);">
        <div style="padding: 0.5rem 0.85rem; display: flex; flex-direction: column; gap: 0.3rem; background: rgba(0,0,0,0.15);">
          {completedRequests.map(r => (
            <div style="display: flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0;">
              <span style="font-size: 0.65rem; flex-shrink: 0;">{r.e}</span>
              <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-primary); flex: 1; min-width: 0; overflow-wrap: anywhere;">{r.t}</span>
