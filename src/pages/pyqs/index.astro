---
import Layout from '../../layouts/Layout.astro';
import pyqsData from '../../../public/data/pyqs.json';
import { ChevronRight, FileText, Download, HelpCircle, GraduationCap } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// STRICT FILTER: Filter out any papers without real files
const availablePyqs = pyqsData.filter(item => !!item.downloadUrl);

// Categories list to display (ordered as in legacy screenshot)
const categories = ['Major', 'Minor', 'MDC', 'SEC', 'VAC', 'AEC'];

// Marks info per category
const categoryInfo: Record<string, { marks: string; label: string; color: string; bg: string; border: string }> = {
  Major: { marks: '100 Marks', label: 'MJ', color: 'var(--accent-primary)', bg: 'rgba(99,102,241,0.12)', border: 'rgba(99,102,241,0.25)' },
  Minor: { marks: '100 Marks', label: 'AC', color: 'var(--accent-success)', bg: 'rgba(16,185,129,0.12)', border: 'rgba(16,185,129,0.25)' },
  MDC:   { marks: '75 Marks',  label: 'MDC', color: 'var(--accent-warning)', bg: 'rgba(245,158,11,0.12)', border: 'rgba(245,158,11,0.25)' },
  SEC:   { marks: '75 Marks',  label: 'SEC', color: 'var(--accent-warning)', bg: 'rgba(245,158,11,0.12)', border: 'rgba(245,158,11,0.25)' },
  VAC:   { marks: '50 Marks',  label: 'VAC', color: 'var(--accent-primary)', bg: 'rgba(99,102,241,0.12)', border: 'rgba(99,102,241,0.25)' },
  AEC:   { marks: '50 Marks',  label: 'AEC', color: 'var(--accent-success)', bg: 'rgba(16,185,129,0.12)', border: 'rgba(16,185,129,0.25)' },
};

// Get unique subjects per category
const getSubjectsForCategory = (cat: string) => {
  return [...new Set(availablePyqs.filter(p => p.category === cat).map(p => p.subject))].sort();
};

// Get unique semesters for category + subject
const getSemestersForSubject = (cat: string, sub: string) => {
  return [...new Set(availablePyqs.filter(p => p.category === cat && p.subject === sub).map(p => p.semester))].sort((a, b) => a - b);
};

// Popular papers filtered
const popularPapers = [...availablePyqs]
  .sort((a, b) => (b.downloadCount || 0) - (a.downloadCount || 0))
  .slice(0, 5);
---

<Layout 
  title="Kolhan University Previous Year Question Papers (PYQ) — Tata College"
  description="Download free Kolhan University PYQ (previous year question papers) for Tata College, Chaibasa. Semester-wise exam papers for NEP FYUGP 2022 batch — Major, Minor, MDC, SEC, VAC, AEC for Semester 1 to 8. Free PDF download."
  keywords="Kolhan University PYQ, Kolhan University previous year papers, Kolhan PYQ download, Kolhan University question papers, Tata College PYQ, Tata College Chaibasa question papers, NEP 2022 batch Kolhan University, Kolhan University exam papers 2024, Kolhan University semester papers, FYUGP question papers Kolhan"
  activeTab="pyqs"
>

  <!-- Title & Description -->
  <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2.25rem; font-family: var(--font-display); font-weight: 800; tracking: -0.02em;">Kolhan University PYQ</h1>
    <p style="color: var(--text-secondary); font-size: 1.05rem; font-weight: 500; max-width: 650px; line-height: 1.6;">
      Download free <strong>Kolhan University previous year question papers</strong> (PYQ) for Tata College, Chaibasa.
      Browse semester-wise exam papers for the <strong>NEP 2020 FYUGP 2022 batch</strong> &mdash; Major, Minor, MDC, SEC, VAC &amp; AEC courses.
    </p>
  </div>

  <!-- Passing Marks Info Panel -->
  <div style="background: linear-gradient(135deg, rgba(99,102,241,0.06) 0%, rgba(16,185,129,0.04) 100%); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.1rem 1.35rem; margin-bottom: 1.75rem;">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.85rem;">
      <span style="font-size: 1rem;">📊</span>
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); letter-spacing: 0.06em; text-transform: uppercase;">Marks &amp; Passing Criteria (FYUGP)</span>
      <span style="font-size: 0.7rem; color: var(--text-tertiary); margin-left: auto;">Qualifying: <strong style="color: var(--accent-success);">40% of total marks</strong></span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-primary);">MJ / AC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">100 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 40</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-warning);">MDC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">75 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 30</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-warning);">SEC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">75 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 30</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-primary);">AEC / VAC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">50 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 20</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--text-secondary);">Practical / Lab</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">25 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 10</span>
      </div>
    </div>
    <p style="font-size: 0.72rem; color: var(--text-tertiary); margin-top: 0.75rem; line-height: 1.5;">* For 100-mark theory papers: 75 marks End-Semester + 25 marks Internal Assessment. Combined total must meet the passing threshold.</p>
  </div>

  <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;" class="md:grid-cols-3">
    
    <!-- Left 2 Cols: Browse Categories Accordion -->
    <div class="md:col-span-2" style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Styled Slate Container Card -->
      <div class="card" style="padding: 1.5rem 1.25rem; background-color: var(--bg-secondary); border-color: var(--border-color); box-shadow: var(--shadow-lg);">
        <h2 style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1rem; padding-left: 0.5rem;">
          CHOOSE COURSE CATEGORY
        </h2>
        
        <!-- Accordion Category List -->
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {categories.map(cat => {
            const catSubjects = getSubjectsForCategory(cat);
            const hasData = catSubjects.length > 0;
            
            return (
              <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden;">
                <!-- Row Trigger -->
                <button 
                  class="accordion-trigger" 
                  data-cat={cat.toLowerCase()}
                  style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; transition: background 0.25s;"
                >
                  <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                    <span style={`font-size: 1.05rem; font-weight: 700; color: ${categoryInfo[cat]?.color ?? 'var(--accent-primary)'};`}>{cat} Paper</span>
                    {categoryInfo[cat] && (
                      <span style={`font-size: 0.62rem; font-weight: 700; background: ${categoryInfo[cat].bg}; color: ${categoryInfo[cat].color}; border: 1px solid ${categoryInfo[cat].border}; border-radius: 20px; padding: 2px 7px; letter-spacing: 0.3px;`}>
                        {categoryInfo[cat].label} · {categoryInfo[cat].marks}
                      </span>
                    )}
                  </div>
                  <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s;" />
                </button>

                <!-- Subjects list (Collapsible content) -->
                <div class="accordion-content" style="max-height: 0; overflow: hidden; transition: max-height 0.25s ease-out; background-color: rgba(0,0,0,0.15);">
                  {hasData ? (
                    <div style="padding: 0.75rem 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
                      {/* AC renaming notice inside Minor section */}
                      {cat === 'Minor' && (
                        <div style="display: flex; align-items: flex-start; gap: 0.55rem; background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-xs); padding: 0.65rem 0.9rem; font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 0.25rem;">
                          <span style="flex-shrink: 0;">ℹ️</span>
                          <span><strong style="color: var(--accent-success);">2025 batch onwards:</strong> "Minor" is officially renamed <strong>Associated Core (AC)</strong>. Same papers, new name.</span>
                        </div>
                      )}
                      {catSubjects.map(sub => {
                        const sems = getSemestersForSubject(cat, sub);
                        return (
                          <div style="border-bottom: 1px dashed var(--border-color); padding-bottom: 0.75rem;">
                            <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem;">{sub}</h4>
                            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                              {sems.map(sem => (
                                <a 
                                  href={`${baseUrl}/pyqs/${cat.toLowerCase()}/${sub.toLowerCase()}/${sem}`} 
                                  class="btn btn-secondary btn-sm"
                                  style="padding: 0.35rem 0.75rem; font-size: 0.8rem; border-radius: var(--radius-xs);"
                                >
                                  Semester {sem}
                                </a>
                              ))}
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  ) : (
                    <div style="padding: 1.25rem; text-align: center; color: var(--text-secondary); font-size: 0.875rem; display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                      <span>No active exam papers uploaded yet.</span>
                      <button 
                        class="btn btn-outline btn-sm" 
                        style="margin-top: 0.25rem;"
                        onclick={`document.dispatchEvent(new CustomEvent('open-request-modal', { detail: { category: '${cat}' } }));`}
                      >
                        Request Paper
                      </button>
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>

    </div>

    <!-- Right 1 Col: Popular downloads & Quick request -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Popular Downloads -->
      <div class="card">
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <GraduationCap style="color: var(--accent-success);" /> Most Downloaded
        </h2>
        
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {popularPapers.map(paper => {
            const path = `${baseUrl}/pyqs/${paper.category.toLowerCase()}/${paper.subject.toLowerCase()}/${paper.semester}`;
            return (
              <a href={path} style="display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none; color: inherit; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);" class="hover-trigger">
                <div style="font-weight: 700; font-size: 0.875rem; color: var(--text-primary);" class="hover-text-primary">
                  {paper.subject} ({paper.category})
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.15rem;">
                  <span>Sem {paper.semester} • {paper.year}</span>
                  <span style="display: flex; align-items: center; gap: 0.2rem; color: var(--accent-success); font-weight: 600;">
                    <Download size="12" /> {paper.downloadCount}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Quick Contribution Card -->
      <div class="card" style="background-color: var(--bg-tertiary); text-align: center; display: flex; flex-direction: column; gap: 0.75rem;">
        <h3 style="font-size: 1.1rem; font-family: var(--font-display);">Missing a paper?</h3>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">
          Help fellow college students by contributing missing papers, or request a specific semester PYQ paper!
        </p>
        <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%; margin-top: 0.5rem;">
          <button 
            class="btn btn-outline btn-sm" 
            style="width: 100%;"
            onclick="document.dispatchEvent(new CustomEvent('open-submit-modal'));"
          >
            Submit / Upload Paper
          </button>
          <button 
            class="btn btn-primary btn-sm" 
            style="width: 100%;"
            onclick="document.dispatchEvent(new CustomEvent('open-request-modal'));"
          >
            Request a Paper
          </button>
        </div>
      </div>

    </div>

  </div>

  <script>
    // Client-side Accordion script
    const triggers = document.querySelectorAll('.accordion-trigger');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const content = btn.nextElementSibling as HTMLElement;
        const chevron = btn.querySelector('.chevron') as HTMLElement;

        // Toggle active state
        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        // Close all other accordions first for clean UI
        document.querySelectorAll('.accordion-content').forEach(c => {
          (c as HTMLElement).style.maxHeight = '0px';
        });
        document.querySelectorAll('.chevron').forEach(ch => {
          (ch as HTMLElement).style.transform = 'rotate(0deg)';
        });
        document.querySelectorAll('.accordion-trigger').forEach(tr => {
          (tr as HTMLElement).style.backgroundColor = 'transparent';
        });

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
          if (chevron) chevron.style.transform = 'rotate(90deg)';
          btn.style.backgroundColor = 'rgba(99, 102, 241, 0.08)';
        }
      });
    });
  </script>

</Layout>
