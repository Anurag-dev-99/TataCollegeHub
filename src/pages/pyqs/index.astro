          <p style="font-size: 0.79rem; color: var(--text-secondary); line-height: 1.55; margin: 0.5rem 0 0; padding-top: 0.5rem; border-top: 1px solid var(--border-color);">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ═══ 2×2 STUDENT TOOLS STRIP ═══ -->
  <section aria-labelledby="pyq-tools-heading" style="margin-bottom: 0.5rem;">
    <h2 id="pyq-tools-heading" style="font-size: 0.98rem; font-weight: 800; font-family: var(--font-display); margin: 0 0 0.65rem; color: var(--text-primary);">
      🛠️ Next Steps &amp; Student Tools
    </h2>
    <div class="pyq-tools-grid">
      <a href={`${baseUrl}/syllabus/`} class="card pyq-tool-card">
        <span style="font-size: 1.1rem;">📖</span>
        <div>
          <div style="font-size: 0.84rem; font-weight: 700; color: var(--text-primary);">NEP FYUGP Syllabus</div>
          <div style="font-size: 0.7rem; color: var(--text-tertiary);">Major, Minor, MDC &amp; VAC</div>
        </div>
      </a>
      <a href={`${baseUrl}/results/`} class="card pyq-tool-card">
        <span style="font-size: 1.1rem;">📊</span>
        <div>
          <div style="font-size: 0.84rem; font-weight: 700; color: var(--text-primary);">Kolhan University Results</div>
          <div style="font-size: 0.7rem; color: var(--text-tertiary);">Sem 1–7 All 37 Colleges</div>
        </div>
      </a>
      <a href={`${baseUrl}/holiday-list/`} class="card pyq-tool-card">
        <span style="font-size: 1.1rem;">📅</span>
        <div>
          <div style="font-size: 0.84rem; font-weight: 700; color: var(--text-primary);">Holiday List 2026</div>
          <div style="font-size: 0.7rem; color: var(--text-tertiary);">College Open Status &amp; PDF</div>
        </div>
      </a>
      <a href={`${baseUrl}/cgpa/`} class="card pyq-tool-card">
        <span style="font-size: 1.1rem;">🧮</span>
        <div>
          <div style="font-size: 0.84rem; font-weight: 700; color: var(--text-primary);">CGPA Calculator</div>
          <div style="font-size: 0.7rem; color: var(--text-tertiary);">SGPA to % Converter</div>
        </div>
      </a>
    </div>
  </section>

  <style>
    .pyq-cat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr));
      gap: 0.65rem;
    }
    .pyq-marks-grid,
    .pyq-tools-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }
    .pyq-two-col-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
    }
    @media (min-width: 640px) {
      .pyq-two-col-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .pyq-sem-link {
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
      text-decoration: none;
      transition: opacity 0.15s;
    }
    .pyq-sem-link:hover {
      opacity: 0.85;
    }
    .pyq-sem-link-primary {
      background: rgba(99,102,241,0.14);
      color: var(--accent-primary);
      border: 1px solid rgba(99,102,241,0.3);
    }
    .pyq-sem-link-success {
      background: rgba(16,185,129,0.12);
      color: var(--accent-success);
      border: 1px solid rgba(16,185,129,0.3);
    }
    .pyq-sem-link-warning {
      background: rgba(245,158,11,0.12);
      color: var(--accent-warning);
      border: 1px solid rgba(245,158,11,0.3);
    }
    .pyq-direct-card:hover {
      border-color: var(--accent-primary) !important;
    }
    .pyq-tool-card {
      padding: 0.75rem 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      text-decoration: none;
      min-width: 0;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
  </style>

  <script define:vars={{ subpagesJson, baseUrl }}>
    (function() {
      const subpages = JSON.parse(subpagesJson || '[]');
      const escHtml = (str) => String(str || '').replace(/[&<>"']/g, c => (
        { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
      ));

      // 1. Category Accordion Controls + Hash Deep-Linking
      const triggers = document.querySelectorAll('.accordion-trigger');
      function toggleAccordion(btn, forceOpen) {
        const content = btn.nextElementSibling;
        const chevron = btn.querySelector('.chevron');
        const isOpen = content && content.style.maxHeight && content.style.maxHeight !== '0px';

        document.querySelectorAll('.accordion-content').forEach(c => { c.style.maxHeight = '0px'; });
        document.querySelectorAll('.chevron').forEach(ch => { ch.style.transform = 'rotate(0deg)'; });
        document.querySelectorAll('.accordion-trigger').forEach(tr => { tr.style.backgroundColor = 'transparent'; });

        if (forceOpen || !isOpen) {
          if (content) content.style.maxHeight = 'none';
          if (chevron) chevron.style.transform = 'rotate(90deg)';
          btn.style.backgroundColor = 'rgba(99,102,241,0.08)';
        }
      }

      triggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
          toggleAccordion(e.currentTarget, false);
        });
      });

      if (window.location.hash) {
        const hashId = window.location.hash.substring(1);
        const target = document.getElementById(hashId);
        if (target) {
          const parentAcc = target.classList.contains('accordion-trigger')
            ? target
            : target.closest('.accordion-item')?.querySelector('.accordion-trigger');
          if (parentAcc) toggleAccordion(parentAcc, true);
          setTimeout(() => {
            target.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }, 180);
        }
      }

      // 3. MDC Guide arrow rotation
      const mdcGuideDetails = document.getElementById('mdc-guide-details');
      const mdcGuideArrow = document.getElementById('mdc-guide-arrow');
      if (mdcGuideDetails && mdcGuideArrow) {
        mdcGuideDetails.addEventListener('toggle', () => {
          mdcGuideArrow.style.transform = mdcGuideDetails.open ? 'rotate(180deg)' : 'rotate(0deg)';
        });
      }

      // 4. Independent Community Accordions
      function bindCommunityToggle(triggerId, contentId, chevronId) {
        const t = document.getElementById(triggerId);
        const c = document.getElementById(contentId);
        const ch = document.getElementById(chevronId);
        t?.addEventListener('click', () => {
          if (!c) return;
          const open = c.style.maxHeight && c.style.maxHeight !== '0px';
          c.style.maxHeight = open ? '0px' : c.scrollHeight + 'px';
          if (ch) ch.style.transform = open ? 'rotate(0deg)' : 'rotate(90deg)';
        });
      }
      bindCommunityToggle('pyq-req-trigger', 'pyq-req-content', 'pyq-req-chevron');
      bindCommunityToggle('pyq-contrib-trigger', 'pyq-contrib-content', 'pyq-contrib-chevron');

      // 5. IKS direct download tracking
      document.querySelectorAll('.iks-direct-link').forEach(el => {
        el.addEventListener('click', () => {
          if (window.trackDownload) {
            window.trackDownload('pyq', {
              subject: el.getAttribute('data-track-subject') || 'Indian Knowledge System',
              category: 'IKS',
              semester: el.getAttribute('data-track-semester') || '1',
              university: el.getAttribute('data-track-university') || ''
            });
          }
        });
      });

      // 6. Clickable Most Downloaded Loader (stale-while-revalidate)
      const STATS_URL = 'https://script.google.com/macros/s/AKfycbx3ZJ1VuRgNc71FSKnrIAzLsv3qxnUeBwA8HALHWhDxlpJC93YzOwCV5rmLLT-swLaXHQ/exec?action=top';
      const CACHE_KEY = 'tch_most_downloaded_v1';
      const listEl = document.getElementById('most-downloaded-list');
      const noteEl = document.getElementById('most-downloaded-note');

      function resolveItemHref(item) {
        if (item.fileType === 'syllabus') return `${baseUrl}/syllabus/`;
        const itemCat = String(item.category || '').toLowerCase();
        const itemSub = String(item.subject || '').toLowerCase();
        const itemSem = String(item.semester || '');

        let match = subpages.find(s =>
          s.catLower === itemCat && s.subjectLower === itemSub && String(s.sem) === itemSem
        );
        if (!match) {
          match = subpages.find(s =>
            s.catLower === itemCat && String(s.sem) === itemSem && itemSub.includes(s.subjectLower)
          );
        }
        if (!match) {
          match = subpages.find(s => itemSub.includes(s.subjectLower) && String(s.sem) === itemSem);
        }
        return match ? match.href : `${baseUrl}/pyqs/`;
      }

      function renderTop(top) {
        if (!listEl) return;
        listEl.innerHTML = top.map((item, i) => {
          const isLast = i === top.length - 1;
          const href = resolveItemHref(item);
          return `
            <a href="${escHtml(href)}" style="display:flex;flex-direction:column;gap:0.2rem;padding:0.4rem 0.35rem;border-radius:6px;text-decoration:none;${!isLast ? 'border-bottom:1px solid var(--border-color);' : ''}">
              <div style="font-weight:700;font-size:0.86rem;color:var(--text-primary);overflow-wrap:anywhere;">${escHtml(item.subject)} (${escHtml(item.category)})</div>
              <div style="display:flex;justify-content:space-between;font-size:0.74rem;color:var(--text-secondary);">
                <span>Sem ${escHtml(item.semester)} &bull; ${item.fileType === 'pyq' ? 'PYQ' : 'Syllabus'}</span>
                <span style="display:flex;align-items:center;gap:0.2rem;color:var(--accent-success);font-weight:700;">↓ ${escHtml(item.count)}</span>
              </div>
            </a>
          `;
        }).join('');
        if (noteEl) noteEl.style.display = 'block';
      }

      let cached = null;
      try { cached = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null'); } catch (e) {}
      if (cached && cached.top && cached.top.length > 0) {
        renderTop(cached.top);
      }

      fetch(STATS_URL)
        .then(r => r.json())
        .then(data => {
          if (data.status === 'ok' && data.top && data.top.length > 0) {
            renderTop(data.top);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ top: data.top, ts: Date.now() })); } catch (e) {}
          } else if (!cached && listEl) {
            listEl.innerHTML = '<p style="font-size:0.8rem;color:var(--text-tertiary);text-align:center;">Not enough data yet.</p>';
          }
        })
        .catch(() => {
          if (!cached && listEl && listEl.querySelector('[style*="animation"]')) {
            listEl.innerHTML = '<p style="font-size:0.8rem;color:var(--text-tertiary);text-align:center;">Could not load data.</p>';
          }
        });
    })();
  </script>
</Layout>
