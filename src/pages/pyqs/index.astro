---
import Layout from '../../layouts/Layout.astro';
import pyqsData from '../../../public/data/pyqs.json';
import { FileCode, Search, HelpCircle, GraduationCap, Clock, Download, Compass, BookOpen } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Extract unique subjects, categories, and semesters
const categories = [...new Set(pyqsData.map(item => item.category))];
const subjects = [...new Set(pyqsData.map(item => item.subject))].sort();
const semesters = [...new Set(pyqsData.map(item => item.semester))].sort((a, b) => a - b);

// Get popular papers for highlights
const popularPapers = [...pyqsData]
  .sort((a, b) => (b.downloadCount || 0) - (a.downloadCount || 0))
  .slice(0, 5);
---

<Layout title="PYQs Database" activeTab="pyqs">

  <!-- Header -->
  <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Previous Year Questions (PYQs)</h1>
    <p style="color: var(--text-secondary); max-width: 600px; font-size: 1.05rem;">
      Search and download official university exam papers by course category, subject, and semester.
    </p>
  </div>

  <div style="display: grid; grid-template-columns: 1fr; gap: 2rem;" class="md:grid-cols-3">
    
    <!-- Left 2 Cols: Browse and Selector Form -->
    <div class="md:col-span-2" style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Interactive Selector Form -->
      <div class="card" style="border-color: var(--accent-primary);">
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <Compass style="color: var(--accent-primary);" /> Find Papers by Category
        </h2>
        
        <form id="pyq-selector-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" class="md:grid-cols-3">
            
            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="select-category">1. Category</label>
              <select id="select-category" required class="form-input">
                <option value="" disabled selected>Select Category</option>
                {categories.map(cat => (
                  <option value={cat}>{cat}</option>
                ))}
              </select>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="select-subject">2. Subject</label>
              <select id="select-subject" required class="form-input">
                <option value="" disabled selected>Select Subject</option>
                {subjects.map(sub => (
                  <option value={sub}>{sub}</option>
                ))}
              </select>
            </div>

            <div class="form-group" style="margin-bottom: 0;">
              <label class="form-label" for="select-semester">3. Semester</label>
              <select id="select-semester" required class="form-input">
                <option value="" disabled selected>Select Semester</option>
                {semesters.map(sem => (
                  <option value={sem}>Semester {sem}</option>
                ))}
              </select>
            </div>

          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; height: 46px; font-size: 1rem;">
            Search Papers
          </button>
        </form>
      </div>

      <!-- Quick Browse by Category tiles -->
      <div>
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem;">Browse Categories</h2>
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem;" class="md:grid-cols-3">
          {categories.map(cat => (
            <button 
              class="card card-interactive category-tile" 
              data-cat={cat}
              style="display: flex; flex-direction: column; gap: 0.5rem; align-items: center; text-align: center; padding: 1.25rem 1rem;"
            >
              <div style="background-color: var(--bg-tertiary); color: var(--accent-primary); width: 36px; height: 36px; border-radius: var(--radius-xs); display: flex; align-items: center; justify-content: center;">
                <FileCode size="18" />
              </div>
              <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary);">{cat} Papers</h3>
              <span style="font-size: 0.75rem; color: var(--text-secondary);">
                {pyqsData.filter(p => p.category === cat).length} papers available
              </span>
            </button>
          ))}
        </div>
      </div>

    </div>

    <!-- Right 1 Col: Popular downloads & Quick request -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Popular Downloads -->
      <div class="card">
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <GraduationCap style="color: var(--accent-success);" /> Most Downloaded
        </h2>
        
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {popularPapers.map(paper => {
            const path = `${baseUrl}/pyqs/${paper.category.toLowerCase()}/${paper.subject.toLowerCase()}/${paper.semester}`;
            return (
              <a href={path} style="display: flex; flex-direction: column; gap: 0.25rem; text-decoration: none; color: inherit; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);" class="hover-trigger">
                <div style="font-weight: 700; font-size: 0.875rem; color: var(--text-primary);" class="hover-text-primary">
                  {paper.subject} ({paper.category})
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.15rem;">
                  <span>Sem {paper.semester} • {paper.year}</span>
                  <span style="display: flex; align-items: center; gap: 0.2rem; color: var(--accent-success); font-weight: 600;">
                    <Download size="12" /> {paper.downloadCount}
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Quick Contribution Card -->
      <div class="card" style="background-color: var(--bg-tertiary); text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.75rem;">
        <h3 style="font-size: 1.1rem; font-family: var(--font-display);">Missing a paper?</h3>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">
          Help fellow college students by contributing missing papers, or request a specific semester PYQ paper!
        </p>
        <button 
          class="btn btn-primary btn-sm" 
          style="width: 100%; margin-top: 0.5rem;"
          onclick="document.dispatchEvent(new CustomEvent('open-request-modal'));"
        >
          Submit / Request Paper
        </button>
      </div>

    </div>

  </div>

  <script define:vars={{ baseUrl }}>
    // Handle form submit and redirect to dynamic routes
    const form = document.getElementById('pyq-selector-form');
    const selectCat = document.getElementById('select-category');
    const selectSub = document.getElementById('select-subject');
    const selectSem = document.getElementById('select-semester');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const cat = selectCat.value.toLowerCase();
      const sub = selectSub.value.toLowerCase();
      const sem = selectSem.value;

      if (cat && sub && sem) {
        // Redirect to /pyqs/[category]/[subject]/[semester]
        window.location.href = `${baseUrl}/pyqs/${cat}/${sub}/${sem}`;
      }
    });

    // Handle Category tiles selection
    const tiles = document.querySelectorAll('.category-tile');
    tiles.forEach(tile => {
      tile.addEventListener('click', (e) => {
        const cat = e.currentTarget.getAttribute('data-cat');
        if (selectCat) {
          selectCat.value = cat;
          // Trigger input highlight visual
          selectCat.focus();
        }
      });
    });
  </script>

</Layout>
