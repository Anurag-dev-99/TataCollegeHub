  <!-- Live Most Downloaded — stale-while-revalidate via localStorage -->
  <script is:inline>
    // PYQ community panels — both open/close together
    (function() {
      var reqT  = document.getElementById('pyq-req-trigger');
      var reqC  = document.getElementById('pyq-req-content');
      var reqCh = document.getElementById('pyq-req-chevron');
      var conT  = document.getElementById('pyq-contrib-trigger');
      var conC  = document.getElementById('pyq-contrib-content');
      var conCh = document.getElementById('pyq-contrib-chevron');
      function toggleBoth() {
        if (!reqC || !conC) return;
        var open = reqC.style.maxHeight && reqC.style.maxHeight !== '0px';
        reqC.style.maxHeight = open ? '0px' : reqC.scrollHeight + 'px';
        conC.style.maxHeight = open ? '0px' : conC.scrollHeight + 'px';
        var rot = open ? 'rotate(0deg)' : 'rotate(90deg)';
        if (reqCh) reqCh.style.transform = rot;
        if (conCh) conCh.style.transform = rot;
      }
      if (reqT) reqT.addEventListener('click', toggleBoth);
      if (conT) conT.addEventListener('click', toggleBoth);
    })();
    (function() {
      var STATS_URL = 'https://script.google.com/macros/s/AKfycbx3ZJ1VuRgNc71FSKnrIAzLsv3qxnUeBwA8HALHWhDxlpJC93YzOwCV5rmLLT-swLaXHQ/exec?action=top';
      var CACHE_KEY = 'tch_most_downloaded_v1';
      var listEl = document.getElementById('most-downloaded-list');
      var noteEl = document.getElementById('most-downloaded-note');

      function renderTop(top) {
        if (!listEl) return;
        var html = '';
        top.forEach(function(item, i) {
          var isLast = i === top.length - 1;
          html += '<div style="display:flex;flex-direction:column;gap:0.25rem;padding-bottom:0.75rem;' + (!isLast ? 'border-bottom:1px solid var(--border-color);' : '') + '">' +
            '<div style="font-weight:700;font-size:0.875rem;color:var(--text-primary);">' + item.subject + ' (' + item.category + ')</div>' +
            '<div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--text-secondary);">' +
              '<span>Sem ' + item.semester + ' &bull; ' + (item.fileType === 'pyq' ? 'PYQ' : 'Syllabus') + '</span>' +
              '<span style="display:flex;align-items:center;gap:0.2rem;color:var(--accent-success);font-weight:600;">↓ ' + item.count + '</span>' +
            '</div>' +
          '</div>';
        });
        listEl.innerHTML = html;
        if (noteEl) noteEl.style.display = 'block';
      }

      // STEP 1: Show cached data immediately if available — skips the skeleton entirely
      var cached = null;
      try { cached = JSON.parse(localStorage.getItem(CACHE_KEY) || 'null'); } catch(e) {}
      if (cached && cached.top && cached.top.length > 0) {
        renderTop(cached.top);
      }

      // STEP 2: Always fetch fresh data in background — update UI + cache when done
      fetch(STATS_URL)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data.status === 'ok' && data.top && data.top.length > 0) {
            renderTop(data.top);
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ top: data.top, ts: Date.now() })); } catch(e) {}
          } else if (!cached) {
            if (listEl) listEl.innerHTML = '<p style="font-size:0.8rem;color:var(--text-tertiary);text-align:center;">Not enough data yet.</p>';
          }
        })
        .catch(function() {
          // Only show error if nothing was rendered from cache
          if (!cached && listEl && listEl.querySelector('[style*="animation"]')) {
            listEl.innerHTML = '<p style="font-size:0.8rem;color:var(--text-tertiary);text-align:center;">Could not load data.</p>';
          }
        });
    })();
  </script>

  <script>
    // ══════════════════════════════════════════════════════════════════════════
    // STATE PERSISTENCE — save open accordion + card before navigating away,
    // restore when user presses Back so they land exactly where they were.
    //
    // Root cause of earlier failures:
    //   • Reading sessionStorage / history.state in the MAIN script body
    //     does NOT work for bfcache restores (scripts don't re-run).
    //
    // Correct approach:
    //   1. SAVE  → sessionStorage on semester-link click (survives navigation).
    //   2. READ  → inside window 'pageshow' handler (fires for BOTH fresh loads
    //              AND bfcache restores — scripts don't re-run on bfcache, but
    //              already-registered event listeners still fire).
    //   3. BFCACHE (event.persisted=true): DOM is already correct, just scroll.
    //   4. FRESH  (event.persisted=false): read sessionStorage, restore full state.
    // ══════════════════════════════════════════════════════════════════════════

    // Helper: open an accordion trigger programmatically
    function openAccordionById(triggerId: string) {
      const trigger = document.getElementById(triggerId) as HTMLButtonElement | null;
      if (!trigger) return;
      const content = trigger.nextElementSibling as HTMLElement;
      const chevron = trigger.querySelector('.chevron') as HTMLElement;
      document.querySelectorAll('.accordion-content').forEach(c => {
        (c as HTMLElement).style.maxHeight = '0px';
      });
      document.querySelectorAll('.chevron').forEach(ch => {
        (ch as HTMLElement).style.transform = 'rotate(0deg)';
      });
      document.querySelectorAll('.accordion-trigger').forEach(tr => {
        (tr as HTMLElement).style.backgroundColor = 'transparent';
      });
      if (content) {
        content.style.maxHeight = 'none';
        trigger.style.backgroundColor = 'rgba(99,102,241,0.08)';
        if (chevron) chevron.style.transform = 'rotate(90deg)';
      }
    }

    // Helper: open a subject card panel programmatically
    function openSubjectPanel(panelId: string) {
      const panel = document.getElementById(panelId) as HTMLElement | null;
      if (!panel) return;
      panel.style.maxHeight = 'none';
      const prefixes = ['major', 'minor', 'mdc', 'vac', 'sec'];
      for (const prefix of prefixes) {
        const btn = document.querySelector(`.${prefix}-pyq-subject-btn[data-panel="${panelId}"]`) as HTMLElement | null;
        if (btn) {
          const card = btn.closest(`.${prefix}-pyq-subject-card`) as HTMLElement | null;
          if (card) card.classList.add('is-open');
          const icon = btn.querySelector(`.${prefix}-subject-icon`) as HTMLElement | null;
          if (icon) { icon.textContent = '📂'; icon.style.transform = 'rotate(-10deg)'; }
          break;
        }
      }
    }

    // ── STEP 1: Save to sessionStorage on semester-link click ───────────────
    const catPanelSelectors = [
      '.major-pyq-papers-panel a',
      '.minor-pyq-papers-panel a',
      '.mdc-pyq-papers-panel a',
    ];
    document.querySelectorAll(catPanelSelectors.join(', ')).forEach(link => {
      link.addEventListener('click', () => {
        const panel = link.closest('.major-pyq-papers-panel, .minor-pyq-papers-panel, .mdc-pyq-papers-panel') as HTMLElement | null;
        if (!panel) return;
        const accordionContent = link.closest('.accordion-content') as HTMLElement | null;
        const trigger = accordionContent?.previousElementSibling as HTMLElement | null;
        if (panel.id && trigger?.id) {
          sessionStorage.setItem('pyq_restore', JSON.stringify({
            trigger: trigger.id,
            panel: panel.id,
            ts: Date.now(),
          }));
        }
      });
    });

    // ── STEP 2: Read sessionStorage INSIDE pageshow (the only place it works) ─
    window.addEventListener('pageshow', (event: PageTransitionEvent) => {
      let saved: { trigger: string; panel: string; ts: number } | null = null;
      try {
        const raw = sessionStorage.getItem('pyq_restore');
        if (raw) saved = JSON.parse(raw);
      } catch { /* ignore */ }

      if (!saved?.trigger || !saved?.panel) return;
      // Ignore stale saves older than 60 seconds (user opened a new tab etc.)
      if (Date.now() - (saved.ts || 0) > 60000) {
        sessionStorage.removeItem('pyq_restore');
        return;
      }

      const { trigger: triggerId, panel: panelId } = saved;

      if (event.persisted) {
        // ─ bfcache restore ─────────────────────────────────────────────────
        // DOM is FROZEN as it was when user left (accordion open, card open).
        // Don't touch the DOM — just scroll smoothly to the card.
        setTimeout(() => {
          document.getElementById(panelId)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
        // Keep sessionStorage intact (if bfcache is later evicted, the fresh
        // load path below will handle it).
      } else {
        // ─ Fresh load (bfcache evicted / not supported / first load) ───────
        // Remove the save so a subsequent fresh visit doesn't re-trigger.
        sessionStorage.removeItem('pyq_restore');
        requestAnimationFrame(() => {
          openAccordionById(triggerId);
          openSubjectPanel(panelId);
          setTimeout(() => {
            document.getElementById(panelId)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }, 150);
        });
      }
    });

    // ── Accordion script (non-AEC categories) ──────────────────────────────
    const triggers = document.querySelectorAll('.accordion-trigger');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const content = btn.nextElementSibling as HTMLElement;
        const chevron = btn.querySelector('.chevron') as HTMLElement;

        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        // Close all others
        document.querySelectorAll('.accordion-content').forEach(c => {
          (c as HTMLElement).style.maxHeight = '0px';
        });
        document.querySelectorAll('.chevron').forEach(ch => {
          (ch as HTMLElement).style.transform = 'rotate(0deg)';
        });
        document.querySelectorAll('.accordion-trigger').forEach(tr => {
          (tr as HTMLElement).style.backgroundColor = 'transparent';
        });

        if (!isOpen) {
          content.style.maxHeight = content.scrollHeight + 'px';
          if (chevron) chevron.style.transform = 'rotate(90deg)';
          btn.style.backgroundColor = 'rgba(99,102,241,0.08)';
        }
      });
    });

    // ── AEC PYQ: handled via initCatWidget below ──────────────────────────────

    // ── Generic card-grid widget factory for Major / Minor / MDC ────────────
    type CatConfig = {
      prefix: string;
      triggerId: string;
      accentColor: string;
    };

    function initCatWidget(cfg: CatConfig) {
      const tabs   = document.querySelectorAll(`.${cfg.prefix}-pyq-tab`) as NodeListOf<HTMLButtonElement>;
      const cards  = document.querySelectorAll(`.${cfg.prefix}-pyq-subject-card`) as NodeListOf<HTMLElement>;
      const search = document.getElementById(`${cfg.prefix}-pyq-search`) as HTMLInputElement | null;
      const empty  = document.getElementById(`${cfg.prefix}-pyq-empty`) as HTMLElement | null;

      let activeSem = 'all';
      let searchVal = '';

      function filter() {
        let visible = 0;
        cards.forEach(card => {
          const cardSems   = (card.getAttribute('data-sems') || '').split(',');
          const cardSearch = card.getAttribute('data-search') || '';
          const semMatch   = activeSem === 'all' || cardSems.includes(activeSem);
          const txtMatch   = searchVal === '' || cardSearch.includes(searchVal);
          const show = semMatch && txtMatch;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (empty) empty.style.display = visible === 0 ? 'block' : 'none';
        // Re-measure parent accordion height
        const trigger = document.getElementById(cfg.triggerId);
        const content = trigger?.nextElementSibling as HTMLElement | null;
        if (content && content.style.maxHeight && content.style.maxHeight !== '0px') {
          content.style.maxHeight = 'none';
        }
      }

      tabs.forEach(btn => {
        btn.addEventListener('click', () => {
          tabs.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          activeSem = btn.getAttribute('data-sem') || 'all';
          filter();
        });
      });

      search?.addEventListener('input', () => {
        searchVal = search.value.toLowerCase().trim();
        filter();
      });

      // Card expand/collapse
      document.querySelectorAll(`.${cfg.prefix}-pyq-subject-btn`).forEach(btn => {
        btn.addEventListener('click', () => {
          const panelId = (btn as HTMLElement).getAttribute('data-panel');
          const panel = panelId ? document.getElementById(panelId) : null;
          const card = btn.closest(`.${cfg.prefix}-pyq-subject-card`) as HTMLElement;
          const icon = btn.querySelector(`.${cfg.prefix}-subject-icon`) as HTMLElement;
          if (!panel) return;
          const isOpen = panel.style.maxHeight && panel.style.maxHeight !== '0px';
          if (isOpen) {
            panel.style.maxHeight = '0px';
            card?.classList.remove('is-open');
            if (icon) { icon.textContent = '📥'; icon.style.transform = ''; }
          } else {
            panel.style.maxHeight = panel.scrollHeight + 'px';
            card?.classList.add('is-open');
            if (icon) { icon.textContent = '📂'; icon.style.transform = 'rotate(-10deg)'; }
          }
          // Re-measure parent accordion
          const trigger = document.getElementById(cfg.triggerId);
          const content = trigger?.nextElementSibling as HTMLElement | null;
          if (content && content.style.maxHeight && content.style.maxHeight !== '0px') {
            content.style.maxHeight = 'none';
          }
        });
      });
    }

    initCatWidget({ prefix: 'major', triggerId: 'major-pyq-trigger', accentColor: 'var(--accent-primary)' });
    initCatWidget({ prefix: 'minor', triggerId: 'minor-pyq-trigger', accentColor: 'var(--accent-success)' });
    initCatWidget({ prefix: 'mdc',   triggerId: 'mdc-pyq-trigger',   accentColor: 'var(--accent-warning)' });
    initCatWidget({ prefix: 'aec',   triggerId: 'aec-pyq-trigger',   accentColor: 'var(--accent-success)' });

    // ── VAC PYQ: Tab filter + Search + Card expand ─────────────────────────
    const vacTabs    = document.querySelectorAll('.vac-pyq-tab') as NodeListOf<HTMLButtonElement>;
    const vacCards   = document.querySelectorAll('.vac-pyq-subject-card') as NodeListOf<HTMLElement>;
    const vacSearch  = document.getElementById('vac-pyq-search') as HTMLInputElement;
    const vacEmpty   = document.getElementById('vac-pyq-empty') as HTMLElement;

    let vacActiveSem  = 'all';
    let vacSearchTerm = '';

    function filterVac() {
      let visible = 0;
      vacCards.forEach(card => {
        const cardSem    = card.getAttribute('data-sem') || '';
        const cardSearch = card.getAttribute('data-search') || '';
        const semMatch   = vacActiveSem === 'all' || cardSem === vacActiveSem;
        const txtMatch   = vacSearchTerm === '' || cardSearch.includes(vacSearchTerm);
        const show       = semMatch && txtMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (vacEmpty) vacEmpty.style.display = visible === 0 ? 'block' : 'none';
      // Re-measure accordion height
      const vacContent = document.getElementById('vac-pyq-trigger')?.nextElementSibling as HTMLElement | null;
      if (vacContent && vacContent.style.maxHeight && vacContent.style.maxHeight !== '0px') {
        vacContent.style.maxHeight = 'none';
      }
    }

    vacTabs.forEach(btn => {
      btn.addEventListener('click', () => {
        vacTabs.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        vacActiveSem = btn.getAttribute('data-sem') || 'all';
        filterVac();
      });
    });

    vacSearch?.addEventListener('input', () => {
      vacSearchTerm = vacSearch.value.toLowerCase().trim();
      filterVac();
    });

    // VAC subject card expand/collapse
    document.querySelectorAll('.vac-pyq-subject-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const panelId = (btn as HTMLElement).getAttribute('data-panel');
        const panel = panelId ? document.getElementById(panelId) : null;
        const card = btn.closest('.vac-pyq-subject-card') as HTMLElement;
        const icon = btn.querySelector('.vac-subject-icon') as HTMLElement;
        if (!panel) return;
        const isOpen = panel.style.maxHeight && panel.style.maxHeight !== '0px';
        if (isOpen) {
          panel.style.maxHeight = '0px';
          card?.classList.remove('is-open');
          if (icon) { icon.textContent = '📥'; icon.style.transform = ''; }
        } else {
          panel.style.maxHeight = panel.scrollHeight + 'px';
          card?.classList.add('is-open');
          if (icon) { icon.textContent = '📂'; icon.style.transform = 'rotate(-10deg)'; }
        }
        // Re-measure parent accordion
        const vacContent = document.getElementById('vac-pyq-trigger')?.nextElementSibling as HTMLElement | null;
        if (vacContent && vacContent.style.maxHeight && vacContent.style.maxHeight !== '0px') {
          vacContent.style.maxHeight = 'none';
        }
      });
    });

    // ── SEC PYQ: Tab filter + Search + Card expand ─────────────────────────
    const secTabs    = document.querySelectorAll('.sec-pyq-tab') as NodeListOf<HTMLButtonElement>;
    const secCards   = document.querySelectorAll('.sec-pyq-subject-card') as NodeListOf<HTMLElement>;
    const secSearch  = document.getElementById('sec-pyq-search') as HTMLInputElement;
    const secEmpty   = document.getElementById('sec-pyq-empty') as HTMLElement;

    let secActiveSem  = 'all';
    let secSearchTerm = '';

    function filterSec() {
      let visible = 0;
      secCards.forEach(card => {
        const cardSem    = card.getAttribute('data-sem') || '';
        const cardSearch = card.getAttribute('data-search') || '';
        const semMatch   = secActiveSem === 'all' || cardSem === secActiveSem;
        const txtMatch   = secSearchTerm === '' || cardSearch.includes(secSearchTerm);
        const show       = semMatch && txtMatch;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (secEmpty) secEmpty.style.display = visible === 0 ? 'block' : 'none';
      // Re-measure accordion height
      const secContent = document.getElementById('sec-pyq-trigger')?.nextElementSibling as HTMLElement | null;
      if (secContent && secContent.style.maxHeight && secContent.style.maxHeight !== '0px') {
        secContent.style.maxHeight = 'none';
      }
    }

    secTabs.forEach(btn => {
      btn.addEventListener('click', () => {
        secTabs.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        secActiveSem = btn.getAttribute('data-sem') || 'all';
        filterSec();
      });
    });

    secSearch?.addEventListener('input', () => {
      secSearchTerm = secSearch.value.toLowerCase().trim();
      filterSec();
    });

    // SEC subject card expand/collapse
    document.querySelectorAll('.sec-pyq-subject-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const panelId = (btn as HTMLElement).getAttribute('data-panel');
        const panel = panelId ? document.getElementById(panelId) : null;
        const card = btn.closest('.sec-pyq-subject-card') as HTMLElement;
        const icon = btn.querySelector('.sec-subject-icon') as HTMLElement;
        if (!panel) return;
        const isOpen = panel.style.maxHeight && panel.style.maxHeight !== '0px';
        if (isOpen) {
          panel.style.maxHeight = '0px';
          card?.classList.remove('is-open');
          if (icon) { icon.textContent = '📥'; icon.style.transform = ''; }
        } else {
          panel.style.maxHeight = panel.scrollHeight + 'px';
          card?.classList.add('is-open');
          if (icon) { icon.textContent = '📂'; icon.style.transform = 'rotate(-10deg)'; }
        }
        // Re-measure parent accordion
        const secContent = document.getElementById('sec-pyq-trigger')?.nextElementSibling as HTMLElement | null;
        if (secContent && secContent.style.maxHeight && secContent.style.maxHeight !== '0px') {
          secContent.style.maxHeight = 'none';
        }
      });
    });

    // ── MDC Guide <details> arrow toggle ──────────────────────────────────────
    const mdcGuideDetails = document.getElementById('mdc-guide-details') as HTMLDetailsElement | null;
    const mdcGuideArrow = document.getElementById('mdc-guide-arrow') as HTMLElement | null;
    if (mdcGuideDetails && mdcGuideArrow) {
      mdcGuideDetails.addEventListener('toggle', () => {
        mdcGuideArrow.style.transform = mdcGuideDetails.open ? 'rotate(180deg)' : 'rotate(0deg)';
      });
    }
  </script>

