---
import Layout from '../layouts/Layout.astro';
import noticesData from '../../public/data/notices.json';
import { Bell, Filter, ExternalLink, Calendar, Search, Pin, AlertCircle } from '@lucide/astro';

// Sort notices: active first, pinned first, then by date descending
const sortedNotices = [...noticesData].sort((a, b) => {
  // Archived last
  if (a.isArchived !== b.isArchived) {
    return a.isArchived ? 1 : -1;
  }
  // Pinned first
  if (a.isPinned !== b.isPinned) {
    return a.isPinned ? -1 : 1;
  }
  // Date descending
  return new Date(b.date).getTime() - new Date(a.date).getTime();
});

// Categories list mapping labels to exact notice keys
const categories = [
  { label: 'All', key: 'All' },
  { label: 'Exams', key: 'Exam' },
  { label: 'Admissions', key: 'Admission' },
  { label: 'Academic', key: 'Academic' },
  { label: 'Results', key: 'Result' }
];
---

<Layout title="Kolhan University Notices & Notifications — Tata College, Chaibasa" activeTab="notices">

  <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.25rem;">
    <h1 style="font-size: 2.25rem; font-family: var(--font-display); font-weight: 800; tracking: -0.02em;">Notice Board</h1>
    <p style="color: var(--text-secondary); max-width: 600px; font-size: 1.05rem;">
      Stay updated with official notifications from Kolhan University and Tata College.
    </p>
  </div>

  <!-- Archived Button -->
  <div style="margin-bottom: 1.5rem;">
    <button id="archive-toggle-btn" class="btn btn-secondary" style="border-radius: var(--radius-sm); font-weight: 600; padding: 0.625rem 1.25rem; gap: 0.625rem;">
      <Bell size="18" /> View Archived Notices
    </button>
  </div>

  <!-- Filters & Search Unified Card (Matching Screenshot) -->
  <div class="card" style="display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 2.5rem; padding: 1.5rem; border-color: var(--border-color); box-shadow: var(--shadow-lg);">
    
    <!-- Search Input -->
    <div style="position: relative; display: flex; align-items: center; width: 100%;">
      <Search style="position: absolute; left: 1rem; width: 18px; height: 18px; color: var(--text-tertiary);" />
      <input 
        type="text" 
        id="notice-search" 
        class="form-input" 
        placeholder="Search notices by keyword..." 
        style="padding-left: 2.75rem; border-radius: var(--radius-sm); height: 46px; font-size: 0.95rem; background-color: rgba(0,0,0,0.15);" 
      />
    </div>

    <!-- Category Pills -->
    <div style="display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.25rem; -webkit-overflow-scrolling: touch;" class="no-scrollbar">
      {categories.map((cat, idx) => (
        <button 
          class={`btn btn-sm filter-btn ${idx === 0 ? 'btn-primary' : 'btn-secondary'}`} 
          data-category={cat.key}
          style="white-space: nowrap; border-radius: var(--radius-full); padding: 0.5rem 1.15rem; font-size: 0.85rem;"
        >
          {cat.label}
        </button>
      ))}
    </div>

  </div>

  <!-- Notices List Section -->
  <h2 style="font-size: 1.35rem; font-family: var(--font-display); margin-bottom: 1.25rem; color: var(--text-primary);" id="list-heading">
    Latest Active Notices
  </h2>

  <!-- Notices List Container -->
  <div id="notices-container" style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
    {sortedNotices.map(notice => {
      const isExpired = notice.isArchived;
      const containsDeadline = /last date|deadline|due date/i.test(`${notice.title} ${notice.description}`);
      
      // Determine vertical border accent color
      let borderAccent = 'var(--border-color)';
      if (!isExpired) {
        if (notice.category === 'Exam') borderAccent = 'var(--accent-danger)';
        else if (notice.category === 'General') borderAccent = 'var(--accent-warning)';
        else if (notice.category === 'Result') borderAccent = 'var(--accent-success)';
        else if (notice.category === 'Admission') borderAccent = 'var(--accent-primary)';
      }

      return (
        <div 
          class="card notice-card" 
          id={notice.id}
          data-cat={notice.category}
          data-archived={notice.isArchived ? "true" : "false"}
          data-pinned={notice.isPinned ? "true" : "false"}
          style={`display: flex; flex-direction: column; gap: 1rem; position: relative; border-left: 4px solid ${borderAccent}; opacity: ${isExpired ? 0.6 : 1}; display: ${isExpired ? 'none' : 'flex'};`}
        >
          <!-- Notice Metadata -->
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class={`badge ${
                notice.category === 'Exam' ? 'badge-danger' : 
                notice.category === 'Result' ? 'badge-success' : 
                notice.category === 'Admission' ? 'badge-primary' : 
                'badge-warning'
              }`} style="border-radius: var(--radius-xs); text-transform: uppercase;">
                {notice.category}
              </span>
              {isExpired && <span class="badge" style="background-color: var(--bg-tertiary); color: var(--text-secondary); border-radius: var(--radius-xs);">Archived</span>}
            </div>
            
            <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; color: var(--text-tertiary); font-weight: 600;">
              {notice.isPinned && !isExpired && (
                <span style="color: var(--accent-warning); display: flex; align-items: center; gap: 0.2rem; font-weight: 700; text-transform: uppercase;" title="Pinned Notice">
                  📌 Pinned
                </span>
              )}
              <span>{notice.date}</span>
            </div>
          </div>

          <!-- Title & Description -->
          <div>
            <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 0.5rem; line-height: 1.35; color: var(--text-primary);">
              {notice.title}
            </h3>
            <p style="font-size: 0.925rem; color: var(--text-secondary); line-height: 1.6;">
              {notice.description}
            </p>
          </div>

          <!-- Deadline notification warning (inside card) -->
          {!isExpired && containsDeadline && (
            <div style="background-color: rgba(239, 68, 68, 0.05); border: 1px dashed rgba(239, 68, 68, 0.2); border-radius: var(--radius-xs); padding: 0.625rem; display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--accent-danger); font-weight: 600;">
              <AlertCircle size="14" />
              <span>Deadline detected in notice details.</span>
            </div>
          )}

          <!-- Quick Action Buttons inside notice -->
          {notice.links && notice.links.length > 0 && (
            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: auto; border-top: 1px solid var(--border-color); padding-top: 0.875rem;">
              {notice.links.map(link => {
                const isForm = /form|apply|fill/i.test(link.label);
                
                return (
                  <a 
                    href={link.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class={`btn btn-sm ${isForm ? 'btn-primary' : 'btn-secondary'}`}
                    style="flex: 1; min-width: 130px; justify-content: center; gap: 0.4rem; padding: 0.5rem 0.875rem;"
                  >
                    {link.label} <ExternalLink size="14" />
                  </a>
                );
              })}
            </div>
          )}

        </div>
      );
    })}
  </div>

  <!-- Empty Search Result -->
  <div id="no-notices" style="display: none; flex-direction: column; align-items: center; text-align: center; padding: 4rem 1rem; gap: 1rem;">
    <Bell size="48" style="color: var(--text-tertiary);" />
    <div>
      <h3 style="font-size: 1.2rem; font-family: var(--font-display);">No notices found</h3>
      <p style="color: var(--text-secondary); font-size: 0.95rem; margin-top: 0.25rem;">
        Try adjusting your filters or search keywords.
      </p>
    </div>
  </div>

  <script>
    // Client-side Notice Board filter and search logic
    const filterButtons = document.querySelectorAll('.filter-btn');
    const searchInput = document.getElementById('notice-search') as HTMLInputElement;
    const cards = document.querySelectorAll('.notice-card') as NodeListOf<HTMLElement>;
    const noNoticesBox = document.getElementById('no-notices');
    const archiveBtn = document.getElementById('archive-toggle-btn') as HTMLButtonElement;
    const listHeading = document.getElementById('list-heading');

    let currentCategory = 'All';
    let searchQuery = '';
    let showArchived = false;

    const filterNotices = () => {
      let visibleCount = 0;

      cards.forEach(card => {
        const category = card.getAttribute('data-cat') || '';
        const isArchived = card.getAttribute('data-archived') === 'true';
        const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
        const desc = card.querySelector('p')?.textContent?.toLowerCase() || '';
        
        const matchesCategory = currentCategory === 'All' || category.toLowerCase() === currentCategory.toLowerCase();
        const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery);
        const matchesArchiveState = isArchived === showArchived;

        if (matchesCategory && matchesSearch && matchesArchiveState) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (noNoticesBox) {
        noNoticesBox.style.display = visibleCount === 0 ? 'flex' : 'none';
      }
    };

    filterButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        
        // Remove primary state from all filter buttons
        filterButtons.forEach(b => {
          b.classList.remove('btn-primary');
          b.classList.add('btn-secondary');
        });
        
        // Add primary state to current
        target.classList.remove('btn-secondary');
        target.classList.add('btn-primary');

        currentCategory = target.getAttribute('data-category') || 'All';
        filterNotices();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterNotices();
    });

    // Handle archived toggle button click
    archiveBtn?.addEventListener('click', () => {
      showArchived = !showArchived;
      if (showArchived) {
        archiveBtn.innerHTML = `<span>📂 View Active Notices</span>`;
        if (listHeading) listHeading.textContent = 'Archived Notices';
      } else {
        archiveBtn.innerHTML = `<span>📁 View Archived Notices</span>`;
        if (listHeading) listHeading.textContent = 'Latest Active Notices';
      }
      filterNotices();
    });

    // Handle hash scrolling if navigating from banner
    window.addEventListener('load', () => {
      if (window.location.hash) {
        const element = document.getElementById(window.location.hash.substring(1));
        if (element) {
          element.scrollIntoView({ behavior: 'smooth' });
          element.style.boxShadow = '0 0 15px rgba(239, 68, 68, 0.3)';
          element.style.borderColor = 'var(--accent-danger)';
        }
      }
    });
  </script>

  <style>
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

</Layout>
