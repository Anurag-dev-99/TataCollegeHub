  }
  .pac-topper-score {
    font-weight: 900;
    font-family: monospace;
    color: var(--accent-primary);
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .pac-grade-section {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .pac-grade-label-row {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
  }
  .pac-grade-bar {
    display: flex;
    height: 12px;
    border-radius: var(--radius-full, 9999px);
    overflow: hidden;
    background: var(--bg-tertiary);
  }
  .pac-grade-seg {
    height: 100%;
    min-width: 3px;
    transition: width 0.5s ease;
  }
  .pac-grade-a { background: #22c55e; }
  .pac-grade-b { background: #3b82f6; }
  .pac-grade-c { background: #f59e0b; }
  .pac-grade-d { background: #f97316; }
  .pac-grade-f { background: #ef4444; }
  .pac-grade-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: var(--text-tertiary);
  }
  .pac-legend-item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 600;
  }
