    .pac-title {
      font-size: 0.9rem;
      max-width: 60%;
    }
  }
</style>

<script>
  import Chart from 'chart.js/auto';

  // Constants
  const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

  // State
  let currentResultsDataset = [];
  let currentDatasetMetadata = null;
  let selectedMajor = 'All';
  let comparisonChart = null;

  // Custom comparator for grand total (descending), tie-broken by student name (alphabetically ascending)
  const grandTotalComparator = (a, b) => {
    if (b.grand_total !== a.grand_total) {
      return b.grand_total - a.grand_total;
    }
    return a.student_name.localeCompare(b.student_name);
  };

  // DOM Elements
  let hubView;
  let dashboardView;
  let backBtn;
  let examCards;

  // Dashboard DOM Elements
  let examTitle;
  let examSubtitle;
  let filterContainer;
  let majorSelect;

  // Stats DOM Elements
  let totalStudentsEl;
  let passPercentEl;
  let passSubEl;
  let passProgressFill;
  let topperScoreEl;
  let topperNameEl;
  let avgScoreEl;

  // Search DOM Elements
  let searchInput;
  let searchBtn;
  let searchSuggestions;
  let searchOutput;
  let browseAllBtn;

  // Leaderboard DOM Elements
  let leaderboardSortSelect;
  let leaderboardTableBody;
  let leaderboardDesc;

  // Toppers DOM Element
  let subjectToppersList;

  // Comparison DOM Elements
  let compareBtn;
  let compareRoll1;
  let compareRoll2;
  let compareSuggestions1;
  let compareSuggestions2;
  let comparisonResultOutput;

  // Modal DOM Elements
  let browseModal;
  let closeBrowseModalBtn;
  let modalBrowseSearch;
  let browseModalTableBody;

  // Updates Modal DOM Elements
  let updatesModal;
  let closeUpdatesModalBtn;
  let closeUpdatesModalDoneBtn;
  let updatesList;
  let updatesBtn;
  let updatesCount;

  // --- Utility: Clean Subject Names ---
  function cleanSubjectName(name) {
    if (!name) return 'Unknown';
    let cleaned = name;
    
    const majorMatch = name.match(/^MAJOR-([lIVX]+)\s*-\s*(.*)/i);
    if (majorMatch) {
      cleaned = `Major ${majorMatch[1].toUpperCase()}: ${majorMatch[2].trim()}`;
    } else if (name.toLowerCase().startsWith('minor')) {
      const paperMatch = name.match(/Paper Name:?-?\s*(.*)/i);
      if (paperMatch) {
        cleaned = `Minor: ${paperMatch[1].trim()}`;
      } else {
        const parts = name.split('-');
        if (parts.length >= 3) {
          cleaned = `Minor: ${parts.slice(2).join('-').trim()}`;
        } else {
          cleaned = name.replace(/^Minor-[A-Z0-9]+-?/i, 'Minor: ');
        }
      }
    } else if (name.toLowerCase().includes('multi disciplinary course')) {
      cleaned = name.replace(/^Multi Disciplinary Course-[lIVX]+\s*-\s*/i, 'MDC: ').replace(/^Multi Disciplinary Course-[lIVX]+\s*/i, 'MDC: ').replace(/Geography-/, 'Geography');
    } else if (name.toLowerCase().includes('skill enhancement course')) {
      cleaned = name.replace(/^Skill Enhancement Course-[lIVX]+\s*-\s*/i, 'SEC: ').replace(/^Skill Enhancement Course-[lIVX]+\s*/i, 'SEC: ').replace(/^Skill Enhancement Course-\s*-\s*/i, 'SEC: ');
    } else if (name.toLowerCase().includes('ability enhancement course')) {
      cleaned = name.replace(/^Ability Enhancement Courses?-[lIVX]+\s*-\s*/i, 'AEC: ').replace(/^Ability Enhancement Courses?-[lIVX]+\s*/i, 'AEC: ').replace(/^Ability Enhancement Courses?-\s*-\s*/i, 'AEC: ');
    } else if (name.toLowerCase().includes('value addes course') || name.toLowerCase().includes('value added course')) {
      cleaned = name.replace(/^Value Adde[ds] Courses?-[lIVX]+\s*-\s*/i, 'VAC: ').replace(/^Value Adde[ds] Courses?-[lIVX]+\s*/i, 'VAC: ').replace(/^Value Adde[ds] Courses?-\s*-\s*/i, 'VAC: ');
    } else {
      cleaned = name
        .replace(/^MAJOR-[lIVX]+-/i, '')
        .replace(/^Minor-[lIVX]+[a-zA-Z]?-/i, '')
        .replace(/^Ability Enhancement Courses?-[lIVX]+ ?- ?/i, 'AEC: ')
        .replace(/^Value Adde[ds] Courses?-[lIVX]* ?-? ?/i, 'VAC: ')
        .trim();
    }

    return cleaned
      .replace(/Global Citizenship Education for Sustainable Development/gi, "Global Citizenship")
      .replace(/Communication Skills & Personality development/gi, "Comm. Skills & Personality")
      .replace(/News Writing and Reporting/gi, "News Writing")
      .replace(/Chemistry in Everyday Life/gi, "Chem in Everyday Life")
      .replace(/Electrical Circuits and Network Skills/gi, "Electrical Circuits")
      .replace(/Analytical Chemistry/gi, "Analyt. Chem")
      .replace(/Digital Systems and Applications/gi, "Digital Sys")
      .replace(/Digital Systems/gi, "Digital Sys")
      .replace(/Mathematics/gi, "Math")
      .replace(/Composition/gi, "Comp");
  }

  // --- Utility: Get Student Major ---
  function getStudentMajor(student) {
    if (!student || !student.subjects) return 'Unknown';
    // Check major subject keys first (semester-specific keys)
    for (const key of ['major_ii', 'major_iii', 'major_iv', 'major_v', 'major_vi', 'major_vii', 'major_viii']) {
      const subObj = student.subjects[key];
      if (subObj && subObj.subject) {
        const title = subObj.subject.toLowerCase();
        if (title.includes('mathematics') || title.includes('math')) return 'Mathematics';
        if (title.includes('physics')) return 'Physics';
        if (title.includes('chemistry')) return 'Chemistry';
        if (title.includes('zoology')) return 'Zoology';
        if (title.includes('botany')) return 'Botany';
        if (title.includes('psychology')) return 'Psychology';
        if (title.includes('computer application') || title.includes('computer app')) return 'Computer Application';
        if (title.includes('urdu')) return 'Urdu';
        if (title.includes('hindi')) return 'Hindi';
        if (title.includes('english')) return 'English';
        if (title.includes('history')) return 'History';
        if (title.includes('geography')) return 'Geography';
        if (title.includes('economics')) return 'Economics';
        if (title.includes('political science')) return 'Political Science';
        if (title.includes('philosophy')) return 'Philosophy';
        if (title.includes('anthropology')) return 'Anthropology';
        if (title.includes('ho ')) return 'Ho';
        if (title.includes('odia')) return 'Odia';
        if (title.includes('bengali')) return 'Bengali';
        if (title.includes('sociology')) return 'Sociology';
      }
    }
    // Fallback: scan all subject keys
    for (const key in student.subjects) {
      const subObj = student.subjects[key];
      if (subObj && subObj.subject && (key.startsWith('major'))) {
        const title = subObj.subject.toLowerCase();
        if (title.includes('mathematics') || title.includes('math')) return 'Mathematics';
        if (title.includes('physics')) return 'Physics';
        if (title.includes('chemistry')) return 'Chemistry';
        if (title.includes('zoology')) return 'Zoology';
        if (title.includes('botany')) return 'Botany';
        if (title.includes('psychology')) return 'Psychology';
        if (title.includes('computer application') || title.includes('computer app')) return 'Computer Application';
        if (title.includes('urdu')) return 'Urdu';
      }
    }
    return 'General';
  }

  // --- Router: Hash and query state handler ---
  const handleRouting = async () => {
    // Check search queries e.g., ?exam=... or hash parameters e.g., #results?exam=... or #exam=...
    const urlParams = new URLSearchParams(window.location.search);
    let examId = urlParams.get('exam');
    
    if (!examId && window.location.hash) {
      const hashStr = window.location.hash.substring(1);
      // parse parameters from hash if hash contains a question mark e.g., #results?exam=sem4...
      const queryIdx = hashStr.indexOf('?');
      if (queryIdx !== -1) {
        const hashParams = new URLSearchParams(hashStr.substring(queryIdx + 1));
        examId = hashParams.get('exam');
      } else {
        // e.g. #exam=sem4_maths_2022-2026
        const hashParams = new URLSearchParams(hashStr);
        examId = hashParams.get('exam');
      }
    }

    if (examId) {
      // Find metadata from announcements/datasets
      try {
        const resReg = await fetch(`${baseUrl}/data/results.json`);
        const regData = await resReg.json();
        const datasets = regData.datasets || [];
        const dataset = datasets.find(d => d.id === examId);
        
        if (dataset) {
          await loadExamDashboard(dataset);
        } else {
          showHubView();
        }
      } catch (err) {
        console.error("Routing error:", err);
        showHubView();
      }
    } else {
      showHubView();
    }
  };

  const showHubView = () => {
    if (comparisonChart) {
      comparisonChart.destroy();
      comparisonChart = null;
    }
    if (hubView) hubView.style.display = 'block';
    if (dashboardView) dashboardView.style.display = 'none';
  };

  // --- Dashboard Loader ---
  const loadExamDashboard = async (dataset) => {
    currentDatasetMetadata = dataset;
    if (examTitle) examTitle.textContent = dataset.title;
    if (examSubtitle) examSubtitle.textContent = `${dataset.batch} — ${dataset.university} • Declared on ${dataset.date}`;
    
    const examNotice = document.getElementById('dashboard-exam-notice');
    const examNoticeText = document.getElementById('dashboard-exam-notice-text');
    if (examNotice && examNoticeText) {
      if (dataset.notice) {
        examNoticeText.textContent = dataset.notice;
        examNotice.style.display = 'flex';
      } else {
        examNotice.style.display = 'none';
      }
    }

    // Handle Updates Button visibility
    if (updatesBtn && updatesCount) {
      if (dataset.updates && dataset.updates.length > 0) {
        updatesCount.textContent = dataset.updates.length.toString();
        updatesBtn.style.display = 'inline-flex';
      } else {
        updatesBtn.style.display = 'none';
      }
    }
    
    // Reset inputs & output
    if (searchInput) searchInput.value = '';
    if (searchOutput) searchOutput.innerHTML = '';
    if (compareRoll1) compareRoll1.value = '';
    if (compareRoll2) compareRoll2.value = '';
    if (comparisonResultOutput) comparisonResultOutput.innerHTML = '';
    selectedMajor = 'All';

    // Show loading state in lists
    if (leaderboardTableBody) {
      leaderboardTableBody.innerHTML = `<tr><td colspan="4" style="text-align: center; padding: 2rem; color: var(--text-secondary);">Loading leaderboard data...</td></tr>`;
    }
    if (subjectToppersList) {
      subjectToppersList.innerHTML = `<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">Loading toppers...</div>`;
    }

    // Load detailed JSON data
    try {
      const res = await fetch(`${baseUrl}/data/${dataset.file}`);
      currentResultsDataset = await res.json();
      
      // Classify majors for all students
      currentResultsDataset.forEach(s => {
        s.major = getStudentMajor(s);
      });

      // Bind major filter select
      const distinctMajors = [...new Set(currentResultsDataset.map(s => s.major))].filter(m => m !== 'Unknown');
      if (filterContainer && majorSelect && distinctMajors.length > 1) {
        let optHtml = '<option value="All">All Majors</option>';
        distinctMajors.forEach(m => {
          const count = currentResultsDataset.filter(s => s.major === m).length;
          optHtml += `<option value="${m}">${m} Major (${count})</option>`;
        });
        majorSelect.innerHTML = optHtml;
        filterContainer.style.display = 'flex';
      } else if (filterContainer) {
        filterContainer.style.display = 'none';
      }

      // Update dashboard UI elements
      updateDashboardUI();
      
      if (hubView) hubView.style.display = 'none';
      if (dashboardView) dashboardView.style.display = 'flex';
    } catch (err) {
      console.error("Error loading marks dataset: ", err);
      alert("Failed to load results dashboard. Please check your network connection.");
      showHubView();
    }
  };

  const updateDashboardUI = () => {
    // Filter dataset
    const filteredData = selectedMajor === 'All'
      ? currentResultsDataset
      : currentResultsDataset.filter(s => s.major === selectedMajor);

    if (filteredData.length === 0) return;

    // Calculate core statistics
    const totalCount = filteredData.length;
    const passCount = filteredData.filter(s => s.result.toLowerCase() === 'pass').length;
    const passPercent = ((passCount / totalCount) * 100).toFixed(1);
    
    // Sort to find toppers and average
    const sorted = [...filteredData].sort(grandTotalComparator);
    const topStudent = sorted[0];
    const avgScore = (filteredData.reduce((sum, s) => sum + s.grand_total, 0) / totalCount).toFixed(1);

    // Apply values to stats cards
    if (totalStudentsEl) totalStudentsEl.textContent = totalCount.toString();
    if (passPercentEl) passPercentEl.textContent = `${passPercent}%`;
    if (passSubEl) passSubEl.textContent = `${passCount} of ${totalCount} Passed`;
    if (passProgressFill) passProgressFill.style.width = `${passPercent}%`;
    if (topperScoreEl) topperScoreEl.textContent = topStudent?.grand_total.toString() || '0';
    if (topperNameEl) {
      topperNameEl.textContent = topStudent?.student_name || 'N/A';
      topperNameEl.title = topStudent?.student_name || 'N/A';
    }
    if (avgScoreEl) avgScoreEl.textContent = avgScore.toString();

    // Topper card quick search trigger
    const topperCard = document.getElementById('stat-topper-card');
    if (topperCard && topStudent) {
      topperCard.onclick = () => {
        if (searchInput) {
          searchInput.value = topStudent.roll_number;
          performSearch();
          const searchSec = document.getElementById('results-search-section');
          if (searchSec) searchSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };
    }

    // Update Leaderboard sorting selectors
    const subjectKeysMap = {};
    for (const student of filteredData) {
      if (!student.subjects) continue;
      for (const [key, subObj] of Object.entries(student.subjects)) {
        if (!subObj || subObj.subject === undefined) continue;
        subjectKeysMap[key] = cleanSubjectName(subObj.subject);
      }
    }

    if (leaderboardSortSelect) {
      let optHtml = '<option value="grand_total">Grand Total (Overall)</option>';
      for (const [key, cleanName] of Object.entries(subjectKeysMap)) {
        optHtml += `<option value="${key}">${cleanName}</option>`;
      }
      leaderboardSortSelect.innerHTML = optHtml;
      leaderboardSortSelect.value = 'grand_total';
    }

    renderLeaderboard('grand_total');
    renderSubjectToppers(filteredData);
    renderPaperAnalysis(filteredData);
  };

  // --- Leaderboard Rendering ---
  const renderLeaderboard = (sortBy = 'grand_total') => {
    if (!leaderboardTableBody) return;

    const filteredData = selectedMajor === 'All'
      ? currentResultsDataset
      : currentResultsDataset.filter(s => s.major === selectedMajor);

    if (filteredData.length === 0) {
      leaderboardTableBody.innerHTML = `<tr><td colspan="4" style="text-align: center; padding: 2rem; color: var(--text-secondary);">No leaderboard entries match filter.</td></tr>`;
      return;
    }

    let sorted = [];
    if (sortBy === 'grand_total') {
      sorted = [...filteredData].sort(grandTotalComparator);
      if (leaderboardDesc) leaderboardDesc.textContent = "Top 10 students by Grand Total in this semester exam.";
    } else {
      sorted = [...filteredData].sort((a, b) => {
        const t1 = a.subjects[sortBy]?.total ?? 0;
        const t2 = b.subjects[sortBy]?.total ?? 0;
        if (t2 !== t1) {
          return t2 - t1;
        }
        return a.student_name.localeCompare(b.student_name);
      });
      const subName = subjectToppersList?.querySelector(`[data-key="${sortBy}"]`) ? cleanSubjectName(filteredData[0]?.subjects[sortBy]?.subject) : 'Subject';
      if (leaderboardDesc) leaderboardDesc.textContent = `Top 10 students sorted by marks in ${subName}.`;
    }

    const top10 = sorted.slice(0, 10);

    leaderboardTableBody.innerHTML = top10.map((s, idx) => {
      const rank = idx + 1;
      const medal = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : rank;
      const rankClass = rank === 1 ? 'rank-gold' : rank === 2 ? 'rank-silver' : rank === 3 ? 'rank-bronze' : '';
      const score = sortBy === 'grand_total' ? s.grand_total : (s.subjects[sortBy]?.total ?? '-');
      const subLabel = sortBy === 'grand_total' ? '' : `<span style="display: block; font-size: 0.72rem; color: var(--text-secondary); font-weight: 500; margin-top: 2px;">Overall: ${s.grand_total}</span>`;

      return `
        <tr class="leaderboard-row ${rankClass}" data-roll="${s.roll_number}">
          <td style="text-align: center; padding: 0.75rem 0.5rem;">
            <span class="leaderboard-rank">${medal}</span>
          </td>
          <td style="padding: 0.75rem 0.5rem;">
            <div class="leaderboard-student-cell">
              <div class="leaderboard-avatar">${s.student_name.charAt(0)}</div>
              <div class="leaderboard-name-wrapper">
                <span class="leaderboard-name">${s.student_name}</span>
                <span class="leaderboard-roll-sub">${s.roll_number}</span>
              </div>
            </div>
          </td>
          <td style="padding: 0.75rem 0.5rem; font-family: monospace; font-size: 0.85rem; color: var(--text-secondary);">${s.roll_number}</td>
          <td style="padding: 0.75rem 0.5rem; text-align: right;">
            <span class="leaderboard-total">${score}</span>
            ${subLabel}
          </td>
        </tr>
      `;
    }).join('');

    // Bind row click
    leaderboardTableBody.querySelectorAll('.leaderboard-row').forEach(row => {
      row.addEventListener('click', () => {
        const roll = row.getAttribute('data-roll');
        if (searchInput) {
          searchInput.value = roll;
          performSearch();
          const searchSec = document.getElementById('results-search-section');
          if (searchSec) searchSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  };

  // --- Subject Toppers Rendering ---
  const renderSubjectToppers = (filteredData) => {
    if (!subjectToppersList) return;

    const toppersMap = {};
    for (const student of filteredData) {
      if (!student.subjects) continue;
      for (const [key, subObj] of Object.entries(student.subjects)) {
        if (!subObj || subObj.total === null || subObj.total === undefined) continue;
        const score = subObj.total;
        const cleanName = cleanSubjectName(subObj.subject);
        
        if (!toppersMap[key] || score > toppersMap[key].maxScore || (score === toppersMap[key].maxScore && student.student_name.localeCompare(toppersMap[key].student.student_name) < 0)) {
          toppersMap[key] = {
            student,
            maxScore: score,
            subjectName: cleanName
          };
        }
      }
    }

    const toppersList = Object.entries(toppersMap);

    if (toppersList.length === 0) {
      subjectToppersList.innerHTML = `<div style="text-align: center; padding: 2rem; color: var(--text-secondary);">No subject toppers available.</div>`;
      return;
    }

    subjectToppersList.innerHTML = toppersList.map(([key, item]) => `
      <div class="results-topper-compact-row" data-roll="${item.student.roll_number}" data-key="${key}">
        <div class="rtc-medal">🏅</div>
        <div class="rtc-info">
          <span class="rtc-subject">${item.subjectName}</span>
          <span class="rtc-name">${item.student.student_name}</span>
        </div>
        <span class="rtc-score" style="display: inline-block; flex-shrink: 0; min-width: 38px; text-align: center; white-space: nowrap; padding: 0.2rem 0.6rem; border-radius: var(--radius-full); background: rgba(99, 102, 241, 0.12); border: 1px solid rgba(99, 102, 241, 0.3); color: var(--accent-primary); font-weight: 800; font-size: 0.85rem; font-family: monospace;">${item.maxScore}</span>
      </div>
    `).join('');

    // Bind toppers click
    subjectToppersList.querySelectorAll('.results-topper-compact-row').forEach(row => {
      row.addEventListener('click', () => {
        const roll = row.getAttribute('data-roll');
        if (searchInput) {
          searchInput.value = roll;
          performSearch();
          const searchSec = document.getElementById('results-search-section');
          if (searchSec) searchSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  };

  // --- Paper-wise Analysis Rendering ---
  const renderPaperAnalysis = (filteredData) => {
    const container = document.getElementById('paper-analysis-output');
    if (!container) return;

    // Collect stats per subject key
    const subjectStats = {};
    for (const student of filteredData) {
      if (!student.subjects) continue;
      for (const [key, subObj] of Object.entries(student.subjects)) {
        if (!subObj || !subObj.subject || subObj.total === null || subObj.total === undefined) continue;
        if (!subjectStats[key]) {
          subjectStats[key] = {
            name: cleanSubjectName(subObj.subject),
            fullName: subObj.subject,
            scores: [],
            topperName: '',
            topperScore: 0
          };
        }
        const score = Number(subObj.total);
        if (isNaN(score)) continue;
        subjectStats[key].scores.push(score);
        if (score > subjectStats[key].topperScore || (score === subjectStats[key].topperScore && student.student_name.localeCompare(subjectStats[key].topperName) < 0)) {
          subjectStats[key].topperScore = score;
          subjectStats[key].topperName = student.student_name;
        }
      }
    }

    const entries = Object.entries(subjectStats).filter(([_, s]) => s.scores.length > 0);
    if (entries.length === 0) {
      container.innerHTML = '<div style="text-align: center; padding: 2rem; color: var(--text-secondary); grid-column: 1 / -1;">No paper analysis data available.</div>';
      return;
    }

    container.innerHTML = entries.map(([key, stat]) => {
      const scores = stat.scores;
      const count = scores.length;
      const highest = Math.max(...scores);
      const lowest = Math.min(...scores);
      const avg = (scores.reduce((a, b) => a + b, 0) / count).toFixed(1);

      // Grade distribution (approximate based on percentage of max possible)
      // We'll use score ranges relative to the highest score in that paper
      const maxPossible = highest; // Use highest as proxy since we don't have FM per paper
      let gradeA = 0, gradeB = 0, gradeC = 0, gradeD = 0, gradeF = 0;
      for (const s of scores) {
        const pct = (s / Math.max(maxPossible, 1)) * 100;
        if (pct >= 85) gradeA++;
        else if (pct >= 70) gradeB++;
        else if (pct >= 55) gradeC++;
        else if (pct >= 40) gradeD++;
        else gradeF++;
      }
      const passCount = scores.filter(s => s >= (highest * 0.33)).length;
      const passRate = ((passCount / count) * 100).toFixed(0);

      // Color coding for average performance
      const avgPct = (Number(avg) / Math.max(highest, 1)) * 100;
      const avgColor = avgPct >= 70 ? 'var(--accent-success)' : avgPct >= 50 ? 'var(--accent-warning)' : 'var(--accent-error, #ef4444)';

      // Grade bar widths
      const total = count;
      const barA = ((gradeA / total) * 100).toFixed(1);
      const barB = ((gradeB / total) * 100).toFixed(1);
      const barC = ((gradeC / total) * 100).toFixed(1);
      const barD = ((gradeD / total) * 100).toFixed(1);
      const barF = ((gradeF / total) * 100).toFixed(1);

      return `
        <div class="paper-analysis-card">
          <div class="pac-header">
            <span class="pac-title">${stat.name}</span>
            <span class="pac-count">${count} students</span>
          </div>

          <div class="pac-stats-row">
            <div class="pac-stat">
              <span class="pac-stat-label">Highest</span>
              <span class="pac-stat-value" style="color: var(--accent-success);">${highest}</span>
            </div>
            <div class="pac-stat">
              <span class="pac-stat-label">Average</span>
              <span class="pac-stat-value" style="color: ${avgColor};">${avg}</span>
            </div>
            <div class="pac-stat">
              <span class="pac-stat-label">Lowest</span>
              <span class="pac-stat-value" style="color: var(--accent-error, #ef4444);">${lowest}</span>
            </div>
          </div>

          <div class="pac-topper-row">
            <span>🏆</span>
            <span class="pac-topper-name">${stat.topperName}</span>
            <span class="pac-topper-score">${stat.topperScore}</span>
          </div>

          <div class="pac-grade-section">
            <div class="pac-grade-label-row">
              <span>Grade Distribution</span>
            </div>
            <div class="pac-grade-bar">
              ${gradeA > 0 ? `<div class="pac-grade-seg pac-grade-a" style="width: ${barA}%" title="85-100%: ${gradeA} students"></div>` : ''}
              ${gradeB > 0 ? `<div class="pac-grade-seg pac-grade-b" style="width: ${barB}%" title="70-84%: ${gradeB} students"></div>` : ''}
              ${gradeC > 0 ? `<div class="pac-grade-seg pac-grade-c" style="width: ${barC}%" title="55-69%: ${gradeC} students"></div>` : ''}
              ${gradeD > 0 ? `<div class="pac-grade-seg pac-grade-d" style="width: ${barD}%" title="40-54%: ${gradeD} students"></div>` : ''}
              ${gradeF > 0 ? `<div class="pac-grade-seg pac-grade-f" style="width: ${barF}%" title="Below 40%: ${gradeF} students"></div>` : ''}
            </div>
            <div class="pac-grade-legend">
              <span class="pac-legend-item"><span class="pac-legend-dot pac-grade-a"></span>A+ (${gradeA})</span>
              <span class="pac-legend-item"><span class="pac-legend-dot pac-grade-b"></span>B (${gradeB})</span>
              <span class="pac-legend-item"><span class="pac-legend-dot pac-grade-c"></span>C (${gradeC})</span>
              <span class="pac-legend-item"><span class="pac-legend-dot pac-grade-d"></span>D (${gradeD})</span>
              <span class="pac-legend-item"><span class="pac-legend-dot pac-grade-f"></span>F (${gradeF})</span>
            </div>
          </div>
        </div>
      `;
    }).join('');
  };

  // --- Search Results ---
  const performSearch = () => {
    if (!searchInput || !searchOutput) return;
    const query = searchInput.value.toLowerCase().trim();

    if (!query) {
      alert("Please enter a roll number or name to search.");
      return;
    }

    // Resolve query
    const student = currentResultsDataset.find(s => 
      s.roll_number === query || 
      s.student_name.toLowerCase() === query ||
      s.student_name.toLowerCase().includes(query)
    );

    if (!student) {
      searchOutput.innerHTML = `
        <div class="results-error-card animated-slide-up">
          <div class="results-error-icon">⚠️</div>
          <h4>Student Not Found</h4>
          <p>No student matching <strong>"${query}"</strong> was found. Please check the spelling or roll number.</p>
        </div>
      `;
      return;
    }

    renderStudentCard(searchOutput, student);
  };

  const renderStudentCard = (container, student) => {
    const sorted = [...currentResultsDataset].sort(grandTotalComparator);
    const rank = sorted.findIndex(s => s.roll_number === student.roll_number) + 1;
    const isPass = student.result.toLowerCase() === 'pass';
    const statusClass = isPass ? 'pass' : 'promoted';

    let desktopRows = '';
    let mobileRows = '';

    for (const [key, sub] of Object.entries(student.subjects)) {
      const theory = sub.theory !== null && sub.theory !== undefined ? sub.theory : '-';
      const internal = sub.internal !== null && sub.internal !== undefined ? sub.internal : '-';
      const practical = sub.practical !== null && sub.practical !== undefined ? sub.practical : '-';
      const total = sub.total !== null && sub.total !== undefined ? sub.total : '-';
      const subName = cleanSubjectName(sub.subject);

      desktopRows += `
        <tr class="hover:bg-tertiary">
          <td class="subject-name-cell" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); font-weight: 600;">${subName}</td>
          <td class="mark-cell" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); text-align: center; font-family: monospace;">${theory}</td>
          <td class="mark-cell" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); text-align: center; font-family: monospace;">${internal}</td>
          <td class="mark-cell" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); text-align: center; font-family: monospace;">${practical}</td>
          <td class="mark-cell mark-total" style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border-color); text-align: center; font-weight: 700; font-family: monospace;">${total}</td>
        </tr>
      `;

      mobileRows += `
        <div class="results-mobile-mark-row">
          <div class="res-mob-subject-title">${subName}</div>
          <div class="res-mob-marks-grid">
            <div class="res-mob-mark-item">
              <span class="label">Theory</span>
              <span class="value">${theory}</span>
            </div>
            <div class="res-mob-mark-item">
              <span class="label">Internal</span>
              <span class="value">${internal}</span>
            </div>
            <div class="res-mob-mark-item">
              <span class="label">Practical</span>
              <span class="value">${practical}</span>
            </div>
            <div class="res-mob-mark-item highlight">
              <span class="label">Total</span>
              <span class="value">${total}</span>
            </div>
          </div>
        </div>
      `;
    }

    container.innerHTML = `
      <div class="results-student-card animated-slide-up">
        <div class="results-student-header">
          <div class="results-student-avatar">${student.student_name.charAt(0)}</div>
          <div class="results-student-info">
            <h3 class="results-student-name">${student.student_name}</h3>
            <div class="results-student-meta">
              <span>🆔 Roll: ${student.roll_number}</span>
              <span>📈 Rank: #${rank} of ${currentResultsDataset.length}</span>
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
            <div class="results-student-status ${statusClass}">
              <span>${isPass ? '✓' : '⚠'} ${student.result}</span>
            </div>
            ${currentDatasetMetadata && currentDatasetMetadata.hasImages ? `
              <a href="${baseUrl}/images/results/${currentDatasetMetadata.imageFolder}/${student.roll_number}.png" 
                 download="${student.student_name.replace(/\s+/g, '_')}_Result.png" 
                 class="btn btn-primary btn-sm" 
                 style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; flex-shrink: 0; white-space: nowrap; height: 32px;"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                <span>Download Marksheet</span>
              </a>
            ` : ''}
            ${currentDatasetMetadata && currentDatasetMetadata.hasPdfs ? `
              <a href="${baseUrl}/pdfs/results/${currentDatasetMetadata.pdfFolder}/${student.roll_number}.pdf" 
                 download="${student.student_name.replace(/\s+/g, '_')}_Result.pdf" 
                 class="btn btn-success btn-sm" 
                 style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; flex-shrink: 0; white-space: nowrap; height: 32px; background-color: var(--accent-success); border-color: var(--accent-success);"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                <span>Download PDF</span>
              </a>
            ` : ''}
            ${student.sgpa !== undefined && student.sgpa !== null ? `
              <button 
                class="btn btn-sm result-summary-btn" 
                style="display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 700; flex-shrink: 0; white-space: nowrap; height: 32px; background: linear-gradient(135deg, #6366f1, #8b5cf6); border: none; color: white; cursor: pointer;"
                data-roll="${student.roll_number}"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                <span>Result Summary</span>
              </button>
            ` : ''}
          </div>
        </div>

        <div class="results-student-stats">
          <div class="results-stat-pill">
            <span class="results-stat-label">Grand Total</span>
            <span class="results-stat-value" style="font-family: monospace;">${student.grand_total}</span>
          </div>
          <div class="results-stat-pill">
            <span class="results-stat-label">Subjects</span>
            <span class="results-stat-value">${Object.keys(student.subjects).length}</span>
          </div>
          <div class="results-stat-pill">
            <span class="results-stat-label">Batch Rank</span>
            <span class="results-stat-value">#${rank}</span>
          </div>
        </div>

        <!-- Desktop View Table -->
        <div class="desktop-marks-view" style="overflow-x: auto;">
          <table class="results-marks-table">
            <thead>
              <tr>
                <th>Subject</th>
                <th style="text-align: center;">Theory</th>
                <th style="text-align: center;">Internal</th>
                <th style="text-align: center;">Practical</th>
                <th style="text-align: center;">Total</th>
              </tr>
            </thead>
            <tbody>
              ${desktopRows}
            </tbody>
            <tfoot>
              <tr style="border-top: 2px solid var(--border-color); background-color: var(--bg-tertiary);">
                <td style="padding: 0.75rem 1rem; font-weight: 800; color: var(--text-primary);">Grand Total</td>
                <td></td>
                <td></td>
                <td></td>
                <td style="padding: 0.75rem 1rem; text-align: center; font-weight: 800; color: var(--accent-primary); font-family: monospace; font-size: 1.15rem;">${student.grand_total}</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- Mobile View Stacked Cards -->
        <div class="mobile-marks-view results-mobile-marks-list">
          ${mobileRows}
          <div class="results-mobile-mark-row" style="background: rgba(99, 102, 241, 0.05); border-color: rgba(99, 102, 241, 0.25);">
            <div style="display: flex; justify-content: space-between; align-items: center; font-weight: 800;">
              <span style="font-size: 0.95rem;">Grand Total</span>
              <span style="font-size: 1.2rem; color: var(--accent-primary); font-family: monospace;">${student.grand_total}</span>
            </div>
          </div>
        </div>
      </div>
    `;

    // Bind "Result Summary" button click
    container.querySelectorAll('.result-summary-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const roll = btn.getAttribute('data-roll');
        const s = currentResultsDataset.find(st => st.roll_number === roll);
        if (s) openResultSummary(s);
      });
    });
  };

  // --- Result Summary Popup (Print-friendly) ---
  const openResultSummary = (student) => {
    // Build subject rows
    let subjectRows = '';
    for (const [key, sub] of Object.entries(student.subjects)) {
      const theory = sub.theory !== null && sub.theory !== undefined ? sub.theory : '-';
      const internal = sub.internal !== null && sub.internal !== undefined ? sub.internal : '-';
      const practical = sub.practical !== null && sub.practical !== undefined ? sub.practical : '-';
      const total = sub.total !== null && sub.total !== undefined ? sub.total : '-';
      subjectRows += `
        <tr>
          <td style="text-align:left;font-weight:600;padding:10px 12px;border:1px solid #e5e7eb;">${sub.subject || 'N/A'}</td>
          <td style="text-align:center;padding:10px 12px;border:1px solid #e5e7eb;">${theory}</td>
          <td style="text-align:center;padding:10px 12px;border:1px solid #e5e7eb;">${internal}</td>
          <td style="text-align:center;padding:10px 12px;border:1px solid #e5e7eb;">${practical}</td>
          <td style="text-align:center;font-weight:bold;padding:10px 12px;border:1px solid #e5e7eb;">${total}</td>
        </tr>`;
    }

    const isPass = student.result && student.result.toLowerCase() === 'pass';
    const resultColor = isPass ? '#059669' : '#d97706';

    const html = `<!DOCTYPE html>
<html><head>
<meta charset="UTF-8">
<title>Result Summary - ${student.student_name}</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;background:#f3f4f6;color:#333;padding:20px;display:flex;flex-direction:column;align-items:center}
  .card{width:850px;max-width:100%;background:#fff;border:1px solid #e5e7eb;border-radius:8px;overflow:hidden;box-shadow:0 4px 6px -1px rgba(0,0,0,.1)}
  .warn{background:#fef2f2;border-bottom:1px solid #f87171;padding:15px 20px;text-align:center}
  .warn-title{color:#dc2626;font-size:16px;font-weight:bold;margin-bottom:5px}
  .warn-text{color:#991b1b;font-size:13px}
  .content{padding:30px 40px}
  .sec-title{font-size:14px;font-weight:700;color:#4b5563;margin-bottom:15px;text-transform:uppercase;letter-spacing:.5px;border-bottom:2px solid #e5e7eb;padding-bottom:5px}
  .info-table{width:100%;border-collapse:collapse;font-size:14px;margin-bottom:30px}
  .info-table td{padding:8px 0}
  .info-label{width:180px;color:#6b7280;font-weight:600}
  .info-value{font-weight:700;color:#111827}
  .marks-table{width:100%;border-collapse:collapse;font-size:13px;margin-bottom:30px}
  .marks-table th{background:#f9fafb;color:#4b5563;font-weight:600;text-transform:uppercase;font-size:12px;padding:10px 12px;border:1px solid #e5e7eb;text-align:center}
  .result-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:20px;display:flex;flex-wrap:wrap;gap:20px;justify-content:space-between;align-items:center}
  .stat{display:flex;flex-direction:column;gap:4px}
  .stat-label{font-size:12px;color:#64748b;font-weight:600;text-transform:uppercase}
  .stat-val{font-size:18px;font-weight:700;color:#0f172a}
  .action-bar{margin-bottom:20px}
  .btn{padding:10px 24px;font-size:14px;font-weight:bold;color:#fff;background:#3b82f6;border:none;border-radius:6px;cursor:pointer}
  .btn:hover{background:#2563eb}
  @media print{body{background:none;padding:0}.action-bar{display:none}.card{box-shadow:none;border:none;width:100%}}
</style>
</head><body>
<div class="action-bar"><button class="btn" onclick="window.print()">🖨️ Save as PDF</button></div>
<div class="card">
  <div class="warn">
    <div class="warn-title">⚠ INFORMATIONAL RESULT SUMMARY</div>
    <div class="warn-text">For reference only. Not for official use. For official marksheets, please visit kuuniv.in</div>
  </div>
  <div class="content">
    <div class="sec-title">Student Details</div>
    <table class="info-table">
      <tr><td class="info-label">Name of Student</td><td class="info-value">${student.student_name}</td></tr>
      <tr><td class="info-label">Father's Name</td><td class="info-value">${student.father_name || 'N/A'}</td></tr>
      <tr><td class="info-label">Roll Number</td><td class="info-value">${student.roll_number}</td></tr>
      <tr><td class="info-label">Registration No / Year</td><td class="info-value">${student.reg_no || 'N/A'} / ${student.reg_year || 'N/A'}</td></tr>
      <tr><td class="info-label">College Name</td><td class="info-value">${student.college_name || 'Tata College, Chaibasa'}</td></tr>
    </table>
    <div class="sec-title">Marks Obtained (FYUGP Semester-III Exam ${student.year_of_exam || '2024'})</div>
    <table class="marks-table">
      <thead><tr>
        <th style="width:50%;text-align:left;padding-left:12px">Subject</th>
        <th style="width:12.5%">Theory</th>
        <th style="width:12.5%">Internal</th>
        <th style="width:12.5%">Practical</th>
        <th style="width:12.5%">Total</th>
      </tr></thead>
      <tbody>${subjectRows}</tbody>
    </table>
    <div class="result-box">
      <div class="stat"><span class="stat-label">Grand Total</span><span class="stat-val">${student.grand_total} / ${student.full_marks || 500}</span></div>
      <div class="stat"><span class="stat-label">Result</span><span class="stat-val" style="color:${resultColor}">${student.result}</span></div>
      <div class="stat"><span class="stat-label">SGPA</span><span class="stat-val">${student.sgpa || 'N/A'}</span></div>
      <div class="stat"><span class="stat-label">Grade</span><span class="stat-val">${student.grade || 'N/A'}</span></div>
      <div class="stat"><span class="stat-label">Credit</span><span class="stat-val">${student.credits || 'N/A'}</span></div>
    </div>
  </div>
</div>
</body></html>`;

    const popup = window.open('', '_blank', 'width=900,height=700');
    if (popup) {
      popup.document.write(html);
      popup.document.close();
    } else {
      alert('Please allow popups for this site to download the result summary.');
    }
  };

  // --- Compare Logic ---
  const performComparison = () => {
    if (!compareRoll1 || !compareRoll2 || !comparisonResultOutput) return;
    const r1 = compareRoll1.value.trim().toLowerCase();
    const r2 = compareRoll2.value.trim().toLowerCase();

    if (!r1 || !r2) {
      alert("Please enter both roll numbers or names to compare.");
      return;
    }

    if (r1 === r2) {
      alert("Please enter two different students to compare.");
      return;
    }

    const s1 = currentResultsDataset.find(s => s.roll_number === r1 || s.student_name.toLowerCase().includes(r1));
    const s2 = currentResultsDataset.find(s => s.roll_number === r2 || s.student_name.toLowerCase().includes(r2));

    const errors = [];
    if (!s1) errors.push(r1);
    if (!s2) errors.push(r2);

    if (errors.length > 0) {
      comparisonResultOutput.innerHTML = `
        <div class="results-error-card animated-slide-up">
          <div class="results-error-icon">⚠️</div>
          <h4>Student Not Found</h4>
          <p>No student matching <strong>"${errors.join('" or "')}"</strong> was found. Please check spelling or roll number.</p>
        </div>
      `;
      return;
    }

    renderComparison(s1, s2);
  };

  const renderComparison = (s1, s2) => {
    if (!comparisonResultOutput) return;

    const sorted = [...currentResultsDataset].sort(grandTotalComparator);
    const rank1 = sorted.findIndex(s => s.roll_number === s1.roll_number) + 1;
    const rank2 = sorted.findIndex(s => s.roll_number === s2.roll_number) + 1;

    const s1Wins = s1.grand_total > s2.grand_total;
    const tie = s1.grand_total === s2.grand_total;

    const keys = Object.keys(s1.subjects);
    let rows = '';

    for (const key of keys) {
      const sub1 = s1.subjects[key];
      const sub2 = s2.subjects[key];
      if (!sub1 || !sub2) continue;

      const t1 = sub1.total ?? 0;
      const t2 = sub2.total ?? 0;
      const class1 = t1 > t2 ? 'compare-winner' : t1 < t2 ? 'compare-loser' : '';
      const class2 = t2 > t1 ? 'compare-winner' : t2 < t1 ? 'compare-loser' : '';
      const displaySubName = cleanSubjectName(sub1.subject);

      rows += `
        <tr style="border-bottom: 1px solid var(--border-color);">
          <td class="mark-cell ${class1}" style="padding: 0.75rem; font-family: monospace;">${t1}</td>
          <td class="subject-name-cell compare-subject-center" style="padding: 0.75rem; font-weight: 600;">${displaySubName}</td>
          <td class="mark-cell ${class2}" style="padding: 0.75rem; font-family: monospace;">${t2}</td>
        </tr>
      `;
    }

    comparisonResultOutput.innerHTML = `
      <div class="results-compare-output animated-slide-up" style="display: flex; flex-direction: column; gap: 1.5rem;">
        <div class="compare-cards-row">
          <!-- Card 1 -->
          <div class="compare-student-card ${s1Wins && !tie ? 'compare-winner-card' : ''}">
            ${s1Wins && !tie ? '<div class="compare-crown">👑</div>' : ''}
            <div class="compare-avatar">${s1.student_name.charAt(0)}</div>
            <h4>${s1.student_name}</h4>
            <p class="compare-roll">${s1.roll_number}</p>
            <div class="compare-card-stats">
              <div class="compare-stat">
                <span class="compare-stat-num" style="font-family: monospace;">${s1.grand_total}</span>
                <span class="compare-stat-label">Total</span>
              </div>
              <div class="compare-stat">
                <span class="compare-stat-num">#${rank1}</span>
                <span class="compare-stat-label">Rank</span>
              </div>
              <div class="compare-stat">
                <span class="compare-stat-num result-status-${s1.result.toLowerCase()}">${s1.result}</span>
                <span class="compare-stat-label">Status</span>
              </div>
            </div>
          </div>

          <div class="compare-vs-divider">
            <span style="font-weight: 800; color: var(--text-tertiary); background-color: var(--bg-tertiary); padding: 0.35rem 0.75rem; border-radius: var(--radius-full);">VS</span>
          </div>

          <!-- Card 2 -->
          <div class="compare-student-card ${!s1Wins && !tie ? 'compare-winner-card' : ''}">
            ${!s1Wins && !tie ? '<div class="compare-crown">👑</div>' : ''}
            <div class="compare-avatar">${s2.student_name.charAt(0)}</div>
            <h4>${s2.student_name}</h4>
            <p class="compare-roll">${s2.roll_number}</p>
            <div class="compare-card-stats">
              <div class="compare-stat">
                <span class="compare-stat-num" style="font-family: monospace;">${s2.grand_total}</span>
                <span class="compare-stat-label">Total</span>
              </div>
              <div class="compare-stat">
                <span class="compare-stat-num">#${rank2}</span>
                <span class="compare-stat-label">Rank</span>
              </div>
              <div class="compare-stat">
                <span class="compare-stat-num result-status-${s2.result.toLowerCase()}">${s2.result}</span>
                <span class="compare-stat-label">Status</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Comparison Table -->
        <div class="card" style="padding: 0; overflow-x: auto;">
          <table class="results-marks-table compare-table" style="min-width: 100%;">
            <thead>
              <tr style="background-color: var(--bg-tertiary); border-bottom: 1px solid var(--border-color);">
                <th style="padding: 0.75rem; text-align: center;">${s1.student_name.split(' ')[0]}</th>
                <th style="padding: 0.75rem; text-align: center;">Subject</th>
                <th style="padding: 0.75rem; text-align: center;">${s2.student_name.split(' ')[0]}</th>
              </tr>
            </thead>
            <tbody>
              ${rows}
            </tbody>
            <tfoot>
              <tr style="background-color: var(--bg-tertiary); border-top: 2px solid var(--border-color);">
                <td class="mark-cell mark-grand ${s1Wins && !tie ? 'compare-winner' : ''}" style="padding: 0.75rem; font-family: monospace; font-size: 1.1rem; text-align: center;">${s1.grand_total}</td>
                <td class="subject-name-cell compare-subject-center" style="padding: 0.75rem; font-weight: 800; text-align: center;">Grand Total</td>
                <td class="mark-cell mark-grand ${!s1Wins && !tie ? 'compare-winner' : ''}" style="padding: 0.75rem; font-family: monospace; font-size: 1.1rem; text-align: center;">${s2.grand_total}</td>
              </tr>
            </tfoot>
          </table>
        </div>

        <!-- Radar Chart Card -->
        <div class="compare-radar-wrapper">
          <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; color: var(--text-primary);">
            📊 Subject-wise Radar Comparison
          </h4>
          <div class="compare-radar-canvas-container">
            <canvas id="compare-radar-chart"></canvas>
          </div>
        </div>
      </div>
    `;

    renderRadarChart(s1, s2, keys);
  };

  const renderRadarChart = (s1, s2, keys) => {
    const canvas = document.getElementById('compare-radar-chart') as HTMLCanvasElement;
    if (!canvas) return;

    if (comparisonChart) {
      comparisonChart.destroy();
    }

    const labels = keys.map(key => cleanSubjectName(s1.subjects[key]?.subject || s2.subjects[key]?.subject || key));
    const data1 = keys.map(key => s1.subjects[key]?.total ?? 0);
    const data2 = keys.map(key => s2.subjects[key]?.total ?? 0);

    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const gridColor = isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(0, 0, 0, 0.08)';
    const labelColor = isDark ? '#94a3b8' : '#475569';

    comparisonChart = new Chart(canvas, {
      type: 'radar',
      data: {
        labels,
        datasets: [
          {
            label: s1.student_name,
            data: data1,
            borderColor: '#6366f1',
            backgroundColor: 'rgba(99, 102, 241, 0.15)',
            borderWidth: 2,
            pointBackgroundColor: '#6366f1',
            pointRadius: 4,
          },
          {
            label: s2.student_name,
            data: data2,
            borderColor: '#f59e0b',
            backgroundColor: 'rgba(245, 158, 11, 0.15)',
            borderWidth: 2,
            pointBackgroundColor: '#f59e0b',
            pointRadius: 4,
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          r: {
            beginAtZero: true,
            grid: { color: gridColor },
            angleLines: { color: gridColor },
            ticks: { color: labelColor, backdropColor: 'transparent', font: { size: 9 } },
            pointLabels: { color: labelColor, font: { size: 9, weight: '600' } }
          }
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: { color: labelColor, font: { size: 11, weight: '600' }, usePointStyle: true, pointStyle: 'circle' }
          }
        }
      }
    });
  };

  // --- Browse All Modal ---
  // --- Browse All Modal ---
  const openBrowseAllModal = () => {
    if (!browseModal || !browseModalTableBody) return;

    // Filter and rank data
    const filteredData = selectedMajor === 'All'
      ? currentResultsDataset
      : currentResultsDataset.filter(s => s.major === selectedMajor);

    // Baseline rankings list (always sorted by marks high to low to compute Rank)
    const baselineRanked = [...filteredData].sort(grandTotalComparator);

    let activeSort = 'rank';
    let searchQuery = '';

    const sortAndRender = () => {
      // 1. Filter by search query first
      let list = [...baselineRanked];
      if (searchQuery) {
        list = list.filter(s => 
          s.student_name.toLowerCase().includes(searchQuery) || 
          s.roll_number.includes(searchQuery)
        );
      }

      // 2. Sort the filtered list
      if (activeSort === 'rank') {
        list.sort(grandTotalComparator);
      } else if (activeSort === 'rank-asc') {
        list.sort((a, b) => {
          if (a.grand_total !== b.grand_total) {
            return a.grand_total - b.grand_total;
          }
          return a.student_name.localeCompare(b.student_name);
        });
      } else if (activeSort === 'name-asc') {
        list.sort((a, b) => a.student_name.localeCompare(b.student_name));
      } else if (activeSort === 'name-desc') {
        list.sort((a, b) => b.student_name.localeCompare(a.student_name));
      }

      if (list.length === 0) {
        browseModalTableBody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 2rem; color: var(--text-secondary);">No matching student results found.</td></tr>`;
        return;
      }

      browseModalTableBody.innerHTML = list.map(s => {
        const rank = baselineRanked.findIndex(item => item.roll_number === s.roll_number) + 1;
        const medal = rank === 1 ? '🥇' : rank === 2 ? '🥈' : rank === 3 ? '🥉' : `#${rank}`;
        const isPass = s.result.toLowerCase() === 'pass';

        return `
          <tr class="browse-results-row" data-roll="${s.roll_number}" style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 0.75rem 0.5rem; text-align: center; font-weight: 800;">${medal}</td>
            <td style="padding: 0.75rem 0.5rem; font-weight: 600; color: var(--text-primary);">
              ${s.student_name}
              <span style="display: block; font-size: 0.7rem; color: var(--text-secondary); font-weight: 500; margin-top: 2px;">Major: ${s.major}</span>
            </td>
            <td style="padding: 0.75rem 0.5rem; font-family: monospace; font-size: 0.8rem; color: var(--text-secondary);">${s.roll_number}</td>
            <td style="padding: 0.75rem 0.5rem; text-align: right; font-weight: 700; color: var(--accent-primary); font-family: monospace;">${s.grand_total}</td>
            <td style="padding: 0.75rem 0.5rem; text-align: center;">
              <span class="badge ${isPass ? 'badge-success' : 'badge-warning'}" style="font-size: 0.7rem;">${s.result}</span>
            </td>
          </tr>
        `;
      }).join('');

      bindClicks();
    };

    // Bind click events on rows
    const bindClicks = () => {
      browseModalTableBody.querySelectorAll('.browse-results-row').forEach(row => {
        row.addEventListener('click', () => {
          const roll = row.getAttribute('data-roll');
          if (searchInput) {
            searchInput.value = roll;
            browseModal.classList.remove('open');
            performSearch();
            const searchSec = document.getElementById('results-search-section');
            if (searchSec) searchSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    };

    // Reset selectors
    const sortSelect = document.getElementById('modal-browse-sort') as HTMLSelectElement;
    if (sortSelect) sortSelect.value = 'rank';

    // Initial render
    sortAndRender();
    browseModal.classList.add('open');

    // Bind search handler
    if (modalBrowseSearch) {
      modalBrowseSearch.value = '';
      modalBrowseSearch.oninput = (e) => {
        searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
        sortAndRender();
      };
    }

    // Bind sort handler
    if (sortSelect) {
      sortSelect.onchange = (e) => {
        activeSort = (e.target as HTMLSelectElement).value;
        sortAndRender();
      };
    }
  };

  // --- Updates Modal ---
  const openUpdatesModal = () => {
    if (!updatesModal || !updatesList || !currentDatasetMetadata) return;

    const updates = currentDatasetMetadata.updates || [];
    if (updates.length === 0) return;

    updatesList.innerHTML = updates.map(up => `
      <div style="display: flex; gap: 0.75rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; align-items: flex-start;">
        <span style="background: linear-gradient(135deg, var(--accent-primary) 0%, #8b5cf6 100%); color: white; border-radius: var(--radius-xs); padding: 0.25rem 0.5rem; font-size: 0.75rem; font-weight: 800; font-family: var(--font-display); height: fit-content; align-self: flex-start; flex-shrink: 0; line-height: 1;">v${up.version}</span>
        <div style="display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;">
          <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary); line-height: 1.2; font-family: var(--font-display);">${up.title}</h4>
          <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.45; margin: 0;">${up.desc}</p>
        </div>
      </div>
    `).join('');

    // Remove border-bottom from last item
    const lastChild = updatesList.lastElementChild;
    if (lastChild) {
      (lastChild as HTMLElement).style.borderBottom = 'none';
      (lastChild as HTMLElement).style.paddingBottom = '0';
    }

    updatesModal.classList.add('open');
  };

  // --- Auto-complete suggestions ---
  const handleSearchAutocomplete = (e) => {
    const val = e.target.value.toLowerCase().trim();
    if (!searchSuggestions) return;

    if (val.length < 1) {
      searchSuggestions.style.display = 'none';
      return;
    }

    const matches = currentResultsDataset.filter(s => {
      const matchesMajor = selectedMajor === 'All' || s.major === selectedMajor;
      const matchesQuery = s.roll_number.includes(val) || s.student_name.toLowerCase().includes(val);
      return matchesMajor && matchesQuery;
    }).slice(0, 6);

    if (matches.length === 0) {
      searchSuggestions.style.display = 'none';
      return;
    }

    searchSuggestions.innerHTML = matches.map(s => `
      <div class="results-suggestion-item" data-roll="${s.roll_number}">
        <span class="suggestion-name">${s.student_name}</span>
        <span class="suggestion-roll">${s.roll_number}</span>
      </div>
    `).join('');

    searchSuggestions.style.display = 'block';

    searchSuggestions.querySelectorAll('.results-suggestion-item').forEach(item => {
      item.addEventListener('click', () => {
        const roll = item.getAttribute('data-roll');
        if (searchInput) searchInput.value = roll;
        searchSuggestions.style.display = 'none';
        performSearch();
      });
    });
  };

  // --- Compare Auto-complete ---
  const handleCompareAutocomplete = (inputEl, suggestionsEl) => {
    if (!inputEl || !suggestionsEl) return;

    inputEl.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.toLowerCase().trim();

      if (val.length < 1) {
        suggestionsEl.style.display = 'none';
        return;
      }

      const matches = currentResultsDataset.filter(s => {
        const matchesMajor = selectedMajor === 'All' || s.major === selectedMajor;
        const matchesQuery = s.roll_number.includes(val) || s.student_name.toLowerCase().includes(val);
        return matchesMajor && matchesQuery;
      }).slice(0, 6);

      if (matches.length === 0) {
        suggestionsEl.style.display = 'none';
        return;
      }

      suggestionsEl.innerHTML = matches.map(s => `
        <div class="results-suggestion-item" data-roll="${s.roll_number}">
          <span class="suggestion-name">${s.student_name}</span>
          <span class="suggestion-roll">${s.roll_number}</span>
        </div>
      `).join('');

      suggestionsEl.style.display = 'block';

      suggestionsEl.querySelectorAll('.results-suggestion-item').forEach(item => {
        item.addEventListener('click', () => {
          inputEl.value = item.getAttribute('data-roll');
          suggestionsEl.style.display = 'none';
        });
      });
    });
  };

  // --- Initialization & Event Listeners ---
  const init = () => {
    // Re-query DOM Elements for view transitions compatibility
    hubView = document.getElementById('results-hub-view');
    dashboardView = document.getElementById('results-dashboard-view');
    backBtn = document.getElementById('dashboard-back-btn');
    examCards = document.querySelectorAll('.results-card-select');

    examTitle = document.getElementById('dashboard-exam-title');
    examSubtitle = document.getElementById('dashboard-exam-subtitle');
    filterContainer = document.getElementById('dashboard-filter-container');
    majorSelect = document.getElementById('dashboard-major-select') as HTMLSelectElement;

    totalStudentsEl = document.getElementById('stat-total-students');
    passPercentEl = document.getElementById('stat-pass-percent');
    passSubEl = document.getElementById('stat-pass-sub');
    passProgressFill = document.getElementById('stat-pass-progress');
    topperScoreEl = document.getElementById('stat-topper-score');
    topperNameEl = document.getElementById('stat-topper-name');
    avgScoreEl = document.getElementById('stat-avg-score');

    searchInput = document.getElementById('result-search-input') as HTMLInputElement;
    searchBtn = document.getElementById('result-search-btn');
    searchSuggestions = document.getElementById('results-search-suggestions');
    searchOutput = document.getElementById('student-result-output');
    browseAllBtn = document.getElementById('result-browse-all-btn');

    leaderboardSortSelect = document.getElementById('leaderboard-sort-select') as HTMLSelectElement;
    leaderboardTableBody = document.getElementById('leaderboard-table-body');
    leaderboardDesc = document.getElementById('leaderboard-desc');

    subjectToppersList = document.getElementById('subject-toppers-list');

    compareBtn = document.getElementById('compare-btn');
    compareRoll1 = document.getElementById('compare-roll-1') as HTMLInputElement;
    compareRoll2 = document.getElementById('compare-roll-2') as HTMLInputElement;
    compareSuggestions1 = document.getElementById('compare-suggestions-1');
    compareSuggestions2 = document.getElementById('compare-suggestions-2');
    comparisonResultOutput = document.getElementById('comparison-result-output');

    browseModal = document.getElementById('browse-all-modal');
    closeBrowseModalBtn = document.getElementById('close-browse-modal-btn');
    modalBrowseSearch = document.getElementById('modal-browse-search') as HTMLInputElement;
    browseModalTableBody = document.getElementById('browse-modal-table-body');

    updatesModal = document.getElementById('updates-modal');
    closeUpdatesModalBtn = document.getElementById('close-updates-modal-btn');
    closeUpdatesModalDoneBtn = document.getElementById('close-updates-modal-done-btn');
    updatesList = document.getElementById('updates-list');
    updatesBtn = document.getElementById('dashboard-updates-btn');
    updatesCount = document.getElementById('updates-count');

    // 1. Exam cards open dashboard click handlers
    examCards.forEach(card => {
      card.addEventListener('click', () => {
        const examId = card.getAttribute('data-exam');
        window.location.hash = `#results?exam=${examId}`;
      });
    });

    // 2. Back to Selection Hub button click
    backBtn?.addEventListener('click', () => {
      window.location.hash = '#results';
    });

    // 3. Search triggers
    searchBtn?.addEventListener('click', performSearch);
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        if (searchSuggestions) searchSuggestions.style.display = 'none';
        performSearch();
      }
    });
    searchInput?.addEventListener('input', handleSearchAutocomplete);

    // 4. Modal Triggers
    browseAllBtn?.addEventListener('click', openBrowseAllModal);
    closeBrowseModalBtn?.addEventListener('click', () => {
      browseModal?.classList.remove('open');
    });
    browseModal?.addEventListener('click', (e) => {
      if (e.target === browseModal) browseModal.classList.remove('open');
    });

    updatesBtn?.addEventListener('click', openUpdatesModal);
    closeUpdatesModalBtn?.addEventListener('click', () => {
      updatesModal?.classList.remove('open');
    });
    closeUpdatesModalDoneBtn?.addEventListener('click', () => {
      updatesModal?.classList.remove('open');
    });
    updatesModal?.addEventListener('click', (e) => {
      if (e.target === updatesModal) updatesModal.classList.remove('open');
    });

    // 5. Compare triggers
    compareBtn?.addEventListener('click', performComparison);
    handleCompareAutocomplete(compareRoll1, compareSuggestions1);
    handleCompareAutocomplete(compareRoll2, compareSuggestions2);

    // Dismiss autocompletes when clicking outside (registered once globally, queries dynamically)
    if (!(window as any).__click_outside_bound) {
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const activeSearchInput = document.getElementById('result-search-input');
        const activeSearchSuggestions = document.getElementById('results-search-suggestions');
        const activeCompareRoll1 = document.getElementById('compare-roll-1');
        const activeCompareSuggestions1 = document.getElementById('compare-suggestions-1');
        const activeCompareRoll2 = document.getElementById('compare-roll-2');
        const activeCompareSuggestions2 = document.getElementById('compare-suggestions-2');

        if (activeSearchInput && activeSearchSuggestions && !activeSearchInput.contains(target) && !activeSearchSuggestions.contains(target)) {
          activeSearchSuggestions.style.display = 'none';
        }
        if (activeCompareRoll1 && activeCompareSuggestions1 && !activeCompareRoll1.contains(target) && !activeCompareSuggestions1.contains(target)) {
          activeCompareSuggestions1.style.display = 'none';
        }
        if (activeCompareRoll2 && activeCompareSuggestions2 && !activeCompareRoll2.contains(target) && !activeCompareSuggestions2.contains(target)) {
          activeCompareSuggestions2.style.display = 'none';
        }
      });
      (window as any).__click_outside_bound = true;
    }

    // 6. Major Filter select trigger
    majorSelect?.addEventListener('change', (e) => {
      selectedMajor = (e.target as HTMLSelectElement).value;
      updateDashboardUI();
      if (searchInput && searchInput.value) performSearch();
      if (compareRoll1 && compareRoll1.value && compareRoll2 && compareRoll2.value) performComparison();
    });

    // 7. Leaderboard Sort select trigger
    leaderboardSortSelect?.addEventListener('change', (e) => {
      renderLeaderboard((e.target as HTMLSelectElement).value);
    });

    // 8. Listen to hash routing changes (registered once globally)
    if (!(window as any).__hashchange_bound) {
      window.addEventListener('hashchange', handleRouting);
      (window as any).__hashchange_bound = true;
    }
    // Listen to load routing checks
    handleRouting();
  };

  // Run on page load
  document.addEventListener('astro:page-load', init);
  // Fallback for direct load (in static builds without transition)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
