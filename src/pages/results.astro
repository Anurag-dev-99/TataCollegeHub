---
import Layout from '../layouts/Layout.astro';
import resultsData from '../../public/data/results.json';
import { 
  Trophy, Award, TrendingUp, CheckCircle, ArrowUpRight, Sparkles, 
  Calendar, Globe, ArrowLeft, Search, GitCompare, Crown, ExternalLink
} from '@lucide/astro';

const { announcements, passPercentageBySemester, passPercentageByDepartment, yearlyTrends, datasets = [] } = resultsData;

// Group datasets by batch/session
const groupedDatasets: Record<string, typeof datasets> = {};
datasets.forEach(d => {
  if (!groupedDatasets[d.batch]) {
    groupedDatasets[d.batch] = [];
  }
  groupedDatasets[d.batch].push(d);
});
---

<Layout 
  title="Kolhan University Result — Tata College Semester Results & Analysis" 
  activeTab="results"
  description="Kolhan University result for Tata College, Chaibasa — search semester-wise student results by roll number or name, check pass percentages, view batch leaderboards, subject toppers, and compare student marks for NEP 2020 FYUGP batch."
  keywords="Kolhan University result, Kolhan result, Kolhan University exam result 2024, Kolhan University marks, Tata College result, Tata College Chaibasa result, semester result Kolhan University, NEP batch results, student marks card Kolhan, pass percentage Kolhan University, Tata College pass percentage, Kolhan University roll number result"
>

  <!-- ========================================== -->
  <!--   RESULTS SELECTION HUB (Default View)     -->
  <!-- ========================================== -->
  <div id="results-hub-view" class="animated-slide-up">
    <!-- Header -->
    <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
      <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Kolhan University Result</h1>
      <p style="color: var(--text-secondary); max-width: 650px; font-size: 1.05rem; line-height: 1.6;">
        Search <strong>Kolhan University semester results</strong> for Tata College, Chaibasa.
        Find your result by roll number or name, view the batch leaderboard, subject toppers,
        and perform <strong>side-by-side student comparisons</strong> for the NEP 2020 FYUGP batch.
      </p>
    </div>

    <!-- Selection Groups (Separated by Batch) -->
    <div style="display: flex; flex-direction: column; gap: 2.25rem; margin-bottom: 2.5rem;">
      {Object.entries(groupedDatasets).map(([batchName, items]) => (
        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
            <span style="font-size: 1.25rem; line-height: 1;">🎓</span>
            <h2 style="font-size: 1.15rem; font-family: var(--font-display); font-weight: 800; color: var(--accent-primary); letter-spacing: -0.01em;">
              Batch {batchName.replace('Session ', '')}
            </h2>
          </div>
          
          <div class="results-hub-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
            {items.map(d => (
              <div class="results-card-select card card-interactive" data-exam={d.id} style="display: flex; flex-direction: column; gap: 1rem; cursor: pointer; text-decoration: none; color: inherit;">
                <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                  <div style="background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                    <Award size="22" />
                  </div>
                  <div style="display: flex; gap: 0.5rem; align-items: center;">
                    <span class={`badge ${d.batch.includes('2022-2026') ? 'badge-primary' : 'badge-warning'}`} style="font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.625rem; border-radius: var(--radius-xs); letter-spacing: normal; text-transform: none;">
                      {d.batch}
                    </span>
                    <span class="badge badge-success" style="font-size: 0.75rem; font-weight: 800; padding: 0.25rem 0.625rem; text-transform: uppercase; border-radius: var(--radius-xs);">{d.status}</span>
                  </div>
                </div>
                
                <div>
                  <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--text-primary); margin-bottom: 0.15rem; tracking: -0.015em; line-height: 1.35;">{d.title}</h3>
                </div>
                
                <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                  <span style="display: flex; align-items: center; gap: 0.25rem;"><Calendar size="14" /> {d.date}</span>
                  <span style="display: flex; align-items: center; gap: 0.25rem; font-weight: 700; color: var(--accent-primary);">Open Dashboard →</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Grid for Announcements and Analytics -->
    <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;" class="md:grid-cols-3">
      <!-- Left 2 Cols: Result Declarations Table -->
      <div class="md:col-span-2" style="display: flex; flex-direction: column; gap: 2rem;">
        <div>
          <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <CheckCircle style="color: var(--accent-success);" /> Declared Results & Alerts
          </h2>
          
          <div class="card" style="padding: 0; overflow-x: auto;">
            <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
              <thead>
                <tr style="border-bottom: 1px solid var(--border-color); background-color: var(--bg-tertiary);">
                  <th style="padding: 1rem; font-weight: 700; color: var(--text-secondary);">Result Announcement</th>
                  <th style="padding: 1rem; font-weight: 700; color: var(--text-secondary);">Date</th>
                  <th style="padding: 1rem; font-weight: 700; color: var(--text-secondary);">Status</th>
                  <th style="padding: 1rem; font-weight: 700; color: var(--text-secondary);">Action</th>
                </tr>
              </thead>
              <tbody>
                {announcements.map(res => {
                  const isDeclared = res.status === 'Declared';
                  return (
                    <tr style="border-bottom: 1px solid var(--border-color); transition: background-color 0.2s;" class="hover:bg-tertiary">
                      <td style="padding: 1rem; font-weight: 600; color: var(--text-primary);">{res.title}</td>
                      <td style="padding: 1rem; color: var(--text-secondary); font-size: 0.85rem;">{res.date}</td>
                      <td style="padding: 1rem;">
                        <span class={`badge ${isDeclared ? 'badge-success' : 'badge-warning'}`} style="font-size: 0.75rem;">
                          {res.status}
                        </span>
                      </td>
                      <td style="padding: 1rem;">
                        {isDeclared ? (
                          <a href={res.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="font-size: 0.8rem; gap: 0.25rem; white-space: nowrap; padding: 0.35rem 0.65rem;">
                            View Marks <ArrowUpRight size="14" />
                          </a>
                        ) : (
                          <span style="font-size: 0.8rem; color: var(--text-tertiary);">Pending</span>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Department Toppers -->
        <div>
          <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <Trophy style="color: var(--accent-warning);" /> Department Toppers (NEP Batch)
          </h2>
          
          <div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" class="md:grid-cols-2">
            {passPercentageByDepartment.map(dept => (
              <div class="card" style="display: flex; flex-direction: column; gap: 0.75rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
                  <h3 style="font-size: 1.05rem; font-weight: 700;">{dept.department}</h3>
                  <span class="badge badge-success" style="font-size: 0.75rem;">{dept.passPercentage}% Pass</span>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                  {dept.toppers.map((topper, idx) => (
                    <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem;">
                      <Award size="16" style={`color: ${idx === 0 ? 'var(--accent-warning)' : 'var(--text-tertiary)'};`} />
                      <span style="color: var(--text-primary); font-weight: 500;">{topper}</span>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Semester Pass Rates & Updates -->
      <div style="display: flex; flex-direction: column; gap: 2rem;">
        <div>
          <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <TrendingUp style="color: var(--accent-primary);" /> Semester Pass Rates
          </h2>
          
          <div class="card" style="display: flex; flex-direction: column; gap: 1.25rem;">
            <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 0.5rem;">
              Comparative analysis of pass percentages across the undergraduate batches.
            </p>
            
            {passPercentageBySemester.map(item => (
              <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
                  <span style="font-weight: 700; color: var(--text-primary);">{item.semester}</span>
                  <span style="font-size: 0.8rem; color: var(--text-secondary);">
                    <strong style="color: var(--text-primary);">{item.passPercentage}%</strong> ({item.totalStudents} students)
                  </span>
                </div>
                
                <div style="background-color: var(--bg-tertiary); height: 10px; border-radius: var(--radius-full); overflow: hidden; display: flex;">
                  <div style={`width: ${item.passPercentage}%; background: linear-gradient(90deg, var(--accent-primary) 0%, var(--accent-success) 100%); border-radius: var(--radius-full);`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Phase 2 Upgrades -->
        <div class="card" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(16, 185, 129, 0.05) 100%); border: 1px dashed var(--border-color); padding: 1.25rem;">
          <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem; color: var(--accent-primary);">
            <Sparkles size="16" /> Phase 2 Upgrades
          </h3>
          <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
            <strong>Interactive Analytics Reminder</strong>: Chart.js dynamic visual representations (Semester-wise bar graphs, yearly linear trends, and comparison templates) will be configured in the next build session.
          </p>
        </div>
      </div>
    </div>
  </div>


  <!-- ========================================== -->
  <!--   EXAM DASHBOARD VIEW (Initially Hidden)   -->
  <!-- ========================================== -->
  <div id="results-dashboard-view" style="display: none; flex-direction: column; gap: 1.5rem;" class="animated-slide-up">
    
    <!-- Back to Hub Button -->
    <button class="btn btn-secondary" id="dashboard-back-btn" style="width: fit-content; align-items: center; gap: 0.5rem; font-size: 0.9rem; font-weight: 600; padding: 0.5rem 1rem;">
      ← Back to Results Hub
    </button>

    <!-- Dashboard Title Section -->
    <div style="display: flex; flex-direction: column; gap: 0.25rem;">
      <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
        <h2 id="dashboard-exam-title" style="font-size: 1.8rem; font-family: var(--font-display); tracking: -0.02em; margin: 0;">-</h2>
        
        <!-- Inline Updates Button -->
        <button id="dashboard-updates-btn" class="badge badge-warning" style="display: none; align-items: center; gap: 0.35rem; cursor: pointer; border: 1px solid rgba(245, 158, 11, 0.3); padding: 0.35rem 0.75rem; border-radius: var(--radius-full); transition: all 0.2s; background: rgba(245, 158, 11, 0.08); font-size: 0.75rem; font-weight: 700; height: 26px;" onmouseover="this.style.background='rgba(245, 158, 11, 0.15)'" onmouseout="this.style.background='rgba(245, 158, 11, 0.08)'">
          <span>✨ Updates</span>
          <span id="updates-count" style="background-color: var(--accent-warning); color: var(--bg-secondary); border-radius: var(--radius-full); width: 14px; height: 14px; display: flex; align-items: center; justify-content: center; font-size: 0.65rem; font-weight: 950; margin-left: 2px;">0</span>
        </button>
      </div>
      
      <p id="dashboard-exam-subtitle" style="color: var(--text-secondary); font-size: 1rem;">-</p>
      
      <!-- Legacy Notice Banner (hidden by default) -->
      <div id="dashboard-exam-notice" style="display: none; margin-top: 0.75rem; padding: 0.75rem 1rem; border-radius: var(--radius-sm); background-color: rgba(245, 158, 11, 0.08); border: 1px solid rgba(245, 158, 11, 0.25); color: var(--accent-warning); font-size: 0.875rem; font-weight: 500; align-items: center; gap: 0.5rem; width: fit-content;">
        <span style="font-size: 1.15rem; line-height: 1;">⚠️</span>
        <span id="dashboard-exam-notice-text"></span>
      </div>
    </div>

    <!-- Major Filter select (if multi-major) -->
    <div id="dashboard-filter-container" class="card" style="padding: 1rem; display: none; align-items: center; gap: 1rem;">
      <span style="font-size: 0.9rem; font-weight: 700; color: var(--text-secondary); display: flex; align-items: center; gap: 0.35rem;">
        🔍 Filter Major:
      </span>
      <select id="dashboard-major-select" class="form-input" style="width: auto; height: 38px; padding: 0 1rem; font-size: 0.9rem; border-radius: var(--radius-xs); cursor: pointer;">
        <option value="All">All Majors</option>
      </select>
    </div>

    <!-- Stats Cards Grid -->
    <div class="results-stats-grid">
      <!-- Total Enrolled -->
      <div class="card results-stat-card">
        <div class="results-stat-header-row">
          <span class="stat-title">
            <span class="stat-title-desktop">Total Enrolled</span>
            <span class="stat-title-mobile">Total</span>
          </span>
          <span class="stat-icon">👥</span>
        </div>
        <div id="stat-total-students" class="stat-number">0</div>
        <span class="stat-desc">Students in batch</span>
      </div>

      <!-- Pass Percentage -->
      <div class="card results-stat-card">
        <div class="results-stat-header-row">
          <span class="stat-title">
            <span class="stat-title-desktop">Pass Percentage</span>
            <span class="stat-title-mobile">Pass %</span>
          </span>
          <span class="stat-icon">✅</span>
        </div>
        <div id="stat-pass-percent" class="stat-number">0%</div>
        <span id="stat-pass-sub" class="stat-desc">0 of 0 Passed</span>
        <div class="stat-progress-bar">
          <div id="stat-pass-progress" class="stat-progress-fill"></div>
        </div>
      </div>

      <!-- Batch Topper -->
      <div class="card results-stat-card" id="stat-topper-card" style="cursor: pointer;">
        <div class="results-stat-header-row">
          <span class="stat-title">
            <span class="stat-title-desktop">Batch Topper</span>
            <span class="stat-title-mobile">Topper</span>
          </span>
          <span class="stat-icon">👑</span>
        </div>
        <div id="stat-topper-score" class="stat-number">0</div>
        <span id="stat-topper-name" class="highlight-name" title="-">-</span>
      </div>

      <!-- Batch Average -->
      <div class="card results-stat-card">
        <div class="results-stat-header-row">
          <span class="stat-title">
            <span class="stat-title-desktop">Batch Average</span>
            <span class="stat-title-mobile">Avg</span>
          </span>
          <span class="stat-icon">📈</span>
        </div>
        <div id="stat-avg-score" class="stat-number">0</div>
        <span class="stat-desc">Avg grand total score</span>
      </div>
    </div>

    <!-- Student Search Section -->
    <div class="card" id="results-search-section" style="padding: 2rem;">
      <h3 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        🔍 Search Student Result
      </h3>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
        Enter your roll number or student name to view detailed marks cards.
      </p>

      <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; position: relative;">
        <!-- Input wrapper -->
        <div style="position: relative; flex: 1; min-width: 240px;">
          <input type="text" id="result-search-input" class="form-input" placeholder="Type Roll Number or Name..." autocomplete="off" style="height: 44px; padding-left: 2.5rem; border-radius: var(--radius-sm);" />
          <span style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-tertiary); font-size: 1.15rem;">🔍</span>
          
          <!-- Autocomplete suggestions dropdown -->
          <div id="results-search-suggestions" class="card" style="display: none; position: absolute; top: 48px; left: 0; right: 0; z-index: 100; max-height: 250px; overflow-y: auto; padding: 0.5rem; box-shadow: var(--shadow-lg);"></div>
        </div>

        <button class="btn btn-primary" id="result-search-btn" style="height: 44px; padding: 0 1.5rem;">
          Search Result
        </button>

        <button class="btn btn-secondary" id="result-browse-all-btn" style="height: 44px; padding: 0 1.5rem;">
          👥 Browse All
        </button>
      </div>

      <!-- Search Student Output Card -->
      <div id="student-result-output" style="margin-top: 1.5rem;"></div>
    </div>

    <!-- Leaderboard and Toppers Row -->
    <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem;" class="lg:grid-cols-2">
      
      <!-- Batch Leaderboard -->
      <div class="card" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <h3 style="font-size: 1.25rem; font-family: var(--font-display); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0;">
            🏆 Batch Leaderboard
          </h3>
          
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-secondary);">Sort By:</span>
            <select id="leaderboard-sort-select" class="form-input" style="width: auto; height: 32px; padding: 0 0.5rem; font-size: 0.8rem; border-radius: var(--radius-xs); cursor: pointer;">
              <option value="grand_total">Grand Total (Overall)</option>
            </select>
          </div>
        </div>
        <p id="leaderboard-desc" style="color: var(--text-secondary); font-size: 0.825rem; margin-top: -0.5rem;">Top 10 students by Grand Total in this semester exam.</p>

        <div style="overflow-x: auto; border-top: 1px solid var(--border-color); padding-top: 0.5rem;">
          <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.85rem;">
            <thead>
              <tr style="border-bottom: 1px solid var(--border-color);">
                <th style="padding: 0.75rem 0.5rem; font-weight: 700; color: var(--text-secondary); width: 60px; text-align: center;">Rank</th>
                <th style="padding: 0.75rem 0.5rem; font-weight: 700; color: var(--text-secondary);">Student Name</th>
                <th style="padding: 0.75rem 0.5rem; font-weight: 700; color: var(--text-secondary);">Roll Number</th>
                <th style="padding: 0.75rem 0.5rem; font-weight: 700; color: var(--text-secondary); text-align: right; width: 100px;">Total</th>
              </tr>
            </thead>
            <tbody id="leaderboard-table-body">
              <tr>
                <td colspan="4" style="text-align: center; padding: 2rem; color: var(--text-secondary);">Loading leaderboard data...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Subject Toppers list -->
      <div class="card" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
        <h3 style="font-size: 1.25rem; font-family: var(--font-display); display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0;">
          🥇 Subject Toppers
        </h3>
        <p style="color: var(--text-secondary); font-size: 0.825rem; margin-top: -0.5rem;">Click a row to view the student's complete marks card.</p>
        
        <div id="subject-toppers-list" style="display: flex; flex-direction: column; gap: 0.75rem; border-top: 1px solid var(--border-color); padding-top: 1rem; max-height: 400px; overflow-y: auto;">
          <div style="text-align: center; padding: 2rem; color: var(--text-secondary);">Loading subject toppers...</div>
        </div>
      </div>

    </div>

    <!-- Paper-wise Analysis Section -->
    <div class="card" id="paper-analysis-section" style="padding: 2rem;">
      <h3 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        📊 Paper-wise Analysis
      </h3>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
        Deep-dive into how students performed in each paper — highest, average, lowest marks, pass rate, and grade distribution.
      </p>
      <div id="paper-analysis-output" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.25rem;"></div>
    </div>

    <!-- Student Comparison Widget -->
    <div class="card" id="results-compare-section" style="padding: 2rem;">
      <h3 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        🔄 Compare Students
      </h3>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
        Enter two roll numbers or student names to compare marks side by side.
      </p>

      <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; justify-content: center; position: relative;">
        <!-- Input 1 -->
        <div style="position: relative; flex: 1; min-width: 200px;">
          <input type="text" id="compare-roll-1" class="form-input" placeholder="Roll Number or Name 1" autocomplete="off" style="height: 44px; padding-left: 2.25rem; border-radius: var(--radius-sm);" />
          <span style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-tertiary);">👤</span>
          <div id="compare-suggestions-1" class="card" style="display: none; position: absolute; top: 48px; left: 0; right: 0; z-index: 100; max-height: 200px; overflow-y: auto; padding: 0.5rem; box-shadow: var(--shadow-lg);"></div>
        </div>

        <span style="font-weight: 800; font-size: 0.9rem; color: var(--text-tertiary); background-color: var(--bg-tertiary); padding: 0.35rem 0.75rem; border-radius: var(--radius-full);">VS</span>

        <!-- Input 2 -->
        <div style="position: relative; flex: 1; min-width: 200px;">
          <input type="text" id="compare-roll-2" class="form-input" placeholder="Roll Number or Name 2" autocomplete="off" style="height: 44px; padding-left: 2.25rem; border-radius: var(--radius-sm);" />
          <span style="position: absolute; left: 0.85rem; top: 50%; transform: translateY(-50%); color: var(--text-tertiary);">👤</span>
          <div id="compare-suggestions-2" class="card" style="display: none; position: absolute; top: 48px; left: 0; right: 0; z-index: 100; max-height: 200px; overflow-y: auto; padding: 0.5rem; box-shadow: var(--shadow-lg);"></div>
        </div>

