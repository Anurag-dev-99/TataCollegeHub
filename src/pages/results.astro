---
import Layout from '../layouts/Layout.astro';
import resultsData from '../../public/data/results.json';
import { GraduationCap, Trophy, Award, TrendingUp, CheckCircle, HelpCircle, ArrowUpRight, ShieldCheck, Sparkles, Calculator } from '@lucide/astro';

// Results data destructured
const { announcements, passPercentageBySemester, passPercentageByDepartment, yearlyTrends } = resultsData;
---

<Layout title="Results Portal" activeTab="results">

  <!-- Header -->
  <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Results & Analytics Portal</h1>
    <p style="color: var(--text-secondary); max-width: 600px; font-size: 1.05rem;">
      Check examination result updates, department toppers, passing statistics, and estimate your CGPA.
    </p>
  </div>

  <!-- Main Grid Layout -->
  <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2.5rem;" class="md:grid-cols-3">
    
    <!-- Left 2 Cols: Main Results Info -->
    <div class="md:col-span-2" style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Results Announcements -->
      <div>
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <CheckCircle style="color: var(--accent-success);" /> Result Declarations
        </h2>
        
        <div style="display: flex; flex-direction: column; gap: 1rem;">
          {announcements.map(res => {
            const isDeclared = res.status === 'Declared';
            return (
              <div class="card" style={`display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-left: 4px solid ${isDeclared ? 'var(--accent-success)' : 'var(--accent-warning)'};`}>
                <div>
                  <h3 style="font-size: 1rem; font-weight: 700; color: var(--text-primary);">{res.title}</h3>
                  <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.15rem;">
                    Status: <span style={`font-weight: 600; color: ${isDeclared ? 'var(--accent-success)' : 'var(--accent-warning)'};`}>{res.status}</span>
                    {isDeclared && ` • Declared on ${res.date}`}
                  </p>
                </div>
                
                {isDeclared ? (
                  <a href={res.link} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="font-size: 0.8rem; gap: 0.25rem; white-space: nowrap;">
                    View Marks <ArrowUpRight size="14" />
                  </a>
                ) : (
                  <span class="badge badge-warning" style="font-size: 0.75rem;">Awaiting</span>
                )}
              </div>
            );
          })}
        </div>
      </div>


      <!-- Department Toppers -->
      <div>
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <Trophy style="color: var(--accent-warning);" /> Department Toppers (NEP Batch)
        </h2>
        
        <div style="display: grid; grid-template-columns: 1fr; gap: 1rem;" class="md:grid-cols-2">
          {passPercentageByDepartment.map(dept => (
            <div class="card" style="display: flex; flex-direction: column; gap: 0.75rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
                <h3 style="font-size: 1.05rem; font-weight: 700;">{dept.department}</h3>
                <span class="badge badge-success" style="font-size: 0.75rem;">{dept.passPercentage}% Pass</span>
              </div>
              
              <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                {dept.toppers.map((topper, idx) => (
                  <div style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem;">
                    <Award size="16" style={`color: ${idx === 0 ? 'var(--accent-warning)' : 'var(--text-tertiary)'};`} />
                    <span style="color: var(--text-primary); font-weight: 500;">{topper}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

    <!-- Right 1 Col: Analytics & Reminders -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- CSS-Based Visualizations: Pass Rates by Semester -->
      <div>
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <TrendingUp style="color: var(--accent-primary);" /> Semester Pass Rates
        </h2>
        
        <div class="card" style="display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="font-size: 0.875rem; color: var(--text-secondary); margin-bottom: 0.5rem;">
            Comparative analysis of pass percentages across the undergraduate batches.
          </p>
          
          {passPercentageBySemester.map(item => (
            <div style="display: flex; flex-direction: column; gap: 0.35rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem;">
                <span style="font-weight: 700; color: var(--text-primary);">{item.semester}</span>
                <span style="font-size: 0.8rem; color: var(--text-secondary);">
                  <strong style="color: var(--text-primary);">{item.passPercentage}%</strong> ({item.totalStudents} students)
                </span>
              </div>
              
              <!-- Custom styled progress bar -->
              <div style="background-color: var(--bg-tertiary); height: 10px; border-radius: var(--radius-full); overflow: hidden; display: flex;">
                <div 
                  style={`width: ${item.passPercentage}%; background: linear-gradient(90deg, var(--accent-primary) 0%, var(--accent-success) 100%); border-radius: var(--radius-full);`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Postponed Chart.js Reminder Widget -->
      <div class="card" style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(16, 185, 129, 0.05) 100%); border: 1px dashed var(--border-color); padding: 1.25rem;">
        <h3 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.4rem; color: var(--accent-primary);">
          <Sparkles size="16" /> Phase 2 Upgrades
        </h3>
        <p style="font-size: 0.8rem; color: var(--text-secondary); line-height: 1.4;">
          <strong>Interactive Analytics Reminder</strong>: Chart.js dynamic visual representations (Semester-wise bar graphs, yearly linear trends, and comparison templates) will be configured in the next build session.
        </p>
      </div>

    </div>

  </div>

</Layout>
