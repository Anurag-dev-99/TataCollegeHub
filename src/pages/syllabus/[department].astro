---
import Layout from '../../layouts/Layout.astro';
import syllabusData from '../../../public/data/syllabus.json';
import mathsSem3Data from '../../../public/data/maths-sem3-complete.json';
import notesData from '../../../public/data/notes.json';
import pyqsData from '../../../public/data/pyqs.json';
import markingSchemes from '../../../public/data/paper_marking_schemes.json';
import { renderMathText } from '../../utils/renderMath';
import { ChevronLeft, Calendar, Download, FileText, Sparkles, MessageCircle, Eye } from '@lucide/astro';

export async function getStaticPaths() {
  const getSlug = (dept: string) => dept.toLowerCase().replace(/\s+/g, '-');

  // Filter and only build departments that have active files
  const activeDepartments = [
    'Mathematics', 'Physics', 'Mathematics Minor', 'Physics Minor',
    'Botany', 'English', 'Geography', 'Geography Minor',
    'Chemistry', 'Commerce', 'History', 'History Minor', 'Political Science',
    'Zoology', 'Economics', 'Psychology',
    'Hindi', 'Bangla', 'Odia', 'Philosophy', 'Urdu',
    'Santhali', 'Ho', 'Kudmali', 'Sanskrit',
    'Geology', 'Home Science', 'Statistics', 'Environmental Science',
    'BBA', 'BCA', 'Information Technology', 'Mass Communication',
  ];
  const filteredSyllabus = syllabusData.filter(item => activeDepartments.includes(item.department));
  const departments = [...new Set(filteredSyllabus.map(item => item.department))];

  return departments.map(dept => {
    return {
      params: { department: getSlug(dept) },
      props: { departmentName: dept, activeDepartments }
    };
  });
}

const { department } = Astro.params;
const { departmentName, activeDepartments } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const getSlug = (dept: string) => dept.toLowerCase().replace(/\s+/g, '-');

// Get all syllabuses for this department
const syllabuses = syllabusData.filter(s => s.department.toLowerCase().replace(/\s+/g, '-') === department);

const isMathsMajor = department === 'mathematics';
const isEnglish = department === 'english';
const isMinorDept = departmentName.toLowerCase().includes('minor');
const baseSubject = departmentName.replace(/\s+Minor$/i, '').trim();

const notesWaLink = (item: string, price: number) =>
  `https://api.whatsapp.com/send?phone=${notesData.whatsapp}&text=${encodeURIComponent(`Hi KolhanHub! 👋 I want to buy: ${item} – ₹${price}. Please send the payment QR.`)}`;
const noteByPaperCode: Record<string, any> = {
  'MJ-04': notesData.products.find(p => p.id === 'maths-mj04-real-analysis'),
  'MJ-05': notesData.products.find(p => p.id === 'maths-mj05-vectors'),
};

// Verified marking scheme lookup from paper_marking_schemes.json
const SUBJECT_ALIASES: Record<string, string> = {
  'bba': 'business administration',
  'bca': 'computer application',
  'environmental science': 'environment & water management',
  'bangla': 'bengali',
  'kudmali': 'kurmali',
  'mass communication': 'mass communication and video production'
};
const normalizedSubj = SUBJECT_ALIASES[baseSubject.toLowerCase()] || baseSubject.toLowerCase();
const isPracticalSubject = markingSchemes.subjects.alwaysPractical.some(s => s.toLowerCase() === normalizedSubj);
const isMixedVocational = markingSchemes.subjects.mixedVocationalSubjects.some(s => s.toLowerCase() === normalizedSubj);
const markingSummary = isPracticalSubject
  ? 'Practical Paper · 100 Marks (60 Theory + 15 Internal + 25 Practical) · Pass: 40'
  : isMixedVocational
    ? 'Vocational Paper · 100 Marks (60+15+25 Practical or 75+25 Theory depending on semester) · Pass: 40'
    : 'Non-Practical Paper · 100 Marks (75 Theory + 25 Internal) · Pass: 40';

// Auto cross-linking to matching PYQs, Notes & Sibling Major/Minor
const primaryCat = isMinorDept ? 'minor' : 'major';
const altCat = isMinorDept ? 'major' : 'minor';
const pyqUrl = (catLower: string, subjLower: string, sem: number) =>
  `${baseUrl}/pyqs/${catLower}/${encodeURI(subjLower)}/${sem}/`;

const getPyqSemsFor = (catLower: string) => {
  const matching = pyqsData.filter(
    (p: any) => p.downloadUrl && p.type !== 'notes' &&
      p.category.toLowerCase() === catLower &&
      p.subject.toLowerCase() === baseSubject.toLowerCase()
  );
  const sems = [...new Set(matching.map((p: any) => Number(p.semester)))].sort((a, b) => a - b);
  return { sems, count: matching.length };
};

const primaryPyqs = getPyqSemsFor(primaryCat);
const altPyqs = getPyqSemsFor(altCat);
const mdcPyqs = getPyqSemsFor('mdc');

const siblingDeptName = isMinorDept ? baseSubject : `${departmentName} Minor`;
const siblingSlug = activeDepartments.includes(siblingDeptName) ? getSlug(siblingDeptName) : null;

const deptNotes = notesData.products.filter(
  n => n.available && n.match.category === primaryCat && n.match.subject === baseSubject.toLowerCase()
);

// SEO metadata (strictly <= 60 chars title, <= 158 chars description)
const rawCandidateTitle = `Kolhan University ${departmentName} Syllabus PDF (Sem 1–8)`;
const pageTitle = isMathsMajor
  ? 'Kolhan University B.Sc Mathematics Syllabus PDF (Sem 1–8)'
  : isEnglish
    ? 'Kolhan University English Syllabus PDF — NEP FYUGP'
    : rawCandidateTitle.length <= 60
      ? rawCandidateTitle
      : `Kolhan University ${departmentName} Syllabus PDF`;

const pageDescription = isMathsMajor
  ? 'Download official Kolhan University B.Sc Mathematics NEP FYUGP syllabus PDF (Sem 1–8) + Sem 3 MJ-04 Real Analysis & MJ-05 Vectors unit guide, weightage & PYQs.'
  : `Download official Kolhan University ${departmentName} NEP 2020 FYUGP syllabus PDF (${syllabuses[0]?.semester || 'Sem 1–8'}) for all 37 colleges — marking scheme & PYQs.`;

const pageKeywords = `Kolhan University ${departmentName} syllabus, Kolhan University ${departmentName} syllabus pdf, ${departmentName} NEP FYUGP syllabus Kolhan University, KU ${departmentName} syllabus sem 1 2 3 4`;

// WhatsApp link for sharing revised 2025/2026 PDFs
const updateShareWa = `https://api.whatsapp.com/send?phone=${notesData.whatsapp}&text=${encodeURIComponent(`Hi KolhanHub! I have an updated 2025/2026 syllabus PDF for ${departmentName} 📚`)}`;

// Visible 3-Question FAQ + synced FAQPage JSON-LD
const faqItems = [
  {
    q: `How do I download the Kolhan University ${departmentName} Syllabus PDF?`,
    a: `Tap any semester download button above to open the official NEP 2020 FYUGP ${departmentName} syllabus PDF directly without login or fees. It applies to all 37 Kolhan University colleges.`
  },
  {
    q: `What is the exam pattern and passing marks for ${departmentName} in Kolhan University?`,
    a: `${markingSummary}. Students must score at least 40% in each applicable component (Theory, Internal, and Practical) to pass.`
  },
  {
    q: `Is this ${departmentName} syllabus the same for 2022–2024 and 2025–2026 batches?`,
    a: isMathsMajor
      ? 'The 2022, 2023, and 2024 admission batches follow the exact same Mathematics Major syllabus (Sem 1 to 8). From the 2025 batch onwards, Kolhan University revised Sem 1–2 papers — always switch the batch toggle above before studying.'
      : `These PDFs follow Kolhan University's 2022–2024 NEP 2020 FYUGP syllabus${isMinorDept ? ' (renamed Associated Core / AC from 2025 onwards)' : ''}. If you are in the 2025 or 2026 batch, please verify with your subject teacher whether your department revised Sem 1–2 units.`
  }
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
});
---

<Layout
  title={pageTitle}
  rawTitle={true}
  description={pageDescription}
  keywords={pageKeywords}
  activeTab="syllabus"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
    {isMathsMajor && (
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    )}
  </Fragment>

  <!-- Breadcrumb Navigation -->
  <div style="margin-bottom: 1.1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; font-size: 0.85rem;">
    <a href={`${baseUrl}/syllabus/`} style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; color: var(--text-secondary); text-decoration: none;">
      <ChevronLeft size="16" /> Syllabus Directory
    </a>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-primary); font-weight: 600;">{departmentName}</span>
  </div>

  <!-- Main Department Title -->
  <div style="margin-bottom: 1.35rem; display: flex; flex-direction: column; gap: 0.4rem;">
    <h1 style="font-size: clamp(1.38rem, 5vw, 1.95rem); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin: 0;">
      Kolhan University {departmentName} Syllabus
    </h1>
    <p style="color: var(--text-secondary); max-width: 680px; font-size: 0.9rem; line-height: 1.5; margin: 0;">
      {isMathsMajor
        ? 'NEP 2020 FYUGP • Official PDF • All 37 Colleges — Select your batch below for PDFs, Semester 3 (MJ-04 & MJ-05) unit-wise breakdown, weightage, and notes.'
        : 'NEP 2020 FYUGP • Official PDF • All 37 Colleges (BA / BSc / BCom)'}
    </p>
  </div>

  {syllabuses.length === 0 ? (
    <div class="card" style="text-align: center; padding: 3rem 1rem;">
      <p style="color: var(--text-secondary);">No syllabus records found for this department.</p>
    </div>
  ) : (
    <div style="display: flex; flex-direction: column; gap: 1.35rem;">

      {/* ══════════════════════════════════════════════════════════════════
          BATCH SELECTOR FOR MATHEMATICS MAJOR (2022–2024 vs 2025–2026)
      ══════════════════════════════════════════════════════════════════ */}
      {isMathsMajor && (
        <div style="background: linear-gradient(135deg, rgba(129,140,248,0.08) 0%, rgba(16,185,129,0.04) 100%); border: 1px solid rgba(129,140,248,0.28); border-radius: var(--radius-sm); padding: 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.7rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
            <div style="display: flex; align-items: center; gap: 0.45rem;">
              <span style="font-size: 1rem;">🎓</span>
              <span style="font-size: 0.8rem; font-weight: 800; color: var(--text-primary); font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.04em;">Select Your Admission Batch</span>
            </div>
            <span style="font-size: 0.66rem; font-weight: 700; color: #34d399; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.28); border-radius: 20px; padding: 2px 9px;">Avoid Syllabus Confusion</span>
          </div>

          <div style="display: flex; gap: 0.55rem; flex-wrap: wrap;">
            <button type="button" class="math-batch-btn active" data-batch="2022-2024" style="flex: 1; min-width: min(100%, 220px); padding: 0.68rem 0.9rem; border-radius: var(--radius-xs); border: 1px solid #818cf8; background: rgba(129,140,248,0.16); color: var(--text-primary); font-weight: 800; font-size: 0.82rem; cursor: pointer; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
              <span>✅ 2022, 2023 &amp; 2024 Batch (Same Syllabus)</span>
              <span style="font-size: 0.64rem; background: #818cf8; color: #0b0b12; padding: 2px 7px; border-radius: 12px; font-weight: 800; white-space: nowrap;">Sem 1–8 Live</span>
            </button>
            <button type="button" class="math-batch-btn" data-batch="2025-2026" style="flex: 1; min-width: min(100%, 220px); padding: 0.68rem 0.9rem; border-radius: var(--radius-xs); border: 1px solid var(--border-color); background: var(--bg-secondary); color: var(--text-secondary); font-weight: 700; font-size: 0.82rem; cursor: pointer; text-align: left; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
              <span>🆕 2025 &amp; 2026 Batch (Updated Syllabus)</span>
              <span style="font-size: 0.64rem; background: rgba(245,158,11,0.15); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); padding: 2px 7px; border-radius: 12px; font-weight: 700; white-space: nowrap;">Revised NEP</span>
            </button>
          </div>

          <div id="batch-note-2022-2024" style="font-size: 0.77rem; color: var(--text-secondary); line-height: 1.55;">
            <strong style="color: #818cf8;">Note for 2022, 2023 &amp; 2024 batches:</strong> Your syllabus for Semester 1 to Semester 8 is <strong>100% identical</strong>. Semester 3 has two Major papers: <strong>MJ-04 (Real Analysis)</strong> and <strong>MJ-05 (Vectors)</strong>. Scroll down for the full interactive Semester 3 syllabus, unit weightage, book chapters, and 2023 batch result statistics!
          </div>
          <div id="batch-note-2025-2026" style="display: none; font-size: 0.77rem; color: var(--text-secondary); line-height: 1.55; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); border-radius: var(--radius-xs); padding: 0.65rem 0.85rem;">
            <strong style="color: #fbbf24;">⚠️ Important for 2025 &amp; 2026 batches:</strong> Kolhan University revised the Mathematics Major syllabus from the 2025 admission batch onwards (Semester 1 &amp; Semester 2 papers have changed compared to 2022–2024 batches). Do not follow the old 2022–2024 Semester 1 &amp; 2 syllabus. We are adding the separate 2025–2026 batch text breakdown soon!
          </div>

          <!-- Sem 3 Quick-Jump Banner (Connects Homepage Maths Major Notes Funnel) -->
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.55rem; flex-wrap: wrap; border-top: 1px solid rgba(129,140,248,0.22); padding-top: 0.65rem;">
            <a href="#maths-sem3-deep-section" style="font-size: 0.78rem; font-weight: 800; color: #818cf8; text-decoration: none;">
              ⚡ Sem 3 Student? Jump to MJ-04 &amp; MJ-05 Interactive Syllabus, Weightage &amp; Notes ↓
            </a>
            <a href={`${baseUrl}/pyqs/major/mathematics/3/`} style="font-size: 0.72rem; font-weight: 700; color: #34d399; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); border-radius: 20px; padding: 3px 10px; text-decoration: none; white-space: nowrap;">
              📄 Sem 3 Solved PYQs →
            </a>
          </div>
        </div>
      )}

      <!-- Multi-Course Subselector -->
      {syllabuses.length > 1 && (
        <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); padding: 0.75rem; border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 0.5rem;">
          <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em; padding-left: 0.5rem;">Select Course Branch:</span>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            {syllabuses.map((syl, idx) => (
              <button
                type="button"
                class={`btn btn-sm course-tab-btn ${idx === 0 ? 'btn-primary' : 'btn-secondary'}`}
                data-course-id={syl.id}
                style="flex: 1; min-width: min(100%, 200px); text-align: left; justify-content: flex-start; gap: 0.5rem; font-size: 0.85rem;"
              >
                <FileText size="14" /> {syl.title.replace(/ Syllabus \(FYUGP NEP-2020\)/gi, '')}
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Syllabus Containers -->
      {syllabuses.map((syl, courseIdx) => {
        const urls: string[] = (syl as any).downloadUrls || [];
        const customLabels: string[] = (syl as any).downloadLabels || [];
        return (
          <div
            class="course-container animate-fade-in"
            id={`course-section-${syl.id}`}
            style={`display: ${courseIdx === 0 ? 'block' : 'none'};`}
          >
            <!-- Course Header Info -->
            <div class="card" style="background-color: var(--bg-secondary);">
              <h2 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 0.45rem; font-family: var(--font-display);">{syl.title}</h2>
              <p style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.55; margin: 0 0 0.85rem;">{syl.description}</p>

              <div style="display: flex; flex-wrap: wrap; gap: 0.65rem 0.9rem; font-size: 0.78rem; color: var(--text-secondary); border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
                <div style="display: flex; align-items: center; gap: 0.25rem;">
                  <Calendar size="14" style="color: var(--accent-primary);" /> <span>Batch: {isMathsMajor ? '2022, 2023 & 2024 Batches' : syl.effectiveFrom}</span>
                </div>
                <div>•</div>
                <div>Semester Range: {syl.semester}</div>
                <div>•</div>
                <div>File Info: {syl.fileSize}</div>
              </div>

              {/* Verified Marking Scheme Badge */}
              <div style="margin-top: 0.75rem; font-size: 0.76rem; color: var(--text-secondary); background: rgba(99,102,241,0.06); border: 1px solid rgba(99,102,241,0.2); border-radius: var(--radius-xs); padding: 0.5rem 0.75rem; line-height: 1.45;">
                📊 <strong style="color: var(--text-primary);">Exam Pattern:</strong> {markingSummary}
              </div>

              {/* Single legacy downloadUrl */}
              {(syl as any).downloadUrl && urls.length === 0 && (
                <div style="margin-top: 0.9rem; border-top: 1px solid var(--border-color); padding-top: 0.85rem; display: flex; align-items: center; gap: 0.85rem; flex-wrap: wrap;">
                  <a
                    href={(syl as any).downloadUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-outline btn-sm"
                    style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem;"
                    onclick={`if(window.trackDownload) window.trackDownload('syllabus', { subject: '${syl.title} Full Syllabus (Sem 1-8)', category: '${syl.department}', semester: 'All', department: '${syl.department}' });`}
                  >
                    <Download size="14" /> Download Full Syllabus (Sem 1–8)
                  </a>
                  <span style="font-size: 0.74rem; color: var(--text-tertiary); display: flex; align-items: center; gap: 0.25rem;">
                    <Download size="12" /> <span class="live-paper-download-count" data-subject-title={`${syl.title} Full Syllabus (Sem 1-8)`}>—</span> downloads
                  </span>
                </div>
              )}

              {/* Multiple / Array downloadUrls — reads custom downloadLabels */}
              {urls.length > 0 && (
                <div style={`margin-top: 0.9rem; border-top: 1px solid var(--border-color); padding-top: 0.85rem; display: grid; grid-template-columns: ${urls.length > 3 ? 'repeat(auto-fill, minmax(min(100%, 240px), 1fr))' : 'minmax(0, 1fr)'}; gap: 0.65rem;`}>
                  {urls.map((url: string, idx: number) => {
                    const total = urls.length;
                    const legacyTrackingLabel = total === 1
                      ? 'Download Full Syllabus (Sem 1-8)'
                      : `Download Part ${idx + 1}`;
                    const displayLabel = customLabels[idx] || (total === 1 ? 'Download Full Syllabus (Sem 1–8)' : `Download Part ${idx + 1}`);
                    return (
                      <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.65rem; flex-wrap: wrap; background: rgba(0,0,0,0.12); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.5rem 0.65rem;">
                        <a
                          href={url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn btn-outline btn-sm"
                          style="display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.78rem;"
                          onclick={`if(window.trackDownload) window.trackDownload('syllabus', { subject: '${syl.title} ${legacyTrackingLabel}', category: '${syl.department}', semester: 'All', department: '${syl.department}' });`}
                        >
                          <Download size="14" /> {displayLabel}
                        </a>
                        <span style="font-size: 0.72rem; color: var(--text-tertiary); display: flex; align-items: center; gap: 0.25rem;">
                          <Download size="12" /> <span class="live-paper-download-count" data-subject-title={`${syl.title} ${legacyTrackingLabel}`}>—</span>
                        </span>
                      </div>
                    );
                  })}
                </div>
              )}

              {/* Honest 2025/2026 Batch Check Strip (Non-Maths subjects) */}
              {!isMathsMajor && (
                <div style="margin-top: 0.9rem; display: flex; align-items: center; justify-content: space-between; gap: 0.55rem; flex-wrap: wrap; background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.22); border-radius: var(--radius-xs); padding: 0.55rem 0.75rem; font-size: 0.74rem; color: var(--text-secondary); line-height: 1.45;">
                  <span>
                    ℹ️ Applies to <strong>2022–2024 NEP FYUGP</strong> batches{isMinorDept ? ' (renamed AC from 2025)' : ''}. <strong>2025/2026 batch?</strong> Confirm if your department revised Sem 1–2 papers.
                  </span>
                  <a href={updateShareWa} target="_blank" rel="noopener noreferrer" style="font-weight: 700; color: #fbbf24; text-decoration: none; white-space: nowrap;">
                    Share updated 2025/26 PDF →
                  </a>
                </div>
              )}
            </div>
          </div>
        );
      })}

      {/* ══════════════════════════════════════════════════════════════════
          CROSS-LINK CARD: MATCHING PYQs, NOTES & SIBLING MAJOR/MINOR
      ══════════════════════════════════════════════════════════════════ */}
      {(primaryPyqs.sems.length > 0 || altPyqs.sems.length > 0 || mdcPyqs.sems.length > 0 || siblingSlug || (!isMathsMajor && deptNotes.length > 0)) ? (
        <section aria-label={`Practice ${departmentName} PYQs and related resources`} class="card" style="background: linear-gradient(135deg, rgba(16,185,129,0.05) 0%, rgba(99,102,241,0.04) 100%); border-color: rgba(16,185,129,0.24); display: flex; flex-direction: column; gap: 0.75rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
            <h2 style="font-size: 1rem; font-weight: 800; font-family: var(--font-display); margin: 0; color: var(--text-primary);">
              📝 Practice {departmentName} Previous Year Papers (PYQs)
            </h2>
            <a href={`${baseUrl}/pyqs/`} style="font-size: 0.74rem; font-weight: 700; color: #34d399; text-decoration: none;">
              All PYQs →
            </a>
          </div>

          {primaryPyqs.sems.length > 0 && (
            <div style="display: flex; flex-direction: column; gap: 0.4rem;">
              <div style="font-size: 0.74rem; color: var(--text-secondary);">
                {departmentName} ({primaryPyqs.count} {primaryPyqs.count === 1 ? 'paper' : 'papers'}):
              </div>
              <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
                {primaryPyqs.sems.map(sem => (
                  <a
                    href={pyqUrl(primaryCat, baseSubject.toLowerCase(), sem)}
                    style="font-size: 0.74rem; font-weight: 700; color: #34d399; background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); border-radius: 20px; padding: 4px 11px; text-decoration: none;"
                  >
                    Sem {sem} PYQs →
                  </a>
                ))}
              </div>
            </div>
          )}

          {altPyqs.sems.length > 0 && (
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem;">
              <span style="font-size: 0.74rem; color: var(--text-secondary);">{altCat === 'minor' ? 'Minor / AC' : 'Major'} PYQs:</span>
              {altPyqs.sems.map(sem => (
                <a
