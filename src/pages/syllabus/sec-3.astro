---
import Layout from '../../layouts/Layout.astro';
import secData from '../../../public/data/sec.json';
import pyqsData from '../../../public/data/pyqs.json';
import notesData from '../../../public/data/notes.json';
import { ChevronLeft, Download, FileText, Sparkles, Eye, MessageCircle, ExternalLink } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const sec3Syl = secData.find(s => s.id === 'sec-3-mathematical-computational-thinking') || secData[3];
const sec3Pyqs = pyqsData.filter(p => p.category === 'SEC' && p.semester === 3 && !!p.downloadUrl);
const sec3Note = notesData.products.find(n => n.id === 'sec3-mathematical-computational-thinking');
const notesWaLink = (item: string, price: number) =>
  `https://api.whatsapp.com/send?phone=${notesData.whatsapp}&text=${encodeURIComponent(`Hi KolhanHub! 👋 I want to buy: ${item} – ₹${price}. Please send the payment QR.`)}`;

const sec3PyqUrl = `${baseUrl}/pyqs/sec/mathematical%20&%20computational%20thinking%20and%20analysis/3/`;

const faqItems = [
  {
    q: 'Is SEC-3 (Mathematical & Computational Thinking) compulsory for all streams?',
    a: 'Yes! Under Kolhan University NEP 2020 FYUGP, SEC-3 is common across Arts, Science, and Commerce students in Semester 3 across all 37 colleges.'
  },
  {
    q: 'What is the SEC-3 marking scheme and passing marks?',
    a: 'SEC-3 is a 75-mark Theory-only paper (3 credits). There is no separate internal or practical component, and the minimum passing mark is 30 out of 75 (40%).'
  },
  {
    q: 'Which admission batches follow this SEC-3 syllabus?',
    a: 'This official Kolhan University SEC-3 syllabus PDF applies to the 2022–26, 2023–27, and 2024–28 FYUGP batches across all departments.'
  }
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
});
---

<Layout
  title="Kolhan University SEC-3 Syllabus PDF (Sem 3) — NEP FYUGP"
  rawTitle={true}
  description="Download official Kolhan University Sem 3 SEC-3 (Mathematical & Computational Thinking and Analysis) Syllabus PDF, exam pattern, PYQs & handwritten notes."
  keywords="Kolhan University SEC 3 syllabus, Mathematical and Computational Thinking syllabus pdf, Kolhan University Sem 3 SEC-3 syllabus, KU FYUGP SEC-3"
  activeTab="syllabus"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <!-- Breadcrumb Navigation -->
  <div style="margin-bottom: 1.25rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; font-size: 0.85rem;">
    <a href={`${baseUrl}/syllabus/`} style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; color: var(--text-secondary); text-decoration: none;">
      <ChevronLeft size="16" /> Syllabus Directory
    </a>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-secondary); font-weight: 500;">SEC</span>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-primary); font-weight: 600;">SEC-3 (Semester 3)</span>
  </div>

  <!-- Main Header -->
  <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <div style="display: inline-flex; align-items: center; gap: 0.4rem; width: fit-content; font-size: 0.7rem; font-weight: 800; color: #fbbf24; background: rgba(251,191,36,0.12); border: 1px solid rgba(251,191,36,0.3); border-radius: 20px; padding: 3px 10px;">
      <Sparkles size="12" /> Common Paper for All Streams (Arts, Science &amp; Commerce)
    </div>
    <h1 style="font-size: clamp(1.35rem, 5vw, 1.85rem); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin: 0;">
      SEC-3: Mathematical &amp; Computational Thinking and Analysis
    </h1>
    <p style="color: var(--text-secondary); max-width: 680px; font-size: 0.92rem; line-height: 1.55; margin: 0;">
      Official Kolhan University NEP-2020 FYUGP <strong>Semester 3 Skill Enhancement Course (SEC-3)</strong> syllabus, exam pattern, previous year question papers, and handwritten study notes.
    </p>
  </div>

  <div style="display: flex; flex-direction: column; gap: 1.35rem;">

    <!-- Official Syllabus PDF Download Card -->
    <div class="card" style="background: var(--bg-secondary); display: flex; flex-direction: column; gap: 1rem;">
      <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
        <div style="display: flex; gap: 0.85rem; align-items: flex-start; min-width: 0;">
          <div style="width: 44px; height: 44px; border-radius: var(--radius-sm); background: rgba(245,158,11,0.12); color: #fbbf24; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <FileText size="22" />
          </div>
          <div style="min-width: 0;">
            <h2 style="font-size: 1.1rem; font-weight: 800; margin: 0; color: var(--text-primary); font-family: var(--font-display);">
              {sec3Syl.name} — Official Syllabus PDF
            </h2>
            <div style="display: flex; flex-wrap: wrap; gap: 0.55rem; font-size: 0.78rem; color: var(--text-secondary); margin-top: 0.35rem;">
              <span>Semester: <strong>Semester 3</strong></span>
              <span>•</span>
              <span>Credits: <strong>3 Credits</strong></span>
              <span>•</span>
              <span>Full Marks: <strong>75 Marks</strong> (Pass: 30)</span>
            </div>
          </div>
        </div>
        <span style="font-size: 0.68rem; font-weight: 800; background: rgba(245,158,11,0.14); color: #fbbf24; border: 1px solid rgba(245,158,11,0.3); border-radius: 20px; padding: 3px 10px;">
          SEC-3 · 75 Marks
        </span>
      </div>

      <div style="border-top: 1px solid var(--border-color); padding-top: 0.9rem; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; flex-wrap: wrap;">
        <span style="font-size: 0.8rem; color: var(--text-secondary);">
          Applicable to 2022–26, 2023–27 &amp; 2024–28 FYUGP batches across all 37 colleges.
        </span>
        <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
          <a
            href={sec3Syl.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm"
            style="gap: 0.4rem; font-size: 0.82rem;"
            onclick="if(window.trackDownload) window.trackDownload('syllabus', { subject: 'SEC-3 Mathematical & Computational Thinking and Analysis', category: 'SEC', semester: 'Semester 3', department: 'SEC' });"
          >
            <Download size="14" /> Download Official Syllabus PDF
          </a>
          <a
            href={sec3PyqUrl}
            class="btn btn-secondary btn-sm"
            style="gap: 0.4rem; font-size: 0.82rem; text-decoration: none;"
          >
            📄 View SEC-3 PYQ Papers ({sec3Pyqs.length}) →
          </a>
        </div>
      </div>
    </div>

    <!-- SEC-3 Handwritten Study Notes Box (Preserved Paid Notes Funnel) -->
    {sec3Note && (
      <div style={`display: flex; align-items: center; justify-content: space-between; gap: 0.85rem; flex-wrap: wrap; border: 1px solid ${sec3Note.color}44; border-radius: var(--radius-sm); padding: 1rem 1.15rem; background: linear-gradient(135deg, ${sec3Note.color}12 0%, rgba(0,0,0,0.16) 100%);`}>
        <div style="display: flex; align-items: center; gap: 0.65rem; min-width: 0;">
          <span style="font-size: 1.35rem; flex-shrink: 0;">{sec3Note.emoji}</span>
          <div style="min-width: 0;">
            <div style={`font-size: 0.95rem; font-weight: 800; color: ${sec3Note.color}; font-family: var(--font-display);`}>
              {sec3Note.title} — Handwritten Notes PDF
            </div>
            <div style="font-size: 0.76rem; color: var(--text-secondary); margin-top: 2px;">
              Complete exam-focused coaching notes for all streams · View free sample PDF first
            </div>
          </div>
        </div>
        <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <a
            href={sec3Note.demoUrl}
            target="_blank"
            rel="noopener noreferrer"
            onclick={`if(window.trackDownload) window.trackDownload('note', { subject: '${sec3Note.title}', language: 'Free Sample', category: '${sec3Note.course}', medium: 'SEC3_SYLLABUS_PAGE' });`}
            style={`display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.76rem; font-weight: 700; color: ${sec3Note.color}; text-decoration: none; border: 1px solid ${sec3Note.color}66; border-radius: 20px; padding: 6px 13px; white-space: nowrap;`}
          >
            <Eye size="14" /> Free Sample PDF
          </a>
          <a
            href={notesWaLink(`${sec3Note.title} notes (${sec3Note.course})`, sec3Note.price)}
            target="_blank"
            rel="noopener noreferrer"
            onclick={`if(window.trackDownload) window.trackDownload('note', { subject: '${sec3Note.title}', language: 'Get Notes (₹${sec3Note.price})', category: '${sec3Note.course}', medium: 'SEC3_SYLLABUS_PAGE' });`}
            style={`display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.76rem; font-weight: 800; color: #0b0b12; text-decoration: none; background: ${sec3Note.color}; border-radius: 20px; padding: 6px 13px; white-space: nowrap;`}
          >
            <MessageCircle size="14" /> Get Full Notes
          </a>
          <a
            href={`${baseUrl}/notes/`}
            style="font-size: 0.72rem; font-weight: 700; color: var(--text-secondary); text-decoration: none; white-space: nowrap; padding: 4px 6px;"
          >
            See Sem 3 Notes &amp; Bundles →
          </a>
        </div>
      </div>
    )}

    <!-- Quick Links to SEC-3 PYQs -->
    <div class="card" style="background: var(--bg-secondary); display: flex; flex-direction: column; gap: 0.85rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
        <h2 style="font-size: 1.05rem; font-weight: 800; margin: 0; font-family: var(--font-display); color: var(--text-primary);">
          📥 SEC-3 Previous Year Question Papers (Sem 3)
        </h2>
        <a href={sec3PyqUrl} style="font-size: 0.78rem; font-weight: 700; color: #818cf8; text-decoration: none;">
          Open Full SEC-3 PYQ Page →
        </a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 0.65rem;">
        {sec3Pyqs.map(paper => (
          <a
            href={paper.downloadUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.7rem 0.9rem; border-radius: var(--radius-xs); background: var(--bg-tertiary); border: 1px solid var(--border-color); text-decoration: none; color: var(--text-primary); font-size: 0.82rem; font-weight: 700; min-width: 0;"
            onclick={`if(window.trackDownload) window.trackDownload('pyq', { subject: '${paper.title}', category: 'SEC', semester: '3' });`}
          >
            <span>📄 {paper.year} {(paper as any).set ? `— ${(paper as any).set}` : ''}</span>
            <ExternalLink size="14" style="color: #fbbf24; flex-shrink: 0;" />
          </a>
        ))}
      </div>
    </div>

    <!-- Visible FAQ Accordion (Synced with FAQPage JSON-LD) -->
    <section aria-labelledby="sec3-faq-heading">
      <h2 id="sec3-faq-heading" style="font-size: 0.98rem; font-weight: 800; font-family: var(--font-display); margin: 0 0 0.65rem; color: var(--text-primary);">
        ❓ Frequently Asked Questions — SEC-3
      </h2>
      <div style="display: flex; flex-direction: column; gap: 0.45rem;">
        {faqItems.map((item, idx) => (
          <details open={idx === 0} style="border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.7rem 0.9rem; background: var(--bg-secondary);">
            <summary style="font-size: 0.83rem; font-weight: 700; color: var(--text-primary); cursor: pointer;">{item.q}</summary>
            <p style="font-size: 0.79rem; color: var(--text-secondary); line-height: 1.55; margin: 0.5rem 0 0; padding-top: 0.5rem; border-top: 1px solid var(--border-color);">{item.a}</p>
          </details>
        ))}
      </div>
    </section>

  </div>
</Layout>
