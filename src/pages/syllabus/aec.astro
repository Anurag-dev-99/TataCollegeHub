---
import Layout from '../../layouts/Layout.astro';
import aecData from '../../../public/data/aec.json';
import pyqsData from '../../../public/data/pyqs.json';
import markingSchemes from '../../../public/data/paper_marking_schemes.json';
import PastBatchScoreGlimpse from '../../components/PastBatchScoreGlimpse.astro';
import { ChevronLeft } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const aecScheme = markingSchemes.schemes['50_THEORY_ONLY'];

// Group available AEC PYQs by subject
const aecPyqMap = new Map<string, number[]>();
pyqsData.forEach((p: any) => {
  if (p.category === 'AEC' && p.downloadUrl && p.type !== 'notes') {
    const s = p.subject;
    if (!aecPyqMap.has(s)) aecPyqMap.set(s, []);
    const sems = aecPyqMap.get(s)!;
    if (!sems.includes(Number(p.semester))) sems.push(Number(p.semester));
  }
});
const aecPyqSubjects = Array.from(aecPyqMap.entries())
  .map(([subject, sems]) => ({ subject, sems: sems.sort((a, b) => a - b) }))
  .sort((a, b) => a.subject.localeCompare(b.subject));

const faqItems = [
  {
    q: 'What are AEC papers in Kolhan University NEP FYUGP (Sem 1 to 4)?',
    a: 'Ability Enhancement Courses (AEC) focus on language and communication skills. In Sem 3 (AEC-3) and Sem 4 (AEC-4), students continue the same chosen language.'
  },
  {
    q: 'What is the exam pattern and passing marks for AEC?',
    a: `All Kolhan University AEC papers (Sem 1 to 4) are ${aecScheme.fullMarks.total} marks (Theory only, no internal or practical). Minimum passing mark is ${aecScheme.passMarks.total} out of ${aecScheme.fullMarks.total} (40%).`
  },
  {
    q: 'Why do some Sem 4 regional language PDFs say Ranchi University?',
    a: 'Official Kolhan University PDFs are available for AEC-4 Hindi, English, and Sanskrit. For regional languages (Bengali, Ho, Kharia, Khortha, Kurmali, Kurukh, Mundari, Nagpuri, Santali, Urdu), Ranchi University syllabi are linked as reference until official KU PDFs are uploaded.'
  }
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
});
---

<Layout
  title="Kolhan University AEC Syllabus PDF (Sem 1–4) — NEP FYUGP"
  rawTitle={true}
  description="Download Kolhan University NEP FYUGP AEC (Ability Enhancement Course) syllabus PDFs for Sem 1 to 4 — Hindi, English, Sanskrit & regional languages + PYQs."
  keywords="Kolhan University AEC syllabus, Kolhan University AEC Hindi English syllabus pdf, AEC 1 AEC 2 AEC 3 AEC 4 syllabus Kolhan University"
  activeTab="syllabus"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <div style="margin-bottom: 1.1rem; display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; font-size: 0.85rem;">
    <a href={`${baseUrl}/syllabus/`} style="display: inline-flex; align-items: center; gap: 0.25rem; font-weight: 600; color: var(--text-secondary); text-decoration: none;">
      <ChevronLeft size="16" /> Syllabus Directory
    </a>
    <span style="color: var(--text-tertiary);">/</span>
    <span style="color: var(--text-primary); font-weight: 600;">AEC Syllabus</span>
  </div>

  <div style="margin-bottom: 1.15rem; display: flex; flex-direction: column; gap: 0.4rem;">
    <h1 style="font-size: clamp(1.38rem, 5vw, 1.9rem); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin: 0;">
      Kolhan University AEC Syllabus PDF
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.86rem; line-height: 1.45; margin: 0;">
      Ability Enhancement Course &bull; Sem 1–4 &bull; All 37 Colleges
    </p>
    <div style="margin-top: 0.25rem; font-size: 0.75rem; color: var(--text-secondary); background: rgba(16,185,129,0.08); border: 1px solid rgba(16,185,129,0.25); border-radius: var(--radius-xs); padding: 0.45rem 0.7rem; width: fit-content;">
      📊 <strong style="color: var(--text-accent-green);">Exam Pattern:</strong> {aecScheme.fullMarks.total} Marks (Theory Only) &bull; Pass: {aecScheme.passMarks.total} &bull; AEC-3 &amp; AEC-4 are the same language
    </div>
  </div>

  <!-- All 18 AEC PDFs -->
  <section class="card" style="background: var(--bg-secondary); padding: 1rem; margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
    <div id="aec-page-tabs" class="aec-pill-row">
      <button type="button" class="btn btn-secondary aec-p-tab aec-pill active" data-semester="all">All ({aecData.length})</button>
      <button type="button" class="btn btn-secondary aec-p-tab aec-pill" data-semester="Semester 1">Sem 1</button>
      <button type="button" class="btn btn-secondary aec-p-tab aec-pill" data-semester="Semester 2">Sem 2</button>
      <button type="button" class="btn btn-secondary aec-p-tab aec-pill" data-semester="Semester 3">Sem 3</button>
      <button type="button" class="btn btn-secondary aec-p-tab aec-pill" data-semester="Semester 4">Sem 4</button>
    </div>

    <div style="position: relative; display: flex; align-items: center;">
      <input type="text" id="aec-page-search" class="form-input" placeholder="Search AEC subjects..." style="height: 35px; padding-left: 2rem; font-size: 0.82rem; width: 100%; border-radius: var(--radius-xs);" />
      <span style="position: absolute; left: 0.65rem; color: var(--text-tertiary); font-size: 0.85rem;">🔍</span>
    </div>

    <div id="aec-page-sem4-note" style="display: none; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.25); border-radius: var(--radius-xs); padding: 0.45rem 0.7rem; font-size: 0.72rem; color: var(--text-secondary);">
      <span>⚠️ Sem 4 regional PDFs are Ranchi Univ. reference.</span>
      <button type="button" onclick="document.dispatchEvent(new CustomEvent('open-submit-modal'));" style="background:none; border:none; padding:0; color: var(--text-accent-amber); font-weight:700; font-size:0.72rem; cursor:pointer;">
        Have Kolhan Univ. PDF? Share →
      </button>
    </div>

    <div id="aec-page-grid" class="aec-wide-grid">
      {aecData.map(item => (
        <a
          href={item.link}
          target="_blank"
          rel="noopener noreferrer"
          class="card card-interactive aec-p-item"
          data-name={item.name.toLowerCase()}
          data-semester={item.semester}
          style="padding: 0.7rem 0.85rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; min-width: 0;"
          onclick={`if(window.trackDownload) window.trackDownload('syllabus', { subject: '${item.name}', category: 'AEC', semester: '${item.semester || 'Unknown'}', department: 'AEC' });`}
        >
          <div style="display: flex; flex-direction: column; gap: 2px; min-width: 0;">
            <span style="font-weight: 700; font-size: 0.85rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
              {item.name}
            </span>
            <span style="font-size: 0.7rem; color: var(--text-secondary);">{item.semester}</span>
          </div>
          <span style="color: var(--text-accent-green); font-size: 0.95rem; margin-left: 0.45rem; flex-shrink: 0;">📥</span>
        </a>
      ))}
    </div>

    <div id="aec-page-empty" style="display: none; text-align: center; padding: 1.5rem 0.5rem; color: var(--text-secondary); font-size: 0.86rem;">
      No matching AEC subjects found.
    </div>
  </section>

  <!-- Past Batch Score Glimpse (AEC Comparison) -->
  <PastBatchScoreGlimpse mode="category" category="aec" marginTop="0" marginBottom="1.25rem" />

  <!-- Matching AEC PYQs Cross-Links -->
  <section class="card" style="background: linear-gradient(135deg, rgba(16,185,129,0.05) 0%, rgba(99,102,241,0.04) 100%); border-color: rgba(16,185,129,0.24); margin-bottom: 1.25rem; display: flex; flex-direction: column; gap: 0.7rem;">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap;">
      <h2 style="font-size: 1rem; font-weight: 800; font-family: var(--font-display); margin: 0; color: var(--text-primary);">
        📝 Practice AEC Previous Year Papers (PYQs)
      </h2>
      <a href={`${baseUrl}/pyqs/#aec-pyq-trigger`} style="font-size: 0.74rem; font-weight: 700; color: var(--text-accent-green); text-decoration: none;">
        All AEC PYQs →
      </a>
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 0.55rem;">
      {aecPyqSubjects.map(({ subject, sems }) => (
        <div style="background: var(--surface-subtle); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.55rem 0.7rem; display: flex; flex-direction: column; gap: 0.35rem; min-width: 0;">
          <span style="font-size: 0.82rem; font-weight: 700; color: var(--text-primary);">AEC {subject}</span>
          <div style="display: flex; flex-wrap: wrap; gap: 0.3rem;">
            {sems.map(sem => (
              <a
                href={`${baseUrl}/pyqs/aec/${encodeURI(subject.toLowerCase())}/${sem}/`}
                style="font-size: 0.68rem; font-weight: 700; color: var(--text-accent-green); background: rgba(16,185,129,0.12); border: 1px solid rgba(16,185,129,0.3); border-radius: 20px; padding: 2px 8px; text-decoration: none;"
              >
                Sem {sem}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Visible FAQ Accordion -->
  <section aria-labelledby="aec-faq-heading" style="margin-bottom: 1.25rem;">
    <h2 id="aec-faq-heading" style="font-size: 0.98rem; font-weight: 800; font-family: var(--font-display); margin: 0 0 0.65rem; color: var(--text-primary);">
      ❓ Frequently Asked Questions — AEC
    </h2>
    <div style="display: flex; flex-direction: column; gap: 0.45rem;">
      {faqItems.map((item, idx) => (
        <details open={idx === 0} style="border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.7rem 0.9rem; background: var(--bg-secondary);">
          <summary style="font-size: 0.83rem; font-weight: 700; color: var(--text-primary); cursor: pointer;">{item.q}</summary>
          <p style="font-size: 0.79rem; color: var(--text-secondary); line-height: 1.55; margin: 0.5rem 0 0; padding-top: 0.5rem; border-top: 1px solid var(--border-color);">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- 2×2 Student Tools Strip -->
  <section aria-labelledby="aec-tools-heading" style="margin-bottom: 0.5rem;">
    <h2 id="aec-tools-heading" style="font-size: 0.98rem; font-weight: 800; font-family: var(--font-display); margin: 0 0 0.65rem; color: var(--text-primary);">
      🛠️ Student Tools
    </h2>
    <div class="aec-tools-grid">
      <a href={`${baseUrl}/pyqs/`} class="card aec-tool-card">
        <span style="font-size: 1.05rem;">📝</span>
        <div style="min-width: 0;">
          <div style="font-size: 0.82rem; font-weight: 700; color: var(--text-primary);">Previous Year Papers</div>
          <div style="font-size: 0.68rem; color: var(--text-tertiary);">Sem 1–7 PDFs</div>
        </div>
      </a>
      <a href={`${baseUrl}/syllabus/`} class="card aec-tool-card">
        <span style="font-size: 1.05rem;">📖</span>
        <div style="min-width: 0;">
          <div style="font-size: 0.82rem; font-weight: 700; color: var(--text-primary);">All Syllabi</div>
          <div style="font-size: 0.68rem; color: var(--text-tertiary);">Major, Minor, MDC, VAC</div>
        </div>
      </a>
      <a href={`${baseUrl}/results/`} class="card aec-tool-card">
        <span style="font-size: 1.05rem;">📊</span>
        <div style="min-width: 0;">
          <div style="font-size: 0.82rem; font-weight: 700; color: var(--text-primary);">University Results</div>
          <div style="font-size: 0.68rem; color: var(--text-tertiary);">All 37 Colleges</div>
        </div>
      </a>
      <a href={`${baseUrl}/cgpa/`} class="card aec-tool-card">
        <span style="font-size: 1.05rem;">🧮</span>
        <div style="min-width: 0;">
          <div style="font-size: 0.82rem; font-weight: 700; color: var(--text-primary);">CGPA Calculator</div>
          <div style="font-size: 0.68rem; color: var(--text-tertiary);">SGPA to %</div>
        </div>
      </a>
    </div>
  </section>

  <style>
    .aec-pill-row {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.35rem;
      padding-bottom: 0.15rem;
      scrollbar-width: none;
    }
    .aec-pill-row::-webkit-scrollbar { display: none; }
    .aec-pill {
      height: 31px;
      font-size: 0.75rem;
      padding: 0 0.75rem;
      border-radius: 20px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .aec-p-tab.active {
      background-color: rgba(16, 185, 129, 0.14) !important;
      color: var(--text-accent-green) !important;
      border-color: rgba(16, 185, 129, 0.45) !important;
    }
    .aec-wide-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.55rem;
    }
    @media (min-width: 520px) {
      .aec-wide-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .aec-tools-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }
    .aec-tool-card {
      padding: 0.72rem 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      text-decoration: none;
      min-width: 0;
    }
  </style>

  <script>
    const tabs = document.querySelectorAll('.aec-p-tab');
    const search = document.getElementById('aec-page-search') as HTMLInputElement | null;
    const items = document.querySelectorAll('.aec-p-item') as NodeListOf<HTMLElement>;
    const empty = document.getElementById('aec-page-empty');
    const sem4Note = document.getElementById('aec-page-sem4-note');
    let activeSem = 'all';
    let query = '';
    const applyFilter = () => {
      let count = 0;
      items.forEach(el => {
        const name = el.getAttribute('data-name') || '';
        const sem = el.getAttribute('data-semester') || '';
        const show = (activeSem === 'all' || sem === activeSem) && name.includes(query);
        el.style.display = show ? 'flex' : 'none';
        if (show) count++;
      });
      if (empty) empty.style.display = count === 0 ? 'block' : 'none';
      if (sem4Note) sem4Note.style.display = activeSem === 'Semester 4' ? 'flex' : 'none';
    };
    tabs.forEach(t => t.addEventListener('click', () => {
      tabs.forEach(b => b.classList.remove('active'));
      t.classList.add('active');
      activeSem = t.getAttribute('data-semester') || 'all';
      applyFilter();
    }));
    search?.addEventListener('input', () => {
      query = search.value.toLowerCase().trim();
      applyFilter();
    });
  </script>
</Layout>
