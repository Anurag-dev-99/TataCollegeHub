---
import Layout from '../../layouts/Layout.astro';
import syllabusData from '../../../public/data/syllabus.json';
import mdcData from '../../../public/data/mdc.json';
import aecData from '../../../public/data/aec.json';
import vacData from '../../../public/data/vac.json';
import secData from '../../../public/data/sec.json';
import { BookOpen, GraduationCap, ChevronRight, FileText, Compass, Award } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = ["Science", "Arts & Humanities", "Commerce & Business", "Languages"];

// Sort MDC data alphabetically by subject name
const sortedMdcData = [...mdcData].sort((a, b) => a.name.localeCompare(b.name));

// Create slug helper
const getSlug = (dept: string) => {
  return dept.toLowerCase().replace(/\s+/g, '-');
};

// Filter syllabus to only keep ones with actual PDF files
const activeDepartments = ['Mathematics', 'Physics', 'Mathematics Minor', 'Physics Minor'];
const filteredSyllabusData = syllabusData.filter(item => activeDepartments.includes(item.department));

// Group syllabuses by department to show summaries in card
interface SyllabusItem {
  id: string;
  title: string;
  department: string;
  semester: string;
  effectiveFrom: string;
  fileSize: string;
  description: string;
  modules: string[];
}

const deptGroups: Record<string, SyllabusItem[]> = {};
filteredSyllabusData.forEach(item => {
  if (!deptGroups[item.department]) {
    deptGroups[item.department] = [];
  }
  deptGroups[item.department].push(item);
});

const departments = Object.keys(deptGroups);
---

<Layout 
  title="Kolhan University Syllabus — NEP 2020 FYUGP | Tata College, Chaibasa"
  description="Download complete Kolhan University NEP 2020 FYUGP syllabus for Tata College, Chaibasa. Official curriculum PDFs for the 2022 batch — Major Honours, Minor, MDC, AEC, VAC, and SEC courses for Semester 1 to 8. Free Kolhan syllabus download."
  keywords="Kolhan University syllabus, Kolhan syllabus download, Kolhan University NEP 2020 syllabus, Kolhan University FYUGP syllabus, Tata College syllabus, Tata College Chaibasa curriculum, 2022 batch Kolhan University syllabus, Major Minor MDC AEC VAC SEC syllabus, Kolhan University Chaibasa, NEP syllabus Kolhan, Kolhan University semester syllabus"
  activeTab="syllabus"
>

  <!-- Header -->
  <div style="margin-bottom: 2.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Kolhan University Syllabus</h1>
    <p style="color: var(--text-secondary); max-width: 650px; font-size: 1.05rem; line-height: 1.6;">
      Official <strong>Kolhan University NEP 2020 FYUGP syllabus</strong> for Tata College, Chaibasa students.
      Download curriculum PDFs for the <strong>2022 batch</strong> &mdash; Major Honours, Minor, MDC, AEC, VAC &amp; SEC courses across Semester 1 to 8.
    </p>
  </div>

  <!-- Course Types Selection Section -->
  <!-- Course Types Selection Section (Accordion Layout matching PYQ) -->
  <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem;">
    
    <!-- Major Honours Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <Compass style="color: var(--accent-primary); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Major (Honours) Syllabus</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content">
        <div class="accordion-content-inner" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.25rem;">
            Select your department below to view course outlines, semester details, and download official FYUGP curriculum PDFs.
          </p>
          <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
            {departments
              .filter(dept => !dept.toLowerCase().includes('minor'))
              .map(dept => {
                const items = deptGroups[dept];
                const firstItem = items[0];
                const slug = getSlug(dept);
                
                return (
                  <a href={`${baseUrl}/syllabus/${slug}`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit;">
                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                      <div style="background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                        <BookOpen size="22" />
                      </div>
                      <span class="badge badge-primary" style="font-size: 0.7rem;">FYUGP NEP</span>
                    </div>
                    
                    <div>
                      <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">{dept}</h3>
                      <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        {firstItem.description}
                      </p>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                      <span>{items.length} Course {items.length > 1 ? 'Outlines' : 'Outline'}</span>
                      <span style="display: flex; align-items: center; font-weight: 700; color: var(--accent-primary);">View Semesters <ChevronRight size="14" /></span>
                    </div>
                  </a>
                );
              })}
          </div>
        </div>
      </div>
    </div>

    <!-- Minor Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <Award style="color: var(--accent-success); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Minor Syllabus</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content">
        <div class="accordion-content-inner" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.25rem;">
            Official Kolhan University FYUGP Minor course credit requirement syllabuses.
          </p>
          <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
            {departments
              .filter(dept => dept.toLowerCase().includes('minor'))
              .map(dept => {
                const items = deptGroups[dept];
                const firstItem = items[0];
                const slug = getSlug(dept);
                
                return (
                  <a href={`${baseUrl}/syllabus/${slug}`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit;">
                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                      <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                        <GraduationCap size="22" />
                      </div>
                      <span class="badge badge-success" style="font-size: 0.7rem;">Minor Paper</span>
                    </div>
                    
                    <div>
                      <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">{dept}</h3>
                      <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        {firstItem.description}
                      </p>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                      <span>Effective: {firstItem.effectiveFrom}</span>
                      <span style="display: flex; align-items: center; font-weight: 700; color: var(--accent-success);">View Semesters <ChevronRight size="14" /></span>
                    </div>
                  </a>
                );
              })}
          </div>
        </div>
      </div>
    </div>

    <!-- Multidisciplinary Courses (MDC) Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <Compass style="color: var(--accent-warning); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Multidisciplinary Course (MDC) Syllabus</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content" id="mdc-accordion-content">
        <div class="accordion-content-inner" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.25rem;">
            Under NEP 2020, students choose 3 Multidisciplinary Courses (MDC) from outside their major/minor disciplines. Select a course below to download the official PDF.
          </p>
          
          <!-- MDC Categories & Filter Tabs -->
          <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
            <div id="mdc-tabs" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem; align-items: center;">
              <button class="btn btn-secondary mdc-tab-btn active" data-category="all" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                All ({mdcData.length})
              </button>
              {categories.map(cat => (
                <button class="btn btn-secondary mdc-tab-btn" data-category={cat} style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                  {cat} ({mdcData.filter(item => item.category === cat).length})
                </button>
              ))}
              
              <!-- Search input for MDC subjects -->
              <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="mdc-search-wrapper">
                <input type="text" id="mdc-search-input" class="form-input" placeholder="Search MDC subjects..." style="height: 38px; padding-left: 2.25rem; font-size: 0.85rem; width: 220px; border-radius: var(--radius-xs);" />
                <span style="position: absolute; left: 0.75rem; color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 0.9rem;">🔍</span>
              </div>
            </div>

            <!-- MDC Subjects Grid -->
            <div id="mdc-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
              {sortedMdcData.map(item => (
                <a 
                  href={item.link} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="card card-interactive mdc-item" 
                  data-name={item.name.toLowerCase()} 
                  data-category={item.category} 
                  style="padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s;"
                >
                  <div style="display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;">
                    <span style="font-weight: 700; font-size: 0.925rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                      {item.name}
                    </span>
                    <span style="font-size: 0.75rem; color: var(--text-secondary);">
                      {item.category}
                    </span>
                  </div>
                  <span class="mdc-dl-icon" style="color: var(--accent-primary); font-size: 1.1rem; margin-left: 0.5rem; transition: transform 0.2s; display: inline-block;">
                    📥
                  </span>
                </a>
              ))}
            </div>

            <!-- Empty state -->
            <div id="mdc-empty" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary); font-size: 0.95rem;">
              No matching MDC subjects found.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Ability Enhancement Courses (AEC) Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" id="aec-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <Compass style="color: var(--accent-success); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Ability Enhancement Course (AEC) Syllabus</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content" id="aec-accordion-content">
        <div class="accordion-content-inner" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.25rem;">
            Under NEP 2020, Ability Enhancement Courses focus on developing language, communication, and critical thinking skills. Select your semester below.
          </p>
          
          <!-- AEC Semester Filter Tabs -->
          <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
            <div id="aec-tabs" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem; align-items: center;">
              <button class="btn btn-secondary aec-tab-btn active" data-semester="all" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                All ({aecData.length})
              </button>
              <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 1" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 1
              </button>
              <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 2" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 2
              </button>
              <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 3" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 3
              </button>
              <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 4" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 4
              </button>
              
              <!-- Search input for AEC subjects -->
              <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="aec-search-wrapper">
                <input type="text" id="aec-search-input" class="form-input" placeholder="Search AEC subjects..." style="height: 38px; padding-left: 2.25rem; font-size: 0.85rem; width: 220px; border-radius: var(--radius-xs);" />
                <span style="position: absolute; left: 0.75rem; color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 0.9rem;">🔍</span>
              </div>
            </div>

            <!-- AEC Subjects Grid -->
            <div id="aec-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
              {aecData.map(item => (
                <a 
                  href={item.link} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="card card-interactive aec-item" 
                  data-name={item.name.toLowerCase()} 
                  data-semester={item.semester} 
                  style="padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s;"
                >
                  <div style="display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;">
                    <span style="font-weight: 700; font-size: 0.925rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                      {item.name}
                    </span>
                    <span style="font-size: 0.75rem; color: var(--text-secondary);">
                      {item.semester}
                    </span>
                  </div>
                  <span class="aec-dl-icon" style="color: var(--accent-success); font-size: 1.1rem; margin-left: 0.5rem; transition: transform 0.2s; display: inline-block;">
                    📥
                  </span>
                </a>
              ))}
            </div>

            <!-- Empty state -->
            <div id="aec-empty" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary); font-size: 0.95rem;">
              No matching AEC subjects found.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Value Added Courses (VAC) Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" id="vac-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <Award style="color: var(--accent-primary); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Value Added Course (VAC) Syllabus</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content" id="vac-accordion-content">
        <div class="accordion-content-inner" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.25rem;">
            Under NEP 2020, Value Added Courses (VAC) are designed to provide holistic education. In Semester 1, students take two 2-credit courses: VAC-1(A) (compulsory: Understanding India) and VAC-1(B) (choose one from EVS, Health & Wellness, or Yoga). In Semester 4, students take the 2-credit VAC-2 course (Global Citizenship Education).
          </p>
          
          <!-- VAC Semester Filter Tabs -->
          <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
            <div id="vac-tabs" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem; align-items: center;">
              <button class="btn btn-secondary vac-tab-btn active" data-semester="all" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                All ({vacData.length})
              </button>
              <button class="btn btn-secondary vac-tab-btn" data-semester="Semester 1" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 1
              </button>
              <button class="btn btn-secondary vac-tab-btn" data-semester="Semester 4" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 4
              </button>
              
              <!-- Search input for VAC subjects -->
              <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="vac-search-wrapper">
                <input type="text" id="vac-search-input" class="form-input" placeholder="Search VAC subjects..." style="height: 38px; padding-left: 2.25rem; font-size: 0.85rem; width: 220px; border-radius: var(--radius-xs);" />
                <span style="position: absolute; left: 0.75rem; color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 0.9rem;">🔍</span>
              </div>
            </div>

            <!-- VAC Subjects Grid -->
            <div id="vac-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
              {vacData.map(item => (
                <a 
                  href={item.link} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="card card-interactive vac-item" 
                  data-name={item.name.toLowerCase()} 
                  data-semester={item.semester} 
                  style="padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s;"
                >
                  <div style="display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;">
                    <span style="font-weight: 700; font-size: 0.925rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                      {item.name}
                    </span>
                    <span style="font-size: 0.75rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.15rem;">
                      <span>{item.semester}</span>
                      <span style="font-size: 0.65rem; color: var(--accent-primary); font-weight: 600;">{item.type}</span>
                    </span>
                  </div>
                  <span class="vac-dl-icon" style="color: var(--accent-primary); font-size: 1.1rem; margin-left: 0.5rem; transition: transform 0.2s; display: inline-block;">
                    📥
                  </span>
                </a>
              ))}
            </div>

            <!-- Empty state -->
            <div id="vac-empty" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary); font-size: 0.95rem;">
              No matching VAC subjects found.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Skill Enhancement Course (SEC) Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" id="sec-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <BookOpen style="color: var(--accent-warning); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Skill Enhancement Course (SEC) Syllabus</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content" id="sec-accordion-content">
        <div class="accordion-content-inner" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.25rem;">
            Under NEP 2020, Skill Enhancement Courses (SEC) are designed to provide hands-on training, competency, and skills. Select your semester below.
          </p>
          
          <!-- SEC Semester Filter Tabs -->
          <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
            <div id="sec-tabs" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem; align-items: center;">
              <button class="btn btn-secondary sec-tab-btn active" data-semester="all" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                All ({secData.length})
              </button>
              <button class="btn btn-secondary sec-tab-btn" data-semester="Semester 1" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 1
              </button>
              <button class="btn btn-secondary sec-tab-btn" data-semester="Semester 2" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 2
              </button>
              <button class="btn btn-secondary sec-tab-btn" data-semester="Semester 3" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
                Sem 3
              </button>
              
              <!-- Search input for SEC subjects -->
              <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="sec-search-wrapper">
                <input type="text" id="sec-search-input" class="form-input" placeholder="Search SEC subjects..." style="height: 38px; padding-left: 2.25rem; font-size: 0.85rem; width: 220px; border-radius: var(--radius-xs);" />
                <span style="position: absolute; left: 0.75rem; color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 0.9rem;">🔍</span>
              </div>
            </div>

            <!-- SEC Subjects Grid -->
            <div id="sec-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
              {secData.map(item => (
                <a 
                  href={item.link} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="card card-interactive sec-item" 
                  data-name={item.name.toLowerCase()} 
                  data-semester={item.semester} 
                  style="padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s;"
                >
                  <div style="display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;">
                    <span style="font-weight: 700; font-size: 0.925rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                      {item.name}
                    </span>
                    <span style="font-size: 0.75rem; color: var(--text-secondary);">
                      {item.semester}
                    </span>
                  </div>
                  <span class="sec-dl-icon" style="color: var(--accent-warning); font-size: 1.1rem; margin-left: 0.5rem; transition: transform 0.2s; display: inline-block;">
                    📥
                  </span>
                </a>
              ))}
            </div>

            <!-- Empty state -->
            <div id="sec-empty" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary); font-size: 0.95rem;">
              No matching SEC subjects found.
            </div>
          </div>
      </div>
    </div>
  </div>

  <!-- Quick Contribution Card -->
  <div class="card" style="background-color: var(--bg-tertiary); text-align: center; display: flex; flex-direction: column; gap: 0.75rem; margin-top: 2.5rem; max-width: 600px; margin-left: auto; margin-right: auto; padding: 1.75rem;">
    <h3 style="font-size: 1.15rem; font-family: var(--font-display); font-weight: 800; color: var(--text-primary);">Missing a paper?</h3>
    <p style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.5; max-width: 480px; margin: 0 auto;">
      Help fellow college students by contributing missing papers, or request a specific semester PYQ paper!
    </p>
    <div style="display: flex; gap: 0.75rem; width: 100%; margin-top: 0.5rem; justify-content: center; flex-wrap: wrap;">
      <button 
        class="btn btn-outline btn-sm" 
        style="flex: 1; min-width: 200px; max-width: 240px; font-weight: 700;"
        onclick="document.dispatchEvent(new CustomEvent('open-submit-modal'));"
      >
        Submit / Upload Paper
      </button>
      <button 
        class="btn btn-primary btn-sm" 
        style="flex: 1; min-width: 200px; max-width: 240px; font-weight: 700;"
        onclick="document.dispatchEvent(new CustomEvent('open-request-modal'));"
      >
        Request a Paper
      </button>
    </div>
  </div>

  <style>
    .db-filter-btn.active {
      background-color: rgba(99, 102, 241, 0.1) !important;
      color: var(--accent-primary) !important;
      border-color: var(--accent-primary) !important;
    }
    
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(0, 0, 0, 0.1);
      border-radius: var(--radius-full);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: var(--border-color);
      border-radius: var(--radius-full);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: var(--text-tertiary);
    }

    .mdc-tab-btn.active {
      background-color: rgba(99, 102, 241, 0.1) !important;
      color: var(--accent-primary) !important;
      border-color: var(--accent-primary) !important;
    }
    
    .aec-tab-btn.active {
      background-color: rgba(16, 185, 129, 0.1) !important;
      color: var(--accent-success) !important;
      border-color: var(--accent-success) !important;
    }
    
    .vac-tab-btn.active {
      background-color: rgba(99, 102, 241, 0.1) !important;
      color: var(--accent-primary) !important;
      border-color: var(--accent-primary) !important;
    }

    .sec-tab-btn.active {
      background-color: rgba(245, 158, 11, 0.1) !important;
      color: var(--accent-warning) !important;
      border-color: var(--accent-warning) !important;
    }
    
    .mdc-item:hover .mdc-dl-icon, .aec-item:hover .aec-dl-icon, .vac-item:hover .vac-dl-icon, .sec-item:hover .sec-dl-icon {
      transform: translateY(-2px);
    }
    
    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease-out;
      background-color: rgba(0, 0, 0, 0.15);
    }
    
    .accordion-trigger:hover {
      background-color: rgba(99, 102, 241, 0.04);
    }
    
    @media (max-width: 767px) {
      .mdc-search-wrapper, .aec-search-wrapper, .vac-search-wrapper, .sec-search-wrapper {
        width: 100% !important;
        margin-top: 0.75rem;
      }
      .mdc-search-wrapper input, .aec-search-wrapper input, .vac-search-wrapper input, .sec-search-wrapper input {
        width: 100% !important;
      }
      #mdc-tabs, #aec-tabs, #vac-tabs, #sec-tabs {
        padding-bottom: 1rem;
      }
    }
  </style>

  <script>
    // Accordion Toggle Logic
    const accordionTriggers = document.querySelectorAll('.accordion-trigger');
    
    // Add custom handling for initially open accordions
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.accordion-trigger.active-initially').forEach(btn => {
        const content = btn.nextElementSibling as HTMLElement;
        if (content) {
          content.classList.add('open');
          content.style.maxHeight = 'none';
        }
      });
    });

    accordionTriggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const content = btn.nextElementSibling as HTMLElement;
        const chevron = btn.querySelector('.chevron') as HTMLElement;

        const isOpen = content.classList.contains('open');

        // Close all other accordions first for clean UI
        document.querySelectorAll('.accordion-content').forEach(c => {
          const contentEl = c as HTMLElement;
          if (contentEl !== content && contentEl.classList.contains('open')) {
            contentEl.classList.remove('open');
            contentEl.style.maxHeight = contentEl.scrollHeight + 'px';
            void contentEl.offsetHeight; // force reflow
            contentEl.style.maxHeight = '0px';

            const siblingBtn = contentEl.previousElementSibling as HTMLElement;
            if (siblingBtn) {
              siblingBtn.style.backgroundColor = 'transparent';
              const sibChevron = siblingBtn.querySelector('.chevron') as HTMLElement;
              if (sibChevron) sibChevron.style.transform = 'rotate(0deg)';
            }
          }
        });

        if (!isOpen) {
          content.classList.add('open');
          content.style.maxHeight = content.scrollHeight + 'px';
          if (chevron) chevron.style.transform = 'rotate(90deg)';
          btn.style.backgroundColor = 'rgba(99, 102, 241, 0.08)';

          // Transition to none to allow dynamic height changes (tab filtering / search)
          const handleTransitionEnd = (event: TransitionEvent) => {
            if (event.propertyName === 'max-height') {
              if (content.classList.contains('open')) {
                content.style.maxHeight = 'none';
              }
              content.removeEventListener('transitionend', handleTransitionEnd);
            }
          };
          content.addEventListener('transitionend', handleTransitionEnd);
        } else {
          content.classList.remove('open');
          // Collapse from current height
          content.style.maxHeight = content.scrollHeight + 'px';
          void content.offsetHeight; // force reflow
          content.style.maxHeight = '0px';
          if (chevron) chevron.style.transform = 'rotate(0deg)';
          btn.style.backgroundColor = 'transparent';
        }
      });
    });

    const tabBtns = document.querySelectorAll('.mdc-tab-btn');
    const searchInput = document.getElementById('mdc-search-input') as HTMLInputElement;
    const mdcItems = document.querySelectorAll('.mdc-item') as NodeListOf<HTMLAnchorElement>;
    const emptyState = document.getElementById('mdc-empty');

    let activeCategory = 'all';
    let searchQuery = '';

    const filterMdc = () => {
      let visibleCount = 0;

      mdcItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const category = item.getAttribute('data-category') || '';

        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = name.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        tabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');

        activeCategory = clickedBtn.getAttribute('data-category') || 'all';
        filterMdc();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterMdc();
    });

    // AEC Filtering Logic
    const aecTabBtns = document.querySelectorAll('.aec-tab-btn');
    const aecSearchInput = document.getElementById('aec-search-input') as HTMLInputElement;
    const aecItems = document.querySelectorAll('.aec-item') as NodeListOf<HTMLAnchorElement>;
    const aecEmptyState = document.getElementById('aec-empty');

    let activeAecSemester = 'all';
    let aecSearchQuery = '';

    const filterAec = () => {
      let visibleCount = 0;

      aecItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const semester = item.getAttribute('data-semester') || '';

        const matchesSemester = activeAecSemester === 'all' || semester === activeAecSemester;
        const matchesSearch = name.includes(aecSearchQuery);

        if (matchesSemester && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (aecEmptyState) {
        aecEmptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    aecTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        aecTabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');

        activeAecSemester = clickedBtn.getAttribute('data-semester') || 'all';
        filterAec();
      });
    });

    aecSearchInput?.addEventListener('input', (e) => {
      aecSearchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterAec();
    });

    // VAC Filtering Logic
    const vacTabBtns = document.querySelectorAll('.vac-tab-btn');
    const vacSearchInput = document.getElementById('vac-search-input') as HTMLInputElement;
    const vacItems = document.querySelectorAll('.vac-item') as NodeListOf<HTMLAnchorElement>;
    const vacEmptyState = document.getElementById('vac-empty');

    let activeVacSemester = 'all';
    let vacSearchQuery = '';

    const filterVac = () => {
      let visibleCount = 0;

      vacItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const semester = item.getAttribute('data-semester') || '';

        const matchesSemester = activeVacSemester === 'all' || semester === activeVacSemester;
        const matchesSearch = name.includes(vacSearchQuery);

        if (matchesSemester && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (vacEmptyState) {
        vacEmptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    vacTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        vacTabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');

        activeVacSemester = clickedBtn.getAttribute('data-semester') || 'all';
        filterVac();
      });
    });

    vacSearchInput?.addEventListener('input', (e) => {
      vacSearchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterVac();
    });

    // SEC Filtering Logic
    const secTabBtns = document.querySelectorAll('.sec-tab-btn');
    const secSearchInput = document.getElementById('sec-search-input') as HTMLInputElement;
    const secItems = document.querySelectorAll('.sec-item') as NodeListOf<HTMLAnchorElement>;
    const secEmptyState = document.getElementById('sec-empty');

    let activeSecSemester = 'all';
    let secSearchQuery = '';

    const filterSec = () => {
      let visibleCount = 0;

      secItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const semester = item.getAttribute('data-semester') || '';

        const matchesSemester = activeSecSemester === 'all' || semester === activeSecSemester;
        const matchesSearch = name.includes(secSearchQuery);

        if (matchesSemester && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (secEmptyState) {
        secEmptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    secTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        secTabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');

        activeSecSemester = clickedBtn.getAttribute('data-semester') || 'all';
        filterSec();
      });
    });

    secSearchInput?.addEventListener('input', (e) => {
      secSearchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterSec();
    });

    // --- Searchable Syllabi Database Script ---
    const dbSearchInput = document.getElementById('db-search-input') as HTMLInputElement;
    const dbItems = document.querySelectorAll('.db-item') as NodeListOf<HTMLElement>;
    const dbEmptyState = document.getElementById('db-empty');
    const dbShowingCount = document.getElementById('db-showing-count');
    
    let dbSearchQuery = '';
    let dbActiveCat = 'all';
    let dbActiveLevel = 'all';
    let dbActiveType = 'all';

    const filterDatabase = () => {
      let visibleCount = 0;

      dbItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const category = item.getAttribute('data-category') || '';
        const level = item.getAttribute('data-level') || '';
        const type = item.getAttribute('data-type') || '';

        const matchesSearch = !dbSearchQuery || name.includes(dbSearchQuery);
        const matchesCategory = dbActiveCat === 'all' || category === dbActiveCat;
        const matchesLevel = dbActiveLevel === 'all' || level === dbActiveLevel;
        const matchesType = dbActiveType === 'all' || type === dbActiveType;

        if (matchesSearch && matchesCategory && matchesLevel && matchesType) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (dbEmptyState) {
        dbEmptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
      if (dbShowingCount) {
        dbShowingCount.innerHTML = `Showing <strong>${visibleCount}</strong> items`;
      }
    };

    // Listen to text search input
    dbSearchInput?.addEventListener('input', (e) => {
      dbSearchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterDatabase();
    });

    // Category filter button click handlers
    const catBtns = document.querySelectorAll('.db-filter-btn.cat');
    catBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        catBtns.forEach(b => b.classList.remove('active'));
        const clicked = e.currentTarget as HTMLElement;
        clicked.classList.add('active');
        dbActiveCat = clicked.getAttribute('data-filter') || 'all';
        filterDatabase();
      });
    });

    // Level filter button click handlers
    const levelBtns = document.querySelectorAll('.db-filter-btn.level');
    levelBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        levelBtns.forEach(b => b.classList.remove('active'));
        const clicked = e.currentTarget as HTMLElement;
        clicked.classList.add('active');
        dbActiveLevel = clicked.getAttribute('data-filter') || 'all';
        filterDatabase();
      });
    });

    // Type filter button click handlers
    const typeBtns = document.querySelectorAll('.db-filter-btn.type');
    typeBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        typeBtns.forEach(b => b.classList.remove('active'));
        const clicked = e.currentTarget as HTMLElement;
        clicked.classList.add('active');
        dbActiveType = clicked.getAttribute('data-filter') || 'all';
        filterDatabase();
      });
    });

    // Copy link buttons functionality
    const copyBtns = document.querySelectorAll('.copy-syl-link-btn');
    copyBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const clickedBtn = e.currentTarget as HTMLButtonElement;
        const url = clickedBtn.getAttribute('data-url') || '';
        
        navigator.clipboard.writeText(url).then(() => {
          const originalText = clickedBtn.innerHTML;
          clickedBtn.innerHTML = '✅ Copied!';
          clickedBtn.disabled = true;
          setTimeout(() => {
            clickedBtn.innerHTML = originalText;
            clickedBtn.disabled = false;
          }, 2000);
        });
      });
    });
  </script>

</Layout>
