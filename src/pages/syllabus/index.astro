---
import Layout from '../../layouts/Layout.astro';
import syllabusData from '../../../public/data/syllabus.json';
import mdcData from '../../../public/data/mdc.json';
import aecData from '../../../public/data/aec.json';
import vacData from '../../../public/data/vac.json';
import secData from '../../../public/data/sec.json';
import iksData from '../../../public/data/iks.json';
import markingSchemes from '../../../public/data/paper_marking_schemes.json';
import { BookOpen, GraduationCap, ChevronRight, Compass, Award } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = ["Science", "Arts & Humanities", "Commerce & Business", "Languages"];
const shortCatLabel: Record<string, string> = {
  "Science": "Science",
  "Arts & Humanities": "Arts",
  "Commerce & Business": "Commerce",
  "Languages": "Languages",
};

// Sort MDC data alphabetically by subject name
const sortedMdcData = [...mdcData].sort((a, b) => a.name.localeCompare(b.name));

// Create slug helper
const getSlug = (dept: string) => dept.toLowerCase().replace(/\s+/g, '-');

// Filter syllabus to only keep ones with actual PDF files
const activeDepartments = [
  'Mathematics', 'Physics', 'Mathematics Minor', 'Physics Minor',
  'Botany', 'English', 'Geography', 'Geography Minor',
  'Chemistry', 'Commerce', 'History', 'History Minor', 'Political Science',
  'Zoology', 'Economics', 'Psychology',
  'Hindi', 'Bangla', 'Odia', 'Philosophy', 'Urdu',
  'Santhali', 'Ho', 'Kudmali', 'Sanskrit',
  'Geology', 'Home Science', 'Statistics', 'Environmental Science',
  'BBA', 'BCA', 'Information Technology', 'Mass Communication',
];
const filteredSyllabusData = syllabusData.filter(item => activeDepartments.includes(item.department));

// Major subject category mapping
const majorCategoryMap: Record<string, string> = {
  'Mathematics': 'Science', 'Physics': 'Science', 'Chemistry': 'Science',
  'Botany': 'Science', 'Zoology': 'Science', 'Geology': 'Science',
  'Statistics': 'Science', 'Environmental Science': 'Science', 'Home Science': 'Science',
  'Economics': 'Arts & Humanities', 'Psychology': 'Arts & Humanities',
  'Philosophy': 'Arts & Humanities', 'Geography': 'Arts & Humanities',
  'History': 'Arts & Humanities', 'Political Science': 'Arts & Humanities',
  'Commerce': 'Commerce & Business', 'BBA': 'Commerce & Business',
  'BCA': 'Commerce & Business', 'Information Technology': 'Commerce & Business',
  'Mass Communication': 'Commerce & Business',
  'English': 'Languages', 'Hindi': 'Languages', 'Bangla': 'Languages',
  'Odia': 'Languages', 'Urdu': 'Languages', 'Santhali': 'Languages',
  'Ho': 'Languages', 'Kudmali': 'Languages', 'Sanskrit': 'Languages',
};
const majorCategories = ['Science', 'Arts & Humanities', 'Commerce & Business', 'Languages'];

const majorSubjectDepts = [...new Set(
  filteredSyllabusData
    .filter(item => !item.department.toLowerCase().includes('minor'))
    .map(item => item.department)
)].sort((a, b) => a.localeCompare(b));

const majorSubjects = majorSubjectDepts.map(dept => {
  const items = filteredSyllabusData.filter(i => i.department === dept);
  const first = items[0] as any;
  const urls: string[] = first.downloadUrls ?? (first.downloadUrl ? [first.downloadUrl] : []);
  return {
    dept,
    label: dept,
    slug: getSlug(dept),
    category: majorCategoryMap[dept] ?? 'Others',
    hasDownload: urls.length > 0,
  };
});

const minorDepartments = [...new Set(
  filteredSyllabusData
    .filter(item => item.department.toLowerCase().includes('minor'))
    .map(item => item.department)
)].sort((a, b) => a.localeCompare(b));

// Verified marking schemes from paper_marking_schemes.json
const pracFull = markingSchemes.schemes['100_PRACTICAL'].fullMarks;
const pracPass = markingSchemes.schemes['100_PRACTICAL'].passMarks;
const nonPracFull = markingSchemes.schemes['100_NON_PRACTICAL'].fullMarks;
const nonPracPass = markingSchemes.schemes['100_NON_PRACTICAL'].passMarks;
const mdcSecFull = markingSchemes.schemes['75_THEORY_ONLY'].fullMarks;
const mdcSecPass = markingSchemes.schemes['75_THEORY_ONLY'].passMarks;
const aecVacFull = markingSchemes.schemes['50_THEORY_ONLY'].fullMarks;
const aecVacPass = markingSchemes.schemes['50_THEORY_ONLY'].passMarks;

// Visible FAQs + synced FAQPage JSON-LD
const faqItems = [
  {
    q: 'How to download Kolhan University NEP FYUGP UG Syllabus (Sem 1–8) PDF?',
    a: 'Choose your course category above (Major, Minor / AC, MDC, AEC, VAC, SEC, or IKS), select your subject, and tap Download PDF. All syllabus PDFs open directly without login or fees.'
  },
  {
    q: 'Does this syllabus apply to all 37 Kolhan University colleges?',
    a: 'Yes! Kolhan University follows a unified NEP 2020 FYUGP syllabus across all 37 constituent and affiliated colleges in East Singhbhum, West Singhbhum, and Seraikela-Kharsawan (including Tata College, Co-operative College, ABM College, Karim City College, Ghatshila College, etc.).'
  },
  {
    q: 'Is the syllabus the same for 2022, 2023, 2024, 2025, and 2026 batches?',
    a: '2022, 2023, and 2024 admission batches share the same NEP 2020 FYUGP syllabus. From the 2025 batch onwards, Minor was renamed to Associated Core (AC), IKS became compulsory in Semester 1, and some departments (such as Mathematics) revised Semester 1–2 papers — always confirm with your subject teacher if you are in the 2025 or 2026 batch.'
  },
  {
    q: 'What is the difference between Major (MJ), Minor/AC, MDC, AEC, VAC, SEC, and IKS?',
    a: 'Major (MJ) is your core Honours subject (100 marks). Minor / Associated Core (AC) is your supporting subject (100 marks). MDC is Multidisciplinary Course (75 marks), SEC is Skill Enhancement Course (75 marks), AEC is Ability Enhancement Language (50 marks), VAC is Value Added Course like Understanding India (50 marks), and IKS is Indian Knowledge System (50 marks).'
  }
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
});
---

<Layout
  title="Kolhan University Syllabus 2026 PDF — NEP FYUGP Sem 1–8"
  rawTitle={true}
  description="Download official Kolhan University NEP 2020 FYUGP UG Syllabus PDF (Sem 1 to 8) for all 37 colleges — BA, BSc, BCom Major, Minor, MDC, AEC, VAC & SEC."
  keywords="kolhan university syllabus, kolhan university syllabus pdf, kuuniv syllabus, kolhan university chaibasa syllabus, kolhan university fyugp syllabus semester 1 2 3 4, kolhan university ug syllabus pdf, kolhan university nep syllabus, kolhan university syllabus 2026 pdf download, कोल्हान यूनिवर्सिटी सिलेबस 2026"
  activeTab="syllabus"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
  </Fragment>

  <!-- Compact Mobile-First Hero Header -->
  <div style="margin-bottom: 1rem;">
    <h1 style="font-size: clamp(1.38rem, 5.2vw, 1.9rem); font-family: var(--font-display); font-weight: 800; letter-spacing: -0.025em; line-height: 1.2; margin: 0;">
      Kolhan University Syllabus (NEP FYUGP)
    </h1>
    <p style="color: var(--text-secondary); font-size: 0.85rem; line-height: 1.45; margin-top: 0.35rem; margin-bottom: 0;">
      Official UG PDFs &bull; Sem 1–8 &bull; All 37 Colleges (BA, BSc, BCom)
    </p>
  </div>

  <!-- ═══ COURSE TYPES SELECTION (7 Uniform, Left-Aligned, Closed-by-Default Accordions) ═══ -->
  <div style="display: flex; flex-direction: column; gap: 0.6rem; margin-bottom: 1.25rem;">

    <!-- 1. Major (Honours) -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button type="button" class="accordion-trigger">
        <div class="syl-acc-left">
          <Compass style="color: var(--text-accent-indigo); width: 18px; height: 18px; flex-shrink: 0;" />
          <span class="syl-acc-title">Major (Honours)</span>
          <span class="syl-acc-pill" style="background: rgba(99,102,241,0.12); color: var(--text-accent-indigo); border-color: rgba(99,102,241,0.25);">MJ · 100M</span>
        </div>
        <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
      </button>

      <div class="accordion-content">
        <div class="syl-acc-body">
          <div id="major-syl-tabs" class="syl-pill-row">
            <button type="button" class="btn btn-secondary major-syl-tab syl-filter-pill active" data-category="all">
              All ({majorSubjects.length})
            </button>
            {majorCategories.map(cat => (
              <button type="button" class="btn btn-secondary major-syl-tab syl-filter-pill" data-category={cat}>
                {shortCatLabel[cat] || cat} ({majorSubjects.filter(s => s.category === cat).length})
              </button>
            ))}
          </div>

          <div style="position: relative; display: flex; align-items: center;">
            <input type="text" id="major-syl-search" class="form-input" placeholder="Search Major subjects..." style="height: 34px; padding-left: 2rem; font-size: 0.8rem; width: 100%; border-radius: var(--radius-xs);" />
            <span style="position: absolute; left: 0.65rem; color: var(--text-tertiary); font-size: 0.82rem;">🔍</span>
          </div>

          <div id="major-syl-grid" class="syl-compact-grid">
            {majorSubjects.map(subj => (
              <a
                href={`${baseUrl}/syllabus/${subj.slug}/`}
                class="card card-interactive major-syl-item syl-compact-card"
                data-name={subj.label.toLowerCase()}
                data-category={subj.category}
              >
                <div style="display: flex; flex-direction: column; gap: 2px; min-width: 0;">
                  <span style="font-weight: 700; font-size: 0.82rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={subj.label}>
                    {subj.label}
                  </span>
                  {subj.slug === 'mathematics' && (
                    <span style="font-size: 0.58rem; font-weight: 700; color: var(--text-accent-green);">✨ Sem 3 Guide &amp; Notes</span>
                  )}
                </div>
                <span class="major-syl-icon" style={`color: ${subj.hasDownload ? 'var(--text-accent-indigo)' : 'var(--text-tertiary)'}; font-size: 0.9rem; margin-left: 0.35rem; flex-shrink: 0;`}>
                  {subj.hasDownload ? '📥' : '→'}
                </span>
              </a>
            ))}
          </div>

          <div id="major-syl-empty" style="display: none; text-align: center; padding: 1.25rem 0.5rem; color: var(--text-secondary); font-size: 0.85rem;">
            No matching subjects found.
          </div>
        </div>
      </div>
    </div>

    <!-- 2. Minor / AC -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button type="button" class="accordion-trigger">
        <div class="syl-acc-left">
          <Award style="color: var(--text-accent-green); width: 18px; height: 18px; flex-shrink: 0;" />
          <span class="syl-acc-title">Minor / AC</span>
          <span class="syl-acc-pill" style="background: rgba(16,185,129,0.12); color: var(--text-accent-green); border-color: rgba(16,185,129,0.28);">MN / AC · 100M</span>
        </div>
        <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
      </button>

      <div class="accordion-content">
        <div class="syl-acc-body">
          <div class="syl-compact-grid">
            {minorDepartments.map(dept => (
              <a
                href={`${baseUrl}/syllabus/${getSlug(dept)}/`}
                class="card card-interactive syl-compact-card"
              >
                <div style="display: flex; flex-direction: column; gap: 2px; min-width: 0;">
                  <span style="font-weight: 700; font-size: 0.82rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={dept}>
                    {dept}
                  </span>
                  <span style="font-size: 0.65rem; color: var(--text-accent-green); font-weight: 600;">Minor / AC</span>
                </div>
                <span style="color: var(--text-accent-green); font-size: 0.9rem; margin-left: 0.35rem; flex-shrink: 0;">→</span>
              </a>
            ))}
          </div>
          <div style="font-size: 0.7rem; color: var(--text-tertiary);">
            2025+ batch: renamed Associated Core (AC). More Minor syllabi coming soon.
          </div>
        </div>
      </div>
    </div>

    <!-- 3. MDC -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button type="button" class="accordion-trigger">
        <div class="syl-acc-left">
          <Compass style="color: var(--text-accent-amber); width: 18px; height: 18px; flex-shrink: 0;" />
          <span class="syl-acc-title">MDC</span>
          <span class="syl-acc-pill" style="background: rgba(245,158,11,0.12); color: var(--text-accent-amber); border-color: rgba(245,158,11,0.28);">Multidisciplinary · 75M</span>
        </div>
        <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
      </button>

      <div class="accordion-content" id="mdc-accordion-content">
        <div class="syl-acc-body">
          <a href={`${baseUrl}/syllabus/mdc/`} class="syl-hub-link" style="color: var(--text-accent-amber); border-color: rgba(245,158,11,0.28); background: rgba(245,158,11,0.08);">
            <span>📖 Open full MDC Syllabus &amp; PYQs Page</span>
            <span>→</span>
          </a>

          <div id="mdc-tabs" class="syl-pill-row">
            <button type="button" class="btn btn-secondary mdc-tab-btn syl-filter-pill active" data-category="all">
              All ({mdcData.length})
            </button>
            {categories.map(cat => (
              <button type="button" class="btn btn-secondary mdc-tab-btn syl-filter-pill" data-category={cat}>
                {shortCatLabel[cat] || cat} ({mdcData.filter(item => item.category === cat).length})
              </button>
            ))}
          </div>

          <div style="position: relative; display: flex; align-items: center;">
            <input type="text" id="mdc-search-input" class="form-input" placeholder="Search MDC subjects..." style="height: 34px; padding-left: 2rem; font-size: 0.8rem; width: 100%; border-radius: var(--radius-xs);" />
            <span style="position: absolute; left: 0.65rem; color: var(--text-tertiary); font-size: 0.82rem;">🔍</span>
          </div>

          <div id="mdc-grid" class="syl-compact-grid">
            {sortedMdcData.map(item => (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="card card-interactive mdc-item syl-compact-card"
                data-name={item.name.toLowerCase()}
                data-category={item.category}
                onclick={`if(window.trackDownload) window.trackDownload('syllabus', { subject: '${item.name}', category: 'MDC', semester: '${item.semester || 'Unknown'}', department: 'MDC' });`}
              >
                <span style="font-weight: 700; font-size: 0.8rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;" title={item.name}>
                  {item.name}
                </span>
                <span class="mdc-dl-icon" style="color: var(--text-accent-indigo); font-size: 0.88rem; margin-left: 0.35rem; flex-shrink: 0;">
                  📥
                </span>
              </a>
            ))}
          </div>

          <div id="mdc-empty" style="display: none; text-align: center; padding: 1.25rem 0.5rem; color: var(--text-secondary); font-size: 0.85rem;">
            No matching MDC subjects found.
          </div>
        </div>
      </div>
    </div>

    <!-- 4. AEC -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button type="button" class="accordion-trigger" id="aec-trigger">
        <div class="syl-acc-left">
          <Compass style="color: var(--text-accent-green); width: 18px; height: 18px; flex-shrink: 0;" />
          <span class="syl-acc-title">AEC</span>
          <span class="syl-acc-pill" style="background: rgba(16,185,129,0.12); color: var(--text-accent-green); border-color: rgba(16,185,129,0.28);">Languages · 50M</span>
        </div>
        <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
      </button>

      <div class="accordion-content" id="aec-accordion-content">
        <div class="syl-acc-body">
          <a href={`${baseUrl}/syllabus/aec/`} class="syl-hub-link" style="color: var(--text-accent-green); border-color: rgba(16,185,129,0.28); background: rgba(16,185,129,0.08);">
            <span>📖 Open full AEC Syllabus &amp; PYQs Page</span>
            <span>→</span>
          </a>

          <div id="aec-tabs" class="syl-pill-row">
            <button type="button" class="btn btn-secondary aec-tab-btn syl-filter-pill active" data-semester="all">
              All ({aecData.length})
            </button>
            <button type="button" class="btn btn-secondary aec-tab-btn syl-filter-pill" data-semester="Semester 1">
              Sem 1
            </button>
            <button type="button" class="btn btn-secondary aec-tab-btn syl-filter-pill" data-semester="Semester 2">
              Sem 2
            </button>
            <button type="button" class="btn btn-secondary aec-tab-btn syl-filter-pill" data-semester="Semester 3">
              Sem 3
            </button>
            <button type="button" class="btn btn-secondary aec-tab-btn syl-filter-pill" data-semester="Semester 4">
              Sem 4
            </button>
          </div>

          <div style="position: relative; display: flex; align-items: center;">
            <input type="text" id="aec-search-input" class="form-input" placeholder="Search AEC subjects..." style="height: 34px; padding-left: 2rem; font-size: 0.8rem; width: 100%; border-radius: var(--radius-xs);" />
            <span style="position: absolute; left: 0.65rem; color: var(--text-tertiary); font-size: 0.82rem;">🔍</span>
          </div>

          <!-- Compact 1-line note shown ONLY when Sem 4 tab is active -->
          <div id="aec-sem4-note" style="display: none; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; background: rgba(245,158,11,0.08); border: 1px solid rgba(245,158,11,0.28); border-radius: var(--radius-xs); padding: 0.45rem 0.7rem; font-size: 0.72rem; color: var(--text-secondary);">
            <span>⚠️ Sem 4 regional PDFs are Ranchi Univ. reference.</span>
            <button type="button" onclick="document.dispatchEvent(new CustomEvent('open-submit-modal'));" style="background:none; border:none; padding:0; color: var(--text-accent-amber); font-weight:700; font-size:0.72rem; cursor:pointer;">
              Have Kolhan Univ. PDF? Share →
            </button>
          </div>

          <div id="aec-grid" class="syl-wide-grid">
            {aecData.map(item => (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="card card-interactive aec-item"
                data-name={item.name.toLowerCase()}
                data-semester={item.semester}
                style="padding: 0.68rem 0.82rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; min-width: 0;"
                onclick={`if(window.trackDownload) window.trackDownload('syllabus', { subject: '${item.name}', category: 'AEC', semester: '${item.semester || 'Unknown'}', department: 'AEC' });`}
              >
                <div style="display: flex; flex-direction: column; gap: 1px; min-width: 0;">
                  <span style="font-weight: 700; font-size: 0.84rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                    {item.name}
                  </span>
                  <span style="font-size: 0.7rem; color: var(--text-secondary);">
                    {item.semester}
                  </span>
                </div>
                <span class="aec-dl-icon" style="color: var(--text-accent-green); font-size: 0.95rem; margin-left: 0.45rem; flex-shrink: 0;">
                  📥
                </span>
              </a>
            ))}
          </div>

          <div id="aec-empty" style="display: none; text-align: center; padding: 1.25rem 0.5rem; color: var(--text-secondary); font-size: 0.85rem;">
            No matching AEC subjects found.
          </div>
        </div>
      </div>
    </div>

    <!-- 5. VAC -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button type="button" class="accordion-trigger" id="vac-trigger">
        <div class="syl-acc-left">
          <Award style="color: var(--text-accent-indigo); width: 18px; height: 18px; flex-shrink: 0;" />
          <span class="syl-acc-title">VAC</span>
          <span class="syl-acc-pill" style="background: rgba(99,102,241,0.12); color: var(--text-accent-indigo); border-color: rgba(99,102,241,0.28);">Value Added · 50M</span>
        </div>
        <ChevronRight class="chevron" size="18" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;" />
      </button>

      <div class="accordion-content" id="vac-accordion-content">
        <div class="syl-acc-body">
          <a href={`${baseUrl}/syllabus/vac/`} class="syl-hub-link" style="color: var(--text-accent-indigo); border-color: rgba(99,102,241,0.28); background: rgba(99,102,241,0.08);">
            <span>📖 Open full VAC Syllabus &amp; PYQs Page</span>
            <span>→</span>
          </a>

          <div id="vac-tabs" class="syl-pill-row">
            <button type="button" class="btn btn-secondary vac-tab-btn syl-filter-pill active" data-semester="all">
              All ({vacData.length})
            </button>
            <button type="button" class="btn btn-secondary vac-tab-btn syl-filter-pill" data-semester="Semester 1">
              Sem 1
            </button>
            <button type="button" class="btn btn-secondary vac-tab-btn syl-filter-pill" data-semester="Semester 4">
              Sem 4
            </button>
          </div>

          <div id="vac-grid" class="syl-wide-grid">
            {vacData.map(item => (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="card card-interactive vac-item"
                data-name={item.name.toLowerCase()}
                data-semester={item.semester}
                style="padding: 0.68rem 0.82rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; min-width: 0;"
                onclick={`if(window.trackDownload) window.trackDownload('syllabus', { subject: '${item.name}', category: 'VAC', semester: '${item.semester || 'Unknown'}', department: 'VAC' });`}
              >
                <div style="display: flex; flex-direction: column; gap: 1px; min-width: 0;">
                  <span style="font-weight: 700; font-size: 0.84rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                    {item.name}
                  </span>
