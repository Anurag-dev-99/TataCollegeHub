---
import Layout from '../../layouts/Layout.astro';
import syllabusData from '../../../public/data/syllabus.json';
import mdcData from '../../../public/data/mdc.json';
import aecData from '../../../public/data/aec.json';
import vacData from '../../../public/data/vac.json';
import secData from '../../../public/data/sec.json';
import iksData from '../../../public/data/iks.json';
import { BookOpen, GraduationCap, ChevronRight, FileText, Compass, Award } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = ["Science", "Arts & Humanities", "Commerce & Business", "Languages"];

// Sort MDC data alphabetically by subject name
const sortedMdcData = [...mdcData].sort((a, b) => a.name.localeCompare(b.name));

// Create slug helper
const getSlug = (dept: string) => {
  return dept.toLowerCase().replace(/\s+/g, '-');
};

// Filter syllabus to only keep ones with actual PDF files
const activeDepartments = [
  'Mathematics', 'Physics', 'Mathematics Minor', 'Physics Minor',
  'Botany', 'English', 'Geography', 'Geography Minor',
  'Chemistry', 'Commerce', 'History', 'History Minor', 'Political Science',
  'Zoology', 'Economics', 'Psychology',
  'Hindi', 'Bangla', 'Odia', 'Philosophy', 'Urdu',
  'Santhali', 'Ho', 'Kudmali', 'Sanskrit',
  'Geology', 'Home Science', 'Statistics', 'Environmental Science',
  'BBA', 'BCA', 'Information Technology', 'Mass Communication',
];
const filteredSyllabusData = syllabusData.filter(item => activeDepartments.includes(item.department));

// ── Major subject category mapping ────────────────────────────────────────
const majorCategoryMap: Record<string, string> = {
  'Mathematics': 'Science', 'Physics': 'Science', 'Chemistry': 'Science',
  'Botany': 'Science', 'Zoology': 'Science', 'Geology': 'Science',
  'Statistics': 'Science', 'Environmental Science': 'Science', 'Home Science': 'Science',
  'Economics': 'Arts & Humanities', 'Psychology': 'Arts & Humanities',
  'Philosophy': 'Arts & Humanities', 'Geography': 'Arts & Humanities',
  'History': 'Arts & Humanities', 'Political Science': 'Arts & Humanities',
  'Commerce': 'Commerce & Business', 'BBA': 'Commerce & Business',
  'BCA': 'Commerce & Business', 'Information Technology': 'Commerce & Business',
  'Mass Communication': 'Commerce & Business',
  'English': 'Languages', 'Hindi': 'Languages', 'Bangla': 'Languages',
  'Odia': 'Languages', 'Urdu': 'Languages', 'Santhali': 'Languages',
  'Ho': 'Languages', 'Kudmali': 'Languages', 'Sanskrit': 'Languages',
};
const majorCategories = ['Science', 'Arts & Humanities', 'Commerce & Business', 'Languages'];

// Build flat list of major subjects (non-minor, de-duplicated by dept label)
const majorSubjectDepts = [...new Set(
  filteredSyllabusData
    .filter(item => !item.department.toLowerCase().includes('minor'))
    .map(item => item.department)
)].sort((a, b) => a.localeCompare(b));

const majorSubjects = majorSubjectDepts.map(dept => {
  const items = filteredSyllabusData.filter(i => i.department === dept);
  const first = items[0] as any;
  const urls: string[] = first.downloadUrls ?? (first.downloadUrl ? [first.downloadUrl] : []);
  return {
    dept,
    label: dept,
    slug: dept.toLowerCase().replace(/\s+/g, '-'),
    category: majorCategoryMap[dept] ?? 'Others',
    hasDownload: urls.length > 0,
  };
});

// Group syllabuses by department to show summaries in card
interface SyllabusItem {
  id: string;
  title: string;
  department: string;
  semester: string;
  effectiveFrom: string;
  fileSize: string;
  description: string;
  modules: string[];
}

const deptGroups: Record<string, SyllabusItem[]> = {};
filteredSyllabusData.forEach(item => {
  if (!deptGroups[item.department]) {
    deptGroups[item.department] = [];
  }
  deptGroups[item.department].push(item);
});

const departments = Object.keys(deptGroups);
---

<Layout 
  title="Kolhan University Syllabus — NEP 2020 FYUGP | Tata College, Chaibasa"
  description="Download complete Kolhan University NEP 2020 FYUGP syllabus for Tata College, Chaibasa. Official curriculum PDFs for the 2022 batch — Major Honours, Minor, MDC, AEC, VAC, and SEC courses for Semester 1 to 8. Free Kolhan syllabus download."
  keywords="Kolhan University syllabus, Kolhan syllabus download, Kolhan University NEP 2020 syllabus, Kolhan University FYUGP syllabus, Tata College syllabus, Tata College Chaibasa curriculum, 2022 batch Kolhan University syllabus, Major Minor MDC AEC VAC SEC syllabus, Kolhan University Chaibasa, NEP syllabus Kolhan, Kolhan University semester syllabus"
  activeTab="syllabus"
>

  <!-- Header -->
  <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Kolhan University Syllabus</h1>
    <p style="color: var(--text-secondary); max-width: 650px; font-size: 1.05rem; line-height: 1.6;">
      Official <strong>Kolhan University NEP 2020 FYUGP syllabus</strong> for Tata College, Chaibasa students.
      Download curriculum PDFs for the <strong>2022 batch</strong> &mdash; Major Honours, Minor, MDC, AEC, VAC &amp; SEC courses across Semester 1 to 8.
    </p>
  </div>

  <!-- Compact Syllabus Community Row -->
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.5rem;">

    <!-- Completed Syllabus Requests -->
    <div style="border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-sm); overflow: hidden; background: linear-gradient(135deg, rgba(16,185,129,0.02) 0%, rgba(0,0,0,0.12) 100%);">
      <button id="syl-req-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0.85rem; background: transparent; border: none; cursor: pointer; text-align: left;">
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <span style="display: inline-flex; align-items: center; justify-content: center; width: 18px; height: 18px; background: rgba(16,185,129,0.15); border-radius: 50%; font-size: 0.65rem;">✓</span>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-primary);">Syllabus Requests Done</span>
          <span style="font-size: 0.6rem; font-weight: 700; background: rgba(16,185,129,0.12); color: var(--accent-success); border: 1px solid rgba(16,185,129,0.25); border-radius: 20px; padding: 1px 5px;">4</span>
        </div>
        <svg id="syl-req-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <div id="syl-req-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; border-top: 1px solid rgba(16,185,129,0.12);">
        <div style="padding: 0.5rem 0.85rem; display: flex; flex-direction: column; gap: 0.3rem; background: rgba(0,0,0,0.15);">
          {[{e:'🗺️',t:'Geography Major Syllabus',s:'Sem 1–8'},{e:'📖',t:'English Major Syllabus',s:'Sem 1'},{e:'🌿',t:'Botany Major Syllabus',s:'Sem 1–8'},{e:'🔬',t:'Zoology Major Syllabus',s:'Sem 1–8'}].map(r => (
            <div style="display: flex; align-items: center; gap: 0.4rem; padding: 0.3rem 0;">
              <span style="font-size: 0.65rem;">{r.e}</span>
              <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-primary); flex: 1;">{r.t}</span>
              <span style="font-size: 0.65rem; color: var(--accent-success); font-weight: 600;">{r.s}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Syllabus File Contributors -->
    <div style="border: 1px solid rgba(37,211,102,0.2); border-radius: var(--radius-sm); overflow: hidden; background: linear-gradient(135deg, rgba(37,211,102,0.02) 0%, rgba(0,0,0,0.12) 100%);">
      <button id="syl-contrib-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0.65rem 0.85rem; background: transparent; border: none; cursor: pointer; text-align: left;">
        <div style="display: flex; align-items: center; gap: 0.4rem;">
          <span style="font-size: 0.75rem;">📚</span>
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-primary);">Syllabus Contributors</span>
        </div>
        <svg id="syl-contrib-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--text-secondary); transition: transform 0.25s; flex-shrink: 0;"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
      <div id="syl-contrib-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease-out; border-top: 1px solid rgba(37,211,102,0.12);">
        <div style="padding: 0.5rem 0.85rem; display: flex; flex-direction: column; gap: 0.3rem; background: rgba(0,0,0,0.15);">
          {[{i:'K',bg:'#ec4899,#db2777',n:'Kirti Arya',f:'Botany Major Syllabus'},{i:'D',bg:'#6366f1,#8b5cf6',n:'Deepika',f:'AEC Hindi Syllabus'},{i:'N',bg:'#34d399,#059669',n:'Neha Kumari',f:'Geography Syllabus'},{i:'R',bg:'#0ea5e9,#0284c7',n:'Ravi Kumar',f:'English Syllabus'}].map(c => (
            <div style="display: flex; align-items: center; gap: 0.45rem; padding: 0.25rem 0;">
              <div style={`width: 20px; height: 20px; border-radius: 50%; background: linear-gradient(135deg, ${c.bg.split(',')[0]}, ${c.bg.split(',')[1]}); display: flex; align-items: center; justify-content: center; font-size: 0.55rem; font-weight: 800; color: white; flex-shrink: 0;`}>{c.i}</div>
              <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-primary); flex-shrink: 0;">{c.n}</span>
              <span style="font-size: 0.65rem; color: var(--text-tertiary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{c.f}</span>
            </div>
          ))}
          <a href="https://api.whatsapp.com/send?phone=918002059887&text=Hi!%20I%20have%20a%20syllabus%20PDF%20to%20share%20for%20Kolhan%20University%20%F0%9F%93%9A" target="_blank" rel="noopener noreferrer" style="font-size: 0.7rem; color: rgba(37,211,102,0.9); font-weight: 600; text-decoration: none; margin-top: 0.25rem;">💬 Share syllabus files →</a>
        </div>
      </div>
    </div>

  </div>

  <!-- Passing Marks Info Panel -->
  <div style="background: linear-gradient(135deg, rgba(99,102,241,0.06) 0%, rgba(16,185,129,0.04) 100%); border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1.1rem 1.35rem; margin-bottom: 1.75rem;">

    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.85rem;">
      <span style="font-size: 1rem;">📊</span>
      <span style="font-size: 0.75rem; font-weight: 700; color: var(--text-tertiary); letter-spacing: 0.06em; text-transform: uppercase;">Marks &amp; Passing Criteria (FYUGP)</span>
      <span style="font-size: 0.7rem; color: var(--text-tertiary); margin-left: auto;">Qualifying: <strong style="color: var(--accent-success);">40% of total marks</strong></span>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-primary);">MJ / AC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">100 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 40</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-warning);">MDC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">75 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 30</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-warning);">SEC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">75 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 30</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--accent-primary);">AEC / VAC</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">50 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 20</span>
      </div>
      <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-xs); padding: 0.45rem 0.75rem; font-size: 0.8rem;">
        <span style="font-weight: 700; color: var(--text-secondary);">Practical / Lab</span>
        <span style="color: var(--text-tertiary);">|</span>
        <span style="color: var(--text-secondary);">25 marks</span>
        <span style="color: var(--text-tertiary);">·</span>
        <span style="color: var(--accent-success); font-weight: 600;">Pass: 10</span>
      </div>
    </div>
    <p style="font-size: 0.72rem; color: var(--text-tertiary); margin-top: 0.75rem; line-height: 1.5;">* For 100-mark theory papers: 75 marks End-Semester + 25 marks Internal Assessment. Combined total must meet the passing threshold.</p>
  </div>

  <!-- Course Types Selection Section -->
  <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 2rem;">
    
    <!-- Major Honours Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
          <Compass style="color: var(--accent-primary); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Major (Honours) Syllabus</span>
          <span style="font-size: 0.65rem; font-weight: 700; background: rgba(99,102,241,0.12); color: var(--accent-primary); border: 1px solid rgba(99,102,241,0.25); border-radius: 20px; padding: 2px 8px; letter-spacing: 0.3px;">MJ · 100 Marks</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content">
        <div class="accordion-content-inner" style="padding: 1.25rem 1.5rem 1.5rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 1rem;">
            Select your department to view semester details and download official FYUGP curriculum PDFs.
          </p>

          <!-- Major Filter Tabs + Search -->
          <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.25rem; box-shadow: var(--shadow-sm);">
            <div id="major-syl-tabs" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.25rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem; align-items: center;">
              <button class="btn btn-secondary major-syl-tab active" data-category="all" style="height: 36px; font-size: 0.82rem; padding: 0 0.9rem; border-radius: var(--radius-xs);">
                All ({majorSubjects.length})
              </button>
              {majorCategories.map(cat => (
                <button class="btn btn-secondary major-syl-tab" data-category={cat} style="height: 36px; font-size: 0.82rem; padding: 0 0.9rem; border-radius: var(--radius-xs);">
                  {cat} ({majorSubjects.filter(s => s.category === cat).length})
                </button>
              ))}
              <!-- Search -->
              <div style="margin-left: auto; position: relative; display: flex; align-items: center;">
                <input type="text" id="major-syl-search" class="form-input" placeholder="Search subjects..." style="height: 36px; padding-left: 2.1rem; font-size: 0.82rem; width: 180px; border-radius: var(--radius-xs);" />
                <span style="position: absolute; left: 0.65rem; color: var(--text-tertiary); font-size: 0.85rem;">🔍</span>
              </div>
            </div>

            <!-- Major Subject List -->
            <div id="major-syl-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
              {majorSubjects.map(subj => (
                <a
                  href={`${baseUrl}/syllabus/${subj.slug}`}
                  class="card card-interactive major-syl-item"
                  data-name={subj.label.toLowerCase()}
                  data-category={subj.category}
                  style="padding: 0.85rem 1rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s;"
                >
                  <div style="display: flex; flex-direction: column; gap: 0.2rem; min-width: 0;">
                    <span style="font-weight: 700; font-size: 0.9rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={subj.label}>
                      {subj.label}
                    </span>
                    <span style="font-size: 0.72rem; color: var(--text-secondary);">
                      {subj.category}
                    </span>
                  </div>
                  <span class="major-syl-icon" style={`color: ${subj.hasDownload ? 'var(--accent-primary)' : 'var(--text-tertiary)'}; font-size: 1rem; margin-left: 0.5rem; transition: transform 0.2s; display: inline-block; flex-shrink: 0;`}>
                    {subj.hasDownload ? '📥' : '📖'}
                  </span>
                </a>
              ))}
            </div>

            <!-- Empty state -->
            <div id="major-syl-empty" style="display: none; text-align: center; padding: 2rem 1rem; color: var(--text-secondary); font-size: 0.9rem;">
              No matching subjects found.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Minor / Associated Core Accordion Item -->
    <div class="accordion-item" style="border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden; background-color: var(--bg-secondary);">
      <button class="accordion-trigger" style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; transition: background 0.25s;">
        <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
          <Award style="color: var(--accent-success); width: 20px; height: 20px;" />
          <span style="font-size: 1.15rem; font-weight: 700; color: var(--text-primary); font-family: var(--font-display);">Minor Syllabus</span>
          <span style="font-size: 0.65rem; font-weight: 700; background: rgba(16,185,129,0.12); color: var(--accent-success); border: 1px solid rgba(16,185,129,0.25); border-radius: 20px; padding: 2px 8px; letter-spacing: 0.3px;">AC · 100 Marks</span>
        </div>
        <ChevronRight class="chevron" size="20" style="color: var(--text-secondary); transition: transform 0.25s;" />
      </button>
      
      <div class="accordion-content">
        <div class="accordion-content-inner" style="padding: 1.5rem; display: flex; flex-direction: column; gap: 1.25rem;">
          <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.5; margin-bottom: 0.25rem;">
            Official Kolhan University FYUGP Minor course credit requirement syllabuses.
          </p>
          <!-- AC Rename Notice -->
          <div style="display: flex; align-items: flex-start; gap: 0.6rem; background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.2); border-radius: var(--radius-xs); padding: 0.75rem 1rem; font-size: 0.8rem; color: var(--text-secondary); line-height: 1.5;">
            <span style="font-size: 1rem; flex-shrink: 0;">ℹ️</span>
            <span><strong style="color: var(--accent-success);">Nomenclature update:</strong> From the <strong>2025 batch onwards</strong>, the "Minor" paper is officially renamed to <strong>Associated Core (AC)</strong> under Kolhan University's current NEP syllabus. The syllabus content remains the same — only the label has changed.</span>
          </div>
          <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
            {departments
              .filter(dept => dept.toLowerCase().includes('minor'))
              .map(dept => {
                const items = deptGroups[dept];
                const firstItem = items[0];
                const slug = getSlug(dept);
                
                return (
                  <a href={`${baseUrl}/syllabus/${slug}`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit;">
                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                      <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                        <GraduationCap size="22" />
                      </div>
                      <span class="badge badge-success" style="font-size: 0.7rem;">Minor Paper</span>
                    </div>
                    
                    <div>
                      <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">{dept}</h3>
                      <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                        {firstItem.description}
                      </p>
                    </div>
                    
                    <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                      <span>Effective: {firstItem.effectiveFrom}</span>
                      <span style="display: flex; align-items: center; font-weight: 700; color: var(--accent-success);">View Semesters <ChevronRight size="14" /></span>
                    </div>
                  </a>
                );
              })}
          </div>
        </div>
      </div>
