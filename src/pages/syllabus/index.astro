---
import Layout from '../../layouts/Layout.astro';
import syllabusData from '../../../public/data/syllabus.json';
import mdcData from '../../../public/data/mdc.json';
import aecData from '../../../public/data/aec.json';
import { BookOpen, GraduationCap, ChevronRight, FileText, Compass, Award } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = ["Science", "Arts & Humanities", "Commerce & Business", "Languages"];

// Sort MDC data alphabetically by subject name
const sortedMdcData = [...mdcData].sort((a, b) => a.name.localeCompare(b.name));

// Create slug helper
const getSlug = (dept: string) => {
  return dept.toLowerCase().replace(/\s+/g, '-');
};

// Filter syllabus to only keep ones with actual PDF files
const activeDepartments = ['Mathematics', 'Physics', 'Mathematics Minor', 'Physics Minor'];
const filteredSyllabusData = syllabusData.filter(item => activeDepartments.includes(item.department));

// Group syllabuses by department to show summaries in card
interface SyllabusItem {
  id: string;
  title: string;
  department: string;
  semester: string;
  effectiveFrom: string;
  fileSize: string;
  description: string;
  modules: string[];
}

const deptGroups: Record<string, SyllabusItem[]> = {};
filteredSyllabusData.forEach(item => {
  if (!deptGroups[item.department]) {
    deptGroups[item.department] = [];
  }
  deptGroups[item.department].push(item);
});

const departments = Object.keys(deptGroups);
---

<Layout title="Syllabus Directory" activeTab="syllabus">

  <!-- Header -->
  <div style="margin-bottom: 2.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Syllabus Directory</h1>
    <p style="color: var(--text-secondary); max-width: 600px; font-size: 1.05rem;">
      Select your department below to view course outlines, semester details, and download official FYUGP curriculum PDFs.
    </p>
  </div>

  <!-- Course Types Selection Section -->
  <div style="display: flex; flex-direction: column; gap: 2.5rem;">
    
    <!-- Major Courses -->
    <div>
      <h2 style="font-size: 1.35rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
        <Compass style="color: var(--accent-primary);" /> Major (Honours) Curriculums
      </h2>
      
      <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
        {departments
          .filter(dept => !dept.toLowerCase().includes('minor'))
          .map(dept => {
            const items = deptGroups[dept];
            const firstItem = items[0];
            const slug = getSlug(dept);
            
            return (
              <a href={`${baseUrl}/syllabus/${slug}`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit;">
                <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                  <div style="background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                    <BookOpen size="22" />
                  </div>
                  <span class="badge badge-primary" style="font-size: 0.7rem;">FYUGP NEP</span>
                </div>
                
                <div>
                  <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">{dept}</h3>
                  <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                    {firstItem.description}
                  </p>
                </div>
                
                <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                  <span>{items.length} Course {items.length > 1 ? 'Outlines' : 'Outline'}</span>
                  <span style="display: flex; align-items: center; font-weight: 700; color: var(--accent-primary);">View Semesters <ChevronRight size="14" /></span>
                </div>
              </a>
            );
          })}
      </div>
    </div>

    <!-- Minor Courses -->
    <div>
      <h2 style="font-size: 1.35rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
        <Award style="color: var(--accent-success);" /> Minor Curriculums
      </h2>
      
      <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
        {departments
          .filter(dept => dept.toLowerCase().includes('minor'))
          .map(dept => {
            const items = deptGroups[dept];
            const firstItem = items[0];
            const slug = getSlug(dept);
            
            return (
              <a href={`${baseUrl}/syllabus/${slug}`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit;">
                <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                  <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                    <GraduationCap size="22" />
                  </div>
                  <span class="badge badge-success" style="font-size: 0.7rem;">Minor Paper</span>
                </div>
                
                <div>
                  <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">{dept}</h3>
                  <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                    {firstItem.description}
                  </p>
                </div>
                
                <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                  <span>Effective: {firstItem.effectiveFrom}</span>
                  <span style="display: flex; align-items: center; font-weight: 700; color: var(--accent-success);">View Semesters <ChevronRight size="14" /></span>
                </div>
              </a>
            );
          })}
      </div>
    </div>

    <!-- Multidisciplinary Courses (MDC) -->
    <div style="margin-top: 1rem;">
      <h2 style="font-size: 1.35rem; font-family: var(--font-display); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <Compass style="color: var(--accent-warning);" /> Multidisciplinary Courses (MDC) Curriculums
      </h2>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
        Under NEP 2020, students choose 3 Multidisciplinary Courses (MDC) from outside their major/minor disciplines. Select a course to view or download the official PDF.
      </p>
      
      <!-- MDC Categories & Filter Tabs -->
      <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
        <div id="mdc-tabs" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem; align-items: center;">
          <button class="btn btn-secondary mdc-tab-btn active" data-category="all" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
            All ({mdcData.length})
          </button>
          {categories.map(cat => (
            <button class="btn btn-secondary mdc-tab-btn" data-category={cat} style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
              {cat} ({mdcData.filter(item => item.category === cat).length})
            </button>
          ))}
          
          <!-- Search input for MDC subjects -->
          <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="mdc-search-wrapper">
            <input type="text" id="mdc-search-input" class="form-input" placeholder="Search MDC subjects..." style="height: 38px; padding-left: 2.25rem; font-size: 0.85rem; width: 220px; border-radius: var(--radius-xs);" />
            <span style="position: absolute; left: 0.75rem; color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 0.9rem;">🔍</span>
          </div>
        </div>

        <!-- MDC Subjects Grid -->
        <div id="mdc-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
          {sortedMdcData.map(item => (
            <a 
              href={item.link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="card card-interactive mdc-item" 
              data-name={item.name.toLowerCase()} 
              data-category={item.category} 
              style="padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s;"
            >
              <div style="display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;">
                <span style="font-weight: 700; font-size: 0.925rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                  {item.name}
                </span>
                <span style="font-size: 0.75rem; color: var(--text-secondary);">
                  {item.category}
                </span>
              </div>
              <span class="mdc-dl-icon" style="color: var(--accent-primary); font-size: 1.1rem; margin-left: 0.5rem; transition: transform 0.2s; display: inline-block;">
                📥
              </span>
            </a>
          ))}
        </div>

        <!-- Empty state -->
        <div id="mdc-empty" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary); font-size: 0.95rem;">
          No matching MDC subjects found.
        </div>
      </div>
    </div>

    <!-- Ability Enhancement Courses (AEC) -->
    <div style="margin-top: 1rem;">
      <h2 style="font-size: 1.35rem; font-family: var(--font-display); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <Compass style="color: var(--accent-success);" /> Ability Enhancement Courses (AEC) Curriculums
      </h2>
      <p style="color: var(--text-secondary); font-size: 0.9rem; margin-bottom: 1.5rem;">
        Under NEP 2020, Ability Enhancement Courses focus on developing language, communication, and critical thinking skills. Select a semester to filter course documents.
      </p>
      
      <!-- AEC Semester Filter Tabs -->
      <div style="background-color: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.5rem; box-shadow: var(--shadow-sm);">
        <div id="aec-tabs" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem; align-items: center;">
          <button class="btn btn-secondary aec-tab-btn active" data-semester="all" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
            All ({aecData.length})
          </button>
          <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 1" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
            Sem 1
          </button>
          <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 2" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
            Sem 2
          </button>
          <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 3" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
            Sem 3
          </button>
          <button class="btn btn-secondary aec-tab-btn" data-semester="Semester 4" style="height: 38px; font-size: 0.85rem; padding: 0 1rem; border-radius: var(--radius-xs);">
            Sem 4
          </button>
          
          <!-- Search input for AEC subjects -->
          <div style="margin-left: auto; position: relative; display: flex; align-items: center;" class="aec-search-wrapper">
            <input type="text" id="aec-search-input" class="form-input" placeholder="Search AEC subjects..." style="height: 38px; padding-left: 2.25rem; font-size: 0.85rem; width: 220px; border-radius: var(--radius-xs);" />
            <span style="position: absolute; left: 0.75rem; color: var(--text-tertiary); display: flex; align-items: center; justify-content: center; font-size: 0.9rem;">🔍</span>
          </div>
        </div>

        <!-- AEC Subjects Grid -->
        <div id="aec-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem;">
          {aecData.map(item => (
            <a 
              href={item.link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="card card-interactive aec-item" 
              data-name={item.name.toLowerCase()} 
              data-semester={item.semester} 
              style="padding: 1rem; display: flex; align-items: center; justify-content: space-between; border-radius: var(--radius-sm); text-decoration: none; color: inherit; transition: all 0.2s;"
            >
              <div style="display: flex; flex-direction: column; gap: 0.25rem; min-width: 0;">
                <span style="font-weight: 700; font-size: 0.925rem; color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title={item.name}>
                  {item.name}
                </span>
                <span style="font-size: 0.75rem; color: var(--text-secondary);">
                  {item.semester}
                </span>
              </div>
              <span class="aec-dl-icon" style="color: var(--accent-success); font-size: 1.1rem; margin-left: 0.5rem; transition: transform 0.2s; display: inline-block;">
                📥
              </span>
            </a>
          ))}
        </div>

        <!-- Empty state -->
        <div id="aec-empty" style="display: none; text-align: center; padding: 2.5rem 1rem; color: var(--text-secondary); font-size: 0.95rem;">
          No matching AEC subjects found.
        </div>
      </div>
    </div>

  </div>

  <style>
    .mdc-tab-btn.active {
      background-color: rgba(99, 102, 241, 0.1) !important;
      color: var(--accent-primary) !important;
      border-color: var(--accent-primary) !important;
    }
    
    .aec-tab-btn.active {
      background-color: rgba(16, 185, 129, 0.1) !important;
      color: var(--accent-success) !important;
      border-color: var(--accent-success) !important;
    }
    
    .mdc-item:hover .mdc-dl-icon, .aec-item:hover .aec-dl-icon {
      transform: translateY(-2px);
    }
    
    @media (max-width: 767px) {
      .mdc-search-wrapper, .aec-search-wrapper {
        width: 100% !important;
        margin-top: 0.75rem;
      }
      .mdc-search-wrapper input, .aec-search-wrapper input {
        width: 100% !important;
      }
      #mdc-tabs, #aec-tabs {
        padding-bottom: 1rem;
      }
    }
  </style>

  <script>
    const tabBtns = document.querySelectorAll('.mdc-tab-btn');
    const searchInput = document.getElementById('mdc-search-input') as HTMLInputElement;
    const mdcItems = document.querySelectorAll('.mdc-item') as NodeListOf<HTMLAnchorElement>;
    const emptyState = document.getElementById('mdc-empty');

    let activeCategory = 'all';
    let searchQuery = '';

    const filterMdc = () => {
      let visibleCount = 0;

      mdcItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const category = item.getAttribute('data-category') || '';

        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = name.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        tabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');

        activeCategory = clickedBtn.getAttribute('data-category') || 'all';
        filterMdc();
      });
    });

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterMdc();
    });

    // AEC Filtering Logic
    const aecTabBtns = document.querySelectorAll('.aec-tab-btn');
    const aecSearchInput = document.getElementById('aec-search-input') as HTMLInputElement;
    const aecItems = document.querySelectorAll('.aec-item') as NodeListOf<HTMLAnchorElement>;
    const aecEmptyState = document.getElementById('aec-empty');

    let activeAecSemester = 'all';
    let aecSearchQuery = '';

    const filterAec = () => {
      let visibleCount = 0;

      aecItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const semester = item.getAttribute('data-semester') || '';

        const matchesSemester = activeAecSemester === 'all' || semester === activeAecSemester;
        const matchesSearch = name.includes(aecSearchQuery);

        if (matchesSemester && matchesSearch) {
          item.style.display = 'flex';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (aecEmptyState) {
        aecEmptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    };

    aecTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        aecTabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');

        activeAecSemester = clickedBtn.getAttribute('data-semester') || 'all';
        filterAec();
      });
    });

    aecSearchInput?.addEventListener('input', (e) => {
      aecSearchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterAec();
    });
  </script>

</Layout>
