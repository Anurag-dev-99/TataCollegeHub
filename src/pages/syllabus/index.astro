  <style>
    .accordion-trigger {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.85rem 1rem;
      text-align: left;
      background: transparent;
      border: none;
      cursor: pointer;
      transition: background 0.2s;
    }
    .accordion-trigger:hover {
      background-color: rgba(99, 102, 241, 0.04);
    }
    .syl-acc-left {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      min-width: 0;
      flex: 1;
    }
    .syl-acc-title {
      font-size: 0.96rem;
      font-weight: 700;
      color: var(--text-primary);
      font-family: var(--font-display);
      white-space: nowrap;
    }
    .syl-acc-pill {
      font-size: 0.6rem;
      font-weight: 700;
      border: 1px solid;
      border-radius: 20px;
      padding: 1px 7px;
      letter-spacing: 0.2px;
      white-space: nowrap;
    }
    .syl-acc-body {
      padding: 0.75rem 0.85rem 0.95rem;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }
    .syl-hub-link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.5rem 0.75rem;
      border: 1px solid;
      border-radius: var(--radius-xs);
      font-size: 0.75rem;
      font-weight: 700;
      text-decoration: none;
    }
    .syl-pill-row {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.35rem;
      padding-bottom: 0.15rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .syl-pill-row::-webkit-scrollbar {
      display: none;
    }
    .syl-filter-pill {
      height: 31px;
      font-size: 0.75rem;
      padding: 0 0.72rem;
      border-radius: 20px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .syl-compact-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }
    @media (min-width: 640px) {
      .syl-compact-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
    .syl-compact-card {
      padding: 0.58rem 0.68rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: var(--radius-xs);
      text-decoration: none;
      color: inherit;
      min-width: 0;
    }
    .syl-wide-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.55rem;
    }
    @media (min-width: 520px) {
      .syl-wide-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .syl-marks-grid,
    .syl-tools-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }
    .syl-two-col-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.85rem;
    }
    @media (min-width: 640px) {
      .syl-two-col-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }
    .syl-tool-card {
      padding: 0.75rem 0.85rem;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      text-decoration: none;
      min-width: 0;
    }
    .mdc-tab-btn.active {
      background-color: rgba(99, 102, 241, 0.12) !important;
      color: var(--text-accent-indigo) !important;
      border-color: var(--accent-primary) !important;
    }
    .aec-tab-btn.active {
      background-color: rgba(16, 185, 129, 0.12) !important;
      color: var(--text-accent-green) !important;
      border-color: var(--accent-success) !important;
    }
    .vac-tab-btn.active {
      background-color: rgba(99, 102, 241, 0.12) !important;
      color: var(--text-accent-indigo) !important;
      border-color: var(--accent-primary) !important;
    }
    .sec-tab-btn.active {
      background-color: rgba(245, 158, 11, 0.12) !important;
      color: var(--text-accent-amber) !important;
      border-color: var(--accent-warning) !important;
    }
    .major-syl-tab.active {
      background-color: rgba(99, 102, 241, 0.12) !important;
      color: var(--text-accent-indigo) !important;
      border-color: var(--accent-primary) !important;
    }
    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease-out;
      background-color: var(--surface-accordion);
    }
  </style>

  <script>
    // Independent Community Accordion Toggles
    (function() {
      function bindIndependentToggle(triggerId: string, contentId: string, chevronId: string) {
        const trigger = document.getElementById(triggerId);
        const content = document.getElementById(contentId);
        const chevron = document.getElementById(chevronId);
        if (!trigger || !content) return;
        trigger.addEventListener('click', () => {
          const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';
          content.style.maxHeight = isOpen ? '0px' : content.scrollHeight + 'px';
          if (chevron) chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(90deg)';
        });
      }
      bindIndependentToggle('syl-req-trigger', 'syl-req-content', 'syl-req-chevron');
      bindIndependentToggle('syl-contrib-trigger', 'syl-contrib-content', 'syl-contrib-chevron');
    })();

    // Course Category Accordion Toggle Logic (all closed by default)
    const accordionTriggers = document.querySelectorAll('.accordion-trigger');

    accordionTriggers.forEach(trigger => {
      trigger.addEventListener('click', (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const content = btn.nextElementSibling as HTMLElement;
        const chevron = btn.querySelector('.chevron') as HTMLElement;
        const isOpen = content.classList.contains('open');

        // Close all other accordions
        document.querySelectorAll('.accordion-content').forEach(c => {
          const contentEl = c as HTMLElement;
          if (contentEl !== content && contentEl.classList.contains('open')) {
            contentEl.classList.remove('open');
            contentEl.style.maxHeight = contentEl.scrollHeight + 'px';
            void contentEl.offsetHeight;
            contentEl.style.maxHeight = '0px';

            const siblingBtn = contentEl.previousElementSibling as HTMLElement;
            if (siblingBtn) {
              siblingBtn.style.backgroundColor = 'transparent';
              const sibChevron = siblingBtn.querySelector('.chevron') as HTMLElement;
              if (sibChevron) sibChevron.style.transform = 'rotate(0deg)';
            }
          }
        });

        if (!isOpen) {
          content.classList.add('open');
          content.style.maxHeight = content.scrollHeight + 'px';
          if (chevron) chevron.style.transform = 'rotate(90deg)';
          btn.style.backgroundColor = 'rgba(99, 102, 241, 0.08)';

          const handleTransitionEnd = (event: TransitionEvent) => {
            if (event.propertyName === 'max-height') {
              if (content.classList.contains('open')) {
                content.style.maxHeight = 'none';
              }
              content.removeEventListener('transitionend', handleTransitionEnd);
            }
          };
          content.addEventListener('transitionend', handleTransitionEnd);
        } else {
          content.classList.remove('open');
          content.style.maxHeight = content.scrollHeight + 'px';
          void content.offsetHeight;
          content.style.maxHeight = '0px';
          if (chevron) chevron.style.transform = 'rotate(0deg)';
          btn.style.backgroundColor = 'transparent';
        }
      });
    });

    // Major Syllabus filter tabs + search
    let majorActiveCat = 'all';
    let majorSearchTerm = '';
    const filterMajor = () => {
      const items = document.querySelectorAll<HTMLElement>('.major-syl-item');
      const emptyEl = document.getElementById('major-syl-empty');
      let visible = 0;
      items.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const cat  = item.getAttribute('data-category') || '';
        const catOk  = majorActiveCat === 'all' || cat === majorActiveCat;
        const termOk = !majorSearchTerm || name.includes(majorSearchTerm);
        if (catOk && termOk) { item.style.display = 'flex'; visible++; }
        else item.style.display = 'none';
      });
      if (emptyEl) emptyEl.style.display = visible === 0 ? 'block' : 'none';
    };
    document.querySelectorAll('.major-syl-tab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.major-syl-tab').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        majorActiveCat = (btn as HTMLElement).getAttribute('data-category') || 'all';
        filterMajor();
      });
    });
    const majorSearch = document.getElementById('major-syl-search') as HTMLInputElement | null;
    majorSearch?.addEventListener('input', () => {
      majorSearchTerm = majorSearch.value.toLowerCase().trim();
      filterMajor();
    });

    // MDC Filtering Logic
    const tabBtns = document.querySelectorAll('.mdc-tab-btn');
    const searchInput = document.getElementById('mdc-search-input') as HTMLInputElement;
    const mdcItems = document.querySelectorAll('.mdc-item') as NodeListOf<HTMLAnchorElement>;
    const emptyState = document.getElementById('mdc-empty');
    let activeCategory = 'all';
    let searchQuery = '';
    const filterMdc = () => {
      let visibleCount = 0;
      mdcItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const category = item.getAttribute('data-category') || '';
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesSearch = name.includes(searchQuery);
        if (matchesCategory && matchesSearch) { item.style.display = 'flex'; visibleCount++; }
        else { item.style.display = 'none'; }
      });
      if (emptyState) emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
    };
    tabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        tabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');
        activeCategory = clickedBtn.getAttribute('data-category') || 'all';
        filterMdc();
      });
    });
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterMdc();
    });

    // AEC Filtering Logic + Sem 4 Ranchi Univ. Note Toggle
    const aecTabBtns = document.querySelectorAll('.aec-tab-btn');
    const aecSearchInput = document.getElementById('aec-search-input') as HTMLInputElement;
    const aecItems = document.querySelectorAll('.aec-item') as NodeListOf<HTMLAnchorElement>;
    const aecEmptyState = document.getElementById('aec-empty');
    const aecSem4Note = document.getElementById('aec-sem4-note');
    let activeAecSemester = 'all';
    let aecSearchQuery = '';
    const filterAec = () => {
      let visibleCount = 0;
      aecItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const semester = item.getAttribute('data-semester') || '';
        const matchesSemester = activeAecSemester === 'all' || semester === activeAecSemester;
        const matchesSearch = name.includes(aecSearchQuery);
        if (matchesSemester && matchesSearch) { item.style.display = 'flex'; visibleCount++; }
        else { item.style.display = 'none'; }
      });
      if (aecEmptyState) aecEmptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      if (aecSem4Note) aecSem4Note.style.display = activeAecSemester === 'Semester 4' ? 'flex' : 'none';
    };
    aecTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        aecTabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');
        activeAecSemester = clickedBtn.getAttribute('data-semester') || 'all';
        filterAec();
      });
    });
    aecSearchInput?.addEventListener('input', (e) => {
      aecSearchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterAec();
    });

    // VAC Filtering Logic (tabs only)
    const vacTabBtns = document.querySelectorAll('.vac-tab-btn');
    const vacItems = document.querySelectorAll('.vac-item') as NodeListOf<HTMLAnchorElement>;
    let activeVacSemester = 'all';
    const filterVac = () => {
      vacItems.forEach(item => {
        const semester = item.getAttribute('data-semester') || '';
        item.style.display = (activeVacSemester === 'all' || semester === activeVacSemester) ? 'flex' : 'none';
      });
    };
    vacTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        vacTabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');
        activeVacSemester = clickedBtn.getAttribute('data-semester') || 'all';
        filterVac();
      });
    });

    // SEC Filtering Logic (tabs only)
    const secTabBtns = document.querySelectorAll('.sec-tab-btn');
    const secItems = document.querySelectorAll('.sec-item') as NodeListOf<HTMLAnchorElement>;
    let activeSecSemester = 'all';
    const filterSec = () => {
      secItems.forEach(item => {
        const semester = item.getAttribute('data-semester') || '';
        item.style.display = (activeSecSemester === 'all' || semester === activeSecSemester) ? 'flex' : 'none';
      });
    };
    secTabBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        secTabBtns.forEach(b => b.classList.remove('active'));
        const clickedBtn = e.currentTarget as HTMLElement;
        clickedBtn.classList.add('active');
        activeSecSemester = clickedBtn.getAttribute('data-semester') || 'all';
        filterSec();
      });
    });

    // Auto-open accordion based on URL hash
    setTimeout(() => {
      if (window.location.hash) {
        const hashId = window.location.hash.substring(1);
        const targetElement = document.getElementById(hashId);
        if (targetElement) {
          if (targetElement.classList.contains('accordion-trigger') || targetElement.tagName === 'BUTTON') {
            if (!targetElement.nextElementSibling?.classList.contains('open')) {
              targetElement.click();
            }
            setTimeout(() => {
              targetElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 350);
          } else {
            const parentContent = targetElement.closest('.accordion-content');
            if (parentContent && !parentContent.classList.contains('open')) {
              const parentItem = parentContent.closest('.accordion-item') || parentContent.parentElement;
              const trigger = parentItem?.querySelector('.accordion-trigger') as HTMLElement | null;
              if (trigger) trigger.click();
            }
            if (hashId === 'aec-grid' || hashId === 'vac-grid') {
              const prefix = hashId.startsWith('aec') ? 'aec' : 'vac';
              document.querySelectorAll(`.${prefix}-tab-btn`).forEach(btn => {
                if (btn.getAttribute('data-semester') === 'Semester 4') (btn as HTMLElement).click();
              });
            }
            setTimeout(() => {
              targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }, 450);
          }
        }
      }
    }, 150);
  </script>
</Layout>
