---
import Layout from '../../layouts/Layout.astro';
import syllabusData from '../../../public/data/syllabus.json';
import { BookOpen, GraduationCap, ChevronRight, FileText, Compass, Award } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Create slug helper
const getSlug = (dept: string) => {
  return dept.toLowerCase().replace(/\s+/g, '-');
};

// Group syllabuses by department to show summaries in card
interface SyllabusItem {
  id: string;
  title: string;
  department: string;
  semester: string;
  effectiveFrom: string;
  fileSize: string;
  description: string;
  modules: string[];
}

const deptGroups: Record<string, SyllabusItem[]> = {};
syllabusData.forEach(item => {
  if (!deptGroups[item.department]) {
    deptGroups[item.department] = [];
  }
  deptGroups[item.department].push(item);
});

const departments = Object.keys(deptGroups);
---

<Layout title="Syllabus Directory" activeTab="syllabus">

  <!-- Header -->
  <div style="margin-bottom: 2.5rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Syllabus Directory</h1>
    <p style="color: var(--text-secondary); max-width: 600px; font-size: 1.05rem;">
      Select your department below to view course outlines, semester details, and download official FYUGP curriculum PDFs.
    </p>
  </div>

  <!-- Course Types Selection Section -->
  <div style="display: flex; flex-direction: column; gap: 2.5rem;">
    
    <!-- Major Courses -->
    <div>
      <h2 style="font-size: 1.35rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
        <Compass style="color: var(--accent-primary);" /> Major (Honours) Curriculums
      </h2>
      
      <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
        {departments
          .filter(dept => !dept.toLowerCase().includes('minor'))
          .map(dept => {
            const items = deptGroups[dept];
            const firstItem = items[0];
            const slug = getSlug(dept);
            
            return (
              <a href={`${baseUrl}/syllabus/${slug}`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit;">
                <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                  <div style="background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                    <BookOpen size="22" />
                  </div>
                  <span class="badge badge-primary" style="font-size: 0.7rem;">FYUGP NEP</span>
                </div>
                
                <div>
                  <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">{dept}</h3>
                  <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                    {firstItem.description}
                  </p>
                </div>
                
                <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                  <span>{items.length} Course {items.length > 1 ? 'Outlines' : 'Outline'}</span>
                  <span style="display: flex; align-items: center; font-weight: 700; color: var(--accent-primary);">View Semesters <ChevronRight size="14" /></span>
                </div>
              </a>
            );
          })}
      </div>
    </div>

    <!-- Minor Courses -->
    <div>
      <h2 style="font-size: 1.35rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
        <Award style="color: var(--accent-success);" /> Minor Curriculums
      </h2>
      
      <div style="display: grid; grid-template-columns: 1fr; gap: 1.25rem;" class="md:grid-cols-2">
        {departments
          .filter(dept => dept.toLowerCase().includes('minor'))
          .map(dept => {
            const items = deptGroups[dept];
            const firstItem = items[0];
            const slug = getSlug(dept);
            
            return (
              <a href={`${baseUrl}/syllabus/${slug}`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; text-decoration: none; color: inherit;">
                <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                  <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
                    <GraduationCap size="22" />
                  </div>
                  <span class="badge badge-success" style="font-size: 0.7rem;">Minor Paper</span>
                </div>
                
                <div>
                  <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--text-primary);">{dept}</h3>
                  <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.4rem; line-height: 1.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                    {firstItem.description}
                  </p>
                </div>
                
                <div style="display: flex; justify-content: space-between; width: 100%; border-top: 1px solid var(--border-color); padding-top: 0.875rem; margin-top: auto; font-size: 0.8rem; color: var(--text-secondary);">
                  <span>Effective: {firstItem.effectiveFrom}</span>
                  <span style="display: flex; align-items: center; font-weight: 700; color: var(--accent-success);">View Semesters <ChevronRight size="14" /></span>
                </div>
              </a>
            );
          })}
      </div>
    </div>

  </div>

</Layout>
