          if (activeBanner) activeBanner.style.setProperty('display', 'none', 'important');
        }

        // Get next 5 upcoming holidays
        const upcomingHolidays = holidaysData
          .filter(h => {
            const lastDate = h.dates[h.dates.length - 1];
            return lastDate >= todayStr;
          })
          .slice(0, 5);

        listEl.innerHTML = upcomingHolidays.map(h => {
          const firstDateStr = h.dates[0];
          const dateParts = firstDateStr.split('-');
          const monthIndex = parseInt(dateParts[1], 10) - 1;
          const monthsShort = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
          const monthShort = monthsShort[monthIndex];
          
          let dayDisplay = dateParts[2];
          if (h.dates.length > 1) {
            const lastDateStr = h.dates[h.dates.length - 1];
            const lastDay = lastDateStr.split('-')[2];
            dayDisplay = `${parseInt(dayDisplay, 10)}-${parseInt(lastDay, 10)}`;
          } else {
            dayDisplay = parseInt(dayDisplay, 10).toString();
          }

          let badgeClass = 'badge-primary';
          let badgeLabel = 'Break';
          if (h.type === 'festival') {
            badgeClass = 'badge-warning';
            badgeLabel = 'Festival';
          } else if (h.type === 'national') {
            badgeClass = 'badge-danger';
            badgeLabel = 'National';
          }

          const isCurrentlyActive = h.dates.includes(todayStr);
          const activeStyle = isCurrentlyActive ? 'border-color: var(--accent-success); background-color: rgba(16, 185, 129, 0.03);' : '';

          return `
            <div style="display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.35rem; border-radius: var(--radius-sm); border: 1px solid transparent; ${activeStyle}">
              <!-- Date Block -->
              <div style="background-color: var(--bg-tertiary); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--border-color);">
                <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: var(--text-secondary); line-height: 1;">${monthShort}</span>
                <span style="font-size: 1.05rem; font-weight: 800; font-family: var(--font-display); color: var(--accent-primary); line-height: 1.1; margin-top: 1px;">${dayDisplay}</span>
              </div>
              
              <!-- Content Info -->
              <div style="flex: 1; min-width: 0;">
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.25rem;">
                  <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 140px; margin: 0;" title="${h.name}">
                    ${h.name}
                  </h4>
                  <span class="badge ${badgeClass}" style="font-size: 0.55rem; padding: 0.1rem 0.3; line-height: 1; flex-shrink: 0;">${badgeLabel}</span>
                </div>
                <p style="font-size: 0.725rem; color: var(--text-secondary); margin-top: 2px; margin-bottom: 0;">
                  ${h.daysOfWeek} • ${h.daysCount} ${h.daysCount === 1 ? 'day' : 'days'}
                </p>
              </div>
