        if (!listEl) return;

        // Check if currently on holiday
        const currentHoliday = holidaysData.find(h => h.dates.includes(todayStr));
        if (currentHoliday) {
          if (activeBanner) activeBanner.style.setProperty('display', 'flex', 'important');
          if (activeName) activeName.textContent = currentHoliday.name;
          if (activeDays) {
            if (currentHoliday.dates.length > 1) {
              const dayIdx = currentHoliday.dates.indexOf(todayStr) + 1;
              activeDays.textContent = `Day ${dayIdx} of ${currentHoliday.dates.length} (${currentHoliday.dateDisplay})`;
            } else {
              activeDays.textContent = `Official Holiday (${currentHoliday.dateDisplay})`;
            }
