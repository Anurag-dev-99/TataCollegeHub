      const contributorsContent = document.getElementById('contributors-content');
      const contributorsChevron = document.getElementById('contributors-chevron');
      const contributorsPreview = document.getElementById('contributors-preview');
      if (contributorsTrigger && contributorsContent) {
        contributorsTrigger.addEventListener('click', () => {
          const isOpen = contributorsContent.style.maxHeight && contributorsContent.style.maxHeight !== '0px';
          if (isOpen) {
            contributorsContent.style.maxHeight = '0px';
            if (contributorsChevron) contributorsChevron.style.transform = 'rotate(0deg)';
