                  <h4 style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); line-height: 1.2; margin: 0;">${h.name}</h4>
                  <span class="badge ${badgeClass}" style="font-size: 0.55rem; padding: 0.1rem 0.3rem; flex-shrink: 0; line-height: 1;">${badgeLabel}</span>
                </div>
                <div style="font-size: 0.75rem; color: var(--text-secondary); display: flex; flex-direction: column; gap: 0.15rem; margin-top: 0.25rem;">
                  <div>📅 ${h.dateDisplay} (${h.daysOfWeek})</div>
