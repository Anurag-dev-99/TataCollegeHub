    }
  </style>

  <script>
    (() => {
      const btn      = document.getElementById('donate-btn');
      const overlay  = document.getElementById('donate-modal-overlay');
      const closeBtn = document.getElementById('donate-close');
      const upiPill  = document.getElementById('upi-id-pill');
      const copyTick = document.getElementById('copy-tick');
      const qrToggle = document.getElementById('qr-toggle');
      const qrPanel  = document.getElementById('qr-panel');
      if (!btn || !overlay) return;

      const open  = () => { overlay.style.display = 'flex'; document.body.style.overflow = 'hidden'; };
      const close = () => { overlay.style.display = 'none';  document.body.style.overflow = ''; };

      btn.addEventListener('click', open);
      closeBtn?.addEventListener('click', close);
      overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });

      // Copy UPI ID
      upiPill?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText('8002059887@ibl');
          if (copyTick) { copyTick.style.display = 'inline'; setTimeout(() => { copyTick.style.display = 'none'; }, 2000); }
        } catch(_) {}
      });

      // QR panel toggle
      let qrOpen = false;
      qrToggle?.addEventListener('click', () => {
        qrOpen = !qrOpen;
        qrPanel.style.display = qrOpen ? 'flex' : 'none';
        qrToggle.textContent = qrOpen ? '📷 Hide QR ▲' : '📷 Show QR to scan instead ▼';
      });

      // Chai buttons → UPI redirect with selected amount
      document.querySelectorAll('.chai-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const amount = btn.getAttribute('data-amount');
          const params = new URLSearchParams({
            pa: '8002059887@ibl',
            pn: 'Anurag Nishad',
            tn: 'Chai for KolhanHub',
            am: amount,
            cu: 'INR'
          });
          window.location.href = 'upi://pay?' + params.toString();
        });
      });
    })();
  </script>

