        }).join('');
      };

      // 5. Modal Control Listeners
      const openHolidaysModal = () => {
        holidaysModal?.classList.add('open');
        renderModalList();
      };

      const closeHolidaysModal = () => {
        holidaysModal?.classList.remove('open');
      };

      viewAllBtn?.addEventListener('click', openHolidaysModal);
      closeHolidaysBtn?.addEventListener('click', closeHolidaysModal);
      closeHolidaysDoneBtn?.addEventListener('click', closeHolidaysModal);
      holidaysModal?.addEventListener('click', (e) => {
        if (e.target === holidaysModal) closeHolidaysModal();
      });

      // 6. Completed Requests Accordion Toggle
      const completedTrigger = document.getElementById('completed-requests-trigger');
      const completedContent = document.getElementById('completed-requests-content');
      const completedChevron = document.getElementById('completed-chevron');

      completedTrigger?.addEventListener('click', () => {
        const isOpen = completedContent.style.maxHeight && completedContent.style.maxHeight !== '0px';
        if (isOpen) {
          completedContent.style.maxHeight = '0px';
          completedContent.style.borderTopWidth = '0px';
          if (completedChevron) completedChevron.style.transform = 'rotate(0deg)';
        } else {
          completedContent.style.maxHeight = completedContent.scrollHeight + 'px';
          completedContent.style.borderTopWidth = '1px';
          if (completedChevron) completedChevron.style.transform = 'rotate(90deg)';
        }
      });
