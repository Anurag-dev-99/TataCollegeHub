      <div lang="hi" style="padding: 0.65rem 0.8rem; border-radius: 10px; background: var(--surface-subtle); border: 1px solid var(--border-color); font-size: 0.75rem; color: var(--text-secondary); line-height: 1.55;">
        <strong style="color: var(--text-primary);">कोल्हान यूनिवर्सिटी छात्रों के लिए:</strong> यहाँ सभी 37 कॉलेजों के NEP FYUGP सेमेस्टर 1–8 के पिछले साल के प्रश्न पत्र (PYQ), सिलेबस, छुट्टियों की सूची, रिजल्ट और कम कीमत में एग्जाम नोट्स उपलब्ध हैं।
      </div>
    </div>

    <!-- Visible 4-Item FAQ (Synced with FAQPage JSON-LD) -->
    <div class="card" style="padding: 1rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.65rem; flex-wrap: nowrap;">
        <h2 style="font-size: 0.96rem; font-weight: 800; font-family: var(--font-display); color: var(--text-primary); margin: 0; min-width: 0;">
          Frequently Asked Questions
        </h2>
        <a href={`${baseUrl}/faq/`} style="font-size: 0.72rem; font-weight: 700; color: var(--text-accent-indigo); text-decoration: none; white-space: nowrap; flex-shrink: 0;">
          More FAQs →
        </a>
