        { id: 'form-pill-free', start: new Date('2026-07-22'), end: new Date('2026-08-01') },
        { id: 'form-pill-200',  start: new Date('2026-08-01'), end: new Date('2026-08-06') },
        { id: 'form-pill-500',  start: new Date('2026-08-06'), end: new Date('2026-08-11') },
      ];
      pills.forEach(p => {
        const el = document.getElementById(p.id);
        if (!el) return;
        if (now >= p.start && now < p.end) {
          el.style.boxShadow = '0 0 8px ' + (p.id === 'form-pill-free' ? 'rgba(16,185,129,0.3)' : p.id === 'form-pill-200' ? 'rgba(245,158,11,0.3)' : 'rgba(239,68,68,0.3)');
          el.style.fontWeight = '800';
        } else if (now >= p.end) {
          el.style.opacity = '0.4';
          el.style.textDecoration = 'line-through';
        }
      });
    })();
