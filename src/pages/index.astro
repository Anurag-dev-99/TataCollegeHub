  <script is:inline>
    (function () {
      var STATS_URL = "https://script.google.com/macros/s/AKfycbx3ZJ1VuRgNc71FSKnrIAzLsv3qxnUeBwA8HALHWhDxlpJC93YzOwCV5rmLLT-swLaXHQ/exec?action=stats";
      var CACHE_KEY = "kolhanhub_live_stats";
      var totalEl = document.getElementById("stat-total-downloads");
      var pyqEl = document.getElementById("stat-pyq-downloads");
      var sylEl = document.getElementById("stat-syllabus-downloads");
      var reqEl = document.getElementById("stat-requests-count");
      var tyEl = document.getElementById("thankyou-dl-label");

      function applyStats(d) {
        if (!d) return;
        if (typeof d.total === "number" && d.total > 0) {
          var fmtTotal = d.total.toLocaleString("en-IN");
          if (totalEl) totalEl.textContent = fmtTotal;
          if (tyEl) tyEl.textContent = fmtTotal;
        }
        if (pyqEl && typeof d.pyqDownloads === "number" && d.pyqDownloads > 0) pyqEl.textContent = d.pyqDownloads.toLocaleString("en-IN");
        if (sylEl && typeof d.syllabusDownloads === "number" && d.syllabusDownloads > 0) sylEl.textContent = d.syllabusDownloads.toLocaleString("en-IN");
        if (reqEl && typeof d.requestsCount === "number" && d.requestsCount > 0) reqEl.textContent = d.requestsCount.toLocaleString("en-IN");
      }

      try {
        var cached = localStorage.getItem(CACHE_KEY);
        if (cached) applyStats(JSON.parse(cached));
      } catch (e) {}

      fetch(STATS_URL)
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && data.status === "ok") {
            applyStats(data);
            try {
              localStorage.setItem(CACHE_KEY, JSON.stringify({
                total: data.total,
                pyqDownloads: data.pyqDownloads,
                syllabusDownloads: data.syllabusDownloads,
                requestsCount: data.requestsCount
              }));
            } catch (e) {}
          }
        })
        .catch(function () {});
    })();
  </script>

