  <script type="module">
  (() => {
    const centres = [
      {centre:"A.B.M College, Jsr.",colleges:["LBSM College, Jsr."]},
      {centre:"Baharagora College, Baharagora",colleges:["Baharagora College, Baharagora"]},
      {centre:"Ghatsila College, Ghatsila",colleges:["Ghatsila College, Ghatsila"]},
      {centre:"The G.S.C. for Women, Jsr.",colleges:["The G.S.C. for Women, Jsr."]},
      {centre:"Jsr. Co-operative College, Jsr.",colleges:["Karim City College, Jsr."]},
      {centre:"Jsr. Workers' College, Jsr.",colleges:["J.K.S College, Jsr."]},
      {centre:"J.L.N. College, Chakradharpur",colleges:["J.L.N. College, Chakradharpur","VAS College, Sonua"]},
      {centre:"K.S College, Seraikella",colleges:["K.S. College, Seraikella","Degree College, Kharsawan","Institute for Education Seraikella Kharsawan"]},
      {centre:"L.B.S.M College, Jsr.",colleges:["Jsr. Co-operative College, Jsr.","Rambha College, Gitilata"]},
      {centre:"Mahila College, Chaibasa",colleges:["Tata College, Chaibasa","G.C. Jain Commerce College, Chaibasa"]},
      {centre:"Singhbhum College, Chandil",colleges:["Singhbhum College, Chandil","MBNS Institute of Graduate Studies, Chandil"]},
      {centre:"Tata College, Chaibasa",colleges:["Mahila College, Chaibasa","Degree College, Manjhgaon, Kumardungi"]},
      {centre:"BDSL Mahila College, Ghatsila",colleges:["BDSL Mahila College, Ghatsila","J.K.M College of Management, Science and Commerce, Salboni","AJK College, Chakulia","S.R.K.M. College, Chakulia"]},
      {centre:"J.K.S College, Jsr.",colleges:["Jsr. Worker's College, Jsr."]},
      {centre:"Karim City College, Jsr.",colleges:["ABM College, Jsr.","R.K.M Voc. Training Inst. Jsr.","GIIT Prof. College, Jsr.","Mrs. KMPM Voc. College, Jsr.","XITE, Gamharia"]},
      {centre:"Patamda Degree College, Jalla",colleges:["Patamda Degree College, Jalla"]},
      {centre:"St. Augustin's College, Manoharpur",colleges:["St. Augustin's College, Manoharpur"]},
      {centre:"Noamundi College, Noamundi",colleges:["Noamundi College, Noamundi","Degree College, Jagannathpur"]},
      {centre:"Degree College, Manoharpur",colleges:["Degree College, Manoharpur"]},
      {centre:"Model Mahavidyalaya, Seraikella-Kharswan",colleges:["Model Mahavidyalaya, Seraikella-Kharswan"]},
      {centre:"Mahila Mahavidyalaya, Seraikella-Kharsawan",colleges:["Mahila Mahavidyalaya, Seraikella Kharsawan"]}
    ];

    const toggle = document.getElementById('ec-toggle');
    const content = document.getElementById('ec-content');
    const chevron = document.getElementById('ec-chevron');
    const search = document.getElementById('ec-search');
    const results = document.getElementById('ec-results');
    const noResult = document.getElementById('ec-no-result');
    let isOpen = false;

    function renderCentres(query) {
      results.innerHTML = '';
      const q = (query || '').toLowerCase().trim();
      let matched = 0;

      centres.forEach(c => {
        const centreMatch = c.centre.toLowerCase().includes(q);
        const collegeMatches = c.colleges.filter(col => col.toLowerCase().includes(q));
        if (!q || centreMatch || collegeMatches.length > 0) {
          matched++;
          const row = document.createElement('div');
          row.style.cssText = 'border:1px solid rgba(245,158,11,0.15);border-radius:8px;padding:0.55rem 0.7rem;background:rgba(245,158,11,0.03);transition:border-color 0.2s;';

          const highlight = (text) => {
            if (!q) return text;
            const idx = text.toLowerCase().indexOf(q);
            if (idx === -1) return text;
            return text.substring(0,idx) + '<mark style="background:rgba(245,158,11,0.3);color:#fbbf24;border-radius:2px;padding:0 1px;">' + text.substring(idx, idx+q.length) + '</mark>' + text.substring(idx+q.length);
          };

          const collegeList = c.colleges.map(col =>
            `<span style="font-size:0.72rem;color:var(--text-secondary);">${highlight(col)}</span>`
          ).join('<span style="font-size:0.6rem;color:var(--text-tertiary);"> · </span>');

          row.innerHTML = `
            <div style="font-size:0.75rem;font-weight:700;color:#fbbf24;margin-bottom:3px;">📍 ${highlight(c.centre)}</div>
            <div style="display:flex;flex-wrap:wrap;gap:0.15rem;align-items:center;">
              <span style="font-size:0.62rem;color:var(--text-tertiary);margin-right:2px;">Colleges:</span>
              ${collegeList}
            </div>
          `;
          results.appendChild(row);
        }
      });

      noResult.style.display = matched === 0 ? 'block' : 'none';
    }

    toggle.addEventListener('click', () => {
      isOpen = !isOpen;
      if (isOpen) {
        content.style.maxHeight = content.scrollHeight + 500 + 'px';
        chevron.style.transform = 'rotate(90deg)';
        renderCentres('');
        setTimeout(() => search.focus(), 100);
      } else {
        content.style.maxHeight = '0';
        chevron.style.transform = 'rotate(0deg)';
      }
    });

    search.addEventListener('input', (e) => {
      renderCentres(e.target.value);
      content.style.maxHeight = content.scrollHeight + 500 + 'px';
    });
  })();
  </script>

