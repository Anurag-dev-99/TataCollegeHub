---
import Layout from '../layouts/Layout.astro';
import noticesData from '../../public/data/notices.json';
import calendarData from '../../public/data/calendar.json';
import pyqsData from '../../public/data/pyqs.json';
import holidaysData from '../../public/data/holidays-2026.json';
import { Bell, Calendar, Download, FileSpreadsheet, FileCode, GraduationCap, ChevronRight, AlertTriangle, Clock, ArrowRight, HelpCircle, Calculator, X, ClipboardCheck } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Filter and sort notices
const activeNotices = noticesData.filter(notice => !notice.isArchived);
const pinnedNotices = activeNotices.filter(notice => notice.isPinned);
const recentNotices = activeNotices.filter(notice => !notice.isPinned).slice(0, 3);

// Real computed stats from pyqs.json (always accurate, built at deploy time)
const pyqsWithUrl = pyqsData.filter((p: any) => p.downloadUrl);
const totalPyqsAvailable = pyqsWithUrl.length;
const uniqueSubjects = [...new Set(pyqsWithUrl.map((p: any) => p.subject))].length;
const uniqueCategories = [...new Set(pyqsWithUrl.map((p: any) => p.category))];

// Automated Deadline Parser
interface Deadline {
  title: string;
  dateStr: string;
  originalNoticeId: string;
}

const extractDeadlines = (): Deadline[] => {
  const deadlines: Deadline[] = [];
  const dateRegex = /(?:last date|deadline|form fill-up)[^.]*?((?:June|July|August|September|October|November|December|January|February|March|April|May)\s+\d{1,2},?\s+\d{4}|\d{1,2}\s+(?:June|July|August|September|October|November|December|January|February|March|April|May),?\s+\d{4}|\d{1,2}-\d{1,2}-\d{4})/i;

  activeNotices.forEach(notice => {
    const textToSearch = `${notice.title} ${notice.description}`;
    const containsKeyword = /last date|deadline|exam form|form fill/i.test(textToSearch);
    
    if (containsKeyword) {
      const match = textToSearch.match(dateRegex);
      if (match) {
        deadlines.push({
          title: notice.title.replace(/Examination | official | dates/gi, ''),
          dateStr: match[1],
          originalNoticeId: notice.id
        });
      }
    }
  });
  return deadlines;
};

const extractedDeadlines = extractDeadlines();
const primaryDeadline = extractedDeadlines[0] || null;

// Most popular papers (recent activity stats)
const popularPapers = [...pyqsData]
  .sort((a, b) => (b.downloadCount || 0) - (a.downloadCount || 0))
  .slice(0, 3);
---

<Layout 
  title="Kolhan University Student Hub — Tata College, Chaibasa"
  description="Free Kolhan University PYQ downloads, NEP 2020 FYUGP syllabus, exam results and official notices for Tata College, Chaibasa students. Previous year question papers for 2022 batch — Semester 1 to 8."
  keywords="Kolhan University PYQ, Kolhan University result, Kolhan University syllabus, Kolhan University Chaibasa, Tata College Chaibasa, Kolhan University question papers download, Kolhan University 2022 batch, NEP 2020 Kolhan University, FYUGP syllabus, Tata College PYQ"
  activeTab="home"
>
  
  <!-- Header welcome -->
  <div style="margin-bottom: 2.25rem; display: flex; flex-direction: column; gap: 0.65rem;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(99, 102, 241, 0.08); border: 1px solid rgba(99, 102, 241, 0.15); border-radius: var(--radius-full); padding: 0.35rem 0.95rem; width: fit-content; font-size: 0.75rem; font-weight: 700; color: var(--accent-primary); letter-spacing: 0.02em;">
      🎓 Built by students, for students
    </div>
    <h1 style="font-size: 2.25rem; font-family: var(--font-display); tracking: -0.03em; font-weight: 850; background: linear-gradient(to right, var(--text-primary), var(--text-secondary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0;">
      Kolhan University PYQs, Syllabus, Results &amp; Notices
    </h1>
    <p style="color: var(--text-secondary); max-width: 650px; font-size: 1.08rem; line-height: 1.6; font-weight: 500; margin: 0;">
      in one place
    </p>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       FYUGP SEM 1 EXAM 2025 — LIVE COUNTDOWN (COLLAPSIBLE)
  ════════════════════════════════════════════════════════════════ -->
  <div id="exam-countdown-section" style="margin-bottom: 2rem;">
    <!-- Section header label -->
    <div style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.6rem;">
      <span style="font-size:1rem;">📅</span>
      <span style="font-size:0.82rem;font-weight:700;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.06em;">FYUGP Sem 1 Exam 2025</span>
      <span id="exam-all-done-badge" style="display:none;font-size:0.65rem;font-weight:700;background:rgba(16,185,129,0.12);color:var(--accent-success);border:1px solid rgba(16,185,129,0.25);border-radius:20px;padding:1px 8px;">All Done ✓</span>
    </div>

    <!-- Toggle row (next exam + expand button) — injected by JS -->

    <!-- Expanded cards grid (hidden by default) -->
    <div id="exam-cards-grid" style="display:none;grid-template-columns:repeat(auto-fill,minmax(275px,1fr));gap:0.65rem;margin-top:0.6rem;"></div>

    <!-- All exams done fallback -->
    <div id="exam-all-complete-msg" style="display:none;padding:1.2rem 1.4rem;border:1px solid rgba(16,185,129,0.25);border-radius:var(--radius-sm);background:linear-gradient(135deg,rgba(16,185,129,0.05),rgba(0,0,0,0.15));text-align:center;color:var(--accent-success);font-weight:700;font-size:0.9rem;">
      🎉 All FYUGP Sem 1 exams are over! Results awaited.
    </div>
  </div>

  <script type="module">
  (() => {
    const schedule = [
      {"date":"2026-07-15","day":"Wednesday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"13:00:00","paper_type":"Major (MJ-1)","details":"Science & Commerce/Vocational Subjects (Physics, Chem, Math, Bot, Zoo, Geol, Stat, Commerce, BBA, BCA, IT, Mass Comm, Env.)"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"17:00:00","paper_type":"Major (MJ-1)","details":"Language & Literature Subjects (History, Philosophy, Hindi, English, Bengali, Oriya, Urdu, Sanskrit, Ho, Santali, Mundari, Kurmali, Kurukh, Maithili)"}]},
      {"date":"2026-07-17","day":"Friday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"13:00:00","paper_type":"Major (MJ-1)","details":"Social Sciences (Pol. Science, Public Admin, Economics, Sociology, Psychology, Geography, Anthropology, Home Science)"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"17:00:00","paper_type":"Associated Core (AC-1)","details":"Science & Vocational Subjects"}]},
      {"date":"2026-07-18","day":"Saturday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"13:00:00","paper_type":"Associated Core (AC-1)","details":"Language & Literature Subjects"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"17:00:00","paper_type":"Associated Core (AC-1)","details":"Social Sciences"}]},
      {"date":"2026-07-20","day":"Monday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"13:00:00","paper_type":"MDC-1","details":"Science & Commerce/Vocational Subjects"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"17:00:00","paper_type":"MDC-1","details":"Language & Literature Subjects"}]},
      {"date":"2026-07-21","day":"Tuesday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"13:00:00","paper_type":"MDC-1","details":"Philosophy"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"17:00:00","paper_type":"MDC-1","details":"Social Sciences (except Psychology)"}]},
      {"date":"2026-07-22","day":"Wednesday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"13:00:00","paper_type":"MDC-1","details":"Psychology"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"17:00:00","paper_type":"SEC-1","details":"Digital Education: DE - Set - 1 (For Science, Commerce & Vocational Majors)"}]},
      {"date":"2026-07-23","day":"Thursday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"13:00:00","paper_type":"SEC-1","details":"Digital Education: DE - Set - 2 (For Language & Literature Majors)"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"17:00:00","paper_type":"SEC-1","details":"Digital Education: DE - Set - 3 (For Social Science Majors)"}]},
      {"date":"2026-07-24","day":"Friday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"11:30:00","paper_type":"VAC-1","details":"Understanding India: UI - Set - 1 (Science, Commerce & Vocational Majors)"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"15:30:00","paper_type":"VAC-1","details":"Understanding India: UI - Set - 2 (Language & Literature Majors)"}]},
      {"date":"2026-07-25","day":"Saturday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"11:30:00","paper_type":"VAC-1","details":"Understanding India: UI - Set - 3 (Social Science Majors)"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"15:30:00","paper_type":"AEC-I","details":"Hindi Composition - Set - 1 (Science, Commerce & Vocational Majors)"}]},
      {"date":"2026-07-27","day":"Monday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"11:30:00","paper_type":"AEC-I","details":"Hindi Composition - Set - 2 (Language & Literature Majors)"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"15:30:00","paper_type":"AEC-I","details":"Hindi Composition - Set - 3 (Social Science Majors)"}]},
      {"date":"2026-07-28","day":"Tuesday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"11:30:00","paper_type":"IKS-1","details":"Indian Knowledge System - Set - 1 (Science, Commerce & Vocational Majors)"},{"sitting":"2nd Sitting","time_start":"14:00:00","time_end":"15:30:00","paper_type":"IKS-1","details":"Indian Knowledge System - Set - 2 (Language & Literature Majors)"}]},
      {"date":"2026-07-29","day":"Wednesday","sittings":[{"sitting":"1st Sitting","time_start":"10:00:00","time_end":"11:30:00","paper_type":"IKS-1","details":"Indian Knowledge System - Set - 3 (Social Science Majors)"}]}
    ];

    const typeColors = {
      'Major': { bg:'rgba(99,102,241,0.10)',  border:'rgba(99,102,241,0.30)',  badge:'rgba(99,102,241,0.18)',  text:'#818cf8', icon:'📘' },
      'AC':    { bg:'rgba(139,92,246,0.08)',  border:'rgba(139,92,246,0.25)',  badge:'rgba(139,92,246,0.15)',  text:'#a78bfa', icon:'📗' },
      'MDC':   { bg:'rgba(236,72,153,0.08)', border:'rgba(236,72,153,0.25)', badge:'rgba(236,72,153,0.15)', text:'#f472b6', icon:'📙' },
      'SEC':   { bg:'rgba(20,184,166,0.08)', border:'rgba(20,184,166,0.25)', badge:'rgba(20,184,166,0.15)', text:'#2dd4bf', icon:'💻' },
      'VAC':   { bg:'rgba(245,158,11,0.08)', border:'rgba(245,158,11,0.25)', badge:'rgba(245,158,11,0.15)', text:'#fbbf24', icon:'🌿' },
      'AEC':   { bg:'rgba(239,68,68,0.08)',  border:'rgba(239,68,68,0.25)',  badge:'rgba(239,68,68,0.15)',  text:'#f87171', icon:'✍️' },
      'IKS':   { bg:'rgba(251,191,36,0.08)', border:'rgba(251,191,36,0.25)', badge:'rgba(251,191,36,0.15)', text:'#fcd34d', icon:'📿' },
    };

    function typeKey(pt) {
      if (pt.includes('Major')) return 'Major';
      if (pt.includes('AC'))    return 'AC';
      if (pt.includes('MDC'))   return 'MDC';
      if (pt.includes('SEC'))   return 'SEC';
      if (pt.includes('VAC'))   return 'VAC';
      if (pt.includes('AEC'))   return 'AEC';
      if (pt.includes('IKS'))   return 'IKS';
      return 'Major';
    }

    function buildEvents() {
      const seen = new Map();
      for (const day of schedule) {
        for (const s of day.sittings) {
          const key = `${day.date}|${s.paper_type}`;
          if (!seen.has(key)) {
            seen.set(key, {
              date: day.date, day: day.day,
              paper_type: s.paper_type,
              typeKey: typeKey(s.paper_type),
              startTime: s.time_start.substring(0,5),
              details: [],
              deadline: new Date(`${day.date}T${s.time_start}`)
            });
          }
          seen.get(key).details.push(s.details);
        }
      }
      return [...seen.values()].sort((a,b) => a.deadline - b.deadline);
    }

    const events = buildEvents();

    function pad(n) { return String(n).padStart(2,'0'); }
    function tl(dt) {
      const d = dt - Date.now();
      if (d <= 0) return null;
      return { days:Math.floor(d/86400000), hours:Math.floor((d%86400000)/3600000), mins:Math.floor((d%3600000)/60000), secs:Math.floor((d%60000)/1000), ms:d };
    }
    function urg(ms) {
      const h = ms/3600000;
      if (h<=24) return {bg:'rgba(239,68,68,0.15)',border:'rgba(239,68,68,0.4)',label:'TODAY',lc:'#f87171'};
      if (h<=72) return {bg:'rgba(245,158,11,0.12)',border:'rgba(245,158,11,0.35)',label:'SOON',lc:'#fbbf24'};
      return null;
    }
    function fmtDate(ds) {
      return new Date(ds+'T00:00:00').toLocaleDateString('en-IN',{weekday:'short',day:'numeric',month:'short'});
    }

    // DOM
    const grid      = document.getElementById('exam-cards-grid');
    const allDone   = document.getElementById('exam-all-complete-msg');
    const allBadge  = document.getElementById('exam-all-done-badge');

    let isExpanded = false;
    let cardTimers = {};   // eventIdx → timerEl
    let hdrTimerEl = null; // compact timer in the toggle row

    // ── Card builder ──────────────────────────────────────────────
    function makeCard(ev, i) {
      const t = tl(ev.deadline);
      if (!t) return null;
      const c  = typeColors[ev.typeKey] || typeColors['Major'];
      const u  = urg(t.ms);
      const bc = u ? u.border : c.border;
      const bg = u ? u.bg     : c.bg;
      const up = u ? `<span style="font-size:0.58rem;font-weight:800;color:${u.lc};background:${u.bg};border:1px solid ${u.border};border-radius:20px;padding:1px 6px;">${u.label}</span>` : '';
      const snip = ev.details[0].length > 70 ? ev.details[0].substring(0,68)+'…' : ev.details[0];

      const card = document.createElement('div');
      card.id = `ec-card-${i}`;
      card.style.cssText = `border:1px solid ${bc};border-radius:12px;padding:0.95rem 1.05rem;background:${bg};transition:border-color 0.4s,box-shadow 0.3s;backdrop-filter:blur(4px);`;
      if (u) card.style.boxShadow = `0 0 16px ${bc}55`;
      card.innerHTML = `
        <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:0.5rem;margin-bottom:0.5rem;">
          <div style="display:flex;align-items:center;gap:0.4rem;">
            <span style="font-size:0.95rem;">${c.icon}</span>
            <span style="font-size:0.8rem;font-weight:800;color:${c.text};background:${c.badge};border-radius:20px;padding:2px 8px;">${ev.paper_type}</span>
          </div>
          <div style="display:flex;align-items:center;gap:0.3rem;">
            ${up}
            <span style="font-size:0.67rem;color:var(--text-tertiary);white-space:nowrap;">${fmtDate(ev.date)} · ${ev.startTime}</span>
          </div>
        </div>
        <div style="font-size:0.76rem;color:var(--text-secondary);margin-bottom:0.6rem;line-height:1.45;">${snip}</div>
        <div id="ec-timer-${i}" style="display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap;"></div>
      `;
      return card;
    }

    // ── Full timer renderer (expanded cards) ──────────────────────
    function timerHtml(t) {
      const u = (v,l) => `<div style="text-align:center;min-width:34px;"><div style="font-size:1.3rem;font-weight:900;font-family:var(--font-display);color:var(--text-primary);line-height:1;">${pad(v)}</div><div style="font-size:0.5rem;color:var(--text-tertiary);letter-spacing:0.06em;text-transform:uppercase;margin-top:1px;">${l}</div></div>`;
      const s = () => `<div style="font-size:1rem;font-weight:900;color:var(--text-tertiary);margin-top:-3px;">:</div>`;
      let h = '';
      if (t.days > 0) h += u(t.days,'days') + s();
      return h + u(t.hours,'hrs') + s() + u(t.mins,'min') + s() + u(t.secs,'sec');
    }

    // ── Main build/rebuild ─────────────────────────────────────────
    function buildCards() {
      cardTimers = {};
      hdrTimerEl = null;

      const upcoming = events.map((ev,i)=>({ev,i})).filter(({ev})=>tl(ev.deadline));

      // Remove old toggle row
      document.getElementById('ec-toggle-row')?.remove();

      if (upcoming.length === 0) {
        grid.style.display = 'none';
        allDone.style.display = 'block';
        allBadge.style.display = 'inline-flex';
        return;
      }

      // ── Build the collapsed header row (next exam) ───────────────
      const {ev: ne, i: ni} = upcoming[0];
      const nc = typeColors[ne.typeKey] || typeColors['Major'];
      const nu = urg(tl(ne.deadline)?.ms || 0);
      const nbc = nu ? nu.border : nc.border;
      const nbg = nu ? nu.bg     : nc.bg;
      const moreCount = upcoming.length - 1;

      const row = document.createElement('div');
      row.id = 'ec-toggle-row';
      row.style.cssText = `display:flex;align-items:center;justify-content:space-between;gap:0.6rem;padding:0.75rem 1rem;border:1px solid ${nbc};border-radius:12px;background:${nbg};cursor:pointer;margin-bottom:${isExpanded?'0.65rem':'0'};transition:margin 0.3s;flex-wrap:wrap;`;
      if (nu) row.style.boxShadow = `0 0 16px ${nbc}44`;

      const nup = nu ? `<span style="font-size:0.58rem;font-weight:800;color:${nu.lc};background:${nu.bg};border:1px solid ${nu.border};border-radius:20px;padding:1px 6px;">${nu.label}</span>` : '';

      row.innerHTML = `
        <div style="display:flex;align-items:center;gap:0.55rem;flex:1;min-width:0;">
          <span style="font-size:1rem;">${nc.icon}</span>
          <div style="min-width:0;">
            <div style="display:flex;align-items:center;gap:0.35rem;flex-wrap:wrap;">
              <span style="font-size:0.8rem;font-weight:800;color:${nc.text};background:${nc.badge};border-radius:20px;padding:2px 8px;white-space:nowrap;">${ne.paper_type}</span>
              ${nup}
              <span style="font-size:0.67rem;color:var(--text-tertiary);white-space:nowrap;">${fmtDate(ne.date)} · ${ne.startTime}</span>
            </div>
            <div style="font-size:0.7rem;color:var(--text-secondary);margin-top:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">${ne.details[0].substring(0,55)}…</div>
          </div>
        </div>
        <div style="display:flex;align-items:center;gap:0.55rem;flex-shrink:0;">
          <div id="ec-hdr-timer" style="text-align:right;min-width:64px;"></div>
          <button id="ec-expand-btn" style="display:flex;align-items:center;gap:0.3rem;font-size:0.7rem;font-weight:700;color:${nc.text};background:${nc.badge};border:1px solid ${nc.border};border-radius:20px;padding:3px 10px;cursor:pointer;white-space:nowrap;">${isExpanded ? '▲ Collapse' : `▼ ${moreCount > 0 ? `+${moreCount} more` : 'Expand'}`}</button>
        </div>
      `;

      grid.parentElement.insertBefore(row, grid);
      hdrTimerEl = document.getElementById('ec-hdr-timer');

      // Click to toggle
      const doToggle = (e) => { e.stopPropagation(); isExpanded = !isExpanded; buildCards(); tick(); };
      row.addEventListener('click', doToggle);
      document.getElementById('ec-expand-btn').addEventListener('click', doToggle);

      // ── Grid (expanded) ──────────────────────────────────────────
      if (isExpanded) {
        grid.style.display = 'grid';
        grid.innerHTML = '';
        for (const {ev, i} of upcoming) {
          const card = makeCard(ev, i);
          if (!card) continue;
          grid.appendChild(card);
          cardTimers[i] = document.getElementById(`ec-timer-${i}`);
        }
      } else {
        grid.style.display = 'none';
        grid.innerHTML = '';
        // Track next event for header timer only
        cardTimers[ni] = null;
      }
    }

    // ── Tick every second ─────────────────────────────────────────
    function tick() {
      let rebuild = false;

      // Header compact timer
      const nextEv = events.find(ev => tl(ev.deadline));
      if (nextEv && hdrTimerEl) {
        const t = tl(nextEv.deadline);
        if (!t) { rebuild = true; }
        else {
          hdrTimerEl.innerHTML = t.days > 0
            ? `<span style="font-size:0.88rem;font-weight:900;font-family:var(--font-display);color:var(--text-primary);">${t.days}d ${pad(t.hours)}h ${pad(t.mins)}m</span>`
            : `<span style="font-size:0.88rem;font-weight:900;font-family:var(--font-display);color:var(--text-primary);">${pad(t.hours)}:${pad(t.mins)}:${pad(t.secs)}</span>`;
        }
      }

      // Expanded card timers
      for (const [idx, el] of Object.entries(cardTimers)) {
        if (!el) continue;
        const t = tl(events[idx].deadline);
        if (!t) { rebuild = true; break; }
        el.innerHTML = timerHtml(t);
      }

      if (rebuild) buildCards();
    }

    // ── Init ──────────────────────────────────────────────────────
    buildCards();
    tick();
    setInterval(tick, 1000);
  })();
  </script>

  <!-- Notes Notice -->
  <div style="margin-bottom: 1.5rem; border: 1px solid rgba(6, 182, 212, 0.25); border-radius: var(--radius-sm); padding: 1rem; background: linear-gradient(135deg, rgba(6, 182, 212, 0.05) 0%, rgba(0, 0, 0, 0.15) 100%);">
    <div style="display: flex; align-items: flex-start; gap: 0.75rem;">
      <span style="font-size: 1.2rem;">📢</span>
      <div style="display: flex; flex-direction: column; gap: 0.25rem;">
        <span style="font-size: 0.95rem; font-weight: 700; color: #06b6d4; font-family: var(--font-display);">New Study Notes Added!</span>
        <span style="font-size: 0.85rem; color: var(--text-secondary); line-height: 1.4;">
          <strong>Psychology MDC</strong> notes added in both Hindi and English.<br/>
          <strong>Economics MDC</strong> notes added in both Hindi and English.
        </span>
      </div>
    </div>
  </div>

  <!-- Requests Completed Accordion -->
  <div class="completed-requests-accordion" style="margin-bottom: 2rem; border: 1px solid rgba(16, 185, 129, 0.25); border-radius: var(--radius-sm); overflow: hidden; background: linear-gradient(135deg, rgba(16, 185, 129, 0.02) 0%, rgba(0, 0, 0, 0.15) 100%);">
    <button 
      id="completed-requests-trigger"
      style="width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 1.25rem; background: transparent; border: none; cursor: pointer; text-align: left; transition: background 0.25s;"
