      </div>
    </div>
  </section>

  <!-- Donate Modal (No heavy GIF; QR lazy-loads on modal open) -->
  <div id="donate-modal-overlay" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:1rem;">
    <div style="background:var(--bg-secondary);border:1px solid rgba(245,158,11,0.32);border-radius:18px;width:100%;max-width:320px;box-shadow:0 20px 50px rgba(0,0,0,0.45);animation:donateModalIn 0.28s cubic-bezier(0.34,1.56,0.64,1) both;overflow:hidden;">
      <div style="display:flex;align-items:center;justify-content:space-between;padding:0.8rem 1rem 0.7rem;border-bottom:1px solid var(--border-color);">
        <div style="display:flex;align-items:center;gap:0.45rem;">
          <span style="font-size:1rem;">☕</span>
          <span style="font-size:0.88rem;font-weight:800;color:var(--text-accent-amber);font-family:var(--font-display);">Support KolhanHub</span>
        </div>
        <button type="button" id="donate-close" aria-label="Close modal" style="background:var(--surface-subtle);border:1px solid var(--border-color);border-radius:50%;width:28px;height:28px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--text-secondary);font-size:0.78rem;flex-shrink:0;">✕</button>
      </div>

      <div style="padding:1rem;display:flex;flex-direction:column;align-items:center;gap:0.75rem;text-align:center;">
        <div>
          <div style="font-size:0.9rem;font-weight:900;color:var(--text-accent-amber);font-family:var(--font-display);">Thank you for supporting! 💛</div>
          <div style="font-size:0.72rem;color:var(--text-secondary);margin-top:2px;">Scan the QR or tap to copy UPI ID</div>
        </div>

        <div style="display:flex;flex-direction:column;align-items:center;gap:0.5rem;">
          <div style="border:2px solid rgba(245,158,11,0.3);border-radius:14px;padding:6px;background:#ffffff;">
            <img
              id="donate-qr-img"
              data-src={`${baseUrl}/images/qr_phonepe.jpg`}
              alt="KolhanHub PhonePe UPI QR Code"
              width="180"
              height="180"
              style="width:180px;height:auto;border-radius:10px;display:block;"
            />
          </div>
          <a href={`${baseUrl}/images/qr_phonepe.jpg`} download="KolhanHub_PhonePe_QR.jpg" style="display:inline-flex;align-items:center;gap:0.3rem;font-size:0.68rem;font-weight:700;color:var(--text-secondary);text-decoration:none;background:var(--surface-subtle);border:1px solid var(--border-color);border-radius:20px;padding:4px 10px;">
            ⬇ Download QR
          </a>
        </div>

        <button type="button" id="upi-id-pill" title="Tap to copy UPI ID" style="display:inline-flex;align-items:center;gap:0.4rem;background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.28);border-radius:24px;padding:6px 14px;font-size:0.76rem;color:var(--text-accent-amber);font-family:monospace;cursor:pointer;">
          <span>💳</span>
          <span style="font-weight:700;">8002059887@ibl</span>
          <span style="font-size:0.62rem;font-weight:700;color:var(--text-tertiary);border-left:1px solid rgba(245,158,11,0.28);padding-left:0.4rem;">Copy</span>
          <span id="copy-tick" style="display:none;color:var(--text-accent-green);font-size:0.68rem;font-weight:700;">✓ copied</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    :root {
      --home-purple: #6d28d9;
    }
    html[data-theme="dark"] {
      --home-purple: #c084fc;
    }

    .home-hub-card {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      align-items: flex-start;
      padding: 0.75rem;
      text-decoration: none;
      min-width: 0;
    }
    .home-hub-icon {
      width: 34px;
      height: 34px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .home-hub-title {
      font-size: 0.92rem;
      font-weight: 800;
      font-family: var(--font-display);
      color: var(--text-primary);
      margin: 0;
    }
    .home-hub-sub {
      font-size: 0.7rem;
      color: var(--text-secondary);
      margin: 0.1rem 0 0;
      line-height: 1.3;
    }

    .home-pill {
      display: inline-flex;
      align-items: center;
      font-size: 0.69rem;
      font-weight: 700;
      color: var(--text-accent-indigo);
      background: rgba(99, 102, 241, 0.1);
      border: 1px solid rgba(99, 102, 241, 0.24);
      border-radius: 20px;
      padding: 3px 9px;
      text-decoration: none;
      white-space: nowrap;
    }
    .home-util-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-secondary);
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 20px;
      padding: 4px 9px;
      text-decoration: none;
      white-space: nowrap;
    }

    .home-kr-tile {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.2rem;
      padding: 0.55rem 0.25rem;
      border-radius: 10px;
      background: var(--surface-subtle);
      border: 1px solid var(--border-color);
      text-decoration: none;
      min-width: 0;
      text-align: center;
    }
    .home-kr-lbl {
      font-size: 0.68rem;
      font-weight: 800;
      color: var(--text-primary);
      white-space: nowrap;
    }

    .home-ch-tile {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      padding: 0.6rem 0.7rem;
      border-radius: 12px;
      border: 1px solid var(--border-color);
      text-decoration: none;
      min-width: 0;
    }

    .home-list-item {
      display: flex;
      gap: 0.6rem;
      align-items: center;
      padding: 0.58rem 0.72rem;
      background: var(--surface-subtle);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      text-decoration: none;
      transition: border-color 0.15s ease;
    }
    .home-list-item:hover {
      border-color: var(--accent-primary);
    }
    .home-list-title {
      font-size: 0.79rem;
      font-weight: 700;
      color: var(--text-primary);
      white-space: normal;
      line-height: 1.3;
    }
    .home-list-sub {
      font-size: 0.68rem;
      color: var(--text-secondary);
      margin-top: 2px;
      line-height: 1.35;
    }

    .home-trust-box {
      text-align: center;
      padding: 0.6rem 0.25rem;
      border-radius: 12px;
      background: var(--surface-subtle);
      border: 1px solid var(--border-color);
      min-width: 0;
    }
    .home-trust-val {
      font-size: 0.94rem;
      font-weight: 900;
      font-family: var(--font-display);
      line-height: 1.1;
    }
    .home-trust-lbl {
      font-size: 0.58rem;
      font-weight: 700;
      color: var(--text-tertiary);
      margin-top: 3px;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }

    .home-acc-row {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      padding: 0.85rem 0.95rem;
      background: transparent;
      border: none;
      cursor: pointer;
      text-align: left;
    }

    .home-faq-item {
      border: 1px solid var(--border-color);
      border-radius: 10px;
      background: var(--surface-subtle);
      padding: 0.6rem 0.8rem;
    }
    .home-faq-q {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.6rem;
      cursor: pointer;
      list-style: none;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1.4;
    }
    .home-faq-q::-webkit-details-marker {
      display: none;
    }
    .home-faq-a {
      margin: 0.5rem 0 0;
      font-size: 0.76rem;
      color: var(--text-secondary);
      line-height: 1.55;
    }

    @keyframes donateModalIn {
      from { opacity: 0; transform: scale(0.88) translateY(16px); }
      to   { opacity: 1; transform: scale(1) translateY(0); }
    }
  </style>

  <script is:inline>
    (function () {
      function bindAccordion(triggerId, contentId, chevronId) {
        var trigger = document.getElementById(triggerId);
        var content = document.getElementById(contentId);
        var chevron = document.getElementById(chevronId);
        if (!trigger || !content) return;
        var isOpen = false;
        trigger.addEventListener("click", function () {
          isOpen = !isOpen;
          if (isOpen) {
            content.style.maxHeight = content.scrollHeight + "px";
            if (chevron) chevron.style.transform = "rotate(90deg)";
          } else {
            content.style.maxHeight = "0";
            if (chevron) chevron.style.transform = "rotate(0deg)";
          }
        });
      }

      bindAccordion("completed-requests-trigger", "completed-requests-content", "completed-chevron");
      bindAccordion("contributors-trigger", "contributors-content", "contributors-chevron");
      bindAccordion("thankyou-toggle", "thankyou-content", "thankyou-chevron");

      // Donate modal with lazy QR image load
      var donateTriggers = document.querySelectorAll('[data-open-donate="true"]');
      var overlay = document.getElementById("donate-modal-overlay");
      var closeBtn = document.getElementById("donate-close");
      var qrImg = document.getElementById("donate-qr-img");
      var upiPill = document.getElementById("upi-id-pill");
      var copyTick = document.getElementById("copy-tick");
      var UPI_ID = "8002059887@ibl";

      function openDonate() {
        if (!overlay) return;
        if (qrImg && !qrImg.getAttribute("src")) {
          var ds = qrImg.getAttribute("data-src");
          if (ds) qrImg.setAttribute("src", ds);
        }
        overlay.style.display = "flex";
        document.body.style.overflow = "hidden";
      }
      function closeDonate() {
        if (!overlay) return;
        overlay.style.display = "none";
        document.body.style.overflow = "";
      }

      donateTriggers.forEach(function (btn) {
        btn.addEventListener("click", openDonate);
      });
      if (closeBtn) closeBtn.addEventListener("click", closeDonate);
      if (overlay) {
        overlay.addEventListener("click", function (e) {
          if (e.target === overlay) closeDonate();
        });
      }
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeDonate();
      });

      if (upiPill) {
        upiPill.addEventListener("click", function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(UPI_ID).then(function () {
              if (copyTick) {
                copyTick.style.display = "inline";
                setTimeout(function () { copyTick.style.display = "none"; }, 2000);
              }
            }).catch(function () {});
          }
        });
      }
    })();
  </script>
</Layout>
