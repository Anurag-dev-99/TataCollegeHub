}> = [
  { initial: 'A', gradient: 'linear-gradient(135deg, #14b8a6, #0d9488)', name: 'Afshan Ishaque', dept: 'Zoology', items: 'Sem 1 Major-01 PYQ (2022-25)' },
  { initial: 'A', gradient: 'linear-gradient(135deg, #f59e0b, #d97706)', name: 'Ayushi Kumari', items: 'Geo Major, PolSci Minor, Phil MDC, Digital Edu · Sem 1' },
  { initial: 'I', gradient: 'linear-gradient(135deg, #06b6d4, #0e7490)', name: 'ISHA KUMARI', items: 'Economics Minor, BBA PYQ · Sem 1' },
  { initial: 'I', gradient: 'linear-gradient(135deg, #ec4899, #be185d)', name: 'Isha Kumari', items: 'History MDC, Chem Minor · Sem 1' },
  { initial: 'G', gradient: 'linear-gradient(135deg, #3b82f6, #1d4ed8)', name: 'Gouranga (GG)', items: 'Maths Minor, Geo MDC · Sem 1' },
  { initial: 'P', gradient: 'linear-gradient(135deg, #a855f7, #7e22ce)', name: 'Pooja Rani Pradhan', items: 'Home Science MDC · Sem 1' },
  { initial: 'D', gradient: 'linear-gradient(135deg, #6366f1, #8b5cf6)', name: 'Dheeraj', items: 'Physics Major PYQ · Sem 1 & 2' },
  { initial: 'I', gradient: 'linear-gradient(135deg, #10b981, #059669)', name: 'Indra', items: 'Physics Major PYQ · Sem 3' },
  { initial: 'A', gradient: 'linear-gradient(135deg, #f59e0b, #d97706)', name: 'Ankit', items: 'Chemistry Major PYQ · Sem 1–3' },
  { initial: 'K', gradient: 'linear-gradient(135deg, #ec4899, #db2777)', name: 'Kirti Arya', items: 'Botany Major Syllabus' },
  { initial: 'S', gradient: 'linear-gradient(135deg, #a78bfa, #7c3aed)', name: 'Sunita', items: 'Maths Major PYQ · Sem 5' },
  { initial: 'R', gradient: 'linear-gradient(135deg, #f97316, #ea580c)', name: 'Ritik', items: 'Home Science MDC PYQ' },
  { initial: 'S', gradient: 'linear-gradient(135deg, #3b82f6, #2563eb)', name: 'Suman', items: 'MDC · Psychology, Geography, Economics' },
  { initial: 'R', gradient: 'linear-gradient(135deg, #0ea5e9, #0284c7)', name: 'Ravi Kumar', items: 'MDC Geography PYQ · Sem 1' },
  { initial: 'P', gradient: 'linear-gradient(135deg, #f472b6, #ec4899)', name: 'Priya Sinha', items: 'SEC Communication Skills' },
  { initial: 'A', gradient: 'linear-gradient(135deg, #84cc16, #65a30d)', name: 'Amit', items: 'MDC History PYQ · Sem 2' },
  { initial: 'D', gradient: 'linear-gradient(135deg, #fb7185, #e11d48)', name: 'Deepika', items: 'AEC Hindi PYQ · Sem 3' },
  { initial: 'N', gradient: 'linear-gradient(135deg, #34d399, #059669)', name: 'Neha Kumari', items: 'MDC Economics PYQ · Sem 1' }
];

// Visible FAQs + synced FAQPage JSON-LD
const faqItems = [
  {
    q: 'Is KolhanHub official, and does it cover all Kolhan University colleges?',
    a: 'KolhanHub is an independent, student-run unofficial resource portal for Kolhan University, Chaibasa. While it started at Tata College, Chaibasa, the PYQs, NEP FYUGP syllabus, holiday calendar, and results directory now serve students across all 37 constituent and affiliated Kolhan University colleges.'
  },
  {
    q: 'Are Kolhan University PYQs and NEP FYUGP Syllabus free to download?',
    a: `Yes — all ${totalPyqsAvailable}+ previous year question papers and NEP 2020 FYUGP syllabus PDFs across Major (MJ), Minor / AC, MDC, AEC, VAC, SEC, and IKS (Semester 1 to 8) are 100% free to open and download without login.`
  },
  {
    q: 'How can I check Kolhan University results or past MDC paper marks?',
    a: 'Use our Results page for college-wise links and Tata College batch dashboards, or use the quick search box on the homepage to jump straight to KolhanResult.in — where you can check marksheets by roll number or name across all 37 colleges and inspect past-batch MDC & subject marks on Paper Analysis.'
  },
  {
    q: 'How do KolhanHub Study Notes work, and can students sell their own notes?',
    a: 'Clean, exam-focused scanned notes (such as Sem 3 Maths Major MJ-04/MJ-05 and compulsory SEC-3) start at ₹39 with free sample PDFs at /notes/. Students who write clear semester notes can also sell them on KolhanHub via WhatsApp and earn a share from every sale.'
  }
];

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a
    }
  }))
}).replace(/</g, '\\u003c');

const hubListSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'KolhanHub Main Sections',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Kolhan University PYQs', url: 'https://kolhanhub.in/pyqs/' },
    { '@type': 'ListItem', position: 2, name: 'NEP FYUGP Syllabus', url: 'https://kolhanhub.in/syllabus/' },
    { '@type': 'ListItem', position: 3, name: 'Kolhan University Results', url: 'https://kolhanhub.in/results/' },
    { '@type': 'ListItem', position: 4, name: 'Study Notes Hub', url: 'https://kolhanhub.in/notes/' },
    { '@type': 'ListItem', position: 5, name: 'Holiday List 2026', url: 'https://kolhanhub.in/holiday-list/' },
    { '@type': 'ListItem', position: 6, name: 'CGPA Calculator', url: 'https://kolhanhub.in/cgpa/' }
  ]
}).replace(/</g, '\\u003c');
---

<Layout
  title="KolhanHub — Kolhan University PYQs, Syllabus & Result Hub"
  rawTitle={true}
  description="Free student hub for all 37 Kolhan University colleges (NEP FYUGP Sem 1–8): PYQ PDFs, official syllabus, results, holiday calendar, CGPA & study notes."
  keywords="KolhanHub, Kolhan Hub, Kolhan University, Kolhan University Chaibasa, Kolhan University PYQ, Kolhan University syllabus, Kolhan University result 2026, Kolhan University holiday list 2026, NEP 2020 FYUGP Kolhan University, Tata College Chaibasa"
  activeTab="home"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={faqSchema} />
    <script type="application/ld+json" set:html={hubListSchema} />
  </Fragment>

  <!-- 1. ULTRA-COMPACT HERO -->
  <section style="margin-bottom: 0.75rem; display: flex; flex-direction: column; gap: 0.3rem;">
    <div style="display: inline-flex; align-items: center; gap: 0.35rem; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.24); border-radius: var(--radius-full); padding: 0.18rem 0.65rem; width: fit-content; max-width: 100%; font-size: 0.66rem; font-weight: 700; color: var(--text-accent-indigo); letter-spacing: 0.01em;">
      🎓 All 37 KU Colleges • NEP FYUGP
    </div>

    <h1 style="font-size: clamp(1.28rem, 4.7vw, 1.82rem); font-family: var(--font-display); letter-spacing: -0.03em; font-weight: 850; line-height: 1.16; color: var(--text-primary); margin: 0;">
      Kolhan University PYQs, Syllabus, Results &amp; Notes
    </h1>

    <p style="color: var(--text-secondary); font-size: 0.82rem; line-height: 1.38; font-weight: 500; margin: 0;">
      Free student-run portal for all 37 colleges — Sem 1–8 (BA, BSc, BCom).
    </p>
  </section>

  <!-- 2. PRIMARY STUDY HUB (RIGHT AT TOP) -->
  <section style="margin-bottom: 0.85rem;">
    <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; margin-bottom: 0.65rem;">
      <a href={`${baseUrl}/pyqs/`} class="card card-interactive home-hub-card">
        <div class="home-hub-icon" style="background: rgba(16, 185, 129, 0.12); color: var(--text-accent-green);">
          <FileCode size={18} />
        </div>
        <div style="min-width: 0;">
          <h3 class="home-hub-title">PYQs</h3>
          <p class="home-hub-sub">{totalPyqsAvailable}+ Papers · Sem 1–8</p>
        </div>
      </a>

      <a href={`${baseUrl}/syllabus/`} class="card card-interactive home-hub-card">
        <div class="home-hub-icon" style="background: rgba(99, 102, 241, 0.12); color: var(--text-accent-indigo);">
          <FileSpreadsheet size={18} />
        </div>
        <div style="min-width: 0;">
          <h3 class="home-hub-title">Syllabus</h3>
          <p class="home-hub-sub">NEP FYUGP · All 7 Types</p>
        </div>
      </a>

      <a href={`${baseUrl}/results/`} class="card card-interactive home-hub-card">
        <div class="home-hub-icon" style="background: rgba(245, 158, 11, 0.12); color: var(--text-accent-amber);">
          <GraduationCap size={18} />
        </div>
        <div style="min-width: 0;">
          <h3 class="home-hub-title">Results</h3>
          <p class="home-hub-sub">All 37 Colleges &amp; Toppers</p>
        </div>
      </a>

      <a href={`${baseUrl}/notes/`} class="card card-interactive home-hub-card">
        <div class="home-hub-icon" style="background: rgba(168, 85, 247, 0.12); color: var(--home-purple);">
          <BookOpen size={18} />
        </div>
        <div style="min-width: 0;">
          <h3 class="home-hub-title">Study Notes</h3>
          <p class="home-hub-sub">Sem 3 PDFs · From ₹39</p>
        </div>
      </a>
    </div>

    <!-- Quick Syllabus Category Pills -->
    <div style="display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; margin-bottom: 0.5rem;">
      <span style="font-size: 0.62rem; font-weight: 800; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.05em; margin-right: 0.1rem;">
        Syllabus:
      </span>
      <a href={`${baseUrl}/syllabus/`} class="home-pill">Major</a>
      <a href={`${baseUrl}/syllabus/mdc/`} class="home-pill">MDC</a>
      <a href={`${baseUrl}/syllabus/aec/`} class="home-pill">AEC</a>
      <a href={`${baseUrl}/syllabus/vac/`} class="home-pill">VAC</a>
      <a href={`${baseUrl}/syllabus/sec/`} class="home-pill">SEC</a>
      <a href={`${baseUrl}/syllabus/iks/`} class="home-pill">IKS</a>
    </div>

    <!-- Utility Pills Row -->
    <div style="display: flex; align-items: center; gap: 0.38rem; flex-wrap: wrap;">
      <a href={`${baseUrl}/holiday-list/`} class="home-util-pill">📅 Holiday List</a>
      <a href={`${baseUrl}/cgpa/`} class="home-util-pill">🧮 CGPA Calc</a>
      <a href={`${baseUrl}/recheck/`} class="home-util-pill">🔁 Recheck Guide</a>
      <a href="https://www.kolhanuniversity.ac.in/event-and-news" target="_blank" rel="noopener noreferrer" class="home-util-pill">📰 KU News ↗</a>
      <a href={`${baseUrl}/exam-archive/`} class="home-util-pill">🗂 Exam Archive</a>
      <a href={`${baseUrl}/faq/`} class="home-util-pill">❓ FAQ</a>
    </div>
  </section>

  <!-- 3. LIVE IST COLLEGE OPEN/CLOSED HOLIDAY BAR (cleanly visible on Screen 1) -->
  <section style="margin-bottom: 1rem;">
    <a
      id="home-college-status"
      href={`${baseUrl}/holiday-list/`}
      style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; width: 100%; padding: 0.52rem 0.85rem; border-radius: 12px; background: rgba(16, 185, 129, 0.09); border: 1px solid rgba(16, 185, 129, 0.3); text-decoration: none; transition: border-color 0.2s ease, background 0.2s ease;"
    >
      <span id="home-status-dot" style="width: 8px; height: 8px; border-radius: 50%; background: var(--accent-success); flex-shrink: 0; box-shadow: 0 0 8px rgba(16,185,129,0.6);"></span>
      <span id="home-status-text" style="font-size: 0.77rem; font-weight: 700; color: var(--text-primary);">Check if college is open today</span>
      <span id="home-status-meta" style="font-size: 0.69rem; font-weight: 700; color: var(--text-accent-green); margin-left: auto;">Holiday List →</span>
    </a>
  </section>

  <script type="application/json" id="home-holidays-data" set:html={homeHolidaysJson}></script>
  <script is:inline>
    (function () {
      var el = document.getElementById("home-college-status");
      var dot = document.getElementById("home-status-dot");
      var txt = document.getElementById("home-status-text");
      var meta = document.getElementById("home-status-meta");
      var dataEl = document.getElementById("home-holidays-data");
      if (!el || !dot || !txt || !meta || !dataEl) return;
      var list = [];
      try { list = JSON.parse(dataEl.textContent || "[]"); } catch (e) { return; }
      var qDate = new URLSearchParams(window.location.search).get("date");
      var today = (qDate && /^\d{4}-\d{2}-\d{2}$/.test(qDate))
        ? qDate
        : new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Kolkata" }).format(new Date());
      var dateMap = Object.create(null);
      list.forEach(function (h) {
        (h.d || []).forEach(function (dt) { if (!dateMap[dt]) dateMap[dt] = h; });
      });
      var cur = dateMap[today] || null;
      var isSun = new Date(today + "T00:00:00Z").getUTCDay() === 0;
      function setTheme(accentVar, dotColor, bg, border, glow) {
        el.style.background = bg;
        el.style.borderColor = border;
        dot.style.background = dotColor;
        dot.style.boxShadow = "0 0 8px " + glow;
        meta.style.color = accentVar;
      }
      if (cur) {
        setTheme("var(--text-accent-red)", "#ef4444", "rgba(239, 68, 68, 0.1)", "rgba(239, 68, 68, 0.35)", "rgba(239,68,68,0.65)");
        txt.textContent = "College is closed today · " + cur.n;
        meta.textContent = "Holiday List →";
      } else if (isSun) {
        setTheme("var(--text-accent-red)", "#ef4444", "rgba(239, 68, 68, 0.1)", "rgba(239, 68, 68, 0.35)", "rgba(239,68,68,0.65)");
        txt.textContent = "College is closed today · Sunday";
        meta.textContent = "Holiday List →";
      } else if (today > "2026-12-31") {
        setTheme("var(--text-accent-indigo)", "#6366f1", "rgba(99, 102, 241, 0.1)", "rgba(99, 102, 241, 0.35)", "rgba(99,102,241,0.65)");
        txt.textContent = "Kolhan University Holiday List 2027";
        meta.textContent = "View Calendar →";
      } else {
        setTheme("var(--text-accent-green)", "#10b981", "rgba(16, 185, 129, 0.09)", "rgba(16, 185, 129, 0.3)", "rgba(16,185,129,0.65)");
        txt.textContent = "College is open today";
        var next = list.find(function (h) { return h.s > today; });
        if (next) {
          var daysAway = Math.round((new Date(next.s + "T00:00:00Z").getTime() - new Date(today + "T00:00:00Z").getTime()) / 86400000);
          meta.textContent = "Next: " + next.n + " (" + daysAway + "d) →";
        } else {
          meta.textContent = "Holiday List →";
        }
      }
    })();
  </script>

  <!-- 4. SEMESTER 7 RESULT RELEASED BANNER -->
  <section style="margin-bottom: 1rem;">
    <a
      href="https://kolhanresult.in/"
      target="_blank"
      rel="noopener noreferrer"
      onclick="if(window.trackDownload) window.trackDownload('note', { subject: 'Sem 7 Result KolhanResult', language: 'Home Quick Click', category: 'Home Result', medium: 'HOME' });"
      style="display: flex; align-items: center; justify-content: space-between; gap: 0.65rem; flex-wrap: wrap; padding: 0.8rem 0.9rem; border-radius: 14px; background: linear-gradient(135deg, rgba(16, 185, 129, 0.14) 0%, rgba(16, 185, 129, 0.04) 100%); border: 1px solid rgba(16, 185, 129, 0.4); text-decoration: none;"
    >
      <div style="display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; flex: 1 1 200px;">
        <span style="font-size: 0.62rem; font-weight: 800; color: var(--text-accent-green); letter-spacing: 0.03em; text-transform: uppercase;">
          🟢 Sem 7 Result Live · 2022–26 Batch
        </span>
        <span style="font-size: 0.84rem; font-weight: 800; color: var(--text-primary); font-family: var(--font-display); line-height: 1.3;">
          All Kolhan University Colleges · Search by Roll No. or Name
        </span>
      </div>
      <span style="display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.45rem 0.85rem; border-radius: 20px; background: #10b981; color: #051b11; font-size: 0.72rem; font-weight: 850; white-space: nowrap; flex-shrink: 0;">
        Check on KolhanResult <ExternalLink size={12} />
      </span>
    </a>
  </section>

  <!-- 5. SIMPLE, PUNCHY "EARN MONEY BY SELLING NOTES" CARD -->
  <section style="margin-bottom: 1rem;">
    <div style="border: 1.5px dashed rgba(168, 85, 247, 0.45); border-radius: 14px; padding: 0.85rem 0.9rem; background: linear-gradient(135deg, rgba(168, 85, 247, 0.08) 0%, rgba(16, 185, 129, 0.04) 100%); display: flex; flex-direction: column; gap: 0.5rem;">
      <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.45rem; flex-wrap: nowrap;">
        <h2 style="font-size: 0.9rem; font-weight: 850; font-family: var(--font-display); color: var(--text-primary); margin: 0; min-width: 0;">
