---
import Layout from '../layouts/Layout.astro';
import pyqsData from '../../public/data/pyqs.json';
import holidaysData from '../../public/data/holidays-2026.json';
import notesData from '../../public/data/notes.json';
import {
  FileSpreadsheet,
  FileCode,
  GraduationCap,
  ChevronRight,
  HelpCircle,
  BookOpen,
  ExternalLink
} from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

const homeHolidaysJson = JSON.stringify(
  holidaysData.map((h: any) => ({
    s: h.dates[0],
    e: h.dates[h.dates.length - 1],
    n: h.name.split(' (')[0],
    d: h.dates
  }))
).replace(/</g, '\\u003c');

// Real computed stats from pyqs.json (built at deploy time)
const pyqsWithUrl = pyqsData.filter((p: any) => p.downloadUrl);
const totalPyqsAvailable = pyqsWithUrl.length;
const uniqueSubjects = [...new Set(pyqsWithUrl.map((p: any) => p.subject))].length;

const buildDateStr = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
  timeZone: 'Asia/Kolkata'
}).format(new Date());

const waCreatorLink = `https://api.whatsapp.com/send?phone=${notesData.whatsapp}&text=${encodeURIComponent(
  "Hi KolhanHub! 💰 I'm interested in selling my semester notes on KolhanHub."
)}`;

const waContributeLink = `https://api.whatsapp.com/send?phone=${notesData.whatsapp}&text=${encodeURIComponent(
  'Hi KolhanHub! 📚 I have some study material to share for KolhanHub.'
)}`;

const sec3PyqUrl = `${baseUrl}/pyqs/sec/${encodeURIComponent('mathematical & computational thinking and analysis')}/3/`;

// Preserved 49 completed student requests
const completedRequests: Array<[string, string, string, string, string]> = [
