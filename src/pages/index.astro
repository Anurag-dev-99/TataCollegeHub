---
import Layout from '../layouts/Layout.astro';
import noticesData from '../../public/data/notices.json';
import calendarData from '../../public/data/calendar.json';
import pyqsData from '../../public/data/pyqs.json';
import { Bell, Calendar, Download, FileSpreadsheet, FileCode, GraduationCap, ChevronRight, AlertTriangle, Clock, ArrowRight, HelpCircle, Calculator } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');

// Filter and sort notices
const activeNotices = noticesData.filter(notice => !notice.isArchived);
const pinnedNotices = activeNotices.filter(notice => notice.isPinned);
const recentNotices = activeNotices.filter(notice => !notice.isPinned).slice(0, 3);

// Calculate total downloads from pyqs
const totalDownloads = pyqsData.reduce((acc, item) => acc + (item.downloadCount || 0), 0);

// Automated Deadline Parser
interface Deadline {
  title: string;
  dateStr: string;
  originalNoticeId: string;
}

const extractDeadlines = (): Deadline[] => {
  const deadlines: Deadline[] = [];
  const dateRegex = /(?:last date|deadline|form fill-up)[^.]*?((?:June|July|August|September|October|November|December|January|February|March|April|May)\s+\d{1,2},?\s+\d{4}|\d{1,2}\s+(?:June|July|August|September|October|November|December|January|February|March|April|May),?\s+\d{4}|\d{1,2}-\d{1,2}-\d{4})/i;

  activeNotices.forEach(notice => {
    const textToSearch = `${notice.title} ${notice.description}`;
    const containsKeyword = /last date|deadline|exam form|form fill/i.test(textToSearch);
    
    if (containsKeyword) {
      const match = textToSearch.match(dateRegex);
      if (match) {
        deadlines.push({
          title: notice.title.replace(/Examination | official | dates/gi, ''),
          dateStr: match[1],
          originalNoticeId: notice.id
        });
      }
    }
  });
  return deadlines;
};

const extractedDeadlines = extractDeadlines();
const primaryDeadline = extractedDeadlines[0] || null;

// Most popular papers (recent activity stats)
const popularPapers = [...pyqsData]
  .sort((a, b) => (b.downloadCount || 0) - (a.downloadCount || 0))
  .slice(0, 3);
---

<Layout title="Home Dashboard" activeTab="home">
  
  <!-- Header welcome -->
  <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); tracking: -0.03em;">Welcome to Student Hub</h1>
    <p style="color: var(--text-secondary); max-width: 600px; font-size: 1.05rem;">
      Your college syllabus, previous year question papers, exam notices, and results analytics — all optimized for your Android device.
    </p>
  </div>

  <!-- Automated Deadline Warning Banner -->
  {primaryDeadline && (
    <div class="deadline-banner" style="animation: fadeIn var(--transition-normal) forwards;">
      <div style="display: flex; align-items: flex-start; gap: 0.875rem; flex: 1;">
        <AlertTriangle style="color: var(--accent-danger); width: 24px; height: 24px; flex-shrink: 0; margin-top: 0.125rem;" />
        <div>
          <h3 style="font-size: 0.95rem; font-weight: 700; color: var(--text-primary);">
            Important Form Fill-up Alert
          </h3>
          <p style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.25rem;">
            Deadline detected for <strong>{primaryDeadline.title}</strong>: <span style="color: var(--accent-danger); font-weight: 700;">{primaryDeadline.dateStr}</span>
          </p>
        </div>
      </div>
      <a href={`${baseUrl}/notices#${primaryDeadline.originalNoticeId}`} class="btn btn-danger btn-sm" style="flex-shrink: 0; padding: 0.5rem 1rem; border-radius: var(--radius-sm);">
        View Notice <ArrowRight size="16" />
      </a>
    </div>
  )}

  <!-- Dedicated Request & Contribution Section -->
  <div class="card request-glow-card" style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1.25rem; border-color: var(--accent-primary); position: relative; overflow: hidden; background: linear-gradient(135deg, var(--bg-secondary) 0%, rgba(99, 102, 241, 0.05) 100%);">
    <div class="glow-border-highlight"></div>
    <div style="display: flex; gap: 1rem; align-items: flex-start;">
      <div style="background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); width: 48px; height: 48px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
        <HelpCircle size="24" />
      </div>
      <div>
        <h2 style="font-size: 1.2rem; font-family: var(--font-display); font-weight: 800; margin-bottom: 0.25rem;">Can't find your paper?</h2>
        <p style="color: var(--text-secondary); font-size: 0.9rem; line-height: 1.45;">
          Request any question paper, syllabus, or note. We'll try to add it soon. You can also submit papers you have to help your peers!
        </p>
      </div>
    </div>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.25rem;">
      <button class="btn btn-primary" onclick="document.dispatchEvent(new CustomEvent('open-request-modal'));" style="font-size: 0.875rem; font-weight: 700; height: 40px; padding: 0 1.25rem; border-radius: var(--radius-sm);">
        Request a Paper
      </button>
      <button class="btn btn-outline" onclick="document.dispatchEvent(new CustomEvent('open-submit-modal'));" style="font-size: 0.875rem; font-weight: 700; height: 40px; padding: 0 1.25rem; border-radius: var(--radius-sm); border-color: var(--border-color); color: var(--text-primary);">
        Submit a Paper
      </button>
    </div>
  </div>

  <!-- Local Requests List (Hidden by default unless there are requests in localStorage) -->
  <div id="local-requests-container" class="card" style="display: none; margin-bottom: 2rem; border-color: var(--accent-warning); background-color: rgba(245, 158, 11, 0.02);">
    <h3 style="font-size: 1.05rem; font-family: var(--font-display); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem; color: var(--accent-warning);">
      📂 Your Submitted Requests (Demo Mode)
    </h3>
    <div id="local-requests-list" style="display: flex; flex-direction: column; gap: 0.75rem;">
      <!-- JavaScript will populate this -->
    </div>
    <div style="margin-top: 1rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
      <span style="font-size: 0.75rem; color: var(--text-tertiary);">Saved locally in your browser's Local Storage.</span>
      <button id="clear-requests-btn" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 0.25rem 0.5rem; border-color: var(--border-color);">Clear List</button>
    </div>
  </div>

  <!-- Quick Grid Layout -->
  <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2.5rem;" class="md:grid-cols-3">
    
    <!-- Primary Info Cards -->
    <div class="md:col-span-2" style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Quick Navigation Grid -->
      <div>
        <h2 style="font-size: 1.25rem; margin-bottom: 1rem; font-family: var(--font-display);">Quick Actions</h2>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
          
          <a href={`${baseUrl}/syllabus`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start;">
            <div style="background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <FileSpreadsheet />
            </div>
            <div>
              <h3 style="font-size: 1rem; font-weight: 700;">View Syllabus</h3>
              <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">NEP FYUGP (Sem 1-8)</p>
            </div>
          </a>

          <a href={`${baseUrl}/pyqs`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start;">
            <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <FileCode />
            </div>
            <div>
              <h3 style="font-size: 1rem; font-weight: 700;">PYQ Database</h3>
              <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">Download previous papers</p>
            </div>
          </a>

          <a href={`${baseUrl}/results`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start;">
            <div style="background-color: rgba(245, 158, 11, 0.1); color: var(--accent-warning); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <GraduationCap />
            </div>
            <div>
              <h3 style="font-size: 1rem; font-weight: 700;">Results Portal</h3>
              <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">CGPA & toppers data</p>
            </div>
          </a>

          <a href={`${baseUrl}/notices`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start;">
            <div style="background-color: rgba(239, 68, 68, 0.1); color: var(--accent-danger); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <Bell />
            </div>
            <div>
              <h3 style="font-size: 1rem; font-weight: 700;">Notice Board</h3>
              <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">Latest KU announcements</p>
            </div>
          </a>

          <a href={`${baseUrl}/holidays`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start;">
            <div style="background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <Calendar />
            </div>
            <div>
              <h3 style="font-size: 1rem; font-weight: 700;">Holiday List</h3>
              <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">KU 2026 off-days & vacations</p>
            </div>
          </a>

          <a href={`${baseUrl}/cgpa`} class="card card-interactive" style="display: flex; flex-direction: column; gap: 0.75rem; align-items: flex-start;">
            <div style="background-color: rgba(16, 185, 129, 0.1); color: var(--accent-success); width: 44px; height: 44px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center;">
              <Calculator />
            </div>
            <div>
              <h3 style="font-size: 1rem; font-weight: 700;">CGPA Calculator</h3>
              <p style="font-size: 0.8rem; color: var(--text-secondary); margin-top: 0.25rem;">Check your SGPA to CGPA status</p>
            </div>
          </a>

        </div>
      </div>

      <!-- Recent Notices Section -->
      <div>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <h2 style="font-size: 1.25rem; font-family: var(--font-display);">Latest Notifications</h2>
          <a href={`${baseUrl}/notices`} style="font-size: 0.85rem; font-weight: 600; display: flex; align-items: center; gap: 0.25rem;">
            View All <ChevronRight size="16" />
          </a>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1rem;">
          
          <!-- Pinned Notices First -->
          {pinnedNotices.map(notice => (
            <div class="card" style="border-left: 4px solid var(--accent-primary); position: relative;">
              <div style="position: absolute; top: 1rem; right: 1rem;">
                <span class="badge badge-primary">Pinned</span>
              </div>
              <span style="font-size: 0.75rem; color: var(--text-tertiary); font-weight: 600;">{notice.date} • {notice.category}</span>
              <h3 style="font-size: 1.05rem; font-weight: 700; margin: 0.25rem 0 0.5rem 0; line-height: 1.3; padding-right: 4rem;">{notice.title}</h3>
              <p style="font-size: 0.875rem; color: var(--text-secondary); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                {notice.description}
              </p>
            </div>
          ))}

          <!-- Regular Notices -->
          {recentNotices.map(notice => (
            <div class="card">
              <span style="font-size: 0.75rem; color: var(--text-tertiary); font-weight: 600;">{notice.date} • {notice.category}</span>
              <h3 style="font-size: 1.05rem; font-weight: 700; margin: 0.25rem 0 0.5rem 0; line-height: 1.3;">{notice.title}</h3>
              <p style="font-size: 0.875rem; color: var(--text-secondary); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                {notice.description}
              </p>
            </div>
          ))}

        </div>
      </div>

    </div>

    <!-- Sidebar Info Column (Calendar, Recent Activity) -->
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      
      <!-- Event Calendar Section -->
      <div class="card" style="background-color: var(--bg-secondary); border-color: var(--border-color); padding: 1.5rem 1.25rem;">
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
          <Calendar style="color: var(--accent-primary);" /> Academic Calendar
        </h2>
        
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          {calendarData.map(event => (
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <div style="background-color: var(--bg-tertiary); width: 48px; height: 48px; border-radius: var(--radius-sm); display: flex; flex-direction: column; align-items: center; justify-content: center; flex-shrink: 0; border: 1px solid var(--border-color);">
                <span style="font-size: 0.7rem; font-weight: 800; text-transform: uppercase; color: var(--text-secondary); line-height: 1;">{event.month.substring(0, 3)}</span>
                <span style="font-size: 1.15rem; font-weight: 800; font-family: var(--font-display); color: var(--accent-primary); line-height: 1.1; margin-top: 2px;">{event.day}</span>
              </div>
              <div style="flex: 1;">
                <h3 style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary);">{event.title}</h3>
                <p style="font-size: 0.775rem; color: var(--text-secondary); margin-top: 0.125rem;">{event.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div style="margin-top: 1.25rem; border-top: 1px solid var(--border-color); padding-top: 1rem; text-align: center;">
          <a href={`${baseUrl}/holidays`} style="font-size: 0.85rem; font-weight: 700; display: inline-flex; align-items: center; gap: 0.35rem; color: var(--accent-primary);">
            View 2026 Holiday List <ArrowRight size="14" />
          </a>
        </div>
      </div>

      <!-- Quick Platform Stats & Activity -->
      <div class="card">
        <h2 style="font-size: 1.25rem; font-family: var(--font-display); margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
          <Clock style="color: var(--accent-success);" /> Activity Stats
        </h2>
        
        <!-- Stat items -->
        <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.25rem;">
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
            <span style="font-size: 0.85rem; color: var(--text-secondary);">Total PYQ Downloads</span>
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--accent-success);">{totalDownloads} papers</span>
          </div>
          <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 0.5rem;">
            <span style="font-size: 0.85rem; color: var(--text-secondary);">NEP Batch Coverage</span>
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--accent-primary);">100% NEP 2020</span>
          </div>
        </div>

        <h3 style="font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--text-tertiary); letter-spacing: 0.05em; margin-bottom: 0.75rem;">
          Trending Downloads
        </h3>
        
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {popularPapers.map(paper => (
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
              <div style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;">
                <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-primary);">{paper.subject}</span>
                <span style="font-size: 0.7rem; color: var(--text-secondary); display: block;">Sem {paper.semester} • {paper.year}</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.25rem; color: var(--text-secondary); font-size: 0.75rem; flex-shrink: 0; background: var(--bg-tertiary); padding: 0.25rem 0.5rem; border-radius: var(--radius-xs);">
                <Download size="12" /> {paper.downloadCount}
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>

  <script is:inline>
    const loadLocalRequests = () => {
      const container = document.getElementById('local-requests-container');
      const listEl = document.getElementById('local-requests-list');
      if (!container || !listEl) return;

      try {
        const requests = JSON.parse(localStorage.getItem('requests') || '[]');
        if (requests.length === 0) {
          container.style.display = 'none';
          return;
        }

        container.style.display = 'block';
        listEl.innerHTML = requests.map(req => {
          const typeLabel = req.type === 'pyq' ? '📄 PYQ' : req.type === 'syllabus' ? '📚 Syllabus' : '🔄 Both';
          const semesterText = req.semester === 'All' ? 'All Semesters' : `Sem ${req.semester}`;
          const batchText = (req.type !== 'syllabus' && req.session) ? ` • Batch ${req.session}` : '';
          const nameText = req.name ? req.name : 'Anonymous';

          return `
            <div style="display: flex; justify-content: space-between; align-items: flex-start; padding: 0.75rem; background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: var(--radius-sm); font-size: 0.85rem;">
              <div>
                <div style="font-weight: 700; color: var(--text-primary); display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
                  <span style="font-size: 0.75rem; padding: 0.1rem 0.35rem; background-color: rgba(99, 102, 241, 0.1); color: var(--accent-primary); border-radius: 4px; font-weight: 600;">${typeLabel}</span>
                  <span>${req.subject} (${req.category})</span>
                </div>
                <div style="font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.25rem;">
                  ${semesterText}${batchText} • Requested by ${nameText}
                </div>
              </div>
              <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.25rem; flex-shrink: 0; margin-left: 0.5rem;">
                <span class="badge badge-warning" style="font-size: 0.65rem; background-color: rgba(245, 158, 11, 0.1); color: var(--accent-warning); padding: 0.15rem 0.4rem; border-radius: var(--radius-full); font-weight: 600;">⏳ Pending</span>
                <span style="font-size: 0.65rem; color: var(--text-tertiary);">${new Date(req.date || Date.now()).toLocaleDateString()}</span>
              </div>
            </div>
          `;
        }).join('');
      } catch (err) {
        console.error(err);
      }
    };

    // Load initially
    loadLocalRequests();

    // Listen to changes (e.g. from modal submissions)
    window.addEventListener('storage', loadLocalRequests);
    
    // We can also poll or custom event to refresh when the modal is closed
    document.addEventListener('request-submitted', loadLocalRequests);

    // Clear handler
    document.getElementById('clear-requests-btn')?.addEventListener('click', () => {
      localStorage.removeItem('requests');
      loadLocalRequests();
    });
  </script>
</Layout>
