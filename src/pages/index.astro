    </div>

    <!-- Freshness & Disclaimer Strip -->
    <div style="display: flex; flex-direction: column; gap: 0.25rem; text-align: center; padding: 0.25rem 0.5rem;">
      <div style="font-size: 0.7rem; font-weight: 700; color: var(--text-tertiary);">
