---
import Layout from '../layouts/Layout.astro';
import { Calendar, FileText, MapPin, Award, ExternalLink, GraduationCap, ChevronDown } from '@lucide/astro';
import examData from '../../public/data/exam-archive.json';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout 
  title="Exam Archive — Kolhan University Exam Dates, Results & Notices (2022–2025)" 
  activeTab="exam-archive"
  description="Complete archive of Kolhan University exam dates, form fill-up schedules, exam center lists, result PDFs, and holiday lists for all FYUGP batches (2022, 2023, 2024, 2025). Organized by batch and semester."
  keywords="Kolhan University exam date, Kolhan University result, KU exam form fill up, Kolhan University exam center, Kolhan University holiday list, FYUGP exam schedule"
>

  <!-- Compact Header -->
  <div style="margin-bottom: 1.5rem;">
    <h1 style="font-size: 2rem; font-family: var(--font-display); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.25rem;">
      📋 Exam Archive
    </h1>
    <p style="color: var(--text-tertiary); font-size: 0.88rem;">
      Official exam dates, form fill-ups, exam centers & results — all batches.
    </p>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       HOLIDAY LISTS — Compact inline row
  ════════════════════════════════════════════════════════════════ -->
  <div class="card" style="margin-bottom: 1.5rem; padding: 0.85rem 1rem;">
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
      <span style="font-size: 0.85rem; font-weight: 700; color: var(--text-secondary); display: flex; align-items: center; gap: 0.4rem; white-space: nowrap;">
        🗓️ Holiday Lists
      </span>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        {examData.holidayLists.map(h => (
          <a 
            href={h.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="holiday-chip"
          >
            {h.year} <ExternalLink size="11" style="opacity: 0.5;" />
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       BATCH TABS — Compact pill buttons
  ════════════════════════════════════════════════════════════════ -->
  <div id="batch-tabs" style="display: flex; gap: 0.4rem; margin-bottom: 1.25rem; flex-wrap: wrap;">
    {examData.batches.map((batch, i) => (
      <button 
        class={`batch-tab ${i === 0 ? 'active' : ''}`}
        data-batch={batch.batch}
      >
        {batch.batch} Batch
      </button>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       BATCH PANELS — Compact semester rows
  ════════════════════════════════════════════════════════════════ -->
  {examData.batches.map((batch, batchIdx) => (
    <div class={`batch-panel ${batchIdx === 0 ? 'active' : ''}`} data-batch={batch.batch} style={batchIdx !== 0 ? 'display:none;' : ''}>
      
      <!-- Batch subtitle -->
      <p style="font-size: 0.78rem; color: var(--text-tertiary); margin-bottom: 1rem;">
        {batch.programme} • Session {batch.sessionRange}
      </p>

      <!-- Semester Cards -->
      <div style="display: flex; flex-direction: column; gap: 0.6rem;">
        {batch.semesters.map(sem => {
          const docs = [
            { key: 'examDate', label: 'Exam Date', shortLabel: 'Date', url: sem.examDate, color: '#6366f1', bg: 'rgba(99,102,241,0.1)', border: 'rgba(99,102,241,0.25)' },
            { key: 'formFillup', label: 'Form Fill-up', shortLabel: 'Form', url: sem.formFillup, color: '#f59e0b', bg: 'rgba(245,158,11,0.1)', border: 'rgba(245,158,11,0.25)' },
            { key: 'examCenter', label: 'Exam Center', shortLabel: 'Center', url: sem.examCenter, color: '#10b981', bg: 'rgba(16,185,129,0.1)', border: 'rgba(16,185,129,0.25)' },
            { key: 'result', label: 'Result', shortLabel: 'Result', url: sem.result, color: '#ef4444', bg: 'rgba(239,68,68,0.1)', border: 'rgba(239,68,68,0.25)' },
          ];
          const hasAny = docs.some(d => d.url);
          
          return (
            <div class="card sem-card" style={`padding: 0.75rem 1rem; ${!hasAny ? 'opacity: 0.4;' : ''}`}>
              <!-- Semester label + doc chips in one row -->
              <div style="display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 0.5rem; min-width: 90px;">
                  <span style={`display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 6px; font-size: 0.75rem; font-weight: 800; font-family: var(--font-display); ${hasAny ? 'background: rgba(99,102,241,0.1); color: #6366f1;' : 'background: var(--bg-tertiary); color: var(--text-tertiary);'}`}>
                    {sem.sem}
                  </span>
                  <span style="font-size: 0.88rem; font-weight: 700;">Sem {sem.sem}</span>
                </div>

                <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; flex: 1;">
                  {docs.map(doc => (
                    doc.url ? (
                      <a 
                        href={doc.url} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="doc-chip"
                        style={`background: ${doc.bg}; border-color: ${doc.border}; color: ${doc.color};`}
                      >
                        {doc.key === 'examDate' && <Calendar size="12" />}
                        {doc.key === 'formFillup' && <FileText size="12" />}
                        {doc.key === 'examCenter' && <MapPin size="12" />}
                        {doc.key === 'result' && <Award size="12" />}
                        <span class="doc-chip-label-full">{doc.label}</span>
                        <span class="doc-chip-label-short">{doc.shortLabel}</span>
                      </a>
                    ) : (
                      <div class="doc-chip doc-chip-empty">
                        {doc.key === 'examDate' && <Calendar size="12" />}
                        {doc.key === 'formFillup' && <FileText size="12" />}
                        {doc.key === 'examCenter' && <MapPin size="12" />}
                        {doc.key === 'result' && <Award size="12" />}
                        <span class="doc-chip-label-full">{doc.label}</span>
                        <span class="doc-chip-label-short">{doc.shortLabel}</span>
                      </div>
                    )
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Compact note -->
      <p style="font-size: 0.72rem; color: var(--text-tertiary); margin-top: 1rem; line-height: 1.5;">
        📌 All documents are official Kolhan University notices. Missing items (—) were not separately issued by the university. Updated as new notices are released.
      </p>
    </div>
  ))}

  <!-- SEO text — hidden visually lightweight but present for crawlers -->
  <section style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
    <details style="color: var(--text-tertiary); font-size: 0.82rem;">
      <summary style="cursor: pointer; font-weight: 600; color: var(--text-secondary); font-size: 0.85rem; margin-bottom: 0.5rem;">About This Archive</summary>
      <div style="line-height: 1.7; display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.75rem; max-width: 680px;">
        <p style="margin: 0;">
          This page is a curated archive of official Kolhan University exam-related documents for all FYUGP batches under the NEP 2020 framework. Kolhan University (Chaibasa, Jharkhand) transitioned to the Four-Year Undergraduate Programme starting with the 2022 admission batch, introducing a semester-based credit system with Major, Minor, MDC, AEC, SEC, VAC, and IKS components.
        </p>
        <p style="margin: 0;">
          Each batch goes through 8 semesters over 4 years. For every semester exam cycle, the university typically releases four key documents: an exam date sheet, a form fill-up notification with deadlines and fees, an exam center allotment list, and a result notification. We save these documents because the official university website often removes older notices when new ones are published.
        </p>
        <p style="margin: 0;">
          <strong>Disclaimer:</strong> KolhanHub is an unofficial student resource. All documents are official Kolhan University notices hosted on Google Drive. For the latest notices, check the <a href="https://www.kolhanuniversity.ac.in" target="_blank" rel="noopener noreferrer" style="color: var(--accent-primary);">official Kolhan University website</a>.
        </p>
      </div>
    </details>
  </section>

</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const tabs = document.querySelectorAll('.batch-tab');
    const panels = document.querySelectorAll('.batch-panel');
    
    tabs.forEach(tab => {
      tab.addEventListener('click', function() {
        const batch = this.dataset.batch;
        
        tabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');
        
        panels.forEach(p => {
          p.style.display = p.dataset.batch === batch ? 'block' : 'none';
        });
      });
    });
  });
</script>

<style>
  /* Batch Tab Pills */
  .batch-tab {
    padding: 0.5rem 1.1rem;
    border-radius: 100px;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-tertiary);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    transition: all 0.2s;
  }
  .batch-tab:hover {
    border-color: rgba(99,102,241,0.3);
    color: var(--text-secondary);
  }
  .batch-tab.active {
    background: rgba(99,102,241,0.12);
    color: #818cf8;
    border-color: rgba(99,102,241,0.35);
  }

  /* Holiday Chips */
  .holiday-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.7rem;
    border-radius: 100px;
    background: rgba(16,185,129,0.08);
    border: 1px solid rgba(16,185,129,0.2);
    color: #10b981;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s;
  }
  .holiday-chip:hover {
    background: rgba(16,185,129,0.15);
    transform: translateY(-1px);
  }

  /* Document Chips */
  .doc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.32rem 0.65rem;
    border-radius: 6px;
    border: 1px solid;
    font-size: 0.72rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s;
    white-space: nowrap;
  }
  a.doc-chip:hover {
    filter: brightness(1.15);
    transform: translateY(-1px);
  }
  .doc-chip-empty {
    background: var(--bg-tertiary) !important;
    border-color: var(--border-color) !important;
    color: var(--text-tertiary) !important;
    opacity: 0.5;
  }

  /* Responsive: show short labels on mobile, full labels on desktop */
  .doc-chip-label-short { display: none; }
  .doc-chip-label-full { display: inline; }

  @media (max-width: 600px) {
    .doc-chip-label-short { display: inline; }
    .doc-chip-label-full { display: none; }
    .doc-chip {
      padding: 0.28rem 0.5rem;
      font-size: 0.68rem;
    }
  }

  /* Semester card hover */
  .sem-card {
    transition: border-color 0.2s;
  }
  .sem-card:hover {
    border-color: rgba(99,102,241,0.2);
  }
</style>
